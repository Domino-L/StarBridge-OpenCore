<Project>
  <PropertyGroup>
    <Version>0.6.2</Version>
    <FileVersion>0.6.2</FileVersion>
    <AssemblyVersion>0.6.2</AssemblyVersion>
    <Authors>StarBridge contributors</Authors>
    <Copyright>Copyright 2026 StarBridge contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Domino-L/StarBridge-OpenCore</RepositoryUrl>
    <StarBridgeIncludeRestrictedGameData>false</StarBridgeIncludeRestrictedGameData>
    <StarBridgeIncludeCommercialAppearances>false</StarBridgeIncludeCommercialAppearances>
    <StarBridgeIncludeThirdPartyMedia>false</StarBridgeIncludeThirdPartyMedia>
  </PropertyGroup>
</Project>
