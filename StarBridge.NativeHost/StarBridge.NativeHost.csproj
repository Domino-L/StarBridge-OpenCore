<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StarBridge.NativeHost</AssemblyName>
    <!-- Shown names only (Task Manager uses AssemblyTitle as the file description); 0.7.3 rename to SCM StarBridge.
         AssemblyName and the exe file name stay: the updater and installer find the host by path. -->
    <Product>SCM StarBridge</Product>
    <AssemblyTitle>SCM StarBridge Native Host</AssemblyTitle>
    <Company>SCM StarBridge</Company>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' != ''">net8.0-windows$(StarBridgeTargetPlatformVersion)</TargetFramework>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' == ''">net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformVersion Condition="'$(StarBridgeTargetPlatformVersion)' != ''">$(StarBridgeTargetPlatformVersion)</TargetPlatformVersion>
    <TargetPlatformVersion Condition="'$(StarBridgeTargetPlatformVersion)' == ''">10.0.22621.0</TargetPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarBridge.HostRuntime\StarBridge.HostRuntime.csproj" />
    <ProjectReference Include="..\StarBridge.OverlayRuntime.Windows\StarBridge.OverlayRuntime.Windows.csproj" />
  </ItemGroup>

  <!-- Intentionally empty in local builds. Release packaging must explicitly
       supply the dedicated Flutter installer manifest, never the WPF endpoint. -->
  <ItemGroup>
    <AssemblyMetadata Include="StarBridgeFlutterInstallerManifestUrl" Value="$(StarBridgeFlutterInstallerManifestUrl)" />
    <AssemblyMetadata Include="StarBridgeFlutterInstallerManifestUrlsV2" Value="$(StarBridgeFlutterInstallerManifestUrlsV2)" />
    <AssemblyMetadata Include="StarBridgeEnableInstalledUpdates" Value="$(StarBridgeEnableInstalledUpdates)" />
    <AssemblyMetadata Include="StarBridgeEnableLegacyCleanup" Value="$(StarBridgeEnableLegacyCleanup)" />
    <AssemblyMetadata Include="StarBridgeEnableFirstUse" Value="$(StarBridgeEnableFirstUse)" />
    <AssemblyMetadata Include="StarBridgeEnableConnectionModes" Value="$(StarBridgeEnableFirstUse)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/Audio/cue-catalog.v1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="'$(StarBridgeAcceptanceMediaFree)' != 'true'" />
    <!-- The runtime reader intentionally does not search parent directories. -->
    <Content Include="../LICENSES/OFFICIAL-BINARY-LICENSE.txt" Link="OFFICIAL-BINARY-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The own-health reading model is cut from game HUD images: a private resource, staged only
         when present and restricted game data is not explicitly excluded. Without it the switch stays off. -->
    <Content Include="../.private-ops/hud-health/hud-health-v1.bin" Link="Assets/HudHealth/hud-health-v1.bin"
             Condition="Exists('../.private-ops/hud-health/hud-health-v1.bin') and '$(StarBridgeIncludeRestrictedGameData)' != 'false'"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Private acceptance resources are staged explicitly, not redistributed as public source. -->
    <Content Include="../.private-ops/notification-audio/*.wav" Link="Assets/Audio/%(Filename)%(Extension)"
             Condition="'$(StarBridgeAcceptanceMediaFree)' != 'true'"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateAcceptanceMediaFreeProfile" BeforeTargets="PrepareForBuild"
          Condition="'$(StarBridgeAcceptanceMediaFree)' == 'true'">
    <Error Condition="'$(StarBridgeIncludeRestrictedGameData)' != 'false' or '$(StarBridgeIncludeThirdPartyMedia)' != 'false'"
           Text="AcceptanceMediaFree requires both restricted game data and third-party media to be explicitly disabled." />
    <Error Condition="'$(StarBridgeEnableInstalledUpdates)' == 'true' or '$(StarBridgeEnableLegacyCleanup)' == 'true'"
           Text="AcceptanceMediaFree is a private test profile; installed updates and legacy cleanup must remain disabled." />
  </Target>

</Project>
