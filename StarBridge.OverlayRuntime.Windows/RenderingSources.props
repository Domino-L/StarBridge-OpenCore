<Project>
  <!-- Internal source remains single-owned during extraction. Public export maps
       this exact allowlist into Rendering; no legacy application is required. -->
  <PropertyGroup>
    <StarBridgeWindowsRenderingSourceRoot Condition="'$(StarBridgeWindowsRenderingSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)Rendering/NativeInformationOverlayRuntime.cs')">$(MSBuildThisFileDirectory)Rendering</StarBridgeWindowsRenderingSourceRoot>
    <StarBridgeWindowsRenderingSourceRoot Condition="'$(StarBridgeWindowsRenderingSourceRoot)' == ''">$(MSBuildThisFileDirectory)../StarBridge.Desktop</StarBridgeWindowsRenderingSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(StarBridgeWindowsRenderingSourceRoot)/CommunicationTimeFormatter.cs" Link="Rendering/CommunicationTimeFormatter.cs" />
