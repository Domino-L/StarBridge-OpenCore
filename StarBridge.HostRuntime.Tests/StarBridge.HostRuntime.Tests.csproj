<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' != ''">net8.0-windows$(StarBridgeTargetPlatformVersion)</TargetFramework>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' == ''">net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformVersion Condition="'$(StarBridgeTargetPlatformVersion)' != ''">$(StarBridgeTargetPlatformVersion)</TargetPlatformVersion>
    <TargetPlatformVersion Condition="'$(StarBridgeTargetPlatformVersion)' == ''">10.0.22621.0</TargetPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(StarBridgeSessionProbeEnabled)' == 'true'">$(DefineConstants);STARBRIDGE_SESSION_PROBE</DefineConstants>
    <StarBridgeMemberReadProbeEnabled Condition="'$(StarBridgeMemberReadProbeEnabled)' == ''">false</StarBridgeMemberReadProbeEnabled>
    <DefineConstants Condition="'$(StarBridgeMemberReadProbeEnabled)' == 'true'">$(DefineConstants);STARBRIDGE_MEMBER_READ_PROBE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarBridge.HostRuntime\StarBridge.HostRuntime.csproj" />
    <Compile Include="../shared/test-fixtures/CommunityImageFixtures.cs" Link="CommunityImageFixtures.cs" />
    <ProjectReference Include="..\StarBridge.NativeBridge\StarBridge.NativeBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="StarBridgeMemberReadProbeEnabled" Value="$(StarBridgeMemberReadProbeEnabled)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../StarBridge.Flutter/test/fixtures/official_fleet_governance/context-never-activated.relay.json" LogicalName="Governance.never.relay.json" />
    <EmbeddedResource Include="../StarBridge.Flutter/test/fixtures/official_fleet_governance/context-never-activated.bridge.json" LogicalName="Governance.never.bridge.json" />
    <!-- Test processes never resolve the user's configured data root (HostDataRoot). -->
    <RuntimeHostConfigurationOption Include="StarBridge.HostDataRoot.IsolatedTestProcess" Value="true" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('../StarBridge.Desktop/Data/starbridge_location_catalog.json')">
    <DefineConstants>$(DefineConstants);STARBRIDGE_LOCATION_CATALOG</DefineConstants>
  </PropertyGroup>
</Project>
