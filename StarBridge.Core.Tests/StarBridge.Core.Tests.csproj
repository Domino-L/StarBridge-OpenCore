<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarBridge.Core\StarBridge.Core.csproj" />
    <!-- Exercise the platform-free desktop geometry without moving UI into Core. -->
    <Compile Include="../StarBridge.OverlayRuntime.Windows/Rendering/OverlayEventStackLayout.cs" Link="DesktopGeometry/OverlayEventStackLayout.cs"
             Condition="Exists('../StarBridge.OverlayRuntime.Windows/Rendering/OverlayEventStackLayout.cs')" />
    <Compile Include="../StarBridge.Desktop/OverlayEventStackLayout.cs" Link="DesktopGeometry/OverlayEventStackLayout.cs"
             Condition="!Exists('../StarBridge.OverlayRuntime.Windows/Rendering/OverlayEventStackLayout.cs')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\data\overlay\information-overlay-layout-conformance-v1.json"
          Link="data\information-overlay-layout-conformance-v1.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
