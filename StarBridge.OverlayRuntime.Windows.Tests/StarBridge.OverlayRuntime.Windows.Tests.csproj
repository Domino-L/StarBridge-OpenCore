<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' != ''">net8.0-windows$(StarBridgeTargetPlatformVersion)</TargetFramework>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' == ''">net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StarBridge.OverlayRuntime.Windows/StarBridge.OverlayRuntime.Windows.csproj" />
    <Using Include="StarBridge.Core.Overlay" />
  </ItemGroup>
</Project>
