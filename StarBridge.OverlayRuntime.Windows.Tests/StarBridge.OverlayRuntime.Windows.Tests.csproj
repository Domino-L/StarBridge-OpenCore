<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' != ''">net8.0-windows$(StarBridgeTargetPlatformVersion)</TargetFramework>
    <TargetFramework Condition="'$(StarBridgeTargetPlatformVersion)' == ''">net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../StarBridge.OverlayRuntime.Windows/StarBridge.OverlayRuntime.Windows.csproj" />
    <Using Include="StarBridge.Core.Overlay" />
    <Compile Include="../StarBridge.HostRuntime.Tests/LocalOverlaySourceTests.cs" Link="Onboarding/LocalOverlaySourceTests.cs" />
    <Compile Include="../StarBridge.NativeHost/WindowsNotificationActivity.cs" Link="NativeHost/WindowsNotificationActivity.cs" />
    <Compile Include="../StarBridge.NativeHost/WindowsStorageFolderPicker.cs" Link="NativeHost/WindowsStorageFolderPicker.cs" />
    <!-- Only the regression harness links the old pure producer seam. The
         standalone renderer must still exclude MainWindow and its application. -->
    <Compile Include="../StarBridge.Desktop/FleetEventShipNormalizer.cs" Link="Legacy/FleetEventShipNormalizer.cs"
             Condition="Exists('../StarBridge.Desktop/FleetEventShipNormalizer.cs')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test processes never resolve the user's configured data root (HostDataRoot). -->
    <RuntimeHostConfigurationOption Include="StarBridge.HostDataRoot.IsolatedTestProcess" Value="true" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('../StarBridge.Flutter/assets/achievements/journey-lorville-earned.png')">
    <DefineConstants>$(DefineConstants);STARBRIDGE_JOURNEY_ART</DefineConstants>
  </PropertyGroup>
</Project>
