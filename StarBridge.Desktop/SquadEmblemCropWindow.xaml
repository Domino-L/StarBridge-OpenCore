<Window x:Class="StarBridge.Desktop.SquadEmblemCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="裁切方形图片"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="650"
        Height="730"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="10"
            Background="#F20A1823"
            BorderBrush="#3A6E87"
            BorderThickness="1"
            CornerRadius="2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid Background="#091722">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#29AFFF" />
                <Border Grid.Column="1" Margin="4,0" Background="#42CF7C" />
                <Border Grid.Column="2" Background="#173447" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="18,8,12,7"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="图片裁切"
                               Foreground="#69CCFF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="裁切方形图片"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="19"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="32"
                        Height="30"
                        Padding="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogCloseButton}"
                        ToolTip="关闭"
                        Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <TextBlock Text="拖动方框调整位置；使用下方滑块改变裁切范围。默认保留完整的方形画面。"
                           Margin="0,0,0,10"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <Border Grid.Row="1"
                        Background="#07131D"
                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8">
                    <Canvas x:Name="CropCanvas"
                            Background="{StaticResource FieldBackBrush}"
                            ClipToBounds="True"
                            MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp"
                            MouseMove="CropCanvas_MouseMove"
                            SizeChanged="CropCanvas_SizeChanged">
                        <Image x:Name="SourceImage" Stretch="Uniform" />
                        <Rectangle x:Name="ShadeTop" Fill="#A0000000" />
                        <Rectangle x:Name="ShadeLeft" Fill="#A0000000" />
                        <Rectangle x:Name="ShadeRight" Fill="#A0000000" />
                        <Rectangle x:Name="ShadeBottom" Fill="#A0000000" />
                        <Rectangle x:Name="CropFrame"
                                   Stroke="{StaticResource AccentBrush}"
                                   StrokeThickness="2"
                                   Fill="#0E29AFFF"
                                   Cursor="SizeAll" />
                    </Canvas>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="12,8"
                        Background="#66081723"
                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="裁切范围"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="20%–100%"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10.5" />
                        </StackPanel>
                        <Slider x:Name="CropScaleSlider"
                                Grid.Column="1"
                                Margin="8,0,10,0"
                                Minimum="20"
                                Maximum="100"
                                Value="100"
                                SmallChange="1"
                                LargeChange="5"
                                VerticalAlignment="Center"
                                ValueChanged="CropScaleSlider_ValueChanged" />
                        <TextBlock x:Name="CropScaleValueText"
                                   Grid.Column="2"
                                   Text="100%"
                                   Foreground="#69CCFF"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="18,10,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="方框内区域将作为最终图片"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Height="34"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="取消"
                        Click="Cancel_Click" />
                <Button Grid.Column="2"
                        Height="34"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="使用裁切结果"
                        Click="UseCrop_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
