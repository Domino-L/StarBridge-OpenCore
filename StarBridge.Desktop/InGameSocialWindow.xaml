<Window x:Class="StarBridge.Desktop.InGameSocialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarBridge.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="游戏内社交"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1080"
        Height="720"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <local:ImageDataConverter x:Key="SocialImageDataConverter" />

        <Style x:Key="InGameSocialTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style TargetType="TextBlock"
               BasedOn="{StaticResource InGameSocialTextBlockStyle}" />

        <Style x:Key="SocialListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17384C" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#102B3B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InGameConversationItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#123A52" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#102B3B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InGameChatComposerTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#102C3E" />
            <Setter Property="BorderBrush" Value="#2C6D8E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="InGameChatSendButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="InGameUnifiedChatMessageTemplate">
            <Grid x:Name="MessageRow" Margin="0,3,0,8">
                <Border x:Name="MessageContent"
                        MaxWidth="650"
                        Padding="8,6"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="{Binding SenderRoleBrush}"
                        BorderThickness="2,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MessageAvatar"
                              Grid.Column="0"
                              Width="34"
                              Height="34"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                            <ContentControl Tag="{Binding SenderAvatarImageData}"
                                            Style="{StaticResource IdentityBeaconAvatarFallbackStyle}"
                                            Foreground="{Binding SenderRoleBrush}" />
                            <Image Source="{Binding SenderAvatarImageData, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=68}"
                                   Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel x:Name="MessageBody"
                                    Grid.Column="2"
                                    MaxWidth="590">
                            <Grid x:Name="MessageMetadata"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MessageSender"
                                           Grid.Column="0"
                                           Text="{Binding SenderCallsign}"
                                           Foreground="{Binding SenderRoleBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="MessageGameId"
                                           Grid.Column="1"
                                           Text="{Binding SenderGameIdText}"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                                <Border x:Name="MessageRoleBadge"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="6,1"
                                        Background="#102536"
                                        BorderBrush="{Binding SenderRoleBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding RoleVisibility}">
                                    <TextBlock Text="{Binding SenderRoleTitle}"
                                               Foreground="{Binding SenderRoleBrush}"
                                               FontSize="9" />
                                </Border>
                                <TextBlock x:Name="MessageTime"
                                           Grid.Column="3"
                                           Text="{Binding TimeText}"
                                           Margin="9,0,0,0"
                                           Foreground="#637A89"
                                           FontFamily="Bahnschrift"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="MessageBodyText"
                                       Text="{Binding Text}"
                                       Visibility="{Binding TextVisibility}"
                                       MaxWidth="590"
                                       Margin="0,6,0,0"
                                       Foreground="#D8E5EC"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <Border x:Name="MessageAttachmentCard"
                                    Width="410"
                                    MaxWidth="590"
                                    Margin="0,8,0,0"
                                    Padding="12,10"
                                    HorizontalAlignment="Left"
                                    Background="#C10A1823"
                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding AttachmentVisibility}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding SenderRoleBrush}"
                                            CornerRadius="1" />
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,14,0">
                                        <TextBlock Text="{Binding AttachmentTypeText}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AttachmentTitle}"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AttachmentSummary}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   LineHeight="17"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AttachmentRoomActivityText}"
                                                   Margin="0,7,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding AttachmentRoomDetailsVisibility}" />
                                        <TextBlock Text="{Binding AttachmentRoomFactsText}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding AttachmentRoomDetailsVisibility}" />
                                        <Button Content="{Binding AttachmentActionText}"
                                                Tag="{Binding Attachment}"
                                                IsEnabled="{Binding AttachmentActionEnabled}"
                                                Margin="0,9,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="ChatAttachmentActionButton_Click" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="7,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#1421312B"
                                            BorderBrush="{Binding AttachmentStatusBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Visibility="{Binding AttachmentStatusVisibility}">
                                        <TextBlock Text="{Binding AttachmentStatusText}"
                                                   Foreground="{Binding AttachmentStatusBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter TargetName="MessageContent" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="MessageContent" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="MessageContent" Property="BorderThickness" Value="0,0,2,0" />
                    <Setter TargetName="MessageAvatar" Property="Grid.Column" Value="2" />
                    <Setter TargetName="MessageBody" Property="Grid.Column" Value="0" />
                    <Setter TargetName="MessageMetadata" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="MessageBodyText" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="MessageBodyText" Property="TextAlignment" Value="Right" />
                    <Setter TargetName="MessageAttachmentCard" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="MessageTime" Property="Grid.Column" Value="0" />
                    <Setter TargetName="MessageTime" Property="Margin" Value="0" />
                    <Setter TargetName="MessageRoleBadge" Property="Grid.Column" Value="1" />
                    <Setter TargetName="MessageRoleBadge" Property="Margin" Value="8,0,0,0" />
                    <Setter TargetName="MessageGameId" Property="Grid.Column" Value="2" />
                    <Setter TargetName="MessageGameId" Property="Margin" Value="8,0,0,0" />
                    <Setter TargetName="MessageSender" Property="Grid.Column" Value="3" />
                    <Setter TargetName="MessageSender" Property="Margin" Value="8,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="InGameUnifiedChatMessageListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemTemplate" Value="{StaticResource InGameUnifiedChatMessageTemplate}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource AccentDimBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Height="2"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}"
                    Opacity="0.72"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False" />

            <Border Grid.Row="0"
                    Background="#F0162634"
                    BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="游戏内社交"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderDetailText"
                                   Text="不离开游戏，也能联系好友和队友"
                                   Margin="0,1,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10" />
                    </StackPanel>

                    <Button x:Name="DirectMessagesSectionButton"
                            Grid.Column="1"
                            Height="32"
                            Margin="4,0"
                            Content="私聊"
                            Style="{StaticResource SecondaryButton}"
                            Click="DirectMessagesSectionButton_Click" />
                    <Button x:Name="ChannelsSectionButton"
                            Grid.Column="2"
                            Height="32"
                            Margin="4,0"
                            Content="频道"
                            Style="{StaticResource SecondaryButton}"
                            Click="ChannelsSectionButton_Click" />
                    <Button Grid.Column="3"
                            Tag="Minimize"
                            ToolTip="最小化"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeButton_Click" />
                    <Button Grid.Column="4"
                            Tag="Close"
                            ToolTip="关闭社交窗口"
                            Style="{StaticResource CloseWindowCaptionButton}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid x:Name="UnavailablePanel"
                      Visibility="Collapsed">
                    <StackPanel Width="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="登录后使用游戏内社交"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SocialUnavailableDetailText"
                                   Text="登录星海舰桥账号后，即可联系好友、舰队成员和房间队友。"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SocialContentPanel">
                    <Grid x:Name="FriendsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FriendSearchBox"
                                     Height="34"
                                     Padding="11,4"
                                     VerticalContentAlignment="Center"
                                     Background="#102C3E"
                                     BorderBrush="#2C6D8E"
                                     BorderThickness="1"
                                     Foreground="{StaticResource PrimaryTextBrush}"
                                     FontSize="12"
                                     TextOptions.TextFormattingMode="Ideal"
                                     KeyDown="FriendSearchBox_KeyDown"
                                     ToolTip="按呼号或游戏 ID 查找用户" />
                            <Button Grid.Column="1"
                                    Content="查找用户"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="FriendSearchButton_Click" />
                            <Button Content="刷新"
                                    Grid.Column="2"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="RefreshButton_Click" />
                        </Grid>

                        <Border x:Name="IncomingRequestsPanel"
                                Grid.Row="1"
                                MaxHeight="190"
                                Margin="2,0,2,12"
                                Padding="10"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="收到的好友申请"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="IncomingRequestList"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="32" Height="32">
                                                    <Border Background="#142B3A"
                                                            BorderBrush="#31566C"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding Initials}"
                                                                   Foreground="#77CFFF"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding AvatarSource, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=64}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Callsign}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold" />
                                                     <TextBlock Text="{Binding GameId}"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                FontSize="10" />
                                                 </StackPanel>
                                                 <Button Grid.Column="2"
                                                         Height="30"
                                                         Margin="4,0"
                                                        Content="接受"
                                                        Tag="accept"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Click="FriendActionButton_Click" />
                                                 <Button Grid.Column="3"
                                                         Height="30"
                                                        Margin="4,0"
                                                        Content="拒绝"
                                                        Tag="reject"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="FriendActionButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid x:Name="FriendCollectionPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FriendDirectoryStatusText"
                                           Margin="3,0,3,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="正在加载好友…" />
                            <ListBox x:Name="FriendList"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SocialListItemStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="FriendList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding PresenceBrush}" />
                                                <Grid Grid.Column="1"
                                                      Width="42"
                                                      Height="42"
                                                      Margin="10,0,0,0">
                                                    <Border Background="#142B3A"
                                                            BorderBrush="#31566C"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding Initials}"
                                                                   Foreground="#77CFFF"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding AvatarSource, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=84}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                                <StackPanel Grid.Column="2"
                                                            Margin="12,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Callsign}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding GameId}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10" />
                                                        <Ellipse Width="5"
                                                                 Height="5"
                                                                 Margin="10,0,6,0"
                                                                 Fill="{Binding PresenceBrush}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PresenceText}"
                                                                   Foreground="{Binding PresenceBrush}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3"
                                                           Text="开始私聊  ›"
                                                           Foreground="#69CCFF"
                                                           FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="FriendsEmptyState"
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="还没有好友"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                 <TextBlock Text="在上方搜索呼号或游戏 ID，发送好友申请。"
                                            Margin="0,6,0,0"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="11"
                                            TextAlignment="Center" />
                            </StackPanel>
                            </Grid>

                            <Grid x:Name="SearchResultsPanel"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FriendSearchStatusText"
                                           Margin="3,0,3,8"
                                           Text="输入呼号或游戏 ID 查找用户"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10" />
                                <ListBox x:Name="FriendSearchResultList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7"
                                                    Padding="11"
                                                    Background="{StaticResource AvionicsGlassPanelBrush}"
                                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="108" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="36" Height="36">
                                                        <Border Background="#142B3A"
                                                                BorderBrush="#31566C"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding Initials}"
                                                                       Foreground="#77CFFF"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding AvatarSource, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=72}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="9,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Callsign}"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold" />
                                                         <TextBlock Text="{Binding GameId}"
                                                                    Foreground="{StaticResource MutedTextBrush}"
                                                                    FontSize="10" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Height="30"
                                                            Content="{Binding PrimaryActionText}"
                                                            Tag="{Binding PrimaryAction}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="FriendActionButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ChatPanel"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource AvionicsGlassRaisedBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="14,12"
                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="CommunicationDirectoryTitleText"
                                                       Text="私聊"
                                                       Foreground="#EEF8FF"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="CommunicationDirectoryDetailText"
                                                       Text="只显示与好友的一对一消息"
                                                       Margin="0,3,0,0"
                                                       Foreground="#637A89"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <Button Content="刷新"
                                                Width="64"
                                                Height="30"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="RefreshButton_Click" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="ConversationList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource InGameConversationItemStyle}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="ConversationList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10"
                                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        BorderBrush="#3428576F"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{Binding PresenceBrush}" />
                                                        <Grid Grid.Column="1"
                                                              Width="36"
                                                              Height="36"
                                                              Margin="8,0,0,0">
                                                            <Border Background="#142B3A"
                                                                    BorderBrush="{Binding PresenceBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding AvatarFallbackText}"
                                                                           Foreground="{Binding PresenceBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image Source="{Binding AvatarSource, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=72}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="2"
                                                                    Margin="10,0,8,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Callsign}"
                                                                       Foreground="#EEF8FF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Preview}"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="#78909F"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ContextText}"
                                                                       Margin="0,3,0,0"
                                                                       Foreground="#557D94"
                                                                       FontSize="9"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding UpdatedAtText}"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="#637A89"
                                                                       FontFamily="Bahnschrift"
                                                                       FontSize="9" />
                                                            <Border Height="19"
                                                                    Margin="0,4,0,0"
                                                                    Padding="6,0"
                                                                    HorizontalAlignment="Right"
                                                                    Background="#173247"
                                                                    BorderBrush="#2B759A"
                                                                    BorderThickness="1"
                                                                    Visibility="{Binding RequestBadgeVisibility}">
                                                                <TextBlock Text="{Binding ConversationStateText}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#78CFF4"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border MinWidth="20"
                                                                    Height="20"
                                                                    Margin="0,5,0,0"
                                                                    Padding="5,0"
                                                                    HorizontalAlignment="Right"
                                                                    Background="#174E6E"
                                                                    BorderBrush="#29AFFF"
                                                                    BorderThickness="1"
                                                                    Visibility="{Binding UnreadVisibility}">
                                                                <TextBlock Text="{Binding UnreadText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#EEF8FF"
                                                                           FontFamily="Bahnschrift"
                                                                           FontSize="9" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="ConversationEmptyState"
                                                Width="240"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ConversationEmptyTitleText"
                                                   Text="还没有私聊会话"
                                                   Foreground="#CFE7F4"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center" />
                                        <TextBlock x:Name="ConversationEmptyDetailText"
                                                   Text="从好友列表选择一位好友，即可开始私聊。"
                                                   Margin="0,6,0,0"
                                                   Foreground="#637A89"
                                                   FontSize="10"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <StackPanel x:Name="ChatNoSelectionState"
                                            Width="420"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="ChatNoSelectionTitleText"
                                               Text="选择一位好友"
                                               Foreground="#CFE7F4"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="ChatNoSelectionDetailText"
                                               Text="从左侧选择一位好友开始私聊。"
                                               Margin="0,7,0,0"
                                               Foreground="#637A89"
                                               FontSize="10"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid x:Name="ChatActivePanel"
                                      Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Margin="20,15,20,13"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Grid x:Name="ActiveUserHeader">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="36" Height="36">
                                                <Border Background="#142B3A"
                                                        BorderBrush="{Binding PresenceBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding AvatarFallbackText}"
                                                               Foreground="{Binding PresenceBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding AvatarSource, Converter={StaticResource SocialImageDataConverter}, ConverterParameter=72}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,12,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="ActiveUserNameText"
                                                               Text="选择一个聊天"
                                                               Foreground="#EEF8FF"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ActiveUserPresenceText"
                                                               Margin="9,0,0,0"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="ActiveUserRelationText"
                                                               Margin="9,0,0,0"
                                                               Foreground="#63C7FF"
                                                               FontSize="10"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="ActiveUserDetailText"
                                                           Text="从左侧选择一位好友或一个频道"
                                                           Margin="0,2,0,0"
                                                           Foreground="#637A89"
                                                           FontSize="10" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1"
                                          Background="#07141E">
                                        <Border BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                BorderThickness="0,1,0,1" />
                                        <ListBox x:Name="MessageList"
                                                 Style="{StaticResource InGameUnifiedChatMessageListStyle}" />
                                        <StackPanel x:Name="MessageEmptyState"
                                                    Width="360"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="发送第一条消息"
                                                       Foreground="#CFE7F4"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="在下方输入消息，开始聊天。"
                                                       Margin="0,6,0,0"
                                                       Foreground="#637A89"
                                                       FontSize="10"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Margin="18,14,18,16"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ChatAttachmentButton"
                                                        Width="40"
                                                        Height="40"
                                                        Margin="0,0,10,0"
                                                        Content="＋"
                                                        FontSize="18"
                                                        Style="{StaticResource SecondaryButton}"
                                                        ToolTip="发送预设或邀请"
                                                        Click="ChatAttachmentButton_Click" />
                                                <TextBox x:Name="MessageInputBox"
                                                         Grid.Column="1"
                                                         Height="40"
                                                         MaxLength="1000"
                                                         Padding="12,4"
                                                         FontSize="12"
                                                         Style="{StaticResource InGameChatComposerTextBoxStyle}"
                                                         ToolTip="Enter 发送；Shift+Enter 换行"
                                                         KeyDown="MessageInputBox_KeyDown" />
                                                <Button x:Name="SendButton"
                                                        Grid.Column="2"
                                                        Content="发送"
                                                        Style="{StaticResource InGameChatSendButtonStyle}"
                                                        Click="SendButton_Click" />
                                            </Grid>
                                            <Grid Grid.Row="1"
                                                  Margin="0,7,0,0">
                                                <TextBlock x:Name="StatusText"
                                                           Text="选择好友或频道后即可发送消息"
                                                           Foreground="#637A89"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Enter 发送 · Shift+Enter 换行 · 最多 1000 字"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#506775"
                                                           FontSize="9" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
