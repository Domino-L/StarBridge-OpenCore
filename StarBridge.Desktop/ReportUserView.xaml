<UserControl x:Class="StarBridge.Desktop.ReportUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
             Focusable="True"
             Background="{DynamicResource BridgeGround}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BridgeGround}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <!-- Kept for the existing image-report constructor; the application layer owns the visible title. -->
            <TextBlock x:Name="HeadingText"
                       Text="举报用户"
                       Visibility="Collapsed" />
            <TextBlock x:Name="DescriptionText"
                       Text="请选择最符合实际情况的原因。举报提交后会记录在“通知中心 → 我的举报”。"
                       VerticalAlignment="Center"
                       Style="{StaticResource BridgeBodyTextStyle}"
                       TextWrapping="Wrap" />
        </Grid>

        <controls:ChamferBorder Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="14,12"
                                Style="{StaticResource BridgeDirectorySurfaceStyle}">
            <StackPanel>
                <TextBlock Text="举报对象"
                           Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                <TextBlock x:Name="TargetNameText"
                           Margin="0,4,0,0"
                           Style="{StaticResource BridgeDirectoryFieldPrimaryValueTextStyle}" />
            </StackPanel>
        </controls:ChamferBorder>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="举报原因"
                       Style="{StaticResource BridgeDirectoryLabelStyle}" />
            <ComboBox x:Name="ReasonComboBox"
                      Height="36"
                      Margin="0,7,0,0"
                      SelectedIndex="-1"
                      DisplayMemberPath="Label"
                      Style="{StaticResource BridgeDirectoryComboBoxStyle}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="补充说明（选填）"
                       Style="{StaticResource BridgeDirectoryLabelStyle}" />
            <TextBox x:Name="DetailsTextBox"
                     Grid.Row="1"
                     Margin="0,7,0,0"
                     Padding="10"
                     MaxLength="1000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource BridgeDirectoryTextBoxStyle}"
                     TextChanged="DetailsTextBox_TextChanged" />
            <TextBlock x:Name="DetailsCountText"
                       Grid.Row="2"
                       Text="0 / 1000"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource BridgeDirectoryAuxTextStyle}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="请勿使用举报功能骚扰他人或重复提交相同内容。"
                       VerticalAlignment="Center"
                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="取消"
                    Height="34"
                    MinWidth="76"
                    Margin="12,0,8,0"
                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                    Click="CancelButton_Click" />
            <Button Grid.Column="2"
                    Content="提交举报"
                    Height="34"
                    MinWidth="96"
                    Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                    Click="SubmitButton_Click" />
        </Grid>
    </Grid>
</UserControl>
