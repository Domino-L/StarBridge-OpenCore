<UserControl x:Class="StarBridge.Desktop.ReportUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{StaticResource PageBackgroundBrush}">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SAFETY"
                       Foreground="#FFB54F"
                       FontSize="10"
                       FontWeight="SemiBold" />
            <TextBlock Text="举报用户"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="请选择最符合实际情况的原因。举报提交后会记录在“通知中心 → 我的举报”。"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="12"
                Background="#0A1D2A"
                BorderBrush="#28536B"
                BorderThickness="1"
                CornerRadius="2">
            <StackPanel>
                <TextBlock Text="举报对象"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10" />
                <TextBlock x:Name="TargetNameText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="举报原因"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="ReasonComboBox"
                      Height="36"
                      Margin="0,7,0,0"
                      SelectedIndex="-1"
                      DisplayMemberPath="Label" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="补充说明（选填）"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <TextBox x:Name="DetailsTextBox"
                     Grid.Row="1"
                     Margin="0,7,0,0"
                     Padding="10"
                     MaxLength="1000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="DetailsTextBox_TextChanged" />
            <TextBlock x:Name="DetailsCountText"
                       Grid.Row="2"
                       Text="0 / 1000"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="请勿使用举报功能骚扰他人或重复提交相同内容。"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="取消"
                    Height="34"
                    MinWidth="76"
                    Margin="12,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click" />
            <Button Grid.Column="2"
                    Content="提交举报"
                    Height="34"
                    MinWidth="96"
                    Style="{StaticResource PrimaryButton}"
                    Click="SubmitButton_Click" />
        </Grid>
    </Grid>
</UserControl>
