<Window x:Class="StarBridge.Desktop.HangarReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
        Title="官网机库扫描器"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BridgeGround}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="HangarReaderWindow_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BridgeCaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BridgeCloseCaptionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource BridgeCaptionButtonStyle}">
                <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BridgeGround}"
            BorderBrush="{DynamicResource BridgeHairline}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Height="2"
                    VerticalAlignment="Top"
                    Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Opacity="0.72"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False" />

            <Border Grid.Row="0"
                    Background="{DynamicResource BridgeRail}"
                    BorderBrush="{DynamicResource BridgeHairline}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,11,0"
                                Background="{DynamicResource BridgePanelRaised}"
                                BorderBrush="{DynamicResource BridgeHairline}"
                                BorderThickness="1">
                            <Image Source="/Assets/Brand/StarBridge_AppIcon.ico"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="官网机库扫描器"
                                       Style="{StaticResource BridgeSceneTitleTextStyle}" />
                            <TextBlock Text="读取 RSI My Hangar，并导入星海舰桥"
                                       Margin="0,1,0,0"
                                       Style="{StaticResource BridgeSceneMetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="—"
                            Tag="Minimize"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化"
                            Style="{StaticResource BridgeCaptionButtonStyle}"
                            Click="MinimizeWindowButton_Click" />
                    <Button Grid.Column="2"
                            x:Name="MaximizeWindowButton"
                            Content="□"
                            Tag="Maximize"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化"
                            Style="{StaticResource BridgeCaptionButtonStyle}"
                            Click="MaximizeWindowButton_Click" />
                    <Button Grid.Column="3"
                            Content="×"
                            Tag="Close"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭"
                            Style="{StaticResource BridgeCloseCaptionButtonStyle}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:ChamferBorder Grid.Row="0"
                                        Style="{StaticResource BridgeDirectoryHeaderStyle}"
                                        Margin="0,0,0,12"
                                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,2,12,2"
                                Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="机库地址"
                                       Margin="0,0,0,4"
                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                            <TextBox x:Name="AddressBox"
                                     Style="{StaticResource BridgeDirectoryTextBoxStyle}"
                                     Text="https://robertsspaceindustries.com/en/account/pledges" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="GoButton"
                                Margin="0,18,8,0"
                                Content="打开"
                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                Click="GoButton_Click" />
                        <Button Grid.Column="3"
                                x:Name="ScanFullHangarButton"
                                Margin="0,18,8,0"
                                Content="扫描整库"
                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                Click="ScanFullHangarButton_Click" />
                        <Button Grid.Column="4"
                                x:Name="ImportButton"
                                Margin="0,18,0,0"
                                Content="导入舰船库"
                                IsEnabled="False"
                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                Click="ImportButton_Click" />
                    </Grid>
                </controls:ChamferBorder>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="382" />
                    </Grid.ColumnDefinitions>

                    <controls:ChamferBorder Grid.Column="0"
                                            Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                            Padding="0"
                                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="13,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,8,0"
                                             Fill="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="RSI 机库网页"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <TextBlock Grid.Column="2"
                                               Text="官方网页通道"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BridgeDirectoryAuxTextStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{DynamicResource BridgeGround}">
                                <wv2:WebView2 x:Name="HangarWebView"
                                              Source="https://robertsspaceindustries.com/en/account/pledges" />
                            </Border>
                        </Grid>
                    </controls:ChamferBorder>

                    <controls:ChamferBorder Grid.Column="1"
                                            Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                            Margin="12,0,0,0"
                                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,14,16,12"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="扫描说明"
                                               Style="{StaticResource BridgePageTitleTextStyle}" />
                                    <TextBlock Text="登录 RSI 后打开 My Hangar，再开始扫描。应用会读取当前账号的舰船条目与页面图片；图片只保存在本机，不会自动上传，RSI 账号或密码也不会被保存。"
                                               Margin="0,7,0,0"
                                               Style="{StaticResource BridgeBodyTextStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="16,14,16,0"
                                    Style="{StaticResource BridgeDirectoryStatusBannerStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                    <controls:BridgeLoadingIndicator x:Name="ReaderLoadingIndicator"
                                                                     Grid.Column="1"
                                                                     Margin="10,0,0,0"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="Collapsed" />
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="当前状态"
                                                   Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                        <TextBlock x:Name="ReaderStatusText"
                                                   Text="等待整库扫描。"
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource BridgeBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="16,10,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource BridgeDirectoryCardStyle}" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="扫描进度"
                                                   Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                        <TextBlock x:Name="PageShipCountText"
                                                   Text="扫描页数：0"
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource BridgeDataTextStyle}"
                                                   Foreground="{DynamicResource BridgeMetricDuration}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource BridgeDirectoryCardStyle}" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="已识别舰船"
                                                   Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                        <TextBlock x:Name="TotalShipCountText"
                                                   Text="累计：0"
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource BridgeDataTextStyle}"
                                                   Foreground="{DynamicResource BridgeMetricValue}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3"
                                    Margin="16,0,16,16"
                                    Background="{DynamicResource BridgeGround}"
                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <ListView x:Name="DetectedShipsList"
                                          Background="Transparent"
                                          Foreground="{DynamicResource BridgeInk}"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="舰船"
                                                            DisplayMemberBinding="{Binding DisplayName}"
                                                            Width="184" />
                                            <GridViewColumn Header="代码"
                                                            DisplayMemberBinding="{Binding Code}"
                                                            Width="142" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </controls:ChamferBorder>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
