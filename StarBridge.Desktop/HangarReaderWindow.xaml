<Window x:Class="StarBridge.Desktop.HangarReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="官网机库扫描器"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="HangarReaderWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource AccentDimBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2"
                    Height="2"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}"
                    Opacity="0.72"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False" />

            <Border Grid.Row="0"
                    Background="#F0162634"
                    BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                Margin="0,0,11,0"
                                Background="#102637"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Image Source="/Assets/Brand/StarBridge_AppIcon.ico"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="官网机库扫描器"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="读取 RSI My Hangar，并导入星海舰桥"
                                       Margin="0,1,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Tag="Minimize"
                            AutomationProperties.Name="最小化"
                            ToolTip="最小化"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeWindowButton_Click" />
                    <Button Grid.Column="2"
                            x:Name="MaximizeWindowButton"
                            Tag="Maximize"
                            AutomationProperties.Name="最大化"
                            ToolTip="最大化"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MaximizeWindowButton_Click" />
                    <Button Grid.Column="3"
                            Tag="Close"
                            AutomationProperties.Name="关闭"
                            ToolTip="关闭"
                            Style="{StaticResource CloseWindowCaptionButton}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource HudPanel}"
                        Margin="0,0,0,12"
                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,2,12,2"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="1" />

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,10,0">
                            <TextBlock Text="机库地址"
                                       Margin="0,0,0,4"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" />
                            <TextBox x:Name="AddressBox"
                                     Height="34"
                                     Padding="10,0"
                                     Text="https://robertsspaceindustries.com/en/account/pledges"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                x:Name="GoButton"
                                Height="34"
                                Margin="0,18,8,0"
                                Content="打开"
                                Style="{StaticResource SecondaryButton}"
                                Click="GoButton_Click" />
                        <Button Grid.Column="3"
                                x:Name="ScanFullHangarButton"
                                Height="34"
                                Margin="0,18,8,0"
                                Content="扫描整库"
                                Style="{StaticResource PrimaryButton}"
                                Click="ScanFullHangarButton_Click" />
                        <Button Grid.Column="4"
                                x:Name="ImportButton"
                                Height="34"
                                Margin="0,18,0,0"
                                Content="导入舰船库"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButton}"
                                Click="ImportButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="382" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#FF050B12"
                            BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource AvionicsGlassPanelBrush}"
                                    BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="13,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,8,0"
                                             Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="RSI 机库网页"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="官方网页通道"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10" />
                                </Grid>
                            </Border>

                            <wv2:WebView2 Grid.Row="1"
                                          x:Name="HangarWebView"
                                          Source="https://robertsspaceindustries.com/en/account/pledges" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource HudPanel}"
                            Margin="12,0,0,0"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,14,16,12"
                                    Background="{StaticResource AvionicsGlassPanelBrush}"
                                    BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="扫描说明"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="登录 RSI 后打开 My Hangar，再开始扫描。应用只读取当前账号的舰船条目，不会保存 RSI 账号或密码。"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="16,14,16,0"
                                    Padding="12,10"
                                    Background="#7407111B"
                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentBrush}"
                                            CornerRadius="1" />
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="当前状态"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10" />
                                        <TextBlock x:Name="ReaderStatusText"
                                                   Text="等待整库扫描。"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2"
                                  Margin="16,10,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="10,8"
                                        Background="#650B1924"
                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="扫描进度"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10" />
                                        <TextBlock x:Name="PageShipCountText"
                                                   Text="扫描页数：0"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="10,8"
                                        Background="#650B1924"
                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="已识别舰船"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10" />
                                        <TextBlock x:Name="TotalShipCountText"
                                                   Text="累计：0"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3"
                                    Margin="16,0,16,16"
                                    Background="{StaticResource FieldBackBrush}"
                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <ListView x:Name="DetectedShipsList"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="舰船"
                                                            DisplayMemberBinding="{Binding DisplayName}"
                                                            Width="184" />
                                            <GridViewColumn Header="代码"
                                                            DisplayMemberBinding="{Binding Code}"
                                                            Width="142" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
