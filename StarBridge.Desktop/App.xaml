<Application x:Class="StarBridge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppTheme.xaml" />
                <ResourceDictionary Source="Themes/OverlaySettingsTheme.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Bridge/States.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
