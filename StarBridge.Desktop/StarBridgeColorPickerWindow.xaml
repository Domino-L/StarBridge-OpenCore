<Window x:Class="StarBridge.Desktop.StarBridgeColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="准星颜色"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="548"
        Height="468"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#3B6177" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border Margin="3"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#69CCFF" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC5D2" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColorCalibrationThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbFrame"
                                Width="12"
                                Height="14"
                                Background="#123348"
                                BorderBrush="#69CCFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Rectangle Width="2"
                                       Height="8"
                                       Fill="#DFF5FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.78" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbFrame" Property="Background" Value="#164B69" />
                                <Setter TargetName="ThumbFrame" Property="BorderBrush" Value="#A8E5FF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbFrame" Property="Background" Value="#1677A8" />
                                <Setter TargetName="ThumbFrame" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorCalibrationSlider"
               TargetType="Slider"
               BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="Root"
                              Height="{TemplateBinding Height}"
                              ClipToBounds="False"
                              SnapsToDevicePixels="True">
                            <Border x:Name="FocusRail"
                                    Height="14"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Height="20"
                                   Margin="7,0"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource StarBridgeSliderFilledRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource StarBridgeSliderRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ColorCalibrationThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusRail" Property="BorderBrush" Value="#223B789A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRail" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#F20A1823"
            BorderBrush="#3A6E87"
            BorderThickness="1"
            CornerRadius="2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.62" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Background="#091722">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#29AFFF" />
                <Border Grid.Column="1" Margin="4,0" Background="#42CF7C" />
                <Border Grid.Column="2" Background="#173447" />
            </Grid>

            <Grid Grid.Row="1" Margin="18,9,12,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="EyebrowText"
                               Text="COLOR CALIBRATION"
                               Foreground="#69CCFF"
                               FontFamily="Bahnschrift"
                               FontSize="9.5"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogTitleText"
                               Text="准星颜色"
                               Margin="0,3,0,0"
                               Foreground="#EEF8FF"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource DialogCloseButton}"
                        Click="CloseButton_Click"
                        ToolTip="关闭">
                    <Path Width="10"
                          Height="10"
                          Data="M 1,1 L 9,9 M 9,1 L 1,9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="None" />
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="18,2,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="286" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SpectrumLabelText"
                               Text="连续色域"
                               Style="{StaticResource StarBridgeLabelText}" />
                    <Border Margin="0,7,0,0"
                            Padding="3"
                            Background="#061019"
                            BorderBrush="#315F76"
                            BorderThickness="1">
                        <Grid Width="278" Height="210"
                              MouseLeftButtonDown="ColorField_MouseLeftButtonDown"
                              MouseMove="ColorField_MouseMove"
                              MouseLeftButtonUp="ColorField_MouseLeftButtonUp">
                            <Image x:Name="ColorFieldImage" Stretch="Fill" />
                            <Canvas x:Name="ColorFieldMarkerCanvas" IsHitTestVisible="False">
                                <Ellipse x:Name="ColorFieldMarker"
                                         Width="13"
                                         Height="13"
                                         Fill="#22000000"
                                         Stroke="#FFFFFF"
                                         StrokeThickness="2" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HueLabelText"
                                   Text="色相"
                                   Style="{StaticResource StarBridgeLabelText}"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Height="24" Margin="2,0,8,0" ClipToBounds="False">
                            <Border Height="6" Margin="7,0" VerticalAlignment="Center" BorderBrush="#3A6177" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Slider x:Name="HueSlider"
                                    Minimum="0"
                                    Maximum="255"
                                    Style="{StaticResource ColorCalibrationSlider}"
                                    ValueChanged="HueSlider_ValueChanged" />
                        </Grid>
                        <TextBlock x:Name="HueValueText" Grid.Column="2" Text="0" Style="{StaticResource ColorValueText}" />
                    </Grid>
                    <TextBlock x:Name="SpectrumHintText"
                               Text="拖动定位颜色；色相轨道用于切换主色域。"
                               Margin="0,9,0,0"
                               Style="{StaticResource StarBridgeHintText}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="SignalPreviewLabelText"
                               Text="信号预览"
                               Style="{StaticResource StarBridgeLabelText}" />
                    <Border Margin="0,7,0,0"
                            Height="48"
                            Background="#07141D"
                            BorderBrush="#315F76"
                            BorderThickness="1">
                        <Grid>
                            <Border x:Name="SelectedColorPreview" Margin="4" Background="#EBF7FF" />
                            <TextBlock x:Name="PreviewHexText"
                                       Text="#EBF7FF"
                                       Margin="10,0"
                                       Foreground="#FFFFFF"
                                       FontFamily="Bahnschrift"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="1" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="PaletteLabelText"
                               Text="色板"
                               Margin="0,14,0,0"
                               Style="{StaticResource StarBridgeLabelText}" />
                    <WrapPanel Margin="0,7,0,0">
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#EBF7FF" Background="#EBF7FF" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#69CCFF" Background="#69CCFF" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#29AFFF" Background="#29AFFF" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#42CF7C" Background="#42CF7C" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#FFD95C" Background="#FFD95C" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#FF9B52" Background="#FF9B52" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#F15B65" Background="#F15B65" Click="SwatchButton_Click" />
                        <Button Style="{StaticResource ColorSwatchButton}" Tag="#B27AFF" Background="#B27AFF" Click="SwatchButton_Click" />
                    </WrapPanel>

                    <TextBlock Text="HEX" Margin="0,5,0,0" Style="{StaticResource StarBridgeLabelText}" />
                    <TextBox x:Name="HexColorBox"
                             Height="31"
                             Margin="0,6,0,0"
                             Text="#EBF7FF"
                             FontFamily="Bahnschrift"
                             MaxLength="7"
                             LostKeyboardFocus="HexColorBox_LostKeyboardFocus"
                             PreviewKeyDown="HexColorBox_PreviewKeyDown" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" Foreground="#F15B65" FontFamily="Bahnschrift" VerticalAlignment="Center" />
                        <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource ColorCalibrationSlider}" ValueChanged="RgbSlider_ValueChanged" />
                        <TextBlock x:Name="RedValueText" Grid.Column="2" Text="235" Style="{StaticResource ColorValueText}" />
                        <TextBlock Grid.Row="1" Text="G" Foreground="#42CF7C" FontFamily="Bahnschrift" VerticalAlignment="Center" />
                        <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource ColorCalibrationSlider}" ValueChanged="RgbSlider_ValueChanged" />
                        <TextBlock x:Name="GreenValueText" Grid.Row="1" Grid.Column="2" Text="247" Style="{StaticResource ColorValueText}" />
                        <TextBlock Grid.Row="2" Text="B" Foreground="#69CCFF" FontFamily="Bahnschrift" VerticalAlignment="Center" />
                        <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Style="{StaticResource ColorCalibrationSlider}" ValueChanged="RgbSlider_ValueChanged" />
                        <TextBlock x:Name="BlueValueText" Grid.Row="2" Grid.Column="2" Text="255" Style="{StaticResource ColorValueText}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="18,10,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText"
                           Text="应用后将自动关闭主题跟随，使用此固定颜色。"
                           Style="{StaticResource StarBridgeHintText}"
                           VerticalAlignment="Center" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Width="84"
                        Height="32"
                        Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click" />
                <Button x:Name="ApplyButton"
                        Grid.Column="3"
                        Width="112"
                        Height="32"
                        Content="应用颜色"
                        Style="{StaticResource PrimaryButton}"
                        Click="ApplyButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
