<Window x:Class="StarBridge.Desktop.InGameBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarBridge.Desktop"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="游戏时浏览器"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1120"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BrowserHeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconChrome" Property="Background" Value="#263C5061" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconChrome" Property="Background" Value="#1E304250" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconChrome" Property="BorderBrush" Value="#2E8FBA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BrowserPageTabItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="{Binding TabWidth}" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#0B151E" />
            <Setter Property="BorderBrush" Value="#173447" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AvionicsGlassPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#102536" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource AccentDimBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="38" />
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="5"
                    Height="2"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}"
                    Opacity="0.72"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False" />

            <Border Grid.Row="0"
                    Background="#F0162634"
                    BorderBrush="{StaticResource AvionicsStructuralFrameBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="游戏时浏览器"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Tag="Minimize"
                            ToolTip="最小化"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeButton_Click" />
                    <Button Grid.Column="2"
                            Tag="Close"
                            ToolTip="关闭浏览器"
                            Style="{StaticResource CloseWindowCaptionButton}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border x:Name="BrowserPageStrip"
                    Grid.Row="1"
                    Background="#111A23"
                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="BrowserTabViewport"
                              Margin="8,0,0,0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              local:SmoothWheelScrollBehavior.ScrollsHorizontally="True">
                    <StackPanel x:Name="BrowserTabFlow"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                        <ListBox x:Name="BrowserPageTabs"
                             Height="37"
                             HorizontalAlignment="Left"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource BrowserPageTabItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SizeChanged="BrowserPageTabs_SizeChanged"
                             SelectionChanged="BrowserPageTabs_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="9,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="BrowserPageTitleText"
                                               Grid.Column="1"
                                               Text="{Binding Title}"
                                               Margin="3,0,5,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Content="×"
                                            Tag="{Binding}"
                                            ToolTip="关闭页面"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="CloseBrowserPageButton_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="NewBrowserPageButton"
                                Width="32"
                                Height="29"
                                Margin="0,4,8,3"
                                Padding="0"
                                Content="+"
                                ToolTip="新增页面"
                                Style="{StaticResource SecondaryButton}"
                                PreviewMouseLeftButtonDown="NewBrowserPageButton_PreviewMouseLeftButtonDown" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="BrowserNavigationBar"
                    Grid.Row="2"
                    Padding="14,6"
                    Background="{StaticResource AvionicsGlassPanelBrush}"
                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Width="32"
                            Height="34"
                            Padding="0"
                            Content="←"
                            IsEnabled="False"
                            ToolTip="后退"
                            Style="{StaticResource SecondaryButton}"
                            Click="BackButton_Click" />
                    <Button x:Name="ForwardButton"
                            Grid.Column="1"
                            Width="32"
                            Height="34"
                            Padding="0"
                            Content="→"
                            IsEnabled="False"
                            ToolTip="前进"
                            Style="{StaticResource SecondaryButton}"
                            Click="ForwardButton_Click" />
                    <Button x:Name="RefreshButton"
                            Grid.Column="2"
                            Width="32"
                            Height="34"
                            Padding="0"
                            Content="↻"
                            IsEnabled="False"
                            ToolTip="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshButton_Click" />
                    <Button Grid.Column="3"
                            Width="32"
                            Height="34"
                            Padding="0"
                            Content="⌂"
                            ToolTip="主页"
                            Style="{StaticResource SecondaryButton}"
                            Click="HomeButton_Click" />
                    <TextBlock Grid.Column="4"
                               Text="●"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               ToolTip="仅允许 HTTP 与 HTTPS 网页" />
                    <TextBox x:Name="AddressBox"
                             Grid.Column="5"
                             Height="34"
                             Margin="4,0,8,0"
                             Padding="10,0"
                             Text="https://cn.bing.com/"
                             VerticalContentAlignment="Center"
                             KeyDown="AddressBox_KeyDown" />
                    <Button Grid.Column="6"
                            Height="34"
                            Content="打开"
                            Style="{StaticResource PrimaryButton}"
                            Click="GoButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="3"
                  Background="#01060A">
                <Grid x:Name="BrowserHost" />
                <Border x:Name="LoadingOverlay"
                        Background="#F007121A"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <controls:BridgeLoadingIndicator x:Name="BrowserStartupLoadingIndicator"
                                                         Margin="0,0,0,9"
                                                         IsActive="True" />
                        <TextBlock Text="正在启动浏览器"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="首次打开可能需要几秒钟"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Padding="12,0"
                    Background="{StaticResource AvionicsDataWellBrush}"
                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:BridgeLoadingIndicator x:Name="BrowserStatusLoadingIndicator"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     IsActive="False"
                                                     Visibility="Collapsed" />
                    <TextBlock x:Name="BrowserStatusText"
                               Grid.Column="1"
                               Text="仅允许打开 HTTP 与 HTTPS 网页"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               VerticalAlignment="Center" />
                    <TextBlock Text="ESC 返回游戏"
                               Grid.Column="2"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
