{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scstarbridge.com/schemas/ship-name-pack.schema.json",
  "title": "StarBridge public ship-name pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtimeId",
          "englishName",
          "chineseName",
          "aliases"
        ],
        "properties": {
          "runtimeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+_[A-Za-z0-9_-]+$"
          },
          "englishName": {
            "type": "string",
            "minLength": 1
          },
          "chineseName": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
