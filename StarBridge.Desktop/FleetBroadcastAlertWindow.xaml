<Window x:Class="StarBridge.Desktop.FleetBroadcastAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Canvas x:Name="BroadcastCanvas" ClipToBounds="True">
        <Border x:Name="BroadcastCard"
                Canvas.Top="18"
                Padding="26,14"
                CornerRadius="3"
                BorderThickness="2"
                Background="#E6101822"
                BorderBrush="#FF5D66"
                Opacity="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="舰队广播"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           Foreground="#FFFFFFFF"
                           FontSize="14"
                           FontWeight="Bold" />
                <TextBlock x:Name="BroadcastMessageText"
                           MaxWidth="900"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FFFFFFFF"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock x:Name="BroadcastAuthorText"
                           Margin="22,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#CCFFFFFF"
                           FontSize="13" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
