<Window x:Class="StarBridge.Desktop.GameIdentityVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证 SCM 游戏身份"
        Width="720"
        Height="760"
        MinWidth="620"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SCM 游戏身份"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="验证 Star Citizen 账户"
                               Margin="0,6,0,0"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Content="×"
                        ToolTip="关闭"
                        Style="{DynamicResource SecondaryButton}"
                        Click="CloseButton_Click" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,0"
                       Text="验证由 SCM 完成。应用不会要求、读取或保存你的 RSI 密码、验证码或登录凭据。"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2" Margin="0,24,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="HandleStepMarker"
                        Grid.Column="0"
                        Padding="12,9"
                        Background="{DynamicResource AvionicsGlassRaisedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1">
                    <TextBlock Text="1  获取验证码"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                </Border>
                <Rectangle Grid.Column="1"
                           Height="1"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource AccentDimBrush}" />
                <Border x:Name="VerifyStepMarker"
                        Grid.Column="2"
                        Padding="12,9"
                        Background="{DynamicResource AvionicsGlassRaisedBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <TextBlock Text="2  提交验证"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="HandleStepPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="输入 RSI Handle"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Text="请输入 RSI 个人资料中显示的 Handle。验证成功后，该游戏身份将绑定到当前 SCM 账号。"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock Text="RSI Handle"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="GameNameBox"
                                 Height="42"
                                 Margin="0,8,0,0"
                                 MaxLength="64"
                                 VerticalContentAlignment="Center"
                                 KeyDown="GameNameBox_KeyDown" />
                    </StackPanel>
                    <Border Grid.Row="3"
                            Margin="0,22,0,0"
                            Padding="14,12"
                            Background="{DynamicResource AvionicsGlassRaisedBrush}"
                            BorderBrush="{DynamicResource AvionicsGlassSoftEdgeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="请仔细核对 Handle。每个 SCM 账号只能绑定自己的游戏身份，完成后不能立即更换。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <ScrollViewer x:Name="VerifyStepPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="将验证码写入 RSI Short Bio"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="复制下方完整验证码，在 RSI Account → Profile → Short Bio 中粘贴并保存，然后返回这里提交验证。"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0"
                                Padding="18,16"
                                Background="{DynamicResource AvionicsGlassRaisedBrush}"
                                BorderBrush="{DynamicResource AccentDimBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="你的验证码"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="VerificationCodeText"
                                               Margin="0,7,0,0"
                                               FontSize="24"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="ExpirationText"
                                               Margin="0,7,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="92"
                                        Height="38"
                                        VerticalAlignment="Center"
                                        Content="复制"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="CopyCodeButton_Click" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,20,0,0"
                                   Text="联系方式"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="ContactBox"
                                 Height="42"
                                 Margin="0,8,0,0"
                                 MaxLength="100"
                                 VerticalContentAlignment="Center"
                                 KeyDown="ContactBox_KeyDown" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="填写邮箱、QQ、Discord 或其他可联系到你的方式，至少 7 个字符。"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0"
                                Padding="14,12"
                                Background="{DynamicResource AvionicsGlassRaisedBrush}"
                                BorderBrush="{DynamicResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="提交前确认"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="1. Short Bio 已包含完整验证码&#x0a;2. RSI 个人资料已保存&#x0a;3. 当前 Handle 与第一步一致"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="输入 Handle 后获取一次性验证码。" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackButton"
                            Width="92"
                            Height="40"
                            Margin="0,0,10,0"
                            Content="上一步"
                            Visibility="Collapsed"
                            Style="{DynamicResource SecondaryButton}"
                            Click="BackButton_Click" />
                    <Button x:Name="PrimaryButton"
                            Width="132"
                            Height="40"
                            Content="获取验证码"
                            Style="{DynamicResource PrimaryButton}"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>