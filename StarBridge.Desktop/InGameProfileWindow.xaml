<Window x:Class="StarBridge.Desktop.InGameProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="个人资料"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1360"
        Height="860"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#269DD4"
            BorderThickness="1"
            Background="{StaticResource PageBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#102433"
                    BorderBrush="#2B556B"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,6,0,0">
                        <TextBlock x:Name="WindowTitleText"
                                   Text="个人资料"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="WindowSubtitleText"
                                   Text="与星海舰桥中的个人资料保持一致"
                                   Foreground="#6F9CB5"
                                   FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCaptionButton}"
                            Tag="Close"
                            ToolTip="关闭个人资料"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Background="{StaticResource PageBackgroundBrush}"
                  ClipToBounds="True">
                <ContentControl x:Name="ProfileSurfaceHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <StackPanel x:Name="ProfileLoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <controls:BridgeLoadingIndicator x:Name="ProfileLoadingIndicator"
                                                     Margin="0,0,0,9"
                                                     IsActive="True" />
                    <TextBlock Text="正在打开个人资料"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,7,0,0"
                               Text="资料页面准备完成后会显示在这里。"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
