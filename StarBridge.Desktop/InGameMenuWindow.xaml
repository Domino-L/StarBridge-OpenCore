<Window x:Class="StarBridge.Desktop.InGameMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
        Title="星海舰桥 · 游戏时菜单"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        Focusable="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/InGameMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Rectangle x:Name="BackgroundDimLayer"
                   Fill="{DynamicResource BridgeScrim}"
                   IsHitTestVisible="False"/>

        <Border x:Name="TimeInformationPanel"
                Width="270"
                Margin="34,26,0,0"
                Padding="17,12,18,14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource BridgePanel}"
                BorderBrush="{DynamicResource BridgeHairline}"
                BorderThickness="2,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LocalTimeText"
                           Text="20:23"
                           Foreground="{DynamicResource BridgeInk}"
                           FontFamily="Segoe UI Semibold"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="LocalDateText"
                           Grid.Row="1"
                           Text="2026年7月27日 星期一"
                           Foreground="{DynamicResource BridgeInk2}"
                           FontSize="11"
                           MinHeight="16"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="1,4,0,0" />
                <StackPanel x:Name="PresencePanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="1,10,0,0">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource BridgeStatusOk}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0" />
                    <TextBlock x:Name="PresenceText"
                               Text="应用在线"
                               Foreground="{DynamicResource BridgeStatusOk}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               MinHeight="14"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="TopActionsPanel"
                    Margin="0,26,34,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Button x:Name="MenuSettingsButton"
                    Width="42"
                    Margin="0,0,8,0"
                    Padding="0"
                    Style="{StaticResource MenuTopActionButton}"
                    ToolTip="打开游戏浮层设置"
                    Click="OpenOverlaySettings_Click">
                <Viewbox Width="17" Height="17">
                    <Path Data="M12,3 L13.4,3.4 L14.1,5.1 L16,5.6 L17.2,4.8 L19.2,6.8 L18.4,8 L18.9,9.9 L20.6,10.6 L21,12 L20.6,13.4 L18.9,14.1 L18.4,16 L19.2,17.2 L17.2,19.2 L16,18.4 L14.1,18.9 L13.4,20.6 L12,21 L10.6,20.6 L9.9,18.9 L8,18.4 L6.8,19.2 L4.8,17.2 L5.6,16 L5.1,14.1 L3.4,13.4 L3,12 L3.4,10.6 L5.1,9.9 L5.6,8 L4.8,6.8 L6.8,4.8 L8,5.6 L9.9,5.1 L10.6,3.4 Z M12,8.5 A3.5,3.5 0 1 1 11.9,8.5"
                          Fill="Transparent"
                          Stroke="{DynamicResource BridgeInk}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round" />
                </Viewbox>
            </Button>
            <Button x:Name="InformationOverlayTopButton"
                      Style="{StaticResource MenuTopActionButton}"
                      Click="SwitchToInformationOverlay_Click"
                      Content="打开信息浮层" />
            <Border Height="42"
                    Margin="8,0,8,0"
                    Padding="13,0"
                    Background="{DynamicResource BridgeRail}"
                    BorderBrush="{DynamicResource BridgeHairline}"
                    BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="返回游戏"
                               Foreground="{DynamicResource BridgeInk}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="MenuReturnHotkeyText"
                               Text="-- / ESC"
                               Foreground="{DynamicResource BridgeInk3}"
                               FontSize="8"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource MenuCloseButton}"
                    Click="CloseMenu_Click"
                    Content="&#x00D7;"
                    ToolTip="返回游戏" />
        </StackPanel>

        <Border x:Name="LeftRailDockContainer"
                Margin="28,154,0,78"
                Padding="7"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="{DynamicResource BridgePanelRaised}"
                BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel x:Name="LeftRailDockPanel"
                            Orientation="Vertical">
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="SwitchToInformationOverlay_Click"
                        ToolTip="打开信息浮层">
                    <StackPanel x:Name="SceneContextPanel">
                        <TextBlock Text="&#xE946;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="信息"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenFleet_Click"
                        ToolTip="查看组织详情与当前信息">
                    <StackPanel>
                        <TextBlock Text="&#xE902;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="组织"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenFriends_Click"
                        ToolTip="打开好友中心">
                    <StackPanel>
                        <TextBlock Text="&#xE716;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="好友"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenChat_Click"
                        ToolTip="打开私信、组织与房间通讯">
                    <StackPanel>
                        <TextBlock Text="&#xE8BD;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="通讯"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenRooms_Click"
                        ToolTip="查看、创建和加入组队房间">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="房间"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Border Width="48"
                        Height="1"
                        Margin="10,7"
                        Background="{DynamicResource BridgeHairline}" />
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="CaptureFullscreen_Click"
                        ToolTip="截取当前游戏所在屏幕并保存到图片文件夹">
                    <StackPanel>
                        <TextBlock Text="&#xE722;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="截屏"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenImage_Click"
                        ToolTip="打开参考图工具">
                    <StackPanel>
                        <TextBlock Text="&#xEB9F;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="参考图"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Width="68"
                        Height="54"
                        Margin="0,3"
                        Style="{StaticResource MenuDockButton}"
                        Click="OpenBrowser_Click"
                        ToolTip="打开游戏时浏览器">
                    <StackPanel>
                        <TextBlock Text="&#xE774;"
                                   Style="{StaticResource MenuDockGlyph}"
                                   FontSize="20" />
                        <TextBlock Text="浏览器"
                                   Style="{StaticResource MenuDockLabel}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="BottomMenuWorkspacePanel"
              Margin="28,0,28,26"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="MenuContextPanel"
                    Grid.Row="0"
                    MaxWidth="980"
                    Margin="0,0,0,9"
                    Padding="14,8"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource BridgePanel}"
                    BorderBrush="{DynamicResource BridgeHairline}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.55*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前协作" Style="{StaticResource MenuContextLabel}" />
                        <TextBlock x:Name="SceneTitleText"
                                   Text="当前组织"
                                   Style="{StaticResource MenuContextValue}" />
                    </StackPanel>
                    <StackPanel x:Name="MemberContextPanel" Grid.Column="1">
                        <TextBlock Text="成员" Style="{StaticResource MenuContextLabel}" />
                        <TextBlock x:Name="MemberCountText"
                                   Text="0 人"
                                   Style="{StaticResource MenuContextValue}" />
                    </StackPanel>
                    <StackPanel x:Name="ShipContextPanel" Grid.Column="2">
                        <TextBlock Text="当前飞船" Style="{StaticResource MenuContextLabel}" />
                        <TextBlock x:Name="ShipText"
                                   Text="等待识别"
                                   Style="{StaticResource MenuContextValue}" />
                    </StackPanel>
                    <StackPanel x:Name="LocationContextPanel" Grid.Column="3">
                        <TextBlock Text="当前位置" Style="{StaticResource MenuContextLabel}" />
                        <TextBlock x:Name="LocationText"
                                   Text="等待识别"
                                   Style="{StaticResource MenuContextValue}" />
                    </StackPanel>
                    <StackPanel x:Name="ServerContextPanel" Grid.Column="4">
                        <TextBlock Text="游戏服务器" Style="{StaticResource MenuContextLabel}" />
                        <TextBlock x:Name="ServerText"
                                   Text="等待连接"
                                   Style="{StaticResource MenuContextValue}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="MenuDockContainer"
                    Grid.Row="1"
                    Padding="8"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BridgePanelRaised}"
                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel x:Name="PrimaryDockPanel"
                            Orientation="Horizontal">
                    <Button x:Name="InformationOverlayDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="SwitchToInformationOverlay_Click"
                            ToolTip="打开信息浮层">
                        <StackPanel>
                            <TextBlock Text="&#xE946;" Style="{StaticResource MenuDockGlyph}" />
                            <TextBlock x:Name="InformationOverlayDockLabel"
                                       Text="打开信息浮层"
                                       Style="{StaticResource MenuDockLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FleetDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenFleet_Click"
                            ToolTip="查看组织详情与当前信息">
                        <StackPanel>
                            <TextBlock Text="&#xE902;" Style="{StaticResource MenuDockGlyph}" />
                            <TextBlock x:Name="FleetDockLabel" Text="组织" Style="{StaticResource MenuDockLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FriendsDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenFriends_Click"
                            ToolTip="打开好友中心">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE716;" Style="{StaticResource MenuDockGlyph}" />
                                <TextBlock x:Name="FriendsDockLabel" Text="好友" Style="{StaticResource MenuDockLabel}" />
                            </StackPanel>
                            <Border x:Name="FriendsUnreadBadge"
                                    MinWidth="20"
                                    Height="20"
                                    Padding="5,0"
                                    Margin="0,-8,-14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource Self}}"
                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="FriendsUnreadText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="ChatDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenChat_Click"
                            ToolTip="打开私信、组织与房间通讯">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource MenuDockGlyph}" />
                                <TextBlock x:Name="ChatDockLabel" Text="通讯" Style="{StaticResource MenuDockLabel}" />
                            </StackPanel>
                            <Border x:Name="ChatUnreadBadge"
                                    MinWidth="20"
                                    Height="20"
                                    Padding="5,0"
                                    Margin="0,-8,-14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource Self}}"
                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ChatUnreadText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="RoomsDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenRooms_Click"
                            ToolTip="查看、创建和加入组队房间">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource MenuDockGlyph}" />
                                <TextBlock x:Name="RoomsDockLabel" Text="房间" Style="{StaticResource MenuDockLabel}" />
                            </StackPanel>
                            <Border x:Name="RoomsUnreadBadge"
                                    MinWidth="20"
                                    Height="20"
                                    Padding="5,0"
                                    Margin="0,-8,-14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeStatusWarn}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="RoomsUnreadText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>
                    <Border x:Name="DockGroupDivider"
                            Width="1"
                            Height="50"
                            Margin="8,13"
                            Background="{DynamicResource BridgeHairline}" />

                    <Button x:Name="ScreenshotDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="CaptureFullscreen_Click"
                            ToolTip="截取当前游戏所在屏幕并保存到图片文件夹">
                        <StackPanel>
                            <TextBlock Text="&#xE722;" Style="{StaticResource MenuDockGlyph}" />
                            <TextBlock x:Name="ScreenshotDockLabel" Text="全屏截屏" Style="{StaticResource MenuDockLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImageDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenImage_Click"
                            ToolTip="打开参考图工具">
                        <StackPanel>
                            <TextBlock Text="&#xEB9F;" Style="{StaticResource MenuDockGlyph}" />
                            <TextBlock x:Name="ImageDockLabel" Text="参考图" Style="{StaticResource MenuDockLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BrowserDockButton"
                            Style="{StaticResource MenuDockButton}"
                            Click="OpenBrowser_Click"
                            ToolTip="打开游戏时浏览器">
                        <StackPanel>
                            <TextBlock Text="&#xE774;" Style="{StaticResource MenuDockGlyph}" />
                            <TextBlock x:Name="BrowserDockLabel" Text="浏览器" Style="{StaticResource MenuDockLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid x:Name="MenuBottomFooterPanel"
                  Grid.Row="2"
                  Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:BridgeLoadingIndicator x:Name="NoticeLoadingIndicator"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 IsActive="False"
                                                 Visibility="Collapsed" />
                <TextBlock x:Name="NoticeText"
                           Grid.Column="1"
                           Text="菜单浮层已就绪"
                           Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                           FontSize="9"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="MenuFooterHotkeyText"
                           Grid.Column="2"
                           Text="按 Esc 返回游戏 · 工具窗口会随菜单自动隐藏"
                           Foreground="{DynamicResource BridgeInk3}"
                           FontSize="9"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <Border x:Name="NoticePopup"
                Width="580"
                MaxWidth="720"
                Margin="0,94,0,0"
                Padding="16,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource BridgePanelRaised}"
                BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}"
                BorderThickness="2,1,1,1"
                CornerRadius="3"
                Panel.ZIndex="100"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:BridgeLoadingIndicator x:Name="NoticePopupLoadingIndicator"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     IsActive="False"
                                                     Visibility="Collapsed" />
                    <TextBlock x:Name="NoticePopupTitle"
                               Grid.Column="1"
                               Foreground="{DynamicResource BridgeInk}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Grid>
                <TextBlock x:Name="NoticePopupDetail"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource BridgeInk2}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
