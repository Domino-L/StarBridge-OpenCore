<Window x:Class="StarBridge.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录星海舰桥"
        Width="700"
        Height="760"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="SecurityLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkBackground" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="LinkBackground" Property="BorderThickness" Value="0,0,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            Padding="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
        <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="星海舰桥"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Grid.Row="1"
                       Margin="0,10,0,18"
                       Text="登录后可同步组织、任务与玩家状态。你也可以先跳过，以浏览模式进入应用。"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LoginModeButton"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Content="登录"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginModeButton_Click" />
                <Button x:Name="RegisterModeButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="注册"
                        Style="{StaticResource SecondaryButton}"
                        Click="RegisterModeButton_Click" />
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="LoginPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="登录邮箱"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="LoginEmailBox"
                             Grid.Row="0"
                             Height="40"
                             Margin="0,24,0,14"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1"
                               Text="密码"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <PasswordBox x:Name="LoginPasswordBox"
                                 Grid.Row="1"
                                 Height="40"
                                 Margin="0,24,0,14"
                                 VerticalContentAlignment="Center" />

                    <Button Grid.Row="2"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Right"
                            Content="忘记密码？"
                            Style="{StaticResource SecurityLinkButton}"
                            Click="ForgotPasswordButton_Click" />

                    <TextBlock Grid.Row="3"
                               Text="使用注册邮箱和密码登录。未登录时只能浏览，无法同步和管理组织。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="RegisterPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="登录邮箱"
                               Grid.ColumnSpan="2"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="RegisterEmailBox"
                             Grid.ColumnSpan="2"
                             Height="40"
                             Margin="0,24,0,14"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="密码"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <PasswordBox x:Name="RegisterPasswordBox"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Height="40"
                                 Margin="0,24,0,14"
                                 VerticalContentAlignment="Center" />

                    <Grid Grid.Row="2"
                          Grid.ColumnSpan="2">
                        <TextBlock Text="呼号（昵称）"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="起一个队友好叫的名字～"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </Grid>
                    <TextBox x:Name="RegisterCallsignBox"
                             Grid.Row="2"
                             Grid.ColumnSpan="2"
                             Height="40"
                             Margin="0,24,0,14"
                             VerticalContentAlignment="Center"
                             MaxLength="24" />

                    <TextBlock Grid.Row="3"
                               Text="验证码"
                               Grid.ColumnSpan="2"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="VerificationCodeBox"
                             Grid.Row="3"
                             Height="40"
                             Margin="0,24,12,14"
                             VerticalContentAlignment="Center"
                             MaxLength="6" />
                    <Button x:Name="SendCodeButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Height="40"
                            Margin="0,24,0,14"
                            Content="发送验证码"
                            Style="{StaticResource SecondaryButton}"
                            Click="SendCodeButton_Click" />

                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="2"
                               Text="验证码将发送至你的邮箱，10 分钟内有效。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid x:Name="RecoveryPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="2"
                               Text="注册邮箱"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="RecoveryEmailBox"
                             Grid.ColumnSpan="2"
                             Height="40"
                             Margin="0,24,0,14"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="验证码"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="RecoveryVerificationCodeBox"
                             Grid.Row="1"
                             Height="40"
                             Margin="0,24,12,14"
                             VerticalContentAlignment="Center"
                             MaxLength="6" />
                    <Button x:Name="RecoverySendCodeButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="40"
                            Margin="0,24,0,14"
                            Content="发送验证码"
                            Style="{StaticResource SecondaryButton}"
                            Click="RecoverySendCodeButton_Click" />

                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="新密码"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <PasswordBox x:Name="RecoveryPasswordBox"
                                 Grid.Row="2"
                                 Grid.ColumnSpan="2"
                                 Height="40"
                                 Margin="0,24,0,14"
                                 VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="3"
                               Grid.ColumnSpan="2"
                               Text="确认新密码"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <PasswordBox x:Name="RecoveryConfirmPasswordBox"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="2"
                                 Height="40"
                                 Margin="0,24,0,14"
                                 VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="2"
                               Text="输入注册邮箱获取验证码。为保护账户，无论邮箱是否已注册，系统都会显示相同提示。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <Border x:Name="AccountSecurityPanel"
                    Grid.Row="4"
                    Margin="0,18,0,0"
                    Padding="14,12"
                    Background="{StaticResource AvionicsGlassRaisedBrush}"
                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="账户与安全"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="注册与登录 StarBridge 均不需要 RSI 账户。StarBridge 不会要求、读取或保存你的 RSI 官网登录凭据。" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="账号密码只会通过加密连接发送。星海舰桥不会保存你的明文密码，登录信息会由 Windows 加密保存在本机。" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="邮箱仅用于登录、验证和必要安全通知，不会公开给组织成员。" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Button Content="了解安全措施"
                                Style="{StaticResource SecurityLinkButton}"
                                Click="SecurityMeasuresButton_Click" />
                        <TextBlock Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BorderDefaultBrush}"
                                   Text="|" />
                        <Button Content="查看隐私与数据使用"
                                Style="{StaticResource SecurityLinkButton}"
                                Click="PrivacyDataUseButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="LoginActionFooter" Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText"
                           Grid.Column="0"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="你可以先登录，也可以先进入浏览模式。" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SkipButton"
                            Content="跳过"
                            Width="96"
                            Style="{StaticResource SecondaryButton}"
                            Click="SkipButton_Click" />
                    <Button x:Name="ConfirmButton"
                            Width="112"
                            Margin="8,0,0,0"
                            Content="登录"
                            Style="{StaticResource PrimaryButton}"
                            Click="ConfirmButton_Click" />
                    <Button x:Name="CloseDialogButton"
                            Content="关闭"
                            Width="96"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</Window>
