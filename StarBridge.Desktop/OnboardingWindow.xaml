<Window x:Class="StarBridge.Desktop.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星海舰桥启航引导"
        Width="920"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Closing="OnboardingWindow_Closing">
    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="22,0"
                    Background="#E00B1C28"
                    BorderBrush="#28506A"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启航许可"
                                   Foreground="#E6F1F8"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StageHeaderText"
                                   Text="首次使用说明"
                                   Margin="0,3,0,0"
                                   Foreground="#7F9AAA"
                                   FontSize="10.5" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,5"
                            Background="#122D40"
                            BorderBrush="#2B6B89"
                            BorderThickness="1"
                            CornerRadius="2"
                            VerticalAlignment="Center">
                        <TextBlock Text="首次启动 · 必须完成"
                                   Foreground="#5CCBFF"
                                   FontFamily="Bahnschrift"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="15,18"
                        Background="#C8081722"
                        BorderBrush="#1C3B4E"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="IntroductionStageRail"
                                Padding="12,11"
                                Background="#132E40"
                                BorderBrush="#36B8F2"
                                BorderThickness="2,0,0,0">
                            <StackPanel>
                                <TextBlock Text="01 / READ"
                                           Foreground="#5CCBFF"
                                           FontFamily="Bahnschrift"
                                           FontSize="9.5" />
                                <TextBlock Text="使用说明"
                                           Margin="0,4,0,0"
                                           Foreground="#E6F1F8"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PreparationStageRail"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Padding="12,11"
                                Background="#081722"
                                BorderBrush="#24475C"
                                BorderThickness="2,0,0,0">
                            <StackPanel>
                                <TextBlock Text="02 / IDENTIFY"
                                           Foreground="#637A89"
                                           FontFamily="Bahnschrift"
                                           FontSize="9.5" />
                                <TextBlock Text="账号与识别"
                                           Margin="0,4,0,0"
                                           Foreground="#91A5B5"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="FeatureTourStageRail"
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                Padding="12,11"
                                Background="#081722"
                                BorderBrush="#24475C"
                                BorderThickness="2,0,0,0">
                            <StackPanel>
                                <TextBlock Text="03 / NAVIGATE"
                                           Foreground="#637A89"
                                           FontFamily="Bahnschrift"
                                           FontSize="9.5" />
                                <TextBlock Text="功能导览"
                                           Margin="0,4,0,0"
                                           Foreground="#91A5B5"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="4"
                                   Text="引导进度会保存在本机。未完成前，下次启动将从当前阶段继续。"
                                   Foreground="#637A89"
                                   FontSize="9.5"
                                   LineHeight="15"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="22,18,22,16">
                    <Grid x:Name="IntroductionPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="开始前，请了解星海舰桥如何工作"
                                       Foreground="#E6F1F8"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="阅读到底后才能继续。这里说明应用会读取什么、同步什么，以及哪些选择始终由你控制。"
                                       Margin="0,7,0,14"
                                       Foreground="#91A5B5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer x:Name="IntroductionScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      ScrollChanged="IntroductionScrollViewer_ScrollChanged">
                            <StackPanel Margin="0,0,10,0">
                                <Border Padding="15"
                                        Background="#0B1C28"
                                        BorderBrush="#234A61"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="星海舰桥是什么"
                                                   Foreground="#5CCBFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="星海舰桥是一款面向 Star Citizen 玩家与组织的测试版协同工具。它提供组织、房间、好友、个人资料和游戏浮层等功能。"
                                                   Foreground="#C7D6DF"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,10,0,0"
                                        Padding="15"
                                        Background="#0B1C28"
                                        BorderBrush="#234A61"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="账号与多人同步"
                                                   Foreground="#5CCBFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="登录后才能同步组织、好友、聊天、公开资料和即时状态。星海舰桥账号独立于 RSI 账号，不会要求你的 RSI 登录凭据。"
                                                   Foreground="#C7D6DF"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,10,0,0"
                                        Padding="15"
                                        Background="#0B1C28"
                                        BorderBrush="#234A61"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Game.log 与身份识别"
                                                   Foreground="#5CCBFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="应用只读取你选择的 Star Citizen Game.log，用于识别游戏 ID、游戏状态、舰船、地点和事件。默认路径位于 StarCitizen\LIVE\Game.log。"
                                                   Foreground="#C7D6DF"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,10,0,0"
                                        Padding="15"
                                        Background="#0B1C28"
                                        BorderBrush="#234A61"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="数据与隐私选择"
                                                   Foreground="#5CCBFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="游玩时长记录、地点代码采集和资料公开都有独立授权。初步引导完成后，应用才会逐项询问；未获得允许前不会开始对应采集。"
                                                   Foreground="#C7D6DF"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,10,0,0"
                                        Padding="15"
                                        Background="#0B1C28"
                                        BorderBrush="#234A61"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="使用前说明"
                                                   Foreground="#5CCBFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Text="星海舰桥仍处于测试阶段，识别和同步结果可能受游戏更新或网络状态影响。遇到问题时，可通过“帮助与反馈”告诉我们。"
                                                   Foreground="#C7D6DF"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="IntroductionReadHintText"
                                   Grid.Row="2"
                                   Margin="0,10,0,0"
                                   Text="继续向下阅读以解锁下一步"
                                   Foreground="#E6B84A"
                                   FontSize="10.5" />
                    </Grid>

                    <ScrollViewer x:Name="PreparationPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="完成账号、日志与身份准备"
                                       Foreground="#E6F1F8"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="这三项构成多人功能的身份链路。可以先选择日志，但只有登录并完成身份验证后才能进入功能导览。"
                                       Margin="0,7,0,14"
                                       Foreground="#91A5B5"
                                       TextWrapping="Wrap" />

                            <Border Padding="14"
                                    Background="#0B1C28"
                                    BorderBrush="#234A61"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="账号"
                                                   Foreground="#5CCBFF"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="AccountPreparationStatusText"
                                                   Margin="0,5,12,0"
                                                   Text="未登录 · 先登录或注册以启用多人同步"
                                                   Foreground="#91A5B5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="PreparationLoginButton"
                                            Grid.Column="1"
                                            Content="登录 / 注册"
                                            Height="36"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="PreparationLoginButton_Click" />
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="14"
                                    Background="#0B1C28"
                                    BorderBrush="#234A61"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="找到账号与识别"
                                                   Foreground="#5CCBFF"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,12,0"
                                                   Text="今后可以点击右上角头像，再选择“账号与识别”返回这里。"
                                                   Foreground="#91A5B5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="打开账号与识别"
                                            Height="36"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenIdentitySettingsButton_Click" />
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="14"
                                    Background="#0B1C28"
                                    BorderBrush="#234A61"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Game.log"
                                                   Foreground="#5CCBFF"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="LogPreparationStatusText"
                                                   Margin="0,5,12,0"
                                                   Text="尚未选择 · 文件通常位于 StarCitizen\LIVE\Game.log"
                                                   Foreground="#91A5B5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="选择 Game.log"
                                            Height="36"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="SelectLogButton_Click" />
                                    <Button Grid.Column="2"
                                            Content="快速扫描"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="QuickScanLogButton_Click" />
                                </Grid>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="14"
                                    Background="#0B1C28"
                                    BorderBrush="#234A61"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="游戏身份"
                                                   Foreground="#5CCBFF"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="IdentityPreparationStatusText"
                                                   Margin="0,5,12,0"
                                                   Text="等待日志识别游戏 ID"
                                                   Foreground="#91A5B5"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="BindIdentityButton"
                                            Grid.Column="1"
                                            Content="绑定身份"
                                            Height="36"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BindIdentityButton_Click" />
                                </Grid>
                            </Border>

                            <Border x:Name="PreparationGateBanner"
                                    Margin="0,12,0,0"
                                    Padding="12,9"
                                    Background="#221E1608"
                                    BorderBrush="#6B5420"
                                    BorderThickness="1">
                                <TextBlock x:Name="PreparationGateText"
                                           Text="完成登录、日志选择和身份绑定后即可继续。"
                                           Foreground="#E6B84A"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="FeatureTourPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FeatureTourEyebrowText"
                                       Text="功能导览 1 / 5"
                                       Foreground="#5CCBFF"
                                       FontFamily="Bahnschrift"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="FeatureTourTitleText"
                                       Text="寻找组织"
                                       Margin="0,7,0,0"
                                       Foreground="#E6F1F8"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="FeatureTourSummaryText"
                                       Margin="0,7,0,15"
                                       Foreground="#91A5B5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Row="1"
                                Padding="20"
                                Background="#0B1C28"
                                BorderBrush="#2B5F79"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FeatureTourRouteText"
                                           Foreground="#5CCBFF"
                                           FontFamily="Bahnschrift"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="FeatureTourDetailText"
                                           Grid.Row="1"
                                           Margin="0,18,0,0"
                                           Foreground="#D5E2EA"
                                           FontSize="13"
                                           LineHeight="23"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2"
                                           Text="点击下方按钮后，应用会打开对应页面，再继续下一项。"
                                           Margin="0,18,0,0"
                                           Foreground="#637A89"
                                           FontSize="10" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="20,0"
                    Background="#D9081722"
                    BorderBrush="#234A61"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Button Content="退出应用"
                            Height="36"
                            Style="{StaticResource DangerButton}"
                            Click="ExitApplicationButton_Click" />
                    <TextBlock x:Name="FooterStatusText"
                               Grid.Column="1"
                               Margin="18,0"
                               Text="请阅读使用说明"
                               Foreground="#7F9AAA"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="FooterPrimaryButton"
                            Grid.Column="2"
                            Content="继续"
                            Height="38"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="FooterPrimaryButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
