<Window x:Class="StarBridge.Desktop.InGameFriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarBridge.Desktop"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="游戏内好友"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="340"
        Height="720"
        MinWidth="300"
        MaxWidth="460"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource BridgeGround}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppTheme.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Icons.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Modals.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <local:ImageDataConverter x:Key="FriendImageDataConverter" />

        <Style x:Key="FriendIconButton"
               TargetType="Button"
               BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
        </Style>

        <Style x:Key="AvatarMenuButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendRosterListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FriendRosterListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="FriendRosterRowTemplate">
            <Grid Height="54" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Margin="0,7"
                        Background="{Binding PresenceBrush}" />
                <Button x:Name="FriendAvatarButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource AvatarMenuButton}"
                        ToolTip="打开头像菜单"
                        PreviewMouseLeftButtonDown="AvatarButton_PreviewMouseLeftButtonDown"
                        Click="FriendAvatarButton_Click">
                    <Grid>
                        <Border Background="{DynamicResource BridgePanelRaised}"
                                BorderBrush="{DynamicResource BridgeChipHairline}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding (theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Image Source="{Binding AvatarSource, Converter={StaticResource FriendImageDataConverter}, ConverterParameter=72}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Button>
                <StackPanel Grid.Column="2"
                            Margin="3,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Callsign}"
                               Foreground="{DynamicResource BridgeInk}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PresenceText}"
                               Foreground="{Binding PresenceBrush}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Viewbox Grid.Column="3"
                         Width="10"
                         Height="14"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Data="M 2,1 L 7,6 L 2,11"
                           Stroke="{Binding (theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Viewbox>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BridgeHairline}"
            BorderThickness="1"
            Background="{DynamicResource BridgeGround}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{Binding (theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    BorderBrush="{Binding (theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="12,6,0,0">
                        <TextBlock Text="好友"
                                   Foreground="{DynamicResource BridgeInk}"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock Text="查看状态并开始私聊"
                                   Foreground="{DynamicResource BridgeInk2}"
                                   FontSize="9" />
                    </StackPanel>
                    <Button x:Name="FriendsCloseButton"
                            Grid.Column="1"
                            Width="42"
                            Height="42"
                            Style="{StaticResource CloseWindowCaptionButton}"
                            Tag="Close"
                            ToolTip="关闭好友窗口"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <controls:ChamferBorder x:Name="LocalFriendProfile"
                    Grid.Row="1"
                    Padding="12"
                    Style="{StaticResource BridgeDirectoryHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LocalAvatarButton"
                            Width="50"
                            Height="50"
                            VerticalAlignment="Top"
                            Style="{StaticResource AvatarMenuButton}"
                            ToolTip="打开我的头像菜单"
                            PreviewMouseLeftButtonDown="AvatarButton_PreviewMouseLeftButtonDown"
                            Click="LocalAvatarButton_Click">
                        <Grid>
                            <Border Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeChipHairline}"
                                    BorderThickness="1">
                                <TextBlock x:Name="LocalAvatarFallbackText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding (theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           FontSize="14"
                                           FontWeight="Bold" />
                            </Border>
                            <Image x:Name="LocalAvatarImage"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                        <TextBlock x:Name="LocalCallsignText"
                                   Foreground="{DynamicResource BridgeInk}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LocalGameIdText"
                                   Margin="0,1,0,6"
                                   Foreground="{DynamicResource BridgeInk2}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="LocalPresenceBox"
                                   Height="28"
                                   Padding="7,2"
                                   Style="{StaticResource BridgeDirectoryComboBoxStyle}"
                                   SelectionChanged="LocalPresenceBox_SelectionChanged"
                                  ToolTip="选择你向好友显示的在线状态" />
                    </StackPanel>
                </Grid>
            </controls:ChamferBorder>

            <Grid Grid.Row="2" Margin="10,9,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FriendSearchBox"
                          Height="32"
                          Padding="9,4"
                          Style="{StaticResource BridgeDirectoryTextBoxStyle}"
                          VerticalContentAlignment="Center"
                         ToolTip="输入呼号或游戏 ID"
                         KeyDown="FriendSearchBox_KeyDown" />
                <Button x:Name="FriendSearchButton"
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        Style="{StaticResource FriendIconButton}"
                        ToolTip="查找用户"
                        Click="FriendSearchButton_Click">
                    <Viewbox>
                        <Path x:Name="FriendSearchIconPath"
                              Data="M 9.5,9.5 L 14,14 M 7,1.5 A 5.5,5.5 0 1 1 7,12.5 A 5.5,5.5 0 1 1 7,1.5"
                              Stroke="{DynamicResource BridgeInk}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
                <Button x:Name="FriendRefreshButton"
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Style="{StaticResource FriendIconButton}"
                        ToolTip="刷新好友"
                        Click="RefreshButton_Click">
                    <Viewbox>
                        <Path x:Name="FriendRefreshIconPath"
                              Data="M 12.5,5 A 5.5,5.5 0 1 0 13,10 M 12.5,5 L 12.5,1.5 M 12.5,5 L 9,5"
                              Stroke="{DynamicResource BridgeInk}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="3">
                <controls:ChamferBorder x:Name="UnavailablePanel"
                        Margin="8,0,8,8"
                        Padding="18"
                        Style="{StaticResource BridgeDirectorySurfaceStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <controls:BridgeLoadingIndicator x:Name="UnavailableLoadingIndicator"
                                                         Margin="0,0,0,10"
                                                         HorizontalAlignment="Center"
                                                         IsActive="False"
                                                         Visibility="Collapsed" />
                        <TextBlock Text="好友暂不可用"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BridgeInk}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="UnavailableDetailText"
                                   Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BridgeInk2}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:ChamferBorder>

                <ScrollViewer x:Name="FriendContentPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="SearchResultsPanel"
                                    Margin="10,0,10,8"
                                    Visibility="Collapsed">
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:BridgeLoadingIndicator x:Name="FriendSearchLoadingIndicator"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"
                                                                 IsActive="False"
                                                                 Visibility="Collapsed" />
                                <TextBlock x:Name="FriendSearchStatusText"
                                           Grid.Column="1"
                                           Foreground="{DynamicResource BridgeInk2}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <ListBox x:Name="FriendSearchResultList"
                                     Style="{StaticResource FriendRosterListStyle}"
                                     ItemContainerStyle="{StaticResource FriendRosterListItemStyle}"
                                     SelectionChanged="SearchResultList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FriendRosterRowTemplate}" />
                                            <Button Grid.Column="1"
                                                    Margin="4,8"
                                                    Padding="8,2"
                                                    Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                    Content="{Binding PrimaryActionText}"
                                                    Tag="{Binding PrimaryAction}"
                                                    Click="FriendActionButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel x:Name="IncomingRequestsPanel"
                                    Margin="10,0,10,8"
                                    Visibility="Collapsed">
                            <TextBlock Margin="2,3,0,6"
                                       Text="好友申请"
                                       Foreground="{DynamicResource BridgeStatusWarn}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <ListBox x:Name="IncomingRequestList"
                                     Style="{StaticResource FriendRosterListStyle}"
                                     ItemContainerStyle="{StaticResource FriendRosterListItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource FriendRosterRowTemplate}" />
                                            <Button Grid.Column="1"
                                                    Margin="2,8"
                                                    Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                    Tag="accept"
                                                    ToolTip="接受申请"
                                                    Click="FriendActionButton_Click">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="M 1,7 L 5,11 L 13,2"
                                                          Stroke="White"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Viewbox>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Margin="2,8"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Tag="reject"
                                                    ToolTip="拒绝申请"
                                                    Click="FriendActionButton_Click">
                                                <Viewbox Width="12" Height="12">
                                                    <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                                          Stroke="White"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <Border Margin="0,0,0,2"
                                Padding="12,6"
                                Background="{DynamicResource BridgePanelRaised}">
                            <Grid>
                                <TextBlock Text="在线"
                                           Foreground="{DynamicResource BridgeStatusOk}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="OnlineFriendCountText"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource BridgeInk2}"
                                           FontSize="10" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="OnlineFriendsList"
                                 Margin="8,0"
                                 Style="{StaticResource FriendRosterListStyle}"
                                 ItemTemplate="{StaticResource FriendRosterRowTemplate}"
                                 ItemContainerStyle="{StaticResource FriendRosterListItemStyle}"
                                 SelectionChanged="FriendList_SelectionChanged" />

                        <Border Margin="0,8,0,2"
                                Padding="12,6"
                                Background="{DynamicResource BridgePanelRaised}">
                            <Grid>
                                <TextBlock Text="离线"
                                           Foreground="{DynamicResource BridgeInk2}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="OfflineFriendCountText"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource BridgeInk2}"
                                           FontSize="10" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="OfflineFriendsList"
                                 Margin="8,0,8,10"
                                 Opacity="0.8"
                                 Style="{StaticResource FriendRosterListStyle}"
                                 ItemTemplate="{StaticResource FriendRosterRowTemplate}"
                                 ItemContainerStyle="{StaticResource FriendRosterListItemStyle}"
                                 SelectionChanged="FriendList_SelectionChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="4"
                    Padding="10,5"
                    Background="{DynamicResource BridgeGround}"
                    BorderBrush="{DynamicResource BridgeHairline}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:BridgeLoadingIndicator x:Name="FriendDirectoryLoadingIndicator"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     IsActive="True" />
                    <TextBlock x:Name="FriendDirectoryStatusText"
                               Grid.Column="1"
                               Foreground="{DynamicResource BridgeInk2}"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Popup x:Name="AvatarActionPopup"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <controls:ChamferBorder MinWidth="146"
                        Padding="5"
                        Style="{StaticResource BridgeDirectorySurfaceStyle}">
                    <StackPanel>
                        <Button x:Name="AvatarMessageButton"
                                Height="32"
                                Padding="10,0"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                Content="发消息"
                                Click="AvatarMessageButton_Click" />
                        <Button x:Name="AvatarProfileButton"
                                Height="32"
                                Margin="0,4,0,0"
                                Padding="10,0"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                Content="查看个人资料"
                                Click="AvatarProfileButton_Click" />
                    </StackPanel>
                </controls:ChamferBorder>
            </Popup>
        </Grid>
    </Border>
</Window>
