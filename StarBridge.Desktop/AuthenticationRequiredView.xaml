<UserControl x:Class="StarBridge.Desktop.AuthenticationRequiredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarBridge.Desktop"
             xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
             Background="Transparent"
             Focusable="False">
    <Border Background="{DynamicResource PageBackgroundBrush}"
            BorderBrush="{DynamicResource AccentDimBrush}"
            BorderThickness="1"
            Padding="28">
        <Grid>
            <Border Width="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="46,42"
                    Background="{DynamicResource AvionicsGlassPanelBrush}"
                    BorderBrush="{DynamicResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                        <controls:BridgeLoadingIndicator x:Name="AuthenticationStateLoadingIndicator"
                                         Width="14"
                                         Height="14"
                                         Margin="0,0,7,0"
                                         IsActive="True" />
                        <TextBlock x:Name="AuthenticationStateText"
                               Text="正在恢复 SCM 登录状态"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                        </StackPanel>
                    <TextBlock Text="{Binding Heading, RelativeSource={RelativeSource AncestorType={x:Type local:AuthenticationRequiredView}}}"
                               Margin="0,7,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:AuthenticationRequiredView}}}"
                               Width="560"
                               Margin="0,12,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Grid Width="560"
                          Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding FirstCapability, RelativeSource={RelativeSource AncestorType={x:Type local:AuthenticationRequiredView}}}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <Rectangle Grid.Column="1"
                                   Width="1"
                                   Height="18"
                                   Fill="{DynamicResource AccentDimBrush}"
                                   Opacity="0.7" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SecondCapability, RelativeSource={RelativeSource AncestorType={x:Type local:AuthenticationRequiredView}}}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <Rectangle Grid.Column="3"
                                   Width="1"
                                   Height="18"
                                   Fill="{DynamicResource AccentDimBrush}"
                                   Opacity="0.7" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding ThirdCapability, RelativeSource={RelativeSource AncestorType={x:Type local:AuthenticationRequiredView}}}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </Grid>

                        <Button x:Name="AuthenticationActionButton"
                            Content="登录账号"
                            Width="220"
                            Height="42"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            Style="{DynamicResource PrimaryButton}"
                            Click="LoginButton_Click" />
                    <TextBlock x:Name="AuthenticationFooterText"
                               Text="登录成功后将直接返回当前页面。"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
