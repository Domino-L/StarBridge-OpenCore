<UserControl x:Class="StarBridge.Desktop.InGameMenuSettingsEditor"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarBridge.Desktop"
             MinWidth="980"
             MinHeight="560"
             IsVisibleChanged="Editor_IsVisibleChanged"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="EditorPanel"
               TargetType="Border"
               BasedOn="{StaticResource OverlaySettingsPanelStyle}" />
        <Style x:Key="EditorSection" TargetType="Border"
               BasedOn="{StaticResource MenuOverlaySettingsSectionStyle}" />
        <Geometry x:Key="MenuSettingsOverviewIcon">M3,4 L3,20 L21,20 M6,16 L10,12 L13,14 L18,8 L21,11 M6,7 L9,7</Geometry>
        <Geometry x:Key="MenuSettingsHotkeyIcon">M13,2 L5,13 L11,13 L10,22 L19,10 L13,10 Z</Geometry>
        <Geometry x:Key="MenuSettingsToolbarIcon">M3,5 L21,5 L21,19 L3,19 Z M6,15 L9,15 M11,15 L14,15 M16,15 L18,15 M6,9 L18,9</Geometry>
        <Geometry x:Key="MenuSettingsLocalToolsIcon">M3,5 L10,5 L10,11 L3,11 Z M14,5 L21,5 L21,11 L14,11 Z M3,15 L10,15 L10,21 L3,21 Z M14,15 L21,15 L21,21 L14,21 Z</Geometry>
        <Geometry x:Key="MenuSettingsSocialIcon">M4,5 L20,5 L20,16 L9,16 L4,20 L4,5 Z M8,9 L16,9 M8,12 L14,12</Geometry>
        <Geometry x:Key="MenuSettingsWindowIcon">M12,3 A9,9 0 1 1 11.9,3 M12,8 L12,13 L16,15 M4,4 L6,6 M20,4 L18,6</Geometry>
        <Geometry x:Key="MenuSettingsAppearanceIcon">M4,7 L20,7 M4,12 L20,12 M4,17 L20,17 M9,5 L9,9 M15,10 L15,14 M11,15 L11,19</Geometry>
        <Geometry x:Key="MenuSettingsAdvancedIcon">M12,3 L22,21 L2,21 Z M12,9 L12,15 M12,18 L12,18.1</Geometry>
        <SolidColorBrush x:Key="OverlaySettingsNavigationHoverWashBrush"
                         Color="#2B2940" />
        <SolidColorBrush x:Key="OverlaySettingsNavigationActiveWashBrush"
                         Color="#1E4E416E" />
        <SolidColorBrush x:Key="OverlaySettingsNavigationHoverForegroundBrush"
                         Color="#F0EDFF" />
        <SolidColorBrush x:Key="OverlaySettingsNavigationPressedForegroundBrush"
                         Color="#D0C9FF" />
        <SolidColorBrush x:Key="OverlaySettingsNavigationActiveForegroundBrush"
                         Color="#F6F3FF" />
        <Color x:Key="OverlaySettingsNavigationGlyphGlowColor">#A79BFF</Color>
        <LinearGradientBrush x:Key="OverlaySettingsNavigationRouteLightBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#007B68FF" Offset="0" />
            <GradientStop Color="#B87B68FF" Offset="0.2" />
            <GradientStop Color="#FFE1DCFF" Offset="0.5" />
            <GradientStop Color="#B87B68FF" Offset="0.8" />
            <GradientStop Color="#007B68FF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="EditorNavButton"
               TargetType="Button"
               BasedOn="{StaticResource OverlaySettingsGlowNavigationButtonStyle}" />
        <Style x:Key="EditorHeading" TargetType="TextBlock"
               BasedOn="{StaticResource OverlaySettingsPageTitleTextStyle}" />
        <Style x:Key="EditorSubheading" TargetType="TextBlock"
               BasedOn="{StaticResource OverlaySettingsSectionTitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="EditorHint" TargetType="TextBlock"
               BasedOn="{StaticResource OverlaySettingsHintTextStyle}" />
        <Style x:Key="EditorFieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource OverlaySettingsLabelTextStyle}">
            <Setter Property="Margin" Value="0,10,0,5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorCheck"
               TargetType="CheckBox"
               BasedOn="{StaticResource OverlaySettingsInlineCheckStyle}" />
        <Style x:Key="EditorNestedCheck"
               TargetType="CheckBox"
               BasedOn="{StaticResource EditorCheck}">
            <Setter Property="Margin" Value="12,4,0,4" />
        </Style>
        <Style x:Key="EditorSwitch"
               TargetType="CheckBox"
               BasedOn="{StaticResource OverlaySettingsSwitchRowStyle}">
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style x:Key="EditorButton"
               TargetType="Button"
               BasedOn="{StaticResource OverlaySettingsButtonStyle}" />
        <Style x:Key="EditorActionButton"
               TargetType="Button"
               BasedOn="{StaticResource EditorButton}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="EditorIconButton"
               TargetType="Button"
               BasedOn="{StaticResource OverlaySettingsIconButtonStyle}" />
        <Style x:Key="EditorTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource OverlaySettingsTextBoxStyle}" />
        <Style x:Key="EditorComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource OverlaySettingsComboBoxStyle}" />
        <Style x:Key="EditorSlider"
               TargetType="Slider"
               BasedOn="{StaticResource OverlaySettingsSliderStyle}" />
        <Style TargetType="ScrollBar"
               BasedOn="{StaticResource StarBridgeScrollBar}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="520" MinWidth="460" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource EditorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="17,17,17,12">
                    <TextBlock Text="游戏内工具"
                               Foreground="{StaticResource MenuOverlaySettingsAccentBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="菜单浮层"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="所有设置集中在一条连续页面中；右侧会立即预览尚未保存的更改。"
                               Margin="0,7,0,0"
                               Style="{StaticResource EditorHint}" />
                </StackPanel>
                <ScrollViewer x:Name="SettingsNavigationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="SettingsNavigationContentGrid"
                          SizeChanged="SettingsNavigationContentGrid_SizeChanged">
                        <StackPanel>
                            <TextBlock Text="快速设置"
                                       Margin="16,4,0,4"
                                       Style="{StaticResource OverlaySettingsNavigationCategoryTextStyle}"
                                       FontSize="9.5" />
                            <Button x:Name="OverviewNavigationButton"
                                    Content="总览"
                                    CommandParameter="{StaticResource MenuSettingsOverviewIcon}"
                                    Uid="overview"
                                    Tag="Active"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <Button x:Name="HotkeyNavigationButton"
                                    Content="启动与热键"
                                    CommandParameter="{StaticResource MenuSettingsHotkeyIcon}"
                                    Uid="hotkey"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <TextBlock Text="工具与内容"
                                       Margin="16,10,0,4"
                                       Style="{StaticResource OverlaySettingsNavigationCategoryTextStyle}"
                                       FontSize="9.5" />
                            <Button x:Name="ToolbarNavigationButton"
                                    Content="工具栏与状态"
                                    CommandParameter="{StaticResource MenuSettingsToolbarIcon}"
                                    Uid="toolbar"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <Button x:Name="LocalToolsNavigationButton"
                                     Content="浏览与图像"
                                    CommandParameter="{StaticResource MenuSettingsLocalToolsIcon}"
                                    Uid="local"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <Button x:Name="SocialNavigationButton"
                                    Content="通讯与隐私"
                                    CommandParameter="{StaticResource MenuSettingsSocialIcon}"
                                    Uid="social"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <TextBlock Text="体验与恢复"
                                       Margin="16,10,0,4"
                                       Style="{StaticResource OverlaySettingsNavigationCategoryTextStyle}"
                                       FontSize="9.5" />
                            <Button x:Name="WindowNavigationButton"
                                    Content="窗口与恢复"
                                    CommandParameter="{StaticResource MenuSettingsWindowIcon}"
                                    Uid="window"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <Button x:Name="AppearanceNavigationButton"
                                    Content="外观与性能"
                                    CommandParameter="{StaticResource MenuSettingsAppearanceIcon}"
                                    Uid="appearance"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                            <Button x:Name="AdvancedNavigationButton"
                                    Content="问题处理"
                                    CommandParameter="{StaticResource MenuSettingsAdvancedIcon}"
                                    Uid="advanced"
                                    Tag="Inactive"
                                    Style="{StaticResource EditorNavButton}"
                                    Click="NavigationButton_Click" />
                        </StackPanel>
                        <Border x:Name="SettingsNavigationActiveRail"
                                Height="38"
                                Margin="4,0,0,0"
                                Style="{StaticResource MenuOverlaySettingsActiveRailStyle}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SettingsNavigationActiveRailTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="16">
                    <Border Height="1" Margin="0,0,0,10"
                            Background="{StaticResource OverlaySettingsSoftBorderBrush}" />
                    <TextBlock x:Name="RailHotkeyText"
                               Text="Alt + M"
                               Foreground="{StaticResource MenuOverlaySettingsAccentBrush}"
                               FontFamily="Bahnschrift"
                               FontWeight="SemiBold" />
                    <TextBlock Text="仅在 Star Citizen 位于前台时响应"
                               Margin="0,3,0,0"
                               Style="{StaticResource EditorHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource EditorPanel}">
            <ScrollViewer x:Name="SettingsScrollViewer"
                          Padding="14,14,14,32"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Loaded="SettingsScrollViewer_Loaded"
                          ScrollChanged="SettingsScrollViewer_ScrollChanged">
                <StackPanel>
                    <StackPanel x:Name="OverviewSection" Margin="0,0,0,24">
                        <TextBlock Text="总览" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="菜单浮层与信息浮层独立设置。菜单使用一个固定底部工具栏，普通选项在保存前只影响右侧预览。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="当前布局"
                                               Foreground="{StaticResource MenuOverlaySettingsAccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="底部工具栏（固定）"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="菜单栏固定显示在屏幕底部；打开后的工具窗口仍可单独移动和调整大小。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource EditorHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource OverlaySettingsSoftBorderBrush}" />
                                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                    <TextBlock Text="更改状态"
                                               Foreground="{StaticResource MenuOverlaySettingsAccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="OverviewDirtyText"
                                               Text="没有未保存的更改"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource StatusSuccessUnifiedBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="保存与放弃操作统一位于页面顶部。"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource EditorHint}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HotkeySection" Margin="0,0,0,24">
                        <TextBlock Text="启动与热键" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="点击输入框并按下新组合键。保存时会先注册新热键，成功后才替换旧热键。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="热键与响应" Style="{StaticResource EditorSubheading}" />
                                <CheckBox x:Name="EnableHotkeyCheck"
                                          Content="启用菜单浮层热键"
                                          Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HotkeyBox"
                                             Style="{StaticResource EditorTextBox}"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center"
                                             Padding="10,0"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    <Button Grid.Column="2"
                                            Content="恢复默认"
                                            Style="{StaticResource EditorButton}"
                                            Click="ResetHotkey_Click" />
                                </Grid>
                                <Border x:Name="HotkeyStatusBadge"
                                        Margin="0,10,0,0"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource OverlaySettingsFieldBrush}"
                                        BorderBrush="{StaticResource TextTertiaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HotkeyStatusIndicator"
                                                 Width="6" Height="6" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{StaticResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="HotkeyStatusText"
                                                   Text="正在检查"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="HotkeyStatusHintText"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource EditorHint}"
                                           Text="菜单热键只在游戏位于前台时响应。" />
                                <CheckBox x:Name="CloseWithHotkeyCheck"
                                          Content="菜单打开时再次按热键返回游戏"
                                          Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ToolbarSection" Margin="0,0,0,24">
                        <TextBlock Text="工具栏与状态" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="控制底部入口的显示、顺序和信息密度。信息浮层入口始终保留。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="工具入口与顺序" Style="{StaticResource EditorSubheading}" />
                                <ListBox x:Name="ToolOrderList"
                                         Margin="0,8,0,0"
                                         ItemsSource="{Binding ElementName=Root, Path=ToolItems}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9,5"
                                                    Background="{StaticResource OverlaySettingsFieldBrush}"
                                                    BorderBrush="{StaticResource OverlaySettingsSoftBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding DisplayName}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanHide}"
                                                              Style="{StaticResource EditorCheck}"
                                                              VerticalAlignment="Center"
                                                              Checked="ToolVisibility_Changed"
                                                              Unchecked="ToolVisibility_Changed" />
                                                    <Button Grid.Column="1"
                                                            Content="↑"
                                                            Tag="{Binding ToolKey}"
                                                            Style="{StaticResource EditorIconButton}"
                                                            Click="MoveToolUp_Click" />
                                                    <Button Grid.Column="2"
                                                            Content="↓"
                                                            Tag="{Binding ToolKey}"
                                                            Style="{StaticResource EditorIconButton}"
                                                            Click="MoveToolDown_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="工具栏显示" Style="{StaticResource EditorSubheading}" />
                                <TextBlock Text="密度" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ToolbarDensityCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock Text="标签显示" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ToolLabelModeCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="ShowUnreadBadgesCheck"
                                          Content="显示未读数量"
                                          Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="底部状态信息" Style="{StaticResource EditorSubheading}" />
                                <CheckBox x:Name="ShowContextBarCheck"
                                          Content="显示底部状态信息"
                                          Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                                <WrapPanel x:Name="ContextFieldPanel" Margin="12,3,0,0">
                                    <CheckBox x:Name="ShowSceneCheck" Content="当前协作" Style="{StaticResource EditorNestedCheck}"
                                              Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                    <CheckBox x:Name="ShowMemberCountCheck" Content="成员" Style="{StaticResource EditorNestedCheck}"
                                              Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                    <CheckBox x:Name="ShowShipCheck" Content="飞船" Style="{StaticResource EditorNestedCheck}"
                                              Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                    <CheckBox x:Name="ShowLocationCheck" Content="位置" Style="{StaticResource EditorNestedCheck}"
                                              Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                    <CheckBox x:Name="ShowServerCheck" Content="服务器" Style="{StaticResource EditorNestedCheck}"
                                              Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                </WrapPanel>
                                <CheckBox x:Name="ShowClockCheck" Content="显示时间" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ShowDateCheck" Content="显示日期" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ShowPresenceCheck" Content="显示在线状态" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="时间格式" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ClockFormatCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LocalToolsSection" Margin="0,0,0,24">
                         <TextBlock Text="浏览与图像" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="这些工具无需登录。关闭菜单后按性能和恢复设置暂停或保留。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="浏览器" Style="{StaticResource EditorSubheading}" />
                                    <Button Grid.Column="1" Content="打开浏览器"
                                            Style="{StaticResource EditorButton}"
                                            Tag="OpenBrowser"
                                            Click="ActionButton_Click" />
                                </Grid>
                                <TextBlock Text="默认搜索首页" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="BrowserProviderCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Key"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="BrowserRestorePageCheck" Content="恢复上次浏览页面" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="BrowserNewTabCheck" Content="网页请求新窗口时改为新标签页" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="BrowserPauseHiddenCheck" Content="浏览器隐藏时暂停页面" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock x:Name="BrowserTabLimitText" Text="标签页上限：8" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="BrowserTabLimitSlider" Minimum="1" Maximum="12"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                     <TextBlock Text="参考图" Style="{StaticResource EditorSubheading}" />
                                     <Button Grid.Column="1" Content="打开参考图"
                                            Style="{StaticResource EditorButton}"
                                            Tag="OpenImage"
                                            Click="ActionButton_Click" />
                                </Grid>
                                 <TextBlock Text="默认打开模式" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ImageOpenModeCombo" Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock Text="默认缩放" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ImageScaleModeCombo" Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock x:Name="ImageOpacityText" Text="默认透明度：100%" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="ImageOpacitySlider" Minimum="20" Maximum="100"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                                 <CheckBox x:Name="RememberImageAdjustmentsCheck" Content="再次打开参考图时保留裁剪、缩放和透明度" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                 <CheckBox x:Name="ImageDefaultPinnedCheck" Content="新参考图默认固定在游戏上" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="PauseAnimatedImagesCheck" Content="隐藏时暂停 GIF 动画"
                                          Visibility="Collapsed"
                                          Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="动态图会以静态预览打开，避免在游戏后台持续占用资源。"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource EditorHint}" />
                                <TextBlock x:Name="ImageWindowLimitText" Text="同时打开：5 张" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="ImageWindowLimitSlider" Minimum="1" Maximum="5"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="截图" Style="{StaticResource EditorSubheading}" />
                                <TextBlock Text="保存位置" Style="{StaticResource EditorFieldLabel}" />
                                <Border Height="34"
                                        Padding="10,0"
                                        Background="{StaticResource OverlaySettingsFieldBrush}"
                                        BorderBrush="{StaticResource OverlaySettingsSoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="ScreenshotDirectoryText"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="当前截图保存文件夹" />
                                </Border>
                                <TextBlock x:Name="ScreenshotDirectoryModeText"
                                           Margin="0,5,0,0"
                                           Style="{StaticResource EditorHint}" />
                                <WrapPanel Margin="0,9,0,2">
                                    <Button Content="选择文件夹"
                                            Style="{StaticResource EditorActionButton}"
                                            Click="SelectScreenshotDirectory_Click" />
                                    <Button Content="打开文件夹"
                                            Style="{StaticResource EditorActionButton}"
                                            Tag="OpenScreenshotFolder"
                                            Click="ActionButton_Click" />
                                    <Button Content="恢复默认"
                                            Style="{StaticResource EditorActionButton}"
                                            Click="UseDefaultScreenshotDirectory_Click" />
                                </WrapPanel>
                                <TextBlock Text="文件格式" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="ScreenshotFormatCombo" Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock x:Name="ScreenshotQualityText" Text="JPEG 质量：90%" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="ScreenshotQualitySlider" Minimum="50" Maximum="100"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="ScreenshotClipboardCheck" Content="截图后复制到剪贴板" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ScreenshotHideMenuCheck" Content="截图时隐藏菜单和工具窗口" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ScreenshotNotificationCheck" Content="保存后显示完成提示" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SocialSection" Margin="0,0,0,24">
                        <TextBlock Text="通讯与隐私" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="控制通讯首页、好友排序、邀请预览和公开信息，不改变信息浮层的显示内容。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="通讯偏好" Style="{StaticResource EditorSubheading}" />
                                <TextBlock Text="通讯默认页面" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="CommunicationLandingCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock Text="好友排序" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="FriendSortCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="SocialNotificationsCheck" Content="显示消息、好友与邀请提醒" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="SocialSoundCheck" Content="提醒时播放声音" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="邀请预览" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="InvitationPreviewCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="LoadNetworkAvatarsCheck" Content="加载好友与成员的网络头像" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="游戏内公开信息" Style="{StaticResource EditorSubheading}" />
                                <CheckBox x:Name="StreamerPrivacyCheck" Content="直播隐私模式" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="开启后会隐藏精确位置与房间码；不会更改服务器上的资料。"
                                           Margin="16,0,0,5" Style="{StaticResource EditorHint}" />
                                <CheckBox x:Name="ShowExactLocationCheck" Content="显示精确位置" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ShowRoomCodeCheck" Content="显示房间码" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="ConfirmExternalLinksCheck" Content="打开外部链接前确认"
                                          Visibility="Collapsed"
                                          Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="网页链接始终留在游戏内浏览器中；不支持的地址会被直接拦截。"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource EditorHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WindowSection" Margin="0,0,0,24">
                        <TextBlock Text="窗口与恢复" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="决定工具窗口在隐藏、重新打开、显示器变化或应用重启后的处理方式。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="窗口记忆与恢复" Style="{StaticResource EditorSubheading}" />
                                <CheckBox x:Name="RestoreOpenToolsCheck" Content="重新打开菜单时恢复本次使用的工具" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="RestoreLastFocusedToolCheck" Content="恢复最后使用的工具到前台" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="RememberWindowPlacementCheck" Content="记住工具窗口位置和大小" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="FitToolsToDisplayCheck" Content="显示器变化后自动移回可见区域" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="SnapToolWindowsCheck" Content="工具窗口靠近屏幕边缘时吸附" Style="{StaticResource EditorNestedCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock x:Name="SnapDistanceText" Text="吸附距离：12 像素" Margin="12,8,0,4" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="SnapDistanceSlider" Minimum="0" Maximum="32"
                                        Style="{StaticResource EditorSlider}"
                                        Margin="16,0,0,0"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="RestoreAcrossRestartsCheck" Content="应用重启后恢复未关闭的工具" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="异常退出后的处理" Margin="12,10,0,5" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="CrashRecoveryCombo"
                                          Margin="16,0,0,0"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <Button Content="重置所有工具窗口位置"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource EditorButton}"
                                        Tag="ResetWindowPlacements"
                                        Click="ActionButton_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Margin="0,0,0,24">
                        <TextBlock Text="外观与性能" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="缩放、明暗与动画只作用于菜单浮层和它打开的工具窗口。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="显示体验" Style="{StaticResource EditorSubheading}" />
                                <TextBlock Text="界面缩放" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="InterfaceScaleCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock Text="文字大小" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="TextScaleCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <TextBlock x:Name="BackgroundDimText" Text="游戏背景压暗：65%" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="BackgroundDimSlider" Minimum="35" Maximum="85"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                                <TextBlock Text="动画与过渡" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="MotionModeCombo" Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="HighContrastCheck" Content="增强文字和边框对比度" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock x:Name="ToolTipDelayText" Text="按钮提示延迟：500 毫秒" Style="{StaticResource EditorFieldLabel}" />
                                <Slider x:Name="ToolTipDelaySlider" Minimum="100" Maximum="1500"
                                        Style="{StaticResource EditorSlider}"
                                        TickFrequency="100" IsSnapToTickEnabled="True"
                                        ValueChanged="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="性能与兼容" Style="{StaticResource EditorSubheading}" />
                                <TextBlock Text="性能策略" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="PerformanceModeCombo"
                                          Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                                <CheckBox x:Name="PauseUpdatesWhileDraggingCheck" Content="拖动工具窗口时优先保持移动流畅" Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <CheckBox x:Name="AutoReduceEffectsCheck" Content="检测到卡顿时自动减少过渡效果" Style="{StaticResource EditorCheck}"
                                          Checked="SettingsControl_Changed" Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="显示兼容模式" Style="{StaticResource EditorFieldLabel}" />
                                <ComboBox x:Name="CompatibilityModeCombo" Style="{StaticResource EditorComboBox}"
                                          SelectionChanged="SettingsControl_Changed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSection" Margin="0,0,0,12">
                        <TextBlock Text="问题处理" Style="{StaticResource EditorHeading}" />
                        <TextBlock Text="如果菜单显示异常，可在这里恢复窗口、清理浏览数据或导出问题记录。"
                                   Margin="0,6,0,14"
                                   Style="{StaticResource EditorHint}" />
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <TextBlock Text="恢复与诊断" Style="{StaticResource EditorSubheading}" />
                                <CheckBox x:Name="SafeModeNextLaunchCheck"
                                          Content="下次启动菜单浮层时使用安全模式"
                                          Style="{StaticResource EditorSwitch}"
                                          Checked="SettingsControl_Changed"
                                          Unchecked="SettingsControl_Changed" />
                                <TextBlock Text="如果菜单无法正常显示，下次启动将使用基础显示效果并暂不恢复工具窗口；正常启动后会自动关闭此选项。"
                                           Margin="16,0,0,8"
                                           Style="{StaticResource EditorHint}" />
                                <WrapPanel>
                                    <Button Content="清理浏览器数据"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource EditorButton}"
                                            Tag="ClearBrowserData"
                                            Click="ActionButton_Click" />
                                    <Button Content="导出问题记录"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource EditorButton}"
                                            Tag="ExportDiagnostics"
                                            Click="ActionButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="ActionStatusText"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource EditorHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="4"
                Padding="10"
                Style="{StaticResource EditorPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="菜单布局"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="右侧按当前游戏显示器比例显示菜单；尚未保存的调整会立即出现在这里。"
                               Margin="0,5,0,0"
                               Style="{StaticResource EditorHint}" />
                </StackPanel>
                <local:InGameMenuPreviewSurface x:Name="PreviewSurface"
                                                Grid.Row="1"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{StaticResource OverlaySettingsPanelBrush}"
                                                BorderBrush="{StaticResource MenuOverlaySettingsAccentBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False" />
                <Border Grid.Row="2"
                        Style="{StaticResource MenuOverlaySettingsPreviewFooterStyle}">
                    <TextBlock x:Name="PreviewResolutionText"
                               Text="目标画布 1920 × 1080 · 自动匹配当前显示器"
                               Foreground="{StaticResource MenuOverlaySettingsAccentBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
