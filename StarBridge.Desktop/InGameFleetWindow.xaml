<Window x:Class="StarBridge.Desktop.InGameFleetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarBridge.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="游戏内舰队面板"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#02090F"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:ImageDataConverter x:Key="FleetImageDataConverter" />

        <SolidColorBrush x:Key="FleetVoidBrush" Color="#02090F" />
        <SolidColorBrush x:Key="FleetHullBrush" Color="#071722" />
        <SolidColorBrush x:Key="FleetGlassBrush" Color="#0B2230" />
        <SolidColorBrush x:Key="FleetAccentBrush" Color="#55C9F6" />
        <SolidColorBrush x:Key="FleetOnlineBrush" Color="#55E5A1" />
        <SolidColorBrush x:Key="FleetCommandBrush" Color="#D9A23B" />
        <SolidColorBrush x:Key="FleetTextBrush" Color="#EAF7FF" />
        <SolidColorBrush x:Key="FleetMutedBrush" Color="#86A5B8" />
        <SolidColorBrush x:Key="FleetEdgeBrush" Color="#28526A" />

        <Style x:Key="FleetCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowCaptionButton}" />

        <Style x:Key="FleetTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource FleetMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Margin="0,0,0,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#0D2A3A" />
                                <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#103044" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FleetAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FleetList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>

        <Style x:Key="FleetListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FleetSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FleetAccentBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FleetMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FleetMetricCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FleetMutedBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FleetFilterToggle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Foreground" Value="{StaticResource FleetMutedBrush}" />
            <Setter Property="Background" Value="#071A25" />
            <Setter Property="BorderBrush" Value="#24485D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Margin="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0D2A3A" />
                                <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#11364B" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource FleetAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A8E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FleetSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{StaticResource FleetTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource FleetAccentBrush}" />
            <Setter Property="Background" Value="#071A25" />
            <Setter Property="BorderBrush" Value="#24485D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FleetMemberHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#617A8A" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FleetMemberCallsignText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FleetMemberGameIdText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FleetMemberLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#637A89" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FleetMemberValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4E3EC" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="FleetMemberRowTemplate">
            <Border MinHeight="74"
                    Margin="0,0,0,7"
                    Background="{StaticResource AvionicsGlassPanelBrush}"
                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="1.8*" MinWidth="140" />
                        <ColumnDefinition Width="0.8*" MinWidth="75" />
                        <ColumnDefinition Width="0.95*" MinWidth="92" />
                        <ColumnDefinition Width="0.7*" MinWidth="64" />
                        <ColumnDefinition Width="1.1*" MinWidth="100" />
                        <ColumnDefinition Width="1.3*" MinWidth="118" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding PresenceBrush}" />
                    <Grid Grid.Column="1"
                          Width="44"
                          Height="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Border Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassEdgeBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Initials}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <Image Source="{Binding AvatarSource, Converter={StaticResource FleetImageDataConverter}, ConverterParameter=88}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,-1,-1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Stroke="{StaticResource FieldBackBrush}"
                                 StrokeThickness="1"
                                 Fill="{Binding PresenceBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="2"
                                Margin="8,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Callsign}"
                                   Style="{StaticResource FleetMemberCallsignText}"
                                   ToolTip="{Binding Callsign}" />
                        <TextBlock Text="{Binding GameId}"
                                   Style="{StaticResource FleetMemberGameIdText}"
                                   ToolTip="{Binding GameId}" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            MinHeight="23"
                            MaxHeight="24"
                            Padding="7,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#102536"
                            BorderBrush="{StaticResource AvionicsGlassEdgeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding SquadText}"
                                   VerticalAlignment="Center"
                                   Foreground="#9DCBE4"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SquadText}" />
                    </Border>
                    <Border Grid.Column="4"
                            MinHeight="23"
                            MaxHeight="24"
                            Padding="7,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#102536"
                            BorderBrush="{Binding RoleBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding RoleText}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RoleBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RoleText}" />
                    </Border>
                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding PresenceBrush}" />
                        <TextBlock Text="{Binding PresenceText}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding PresenceBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="当前飞船"
                                   Style="{StaticResource FleetMemberLabelText}" />
                        <TextBlock Text="{Binding ShipText}"
                                   Style="{StaticResource FleetMemberValueText}"
                                   ToolTip="{Binding ShipText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="7"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="当前位置"
                                   Style="{StaticResource FleetMemberLabelText}" />
                        <TextBlock Text="{Binding LocationText}"
                                   Style="{StaticResource FleetMemberValueText}"
                                   ToolTip="{Binding LocationText}" />
                        <TextBlock Text="{Binding ServerText}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ServerText}" />
                    </StackPanel>
                    <Button x:Name="MemberMoreButton"
                            Grid.Column="8"
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="成员操作"
                            Style="{StaticResource SecondaryButton}"
                            Click="MemberMoreButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource StarBridgeContextMenu}"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="查看资料"
                                          Tag="profile"
                                          IsEnabled="{Binding CanOpenProfile}"
                                          Style="{StaticResource StarBridgeContextMenuItem}"
                                          Click="MemberActionButton_Click" />
                                <MenuItem Header="私信"
                                          Tag="message"
                                          IsEnabled="{Binding CanMessage}"
                                          Style="{StaticResource StarBridgeContextMenuItem}"
                                          Click="MemberActionButton_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid x:Name="MemberActionDots"
                              Width="13"
                              Height="3"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" HorizontalAlignment="Left" Fill="{StaticResource PrimaryTextBrush}" />
                            <Ellipse Width="3" Height="3" HorizontalAlignment="Center" Fill="{StaticResource PrimaryTextBrush}" />
                            <Ellipse Width="3" Height="3" HorizontalAlignment="Right" Fill="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FleetSquadRowTemplate">
            <Border Margin="0,0,0,8"
                    Background="#061722"
                    BorderBrush="#1D465D"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ToggleButton x:Name="SquadExpandToggle"
                                  Padding="10"
                                  HorizontalContentAlignment="Stretch"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="SquadHeaderBack"
                                        Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SquadHeaderBack" Property="Background" Value="#091F2B" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="SquadHeaderBack" Property="Background" Value="#0D2939" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <Grid MinHeight="72">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.72*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40">
                                <Border Background="#0A1823"
                                        BorderBrush="#315469"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Icon}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource FleetAccentBrush}"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                </Border>
                                <Image Source="{Binding EmblemSource, Converter={StaticResource FleetImageDataConverter}, ConverterParameter=80}"
                                       Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource FleetTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding CommanderText}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="协作方向"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="9.5" />
                                <TextBlock Text="{Binding TypeText}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource FleetAccentBrush}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="小队介绍"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="9.5" />
                                <TextBlock Text="{Binding Description}"
                                           Margin="0,4,0,0"
                                           Foreground="#CFE5F1"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="成员预览"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="9.5" />
                                <TextBlock Text="{Binding MemberNames}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="在线情况"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource FleetMutedBrush}"
                                           FontSize="9.5" />
                                <TextBlock Text="{Binding CountText}"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{Binding StateBrush}"
                                           FontFamily="Bahnschrift"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InGameCountText}"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource FleetAccentBrush}"
                                           FontSize="9.5" />
                            </StackPanel>
                            <TextBlock Grid.Column="6"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource FleetAccentBrush}"
                                       FontSize="10.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="展开成员" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SquadExpandToggle}" Value="True">
                                                <Setter Property="Text" Value="收起成员" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ToggleButton>
                    <Border Grid.Row="1"
                            Padding="8"
                            Background="#04121B"
                            BorderBrush="#1D465D"
                            BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=SquadExpandToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding Members}"
                                      ItemTemplate="{StaticResource FleetMemberRowTemplate}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FleetShipRowTemplate">
            <Border Padding="8,7"
                    Background="#061722"
                    BorderBrush="#17384A"
                    BorderThickness="0,0,0,1">
                <Grid MinHeight="62">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="94" Height="56">
                        <Border Background="#0A1823"
                                BorderBrush="#315469"
                                BorderThickness="1">
                            <TextBlock Text="舰船"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource FleetMutedBrush}"
                                       FontSize="9.5" />
                        </Border>
                        <Image Margin="1"
                               Source="{Binding ImageSource, Converter={StaticResource FleetImageDataConverter}, ConverterParameter=180}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource FleetTextBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding IdentityText}" />
                        <TextBlock Text="{Binding EnglishName}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource FleetMutedBrush}"
                                   FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding EnglishName}" />
                        <TextBlock Text="{Binding SpecText}"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource FleetAccentBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SpecText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Margin="14,0"
                                VerticalAlignment="Center">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,5,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding OwnerPresenceBrush}" />
                                <TextBlock Text="{Binding OwnerPresenceText}"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding OwnerPresenceBrush}"
                                           FontSize="9.5" />
                            </StackPanel>
                            <TextBlock Text="舰长"
                                       Foreground="{StaticResource FleetMutedBrush}"
                                       FontSize="9.5" />
                        </DockPanel>
                        <TextBlock Text="{Binding CaptainText}"
                                   Margin="0,3,0,0"
                                   Foreground="#CFE5F1"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CaptainText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Margin="14,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="状态"
                                   Foreground="{StaticResource FleetMutedBrush}"
                                   FontSize="9.5" />
                        <TextBlock Text="{Binding Status}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource FleetOnlineBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="4"
                               Text="{Binding ValueText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FleetTextBrush}"
                               FontFamily="Bahnschrift"
                               FontSize="11" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            Background="{StaticResource FieldBackBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#102433"
                    BorderBrush="#2B556B"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,5,0,0">
                        <TextBlock Text="舰队协作"
                                   Foreground="{StaticResource FleetTextBrush}"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="快速查看队友状态并发起联系"
                                   Foreground="#6F9CB5"
                                   FontSize="9.5" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource FleetCaptionButton}"
                            Tag="Close"
                            ToolTip="关闭舰队面板"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="UnavailablePanel"
                  Grid.Row="1"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="舰队信息暂不可用"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource FleetTextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="UnavailableDetailText"
                               Width="480"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource FleetMutedBrush}"
                               FontSize="11" />
                    <Button Content="重试"
                            Margin="0,18,0,0"
                            Padding="20,7"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="FleetContent"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="104" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="14,11,14,0"
                        Padding="14,10"
                        Background="{StaticResource AvionicsGlassPanelBrush}"
                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.78*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="138" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="54"
                              Height="54"
                              VerticalAlignment="Center">
                            <Border Background="{StaticResource AvionicsGlassPanelBrush}"
                                    BorderBrush="{StaticResource AvionicsGlassEdgeBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="FleetLogoFallbackText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="15"
                                           FontWeight="Bold" />
                            </Border>
                            <Image x:Name="FleetLogoImage"
                                   Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1"
                                    Margin="2,0,18,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="FleetNameText"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="FleetCodeText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Bahnschrift"
                                       FontSize="10.5"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                Margin="0,0,16,0"
                                Padding="12,7"
                                VerticalAlignment="Stretch"
                                Background="#091B27"
                                BorderBrush="{StaticResource StatusWarningBrush}"
                                BorderThickness="2,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="舰队指挥官"
                                           Style="{StaticResource FleetSectionLabel}" />
                                <TextBlock x:Name="FleetCommanderText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource StatusWarningBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3"
                                Margin="0,0,16,0"
                                Padding="12,7"
                                Background="{StaticResource FieldBackBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="舰队公告"
                                           Style="{StaticResource FleetSectionLabel}" />
                                <TextBlock x:Name="AnnouncementTitleText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="AnnouncementContentText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="4"
                                Content="舰队通讯"
                                MinWidth="120"
                                Height="32"
                                Padding="14,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButton}"
                                Click="OpenCommunicationButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="14,7,14,0"
                        Padding="12,5"
                        Background="{StaticResource AvionicsGlassPanelBrush}"
                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="在线概况"
                                       Style="{StaticResource FleetSectionLabel}" />
                            <Grid Width="168"
                                  Height="5"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="InGameSignalColumn" Width="1*" />
                                    <ColumnDefinition x:Name="OnlineSignalColumn" Width="1*" />
                                    <ColumnDefinition x:Name="AwaySignalColumn" Width="1*" />
                                    <ColumnDefinition x:Name="OfflineSignalColumn" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource StatusSuccessBrush}" />
                                <Border Grid.Column="1" Background="{StaticResource AccentBrush}" />
                                <Border Grid.Column="2" Background="{StaticResource StatusWarningBrush}" />
                                <Border Grid.Column="3" Background="#536C7B" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TotalMemberCountText" Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="成员" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="InGameMemberCountText"
                                       Foreground="{StaticResource StatusSuccessBrush}"
                                       Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="游戏中" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="SameServerMemberCountText"
                                       Foreground="{StaticResource StatusSuccessBrush}"
                                       Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="同服" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="OnlineMemberCountText"
                                       Foreground="{StaticResource AccentBrush}"
                                       Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="应用在线" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="AwayMemberCountText"
                                       Foreground="{StaticResource StatusWarningBrush}"
                                       Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="暂离" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="OfflineMemberCountText"
                                       Foreground="#728B9A"
                                       Style="{StaticResource FleetMetricValue}" />
                            <TextBlock Text="离线" Style="{StaticResource FleetMetricCaption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="7"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource StatusSuccessBrush}" />
                            <TextBlock Text="自动更新"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2"
                            Margin="14,7,14,10"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="即时协作" Style="{StaticResource FleetTabItem}">
                        <Border Margin="0,8,0,0"
                                Background="{StaticResource FieldBackBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="31" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="CollaborationAllFilter"
                                                      Content="全部"
                                                      Tag="all"
                                                      IsChecked="True"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="CollaborationFilter_Click" />
                                        <ToggleButton x:Name="CollaborationSameServerFilter"
                                                      Content="同服务器"
                                                      Tag="same-server"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="CollaborationFilter_Click" />
                                        <ToggleButton x:Name="CollaborationSquadFilter"
                                                      Content="我的小队"
                                                      Tag="squad"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="CollaborationFilter_Click" />
                                        <ToggleButton x:Name="CollaborationInGameFilter"
                                                      Content="游戏中"
                                                      Tag="in-game"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="CollaborationFilter_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="搜索成员"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5" />
                                        <TextBox x:Name="CollaborationSearchBox"
                                                 Width="180"
                                                 ToolTip="输入呼号、游戏 ID、小队、飞船或地点"
                                                 Style="{StaticResource FleetSearchBox}"
                                                 TextChanged="CollaborationSearchBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Padding="12,0"
                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                        BorderThickness="0,1,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="1.8*" MinWidth="140" />
                                            <ColumnDefinition Width="0.8*" MinWidth="75" />
                                            <ColumnDefinition Width="0.95*" MinWidth="92" />
                                            <ColumnDefinition Width="0.7*" MinWidth="64" />
                                            <ColumnDefinition Width="1.1*" MinWidth="100" />
                                            <ColumnDefinition Width="1.3*" MinWidth="118" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="2" Text="成员" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="3" Text="小队" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="4" Text="角色" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="6" Text="飞船" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="7" Text="位置" Style="{StaticResource FleetMemberHeaderText}" />
                                        <TextBlock Grid.Column="8"
                                                   Text="操作"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource FleetMemberHeaderText}" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2"
                                      Margin="12,0,12,12">
                                    <ListBox x:Name="CollaborationMemberList"
                                             Style="{StaticResource FleetList}"
                                             ItemContainerStyle="{StaticResource FleetListItem}"
                                             ItemTemplate="{StaticResource FleetMemberRowTemplate}" />
                                    <TextBlock x:Name="CollaborationEmptyText"
                                               Text="当前筛选下没有可显示的成员"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="小队" Style="{StaticResource FleetTabItem}">
                        <Border Margin="0,8,0,0"
                                Background="{StaticResource FieldBackBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SquadFilterSummaryText"
                                               Text="0 个小队"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource FleetMutedBrush}"
                                               FontSize="10.5" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="搜索小队"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5" />
                                        <TextBox x:Name="SquadSearchBox"
                                                 Width="210"
                                                 ToolTip="输入小队名称、指挥官、类型或成员"
                                                 Style="{StaticResource FleetSearchBox}"
                                                 TextChanged="SquadSearchBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Padding="12"
                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <ListBox x:Name="SquadList"
                                                 Style="{StaticResource FleetList}"
                                                 ItemContainerStyle="{StaticResource FleetListItem}"
                                                 ItemTemplate="{StaticResource FleetSquadRowTemplate}" />
                                        <TextBlock x:Name="SquadEmptyText"
                                                   Text="舰队暂未建立小队"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                    <TabItem Header="舰船" Style="{StaticResource FleetTabItem}">
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="{StaticResource FieldBackBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="ShipAllFilter"
                                                      Content="全部"
                                                      Tag="all"
                                                      IsChecked="True"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="ShipOwnerFilter_Click" />
                                        <ToggleButton x:Name="ShipOnlineFilter"
                                                      Content="在线"
                                                      Tag="online"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="ShipOwnerFilter_Click" />
                                        <ToggleButton x:Name="ShipOfflineFilter"
                                                      Content="离线"
                                                      Tag="offline"
                                                      Style="{StaticResource FleetFilterToggle}"
                                                      Click="ShipOwnerFilter_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ShipFilterSummaryText"
                                               Text="0 艘"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource FleetMutedBrush}"
                                               FontSize="10.5" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="ShipList"
                                             Style="{StaticResource FleetList}"
                                             ItemContainerStyle="{StaticResource FleetListItem}"
                                             ItemTemplate="{StaticResource FleetShipRowTemplate}"
                                             VirtualizingPanel.ScrollUnit="Item" />
                                    <TextBlock x:Name="ShipEmptyText"
                                               Text="还没有成员共享舰船"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border Grid.Row="2"
                    Padding="12,0"
                    Background="#06131C"
                    BorderBrush="#1D4054"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource FleetMutedBrush}"
                               FontSize="9.5"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="舰队信息会自动更新 · Esc 返回游戏"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#69889A"
                               FontSize="9.5"
                               LineHeight="14"
                               LineStackingStrategy="BlockLineHeight" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
