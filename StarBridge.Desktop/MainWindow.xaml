                                                                    <CheckBox x:Name="NotificationEmailCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" IsEnabled="False" Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Padding="0,5,0,5" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
