                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="地点数据采集许可"
                                           Margin="0,1,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ToolTip="关闭"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="LocationDataConsentCloseButton_Click">
                                <Path Width="10"
                                      Height="10"
                                      Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                      Stroke="#B9CDD9"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="None" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="24,22,24,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="帮助完善地点名称转换？"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,9,0,0"
                                       Text="允许后，星海舰桥会从 Game.log 中提取地点代码，并将匿名候选关系提交给星海舰桥服务器，用于建立量子目标与实际地点的对照。"
                                       Foreground="#B9CDD9"
                                       FontSize="12"
                                       LineHeight="20"
                                       TextWrapping="Wrap" />

                            <UniformGrid Grid.Row="2"
                                         Rows="1"
                                         Columns="3"
                                         Margin="0,17,0,0">
                                <Border Margin="0,0,5,0" Padding="11,10" Background="{StaticResource AvionicsGlassPanelBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="只采集地点代码" Foreground="#E6F1F8" FontWeight="SemiBold" />
                                        <TextBlock Text="不提交玩家名、完整日志或聊天内容。" Margin="0,4,0,0" Foreground="#7F95A4" FontSize="10.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="5,0" Padding="11,10" Background="{StaticResource AvionicsGlassPanelBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="候选不会直接生效" Foreground="#E6F1F8" FontWeight="SemiBold" />
                                        <TextBlock Text="需要重复证据并审核后才会更新名称表。" Margin="0,4,0,0" Foreground="#7F95A4" FontSize="10.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="5,0,0,0" Padding="11,10" Background="{StaticResource AvionicsGlassPanelBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="随时可以停止" Foreground="#E6F1F8" FontWeight="SemiBold" />
                                        <TextBlock Text="可在应用设置中关闭，未提交候选会被清除。" Margin="0,4,0,0" Foreground="#7F95A4" FontSize="10.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid Grid.Row="3" Margin="0,21,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="168" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已提交的数据仅作为匿名汇总保留，不会关联到公开资料。"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap" />
                                <Button x:Name="LocationDataConsentDeclineButton"
                                        Grid.Column="1"
                                        Content="暂不参与"
                                        Height="34"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="LocationDataConsentDeclineButton_Click" />
                                <Button x:Name="LocationDataConsentAllowButton"
                                        Grid.Column="2"
                                        Content="同意并开始采集"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="LocationDataConsentAllowButton_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <controls:BridgeModalHost x:Name="AppConfirmOverlay"
                                  Grid.RowSpan="2"
                                  Panel.ZIndex="135"
                                  Title="确认操作"
                                  Size="Confirm"
                                  DismissRequested="AppConfirmCancelButton_Click">
            <controls:BridgeModalHost.Footer>
                <Grid Style="{StaticResource BridgeModalFooterStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppConfirmFooterText"
                               Text="此操作会同步到舰队。"
                               VerticalAlignment="Center"
                               Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                               TextWrapping="Wrap" />
                    <Button x:Name="AppConfirmCancelButton"
                            Grid.Column="1"
                            Content="取消"
                            Height="34"
                            Margin="12,0,0,0"
                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                            Click="AppConfirmCancelButton_Click" />
                    <Button x:Name="AppConfirmPrimaryButton"
                            Grid.Column="2"
                            Content="确认"
                            Height="34"
                            Margin="12,0,0,0"
                            Style="{StaticResource BridgeModalDangerButtonStyle}"
                            Click="AppConfirmPrimaryButton_Click" />
                </Grid>
            </controls:BridgeModalHost.Footer>
            <StackPanel>
                        <TextBlock x:Name="AppConfirmMessageText"
                                   Style="{StaticResource BridgeDirectorySectionTitleStyle}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,14,0,0"
                                Padding="12,10"
                                Style="{StaticResource BridgeDirectorySeamSurfaceStyle}">
                            <TextBlock x:Name="AppConfirmDetailText"
                                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                                       TextWrapping="Wrap" />
                        </Border>

            </StackPanel>
        </controls:BridgeModalHost>

        <Border x:Name="UpdateProgressOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="140"
                Visibility="Collapsed"
                Background="{DynamicResource BridgeScrim}">
            <Grid>
                <Rectangle Fill="{StaticResource GeometricBackgroundBrush}"
                           Opacity="0.75"
                           IsHitTestVisible="False" />
                <Border Width="760"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F006101A"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="UpdateOverlayTitleText"
                                       Text="发现新版本"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateOverlayVersionText"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateOverlayModeText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,22,0,0"
                                Padding="16"
                                MinHeight="110"
                                Background="{StaticResource FieldBackBrush}"
                                BorderBrush="{StaticResource AccentDimBrush}"
                                BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="180">
                                <TextBlock x:Name="UpdateOverlayNotesText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2"
                              Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="UpdateOverlayProgressBar"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />
                            <TextBlock x:Name="UpdateOverlayProgressText"
                                       Grid.Column="1"
                                       Text="0%"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock x:Name="UpdateOverlayStatusText"
                                   Grid.Row="3"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="4"
                              Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="更新期间应用会锁定操作。下载完成后可能自动关闭并重启，请不要手动结束更新进程。"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="UpdateOverlayCancelButton"
                                    Grid.Column="1"
                                    Content="稍后"
                                    Height="40"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="UpdateOverlayCancelButton_Click" />
                            <Button x:Name="UpdateOverlayPrimaryButton"
                                    Grid.Column="2"
                                    Content="立即更新"
                                    Height="40"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="UpdateOverlayPrimaryButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="GuidedTourOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="500"
              Visibility="Collapsed"
              SizeChanged="GuidedTourOverlay_SizeChanged">
            <Canvas x:Name="GuidedTourVisualLayer"
                    IsHitTestVisible="False">
                <Border x:Name="GuidedTourMaskTop"
                    Background="{DynamicResource BridgeScrim}"
                    Opacity="0.48"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0" />
            <Border x:Name="GuidedTourMaskLeft"
                    Background="{DynamicResource BridgeScrim}"
                    Opacity="0.48"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0" />
            <Border x:Name="GuidedTourMaskRight"
                    Background="{DynamicResource BridgeScrim}"
                    Opacity="0.48"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0" />
            <Border x:Name="GuidedTourMaskBottom"
                    Background="{DynamicResource BridgeScrim}"
                    Opacity="0.48"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0" />

                <Border x:Name="GuidedTourTargetFrame"
                    Width="120"
                    Height="42"
                    BorderBrush="#68D3FF"
                    BorderThickness="1.5"
                    CornerRadius="4"
                    Background="#1029AFFF"
                    IsHitTestVisible="False"
                    Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect Color="#5CCBFF"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.58" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="GuidedTourTargetTransform" />
                </Border.RenderTransform>
                </Border>
            </Canvas>

            <Canvas x:Name="GuidedTourCoachLayer">
                <Border x:Name="GuidedTourCoachCard"
                    Width="400"
                    MaxWidth="420"
                    Padding="18"
                    Background="#F20B1C28"
                    BorderBrush="#2A5871"
                    BorderThickness="1"
                    CornerRadius="4"
                    Panel.ZIndex="2"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="GuidedTourCardTransform" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3"
                                Height="28"
                                VerticalAlignment="Top"
                                Background="{StaticResource AvionicsRouteLightBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock x:Name="GuidedTourEyebrowText"
                                       Text="首次启航"
                                       Foreground="#63C7FF"
                                       FontFamily="Bahnschrift"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="GuidedTourTitleText"
                                       Text="欢迎使用星海舰桥"
                                       Margin="0,3,0,0"
                                       Foreground="#E6F1F8"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="GuidedTourBodyText"
                               Grid.Row="1"
                               Margin="0,14,0,0"
                               Foreground="#B7CAD6"
                               FontSize="12"
                               LineHeight="19"
                               TextWrapping="Wrap" />

                    <ScrollViewer x:Name="GuidedTourIntroductionScrollViewer"
                                  Grid.Row="2"
                                  Height="210"
                                  Margin="0,14,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed"
                                  ScrollChanged="GuidedTourIntroductionScrollViewer_ScrollChanged">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="开始前，请先了解这些边界"
                                       Foreground="#E6F1F8"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#9DB4C2"
                                       FontSize="11.5"
                                       LineHeight="19"
                                       TextWrapping="Wrap">
                                <Run Text="星海舰桥是一款面向 Star Citizen 玩家和舰队的协作应用，用于组织、通讯、游戏状态展示与本地日志分析。" />
                                <LineBreak /><LineBreak />
                                <Run Text="应用不会替代游戏客户端，也不保证游戏日志、服务器状态或第三方服务始终可用。识别结果可能因游戏版本变化而延迟或不完整。" />
                                <LineBreak /><LineBreak />
                                <Run Text="多人同步、个人资料、好友、舰队与聊天内容会发送到星海舰桥服务器；本地日志和统计数据只会在你完成相应授权后开始处理。" />
                                <LineBreak /><LineBreak />
                                <Run Text="请勿在公开资料、聊天或公告中发布账号密码、验证码、现实身份、付款信息等敏感内容；重要资料请另行备份。" />
                                <LineBreak /><LineBreak />
                                <Run Text="继续后会逐步标出主要入口。你可以在真实页面中自由查看和调整，也可以随时收起引导；引导不会代替你提交或保存任何操作。" />
                            </TextBlock>
                            <Border Height="1"
                                    Margin="0,16,0,8"
                                    Background="#315A70" />
                            <TextBlock Text="已阅读到底，可继续"
                                       Foreground="#63C7FF"
                                       FontSize="10.5" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GuidedTourProgressText"
                                   Text="准备开始"
                                   VerticalAlignment="Center"
                                   Foreground="#6F8C9D"
                                   FontFamily="Bahnschrift"
                                   FontSize="10" />
                        <Button x:Name="GuidedTourBackButton"
                                Grid.Column="1"
                                Content="上一步"
                                MinWidth="76"
                                Height="34"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                Click="GuidedTourBackButton_Click" />
                        <Button x:Name="GuidedTourSecondaryButton"
                                Grid.Column="2"
                                Content="暂时收起"
                                MinWidth="92"
                                Height="34"
                                Margin="10,0,0,0"
                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                Click="GuidedTourSecondaryButton_Click" />
                        <Button x:Name="GuidedTourPrimaryButton"
                                Grid.Column="3"
                                Content="继续"
                                MinWidth="104"
                                Height="34"
                                Margin="10,0,0,0"
                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                Click="GuidedTourPrimaryButton_Click" />
                    </Grid>
                </Grid>
                </Border>
            </Canvas>
        </Grid>

        <local:ApplicationLayerHost x:Name="ApplicationLayerHost"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Panel.ZIndex="500"
                                    ClipToBounds="True" />

        <Popup x:Name="UserAvatarActionPopup"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="6"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Width="184"
                    Padding="7"
                    Background="#FA0B1C28"
                    BorderBrush="#2A5871"
                    BorderThickness="1"
                    CornerRadius="3">
                <StackPanel>
                    <Button x:Name="UserAvatarProfileActionButton"
                            Content="查看个人资料"
                            Height="34"
                            Style="{StaticResource SecondaryButton}"
                            Click="UserAvatarProfileActionButton_Click" />
                    <Button x:Name="UserAvatarMessageActionButton"
                            Content="发送消息"
                            Height="34"
                            Margin="0,6,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="UserAvatarMessageActionButton_Click" />
                    <Button x:Name="UserAvatarFriendActionButton"
                            Content="添加好友"
                            Height="34"
                            Margin="0,6,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="UserAvatarFriendActionButton_Click" />
                    <TextBlock x:Name="UserAvatarActionUnavailableText"
                               Text="资料暂不可用"
                               Margin="6,6,6,2"
                               Foreground="#7F9AAA"
                               FontSize="10"
                               TextAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Border>
</Window>
