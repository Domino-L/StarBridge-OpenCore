                                                                                Height="30"
                                                                                Padding="12,0"
                                                                                VerticalAlignment="Center"
                                                                                Style="{StaticResource SecondaryButton}"
                                                                                Click="ConfirmLegacyPrivateExternalContactsButton_Click" />
                                                                    </Grid>
                                                                </Border>

                                                                <ItemsControl x:Name="ManageFleetExternalContactsList">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,0,0,6">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="96" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="62" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <ComboBox Height="30"
                                                                                          SelectedValue="{Binding Platform, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                          SelectedValuePath="Tag"
                                                                                          SelectionChanged="ManageProfileDraftChanged">
                                                                                    <ComboBoxItem Content="QQ" Tag="QQ" />
                                                                                    <ComboBoxItem Content="微信" Tag="微信" />
                                                                                    <ComboBoxItem Content="KOOK" Tag="KOOK" />
                                                                                    <ComboBoxItem Content="OOPZ" Tag="OOPZ" />
                                                                                    <ComboBoxItem Content="Discord" Tag="Discord" />
                                                                                    <ComboBoxItem Content="Telegram" Tag="Telegram" />
                                                                                    <ComboBoxItem Content="Bilibili" Tag="Bilibili" />
                                                                                    <ComboBoxItem Content="X / Twitter" Tag="X" />
                                                                                    <ComboBoxItem Content="YouTube" Tag="YouTube" />
                                                                                    <ComboBoxItem Content="Twitch" Tag="Twitch" />
                                                                                    <ComboBoxItem Content="Reddit" Tag="Reddit" />
                                                                                    <ComboBoxItem Content="邮箱" Tag="邮箱" />
                                                                                    <ComboBoxItem Content="其他" Tag="其他" />
                                                                                </ComboBox>
                                                                                <TextBox Grid.Column="1"
                                                                                         Height="30"
                                                                                         Margin="6,0"
                                                                                         Style="{StaticResource ManageProfileTextBox}"
                                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         TextChanged="ManageProfileDraftChanged" />
                                                                                <Button Grid.Column="2"
                                                                                        Content="删除"
                                                                                        Width="58"
                                                                                        Height="30"
                                                                                        Padding="8,0"
                                                                                        Style="{StaticResource SecondaryButton}"
                                                                                        Click="RemoveExternalContactButton_Click" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <Border x:Name="ManageExternalContactsEmptyText"
                                                                        Visibility="Collapsed"
                                                                        Style="{StaticResource ManageProfileFieldBox}">
                                                                    <TextBlock Text="尚未添加外部联系方式。"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </Border>

                                                                <StackPanel Visibility="Collapsed">
                                                                    <TextBlock x:Name="ManageBasicMemberCountText" Text="0" />
                                                                    <TextBlock x:Name="ManageBasicShipCountText" Text="0" />
                                                                    <TextBlock x:Name="ManageBasicUpdatedAtText" Text="暂无" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Visibility="Collapsed">
                                                        <CheckBox x:Name="ManageProfileShowDescriptionCheck"
                                                                  Style="{StaticResource ManageProfileSwitchStyle}"
                                                                  Checked="ManageProfileDraftChanged"
                                                                  Unchecked="ManageProfileDraftChanged" />
                                                        <CheckBox x:Name="ManageProfileShowAnnouncementCheck"
                                                                  Style="{StaticResource ManageProfileSwitchStyle}"
                                                                  Checked="ManageProfileDraftChanged"
                                                                  Unchecked="ManageProfileDraftChanged" />
                                                        <CheckBox x:Name="ManageProfileAllowPublicProfileCheck"
                                                                  Style="{StaticResource ManageProfileSwitchStyle}"
                                                                  Checked="ManageProfileDraftChanged"
                                                                  Unchecked="ManageProfileDraftChanged" />
                                                    </StackPanel>

                                                    <TextBlock x:Name="FleetDescriptionStatusText"
                                                               Foreground="{DynamicResource BridgeStatusInfo}"
                                                               Margin="2,0,0,8" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </controls:ChamferBorder>
                                </TabItem>
                                <TabItem x:Name="ManageFleetNotificationsTab"
                                         Header="通知与邮件"
                                         Visibility="Collapsed">
                                    <controls:ChamferBorder x:Name="FleetManagementNotificationsSurface"
                                                            Style="{StaticResource FleetManagementContentSurfaceStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="FleetManagementNotificationsTitle"
                                                           Text="通知与邮件"
                                                           Style="{StaticResource BridgePageTitleTextStyle}" />
                                            </StackPanel>
                                            <Border Grid.Row="1"
                                                    Margin="0,18,0,0"
                                                    Padding="0"
                                                    Style="{StaticResource FleetManagementModuleStyle}">
                                                <Grid>
                                                    <TextBlock Text="暂无可用内容"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="22"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                            </Border>
                                            <CheckBox x:Name="FleetEmailNotificationsEnabledCheck"
                                                      Visibility="Collapsed" />
                                            <TextBlock x:Name="FleetEmailNotificationsStatusText"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </controls:ChamferBorder>
                                </TabItem>
                                <TabItem x:Name="ManageFleetPlanTab" Header="计划">
                                    <controls:ChamferBorder x:Name="FleetManagementPlanSurface"
                                                            Style="{StaticResource FleetManagementContentSurfaceStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="FleetManagementPlanTitle"
                                                               Text="行动计划"
                                                               Style="{StaticResource BridgePageTitleTextStyle}" />
                                                </StackPanel>
                                                <Button x:Name="OpenActionPlanEditorButton"
                                                        Grid.Column="1"
                                                        Content="新建计划"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="42"
                                                        VerticalAlignment="Center"
                                                        Click="OpenActionPlanEditorButton_Click" />
                                            </Grid>
                                            <Grid Grid.Row="1"
                                                  Margin="0,18,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Style="{StaticResource FleetManagementModuleStyle}"
                                                        Padding="14">
                                                    <TextBlock Text="显示前两天与后七天内的行动计划；同一舰队最多保留 3 个未结束计划，到时后名单冻结。"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                                <Border Grid.Row="1"
                                                        Margin="0,12,0,0"
                                                        Background="{DynamicResource BridgeGround}"
                                                        BorderBrush="{DynamicResource BridgeRowHairline}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock x:Name="FleetActionPlansEmptyText"
                                                                   Text="暂无行动计划。"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="FleetActionPlanList"
                                                                          Margin="10">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource FleetManagementModuleRowStyle}"
                                                                                MinHeight="118"
                                                                                Margin="0,0,0,10">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="4" />
                                                                                    <ColumnDefinition Width="12" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="240" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.RowSpan="3"
                                                                                        Style="{StaticResource StatusAccentStrip}"
                                                                                        Background="{Binding StatusBrush}" />
                                                                                <StackPanel Grid.Column="2">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="16"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding Content}"
                                                                                               Margin="0,6,0,0"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                              TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="3"
                                                                                            VerticalAlignment="Top">
                                                                                    <TextBlock Text="{Binding StartTimeText}"
                                                                                               Foreground="{Binding TimeBrush}"
                                                                                               FontWeight="SemiBold" />
                                                                                    <TextBlock Text="{Binding NotifyText}"
                                                                                               Margin="0,6,0,0"
                                                                                               Foreground="{Binding NotifyBrush}" />
                                                                                    <TextBlock Text="{Binding ParticipantCountText}"
                                                                                               Margin="0,6,0,0"
                                                                                               Style="{StaticResource HudCaptionText}" />
                                                                                    <StackPanel Orientation="Horizontal"
                                                                                                Margin="0,6,0,0">
                                                                                        <Ellipse Style="{StaticResource StatusDot}"
                                                                                                 Fill="{Binding StatusBrush}" />
                                                                                        <TextBlock Text="{Binding StatusText}"
                                                                                                   Foreground="{Binding StatusBrush}" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                                <ItemsControl Grid.Row="1"
                                                                                              Grid.Column="2"
                                                                                              Grid.ColumnSpan="2"
                                                                                              ItemsSource="{Binding Participants}"
                                                                                              Margin="0,14,0,0">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border BorderBrush="{DynamicResource BridgeRowHairline}"
                                                                                                    BorderThickness="1"
                                                                                                    Background="{DynamicResource BridgeGround}"
                                                                                                    Padding="8"
                                                                                                    Margin="0,0,8,8"
                                                                                                    MinWidth="210">
                                                                                                <Grid>
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="42" />
                                                                                                        <ColumnDefinition Width="*" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Border Width="32"
                                                                                                            Height="32"
                                                                                                            Background="{DynamicResource BridgePanelRaised}"
                                                                                                            BorderBrush="{StaticResource AccentBrush}"
                                                                                                            BorderThickness="1">
                                                                                                        <Grid>
                                                                                                            <Image Source="{Binding AvatarPath, Converter={StaticResource ImagePathConverter}}"
                                                                                                                   Stretch="UniformToFill" />
                                                                                                            <ContentControl Tag="{Binding AvatarPath}"
                                                                                                                            Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                    <StackPanel Grid.Column="1">
                                                                                                        <TextBlock Text="{Binding Callsign}"
                                                                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                                                                   FontWeight="SemiBold"
                                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                                        <TextBlock Text="{Binding GameName}"
                                                                                                                   Style="{StaticResource HudCaptionText}"
                                                                                                                   Margin="0,3,0,0"
                                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                                    </StackPanel>
                                                                                                </Grid>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <StackPanel Grid.Row="2"
                                                                                            Grid.Column="2"
                                                                                            Grid.ColumnSpan="2"
                                                                                            Margin="0,12,0,0"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Right">
                                                                                    <Button Content="完成"
                                                                                            Width="96"
                                                                                            Height="34"
                                                                                            Style="{StaticResource PrimaryButton}"
                                                                                            IsEnabled="{Binding CanComplete}"
                                                                                            Click="CompleteActionPlanRowButton_Click" />
                                                                                    <Button Content="编辑"
                                                                                            Width="96"
                                                                                            Height="34"
                                                                                            Margin="8,0,0,0"
                                                                                            Style="{StaticResource SecondaryButton}"
                                                                                            IsEnabled="{Binding CanEdit}"
                                                                                            Click="EditActionPlanRowButton_Click" />
                                                                                    <Button Content="取消计划"
                                                                                            Width="112"
                                                                                            Height="34"
                                                                                            Margin="8,0,0,0"
                                                                                            Style="{StaticResource DangerButton}"
                                                                                            IsEnabled="{Binding CanCancel}"
                                                                                            Click="CancelActionPlanRowButton_Click" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </controls:ChamferBorder>
                                </TabItem>
                                <TabItem x:Name="ManageFleetTaskTab" Header="发布任务">
                                    <controls:ChamferBorder x:Name="FleetManagementTaskSurface"
                                                            Style="{StaticResource FleetManagementContentSurfaceStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="FleetManagementTaskTitle"
                                                               Text="发布任务与集结点"
                                                               Style="{StaticResource BridgePageTitleTextStyle}" />
                                                </StackPanel>
                                                <Button x:Name="OpenPublishTaskButton"
                                                        Grid.Column="1"
                                                        Content="新建任务"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="42"
                                                        VerticalAlignment="Center"
                                                        Click="OpenPublishTaskButton_Click" />
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Style="{StaticResource FleetManagementModuleStyle}"
                                                    Margin="0,18,0,14"
                                                    Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="440" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="当前任务"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="ManageCurrentTaskTitleText"
                                                                   Text="暂无当前任务"
                                                                   Margin="0,8,0,0"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock x:Name="ManageCurrentTaskSummaryText"
                                                                   Text="请前往 管理舰队-发布任务 进行任务发布"
                                                                   Margin="0,8,0,0"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock x:Name="ManageCurrentTaskMetaText"
                                                                   Text=""
                                                                   Margin="0,8,0,0"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="1"
                                                          VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="EditCurrentTaskButton"
                                                                Content="编辑"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Height="38"
                                                                Margin="8,0,0,0"
                                                                Click="EditCurrentTaskButton_Click" />
                                                        <Button x:Name="CompleteCurrentTaskButton"
                                                                Grid.Column="1"
                                                                Content="已完成"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Height="38"
                                                                Margin="8,0,0,0"
                                                                Click="CompleteCurrentTaskButton_Click" />
                                                        <Button x:Name="DeleteCurrentTaskButton"
                                                                Grid.Column="2"
                                                                Content="删除"
                                                                Style="{StaticResource DangerButton}"
                                                                Height="38"
                                                                Margin="8,0,0,0"
                                                                Click="DeleteCurrentTaskButton_Click" />
                                                        <Button x:Name="RenotifyCurrentTaskButton"
                                                                Grid.Column="3"
                                                                Content="再次通知"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Height="38"
                                                                Margin="8,0,0,0"
                                                                Click="RenotifyCurrentTaskButton_Click" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Background="{DynamicResource BridgeGround}"
                                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                                    BorderThickness="1">
                                                <Grid>
