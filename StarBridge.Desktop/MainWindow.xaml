                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontSize="10.5"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AttachmentRoomActivityText}"
                                                   Margin="0,7,0,0"
                                                   Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding AttachmentRoomDetailsVisibility}" />
                                        <TextBlock Text="{Binding AttachmentRoomFactsText}"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontFamily="{DynamicResource BridgeDataFont}"
                                                   FontSize="{DynamicResource BridgeFontAux}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding AttachmentRoomDetailsVisibility}" />
                                    </StackPanel>
                                    <Border x:Name="UnifiedAttachmentStatusBadge"
                                            Grid.Column="2"
                                            Padding="7,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource BridgePanelRaised}"
                                            BorderBrush="{Binding AttachmentStatusBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            Visibility="{Binding AttachmentStatusVisibility}">
                                        <TextBlock Text="{Binding AttachmentStatusText}"
                                                   Foreground="{Binding AttachmentStatusBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Button Grid.Column="2"
                                             MinWidth="82"
                                             Height="32"
                                             Margin="0,30,0,0"
                                             Padding="10,0"
                                             VerticalAlignment="Bottom"
                                            Content="{Binding AttachmentActionText}"
                                            IsEnabled="{Binding AttachmentActionEnabled}"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Click="ChatAttachmentActionButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter TargetName="UnifiedMessagePanel" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="UnifiedMessagePanel" Property="Background" Value="Transparent" />
                    <Setter TargetName="UnifiedMessagePanel"
                            Property="BorderBrush"
                            Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Setter TargetName="UnifiedMessagePanel" Property="BorderThickness" Value="0,0,2,0" />
                    <Setter TargetName="UnifiedMessageAvatarButton" Property="Grid.Column" Value="2" />
                    <Setter TargetName="UnifiedMessageBody" Property="Grid.Column" Value="0" />
                    <Setter TargetName="UnifiedMessageMeta" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="UnifiedMessageText" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="UnifiedMessageText" Property="TextAlignment" Value="Right" />
                    <Setter TargetName="UnifiedAttachmentCard" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="UnifiedMessageTime" Property="Grid.Column" Value="0" />
                    <Setter TargetName="UnifiedMessageTime" Property="Margin" Value="0" />
                    <Setter TargetName="UnifiedMessageRoleBadge" Property="Grid.Column" Value="1" />
                    <Setter TargetName="UnifiedMessageRoleBadge" Property="Margin" Value="8,0,0,0" />
                    <Setter TargetName="UnifiedMessageGameId" Property="Grid.Column" Value="2" />
                    <Setter TargetName="UnifiedMessageGameId" Property="Margin" Value="8,0,0,0" />
                    <Setter TargetName="UnifiedMessageSender" Property="Grid.Column" Value="3" />
                    <Setter TargetName="UnifiedMessageSender" Property="Margin" Value="8,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter TargetName="UnifiedMessagePanel" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="UnifiedMessagePanel" Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                    <Setter TargetName="UnifiedMessagePanel" Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                    <Setter TargetName="UnifiedMessagePanel" Property="BorderThickness" Value="1,0,1,0" />
                    <Setter TargetName="UnifiedMessageAvatarButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="UnifiedMessageBody" Property="Grid.Column" Value="0" />
                    <Setter TargetName="UnifiedMessageBody" Property="Grid.ColumnSpan" Value="3" />
                    <Setter TargetName="UnifiedMessageMeta" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="UnifiedMessageGameId" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="UnifiedMessageRoleBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="UnifiedMessageText" Property="TextAlignment" Value="Center" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="UnifiedChatMessageListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
