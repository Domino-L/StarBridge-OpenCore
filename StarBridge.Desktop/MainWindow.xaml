                                                            Tag="1"
                                                            Height="34"
                                                            Margin="0,0,0,5"
                                                            Content="1 格 · 紧凑"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="PersonalProfileModuleSizeOption_Click" />
                                                    <Button x:Name="PersonalProfileModuleSizeTwoButton"
                                                            Tag="2"
                                                            Height="34"
                                                            Margin="0,0,0,5"
                                                            Content="2 格 · 标准"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="PersonalProfileModuleSizeOption_Click" />
                                                    <Button x:Name="PersonalProfileModuleSizeThreeButton"
                                                            Tag="3"
                                                            Height="34"
                                                            Content="3 格 · 宽幅"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="PersonalProfileModuleSizeOption_Click" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>

                                    <Border x:Name="PersonalProfilePreviewBanner"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Margin="0,12,0,0"
                                            Padding="11,8"
                                            Background="{DynamicResource BridgePanelRaised}"
                                            BorderBrush="{DynamicResource BridgeHairline}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" BorderThickness="1">
                                                <TextBlock Text="览" Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PersonalProfilePreviewTitleText"
                                                           Text="访客视角预览"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="PersonalProfilePreviewDescriptionText"
                                                           Margin="0,2,0,0"
                                                           Text="这是其他用户查看你的个人主页时看到的内容。"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10" />
                                            </StackPanel>
                                            <Button x:Name="PersonalProfilePreviewExitButton"
                                                    Grid.Column="2"
                                                    Content="返回我的主页"
                                                    Height="28"
                                                    MinWidth="104"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="PersonalProfilePreviewExitButton_Click" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="PersonalProfileFixedInfoPanel"
                                            Grid.Row="2"
                                            Grid.ColumnSpan="3"
                                            Margin="0,12,0,0"
                                            Padding="13,9"
                                            Background="{DynamicResource BridgeGround}"
                                            BorderBrush="{StaticResource AvionicsGlassEdgeBrush}"
                                            BorderThickness="0,1,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="PersonalProfileOnlineTimeSummaryColumn" Width="*" />
                                            <ColumnDefinition x:Name="PersonalProfileOnlineTimeDividerColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="PersonalProfileGameplayStatisticsColumn" Width="*" />
                                            <ColumnDefinition x:Name="PersonalProfileGameplayStatisticsDividerColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="PersonalProfileOnlineTimeEditorColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Width="28"
                                                    Height="2"
                                                    Margin="0,0,0,6"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource BridgeMetricInfo}" />
                                            <TextBlock Text="通常可游玩时间"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontSize="10" />
                                            <TextBlock x:Name="PersonalProfileOnlineTimeText"
                                                       Margin="0,3,0,0"
                                                       Text="未填写"
                                                       Foreground="{DynamicResource BridgeInk}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18" />
                                                <TextBlock x:Name="PersonalProfileAvailabilityTimeZoneText"
                                                           Margin="0,3,0,0"
                                                           Text="所在时区：自动识别"
                                                           Foreground="{DynamicResource BridgeInk3}"
                                                           FontSize="9"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="PersonalProfileOnlineTimeDescriptionText"
                                                           Text="用于寻找舰队与加入审核；不代表实时在线状态。"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10" />
                                        </StackPanel>

                                        <Border x:Name="PersonalProfileOnlineTimeDivider"
                                                Grid.Column="1"
                                                Width="1"
                                                Margin="18,0"
                                                Background="{DynamicResource BridgeHairline}" />

                                        <StackPanel x:Name="PersonalProfileGameplayStatisticsSection"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <Border Width="28"
                                                    Height="2"
                                                    Margin="0,0,0,6"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource BridgeMetricDuration}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="游玩时长"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                                <Border x:Name="PersonalProfileGameplayPrivacyBadge"
                                                        Grid.Column="1"
                                                        Margin="8,-2,0,0"
                                                        Padding="6,2"
                                                        Background="{DynamicResource BridgePanel}"
                                                        BorderBrush="{DynamicResource BridgeStatusOff}"
                                                        BorderThickness="1"
                                                        ToolTip="可在应用设置中更改访客权限">
                                                    <TextBlock x:Name="PersonalProfileGameplayPrivacyText"
                                                               Text="仅自己可见"
                                                               Foreground="{DynamicResource BridgeInk2}"
                                                               FontSize="8.5" />
                                                </Border>
                                            </Grid>
                                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                    <TextBlock x:Name="PersonalProfileGameplayDurationText"
                                                               Text="0分钟"
                                                               Foreground="{DynamicResource BridgeInk}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                        </StackPanel>

                                        <Border x:Name="PersonalProfileGameplayStatisticsDivider"
                                                Grid.Column="3"
                                                Width="1"
                                                Margin="18,0"
                                                Background="{DynamicResource BridgeHairline}" />

                                        <StackPanel x:Name="PersonalProfileOnlineTimeEditorPanel"
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="PersonalProfileOnlineTimeEnabledCheck"
                                                          Content="对外展示"
                                                          VerticalAlignment="Center"
                                                          Checked="PersonalProfileEditorChanged"
                                                          Unchecked="PersonalProfileEditorChanged" />
                                                <ComboBox x:Name="PersonalProfileAvailabilityTimeZoneBox"
                                                          Grid.Column="1"
                                                          Height="30"
                                                          Margin="12,0,8,0"
                                                          SelectionChanged="PersonalProfileEditorChanged" />
                                                <Button x:Name="PersonalProfileUseLocalTimeZoneButton"
                                                        Grid.Column="2"
                                                        Content="自动识别"
                                                        Height="30"
                                                        MinWidth="76"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PersonalProfileUseLocalTimeZoneButton_Click" />
                                            </Grid>

                                            <StackPanel x:Name="PersonalProfileAvailabilityWindowsPanel"
                                                        Margin="0,8,0,0" />

                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="PersonalProfileAddAvailabilityWindowButton"
                                                        Content="添加时间段"
                                                        Height="28"
                                                        MinWidth="90"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PersonalProfileAddAvailabilityWindowButton_Click" />
                                                <TextBlock x:Name="PersonalProfileAvailabilityWindowCountText"
                                                           Grid.Column="1"
                                                           Margin="9,0,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="9"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="PersonalProfileOnlineTimeSaveStateText"
                                                           Grid.Column="2"
                                                           Text="随主页设置一起保存"
                                                           Foreground="{DynamicResource BridgeInk3}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>

                                        <Border x:Name="PersonalProfileFixedInfoRowDivider"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="5"
                                                Margin="0,10,0,9"
                                                Background="{DynamicResource BridgeHairline}" />

                                        <Grid x:Name="PersonalProfileActivityRhythmSection"
                                              Grid.Row="2"
                                              Grid.ColumnSpan="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="PersonalProfileActivityRhythmSummaryColumn" Width="*" />
                                                <ColumnDefinition x:Name="PersonalProfileActivityRhythmDividerColumn" Width="Auto" />
                                                <ColumnDefinition x:Name="PersonalProfileActivityRhythmEditorColumn" Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Width="28"
                                                        Height="2"
                                                        Margin="0,0,0,6"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource BridgeStatusOk}" />
                                                <TextBlock Text="活动节奏"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10" />
                                                <TextBlock x:Name="PersonalProfileActivityRhythmText"
                                                           Margin="0,3,0,0"
                                                           Text="休闲"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PersonalProfileActivityRhythmDescriptionText"
                                                               Text="用于表达平时的游玩频率；固定显示在个人资料中。"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource BridgeInk2}"
                                                               FontSize="10" />
                                            </StackPanel>
                                            <Border x:Name="PersonalProfileActivityRhythmDivider"
                                                    Grid.Column="1"
                                                    Width="1"
                                                    Margin="18,0"
                                                    Background="{DynamicResource BridgeHairline}" />
                                            <StackPanel x:Name="PersonalProfileActivityRhythmEditorPanel"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="选择活动节奏"
                                                           Margin="0,0,0,5"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10" />
                                                <ComboBox x:Name="PersonalProfileActivityRhythmBox"
                                                          Height="30"
                                                          SelectionChanged="PersonalProfileEditorChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="PersonalProfilePrivatePreviewPanel"
                                    MinHeight="180"
                                    Margin="0,12,0,0"
                                    Padding="24"
                                    Background="{StaticResource AvionicsGlassPanelBrush}"
                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <controls:BridgeStatePresenter x:Name="PersonalProfilePrivateStatePresenter"
                                                               State="Empty"
                                                               TitleOverride="该用户未公开个人主页"
                                                               DescriptionOverride="当前仅展示头像、呼号与游戏 ID。"
                                                               ActionTextOverride=""
                                                               ActionInvoked="PersonalProfileVisitorRetryButton_Click" />
                            </Border>

                            <Grid x:Name="PersonalProfileModuleGrid"
                                  Margin="0,12,0,0"
                                  AllowDrop="True"
                                  PreviewDragOver="PersonalProfileModuleGrid_DragOver"
                                  PreviewDrop="PersonalProfileModuleGrid_Drop">
                                <Grid.Resources>
                                    <Style x:Key="PersonalProfileEmptySlotButton" TargetType="Button">
                                        <Setter Property="MinHeight" Value="112" />
                                        <Setter Property="Background" Value="{DynamicResource BridgeGround}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{DynamicResource BridgeInk3}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Focusable" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Rectangle x:Name="SlotOutline"
                                                                   Fill="{TemplateBinding Background}"
                                                                   Stroke="{TemplateBinding BorderBrush}"
                                                                   StrokeThickness="1"
                                                                   StrokeDashArray="5 4"
                                                                   RadiusX="2"
                                                                   RadiusY="2" />
                                                        <Grid Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse x:Name="AddCircle" Fill="{DynamicResource BridgePanelRaised}" Stroke="{DynamicResource BridgeChipHairline}" StrokeThickness="1" />
                                                            <TextBlock x:Name="AddGlyph"
                                                                       Text="+"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       FontSize="23"
                                                                       FontWeight="Light"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,-2,0,0" />
                                                        </Grid>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SlotOutline" Property="Stroke" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            <Setter TargetName="SlotOutline" Property="Fill" Value="{DynamicResource BridgePanelRaised}" />
                                                            <Setter TargetName="AddCircle" Property="Stroke" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            <Setter TargetName="AddCircle" Property="Fill" Value="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            <Setter TargetName="AddGlyph" Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="SlotOutline" Property="Stroke" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            <Setter TargetName="AddGlyph" Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="SlotOutline" Property="Fill" Value="{DynamicResource BridgePanelRaised}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="140" />
                                </Grid.RowDefinitions>

                                <Border x:Name="PersonalProfileEmptyState" Grid.RowSpan="3" Grid.ColumnSpan="3" MinHeight="144" Padding="20" Background="{StaticResource AvionicsGlassPanelBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="PersonalProfileEmptyStateTitle" Text="主页暂时没有模块" Foreground="{DynamicResource BridgeInk}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="PersonalProfileEmptyStateDescription" Text="点击“编辑主页”，选择你愿意展示的内容。" Margin="0,7,0,0" Foreground="{DynamicResource BridgeInk2}" FontSize="11" HorizontalAlignment="Center" />
