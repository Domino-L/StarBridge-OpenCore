                                                                                                Tag="{Binding}"
                                                                                                Click="RemoveFleetMember_Click" />
                                                                                        <Button Grid.Column="2"
                                                                                                Content="转移"
                                                                                                Height="30"
                                                                                                Margin="6,0,0,0"
