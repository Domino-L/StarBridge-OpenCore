                                                Chamfer="8"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1">
                            <controls:ChamferBorder.Resources>
                                <Style x:Key="InformationOverlaySettingSwitchRowStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource InformationOverlaySettingsSwitchRowStyle}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                                 Handler="OverlaySettingSwitch_PreviewMouseLeftButtonDown" />
                                </Style>
                                <Style x:Key="OverlayOptionCheckStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource InformationOverlaySettingSwitchRowStyle}" />
                                <Style x:Key="OverlayCommandSwitchStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource InformationOverlaySettingSwitchRowStyle}">
                                    <Setter Property="MinHeight" Value="38" />
                                    <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </controls:ChamferBorder.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Margin="14,12,14,0"
                                        Padding="10,8"
                                        Background="{DynamicResource BridgePanelRaised}"
                                        BorderBrush="{DynamicResource BridgeHairline}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="OverlaySettingsScopeLabelText"
                                                       Text="设置范围"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <Border Padding="7,3"
                                                    Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <TextBlock x:Name="OverlaySettingsGlobalScopeText"
                                                           Text="通用"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <Border Padding="7,3"
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource BridgePanelRaised}"
                                                    BorderBrush="{DynamicResource BridgeStatusWarn}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <TextBlock x:Name="OverlaySettingsPresetScopeText"
                                                           Text="当前预设"
                                                           Foreground="{DynamicResource BridgeStatusWarn}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="OverlaySettingsScopeHintText"
                                                   Grid.Column="1"
                                                   Text="打开方式作用于所有预设；布局、内容和外观保存到当前预设。"
                                                   Foreground="{DynamicResource BridgeInk3}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            <ScrollViewer x:Name="OverlaySettingsScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          CanContentScroll="False"
                                          Padding="14"
                                          Loaded="OverlaySettingsScrollViewer_Loaded"
                                          ScrollChanged="OverlaySettingsScrollViewer_ScrollChanged">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource StarBridgeScrollBar}" />
                                </ScrollViewer.Resources>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="OverlaySettingsSectionOverview"
                                            Grid.Row="0"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                            <TextBlock x:Name="OverlayOverviewTitleText"
                                                       Text="总览"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}" />
                                            <TextBlock x:Name="OverlayOverviewDescriptionText"
                                                       Text="从这里检查当前浮层的预设、模块与启动行为。右侧屏幕布局就是游戏内布局的编辑面。"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,12" />
                                            <UniformGrid Columns="2">
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewStatusLabel"
                                                                   Text="浮层状态"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewStatusText"
                                                                   Text="未开启"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="6,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewPresetLabel"
                                                                   Text="当前预设"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewPresetText"
                                                                   Text="战斗"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <UniformGrid Columns="2"
                                                         Margin="0,12,0,0">
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewModuleCountLabel"
                                                                   Text="信息模块"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewModuleCountText"
                                                                   Text="4 个启用"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="6,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewLayoutLabel"
                                                                   Text="目标画布"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewLayoutText"
                                                                   Text="2560 × 1440"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                        <TextBlock x:Name="OverlayOverviewCanvasHintText"
                                                                   Text="自动匹配当前显示器"
                                                                   Foreground="{DynamicResource BridgeInk3}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <UniformGrid Columns="2"
                                                         Margin="0,12,0,0">
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="0,0,6,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewSavedLabel"
                                                                   Text="本次保存"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewSavedText"
                                                                   Text="尚无记录"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InformationOverlaySettingsSummaryCardStyle}"
                                                        Margin="6,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OverlayOverviewDirtyLabel"
                                                                   Text="未保存更改"
                                                                   Style="{StaticResource HudCaptionText}" />
                                                        <TextBlock x:Name="OverlayOverviewDirtyText"
                                                                   Text="无"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <Border Margin="0,14,0,0"
                                                    Padding="10,8"
                                                    Background="{DynamicResource BridgePanelRaised}"
                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="OverlayOverviewActionsHintText"
                                                           Text="打开、保存和放弃更改统一位于页面顶部；恢复操作集中在“预设与恢复”。"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="OverlaySettingsSectionPreset"
                                            Grid.Row="8"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                             <TextBlock x:Name="OverlayPresetLabel"
                                                        Text="预设与恢复"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}"
                                                       Margin="0,0,0,8" />
                                            <ComboBox x:Name="OverlayPresetBox"
                                                      Height="34"
                                                      SelectionChanged="OverlayPresetBox_SelectionChanged" />
                                            <TextBlock Text="预设会保存各自的模块位置、显示选项与视觉风格。"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <UniformGrid Columns="3"
                                                         Margin="0,12,0,0">
                                                <Button x:Name="OverlayRenamePresetButton"
                                                        Content="重命名"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="RenameOverlayPreset_Click" />
                                                <Button x:Name="OverlayDuplicatePresetButton"
                                                        Content="复制"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="DuplicateOverlayPreset_Click" />
                                                <Button x:Name="OverlayDeletePresetButton"
                                                        Content="删除"
                                                        Height="30"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="DeleteOverlayPreset_Click" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2"
                                                         Margin="0,8,0,0">
                                                <Button x:Name="OverlayImportPresetButton"
                                                        Content="导入预设"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="ImportOverlayPreset_Click" />
                                                <Button x:Name="OverlayExportPresetButton"
                                                        Content="导出预设"
                                                        Height="30"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="ExportOverlayPreset_Click" />
                                            </UniformGrid>
                                            <UniformGrid Columns="2"
                                                         Margin="0,12,0,0">
                                                <Button Content="保存当前布局"
                                                        Height="32"
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="SaveOverlayLayout_Click" />
                                                <Button Content="恢复默认布局"
                                                        Height="32"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="ResetOverlayLayout_Click" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="OverlaySettingsSectionModules"
                                            Grid.Row="3"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                             <TextBlock x:Name="OverlayOptionsLabel"
                                                        Text="模块与内容"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock x:Name="OverlayModuleSummaryText"
                                                       Text="已启用 5 / 5，隐藏 0"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />
                                            <Border x:Name="OverlayModuleWorkbenchEntry"
                                                    Margin="0,0,0,14"
                                                    Padding="12"
                                                    Background="{DynamicResource BridgePanelRaised}"
                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock x:Name="OverlayModuleWorkbenchEntryTitleText"
                                                                   Text="模块工作台"
                                                                   Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock x:Name="OverlayModuleWorkbenchEntryDescriptionText"
                                                                   Text="选择模块，调整内容、显示规则、停留时间、位置与外观。"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="{DynamicResource BridgeInk2}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button x:Name="OverlayOpenModuleWorkbenchButton"
                                                            Grid.Column="1"
                                                            MinWidth="112"
                                                            Height="32"
                                                            Padding="12,0"
                                                            VerticalAlignment="Center"
                                                            Content="打开工作台"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="OpenOverlayModuleWorkbench_Click" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OverlayModuleTogglesGroupLabel"
                                                       Text="全部模块"
                                                       Style="{StaticResource HudCaptionText}"
                                                       Margin="0,4,0,8" />
                                            <CheckBox x:Name="ShowNoticePanelCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示通讯提醒"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <CheckBox x:Name="ShowSquadsPanelCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示舰队总览"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <CheckBox x:Name="ShowMembersPanelCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示成员状态"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <CheckBox x:Name="ShowChatPanelCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示场景通讯"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <CheckBox x:Name="ShowEventNotificationsCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示事件通知"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <TextBlock x:Name="OverlayModuleSettingsOwnershipHintText"
                                                       Text="可点击右侧画布中的模块快速调整，也可从上方模块工作台统一选择。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,12,0,0" />

                                            <StackPanel x:Name="OverlayModuleLibraryPanel"
                                                        Visibility="Collapsed"
                                                        Margin="0,16,0,0">
                                                <Rectangle Height="1"
                                                           Style="{StaticResource StarBridgeSettingsDivider}"
                                                           Margin="0,0,0,14" />
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="OverlayModuleLibraryTitleText"
                                                               Text="已隐藏模块"
                                                               Style="{StaticResource HudCaptionText}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="OverlayModuleLibraryCountText"
                                                               Grid.Column="1"
                                                               Text="0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="OverlayModuleLibraryHintText"
                                                           Text="点击模块即可恢复到上次布局位置。"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8" />
                                                <WrapPanel x:Name="OverlayModuleLibraryButtonsPanel" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="OverlaySettingsSectionPlacement"
                                            Grid.Row="4"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="屏幕布局"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="控制屏幕布局的网格、吸附与锁定行为。可从模块工作台统一选择模块，也可直接点击右侧画布快速调整。"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,12" />
                                            <CheckBox x:Name="OverlaySettingsShowGridCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="显示网格"
                                                      Checked="OverlaySettingsShowGridCheck_Changed"
                                                      Unchecked="OverlaySettingsShowGridCheck_Changed" />
                                            <CheckBox x:Name="OverlaySettingsSnapGridCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="吸附到网格"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySettingsSnapGridCheck_Changed"
                                                      Unchecked="OverlaySettingsSnapGridCheck_Changed" />
                                            <CheckBox x:Name="OverlaySettingsSnapEdgeCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="吸附到边缘与中心线"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySettingsSnapEdgeCheck_Changed"
                                                      Unchecked="OverlaySettingsSnapEdgeCheck_Changed" />
                                            <CheckBox x:Name="OverlaySettingsLockLayoutCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="锁定布局"
                                                      Margin="0,8,0,0"
                                                      Checked="OverlaySettingsLockLayoutCheck_Changed"
                                                      Unchecked="OverlaySettingsLockLayoutCheck_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                    <Border x:Name="OverlaySettingsSectionMotion"
                                            Grid.Row="1"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                             <TextBlock x:Name="OverlayTransitionLabel"
                                                        Text="动画与性能"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}"
                                                       Margin="0,0,0,8" />
                                             <TextBlock x:Name="OverlayMotionDescriptionText"
                                                        Text="选择常用体验方案，或继续分别调整转场与常驻动画。"
                                                        Foreground="{DynamicResource BridgeInk2}"
                                                        FontSize="11"
                                                        TextWrapping="Wrap"
                                                        Margin="0,6,0,14" />
                                            <Border Padding="10"
                                                    Margin="0,0,0,14"
                                                    Background="{DynamicResource BridgePanelRaised}"
                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="OverlayExperiencePresetLabelText"
                                                                   Text="快速体验设置"
                                                                   Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock x:Name="OverlayExperiencePresetStatusText"
                                                                   Grid.Column="1"
                                                                   Text="当前：自定义"
                                                                   Foreground="{DynamicResource BridgeInk2}"
                                                                   FontSize="10.5"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                    <UniformGrid Columns="3">
                                                        <Button x:Name="OverlayExperienceSmoothButton"
                                                                Content="流畅优先"
                                                                Tag="Smooth"
                                                                Height="32"
                                                                Margin="0,0,5,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ApplyOverlayExperiencePreset_Click" />
                                                        <Button x:Name="OverlayExperienceBalancedButton"
                                                                Content="均衡"
                                                                Tag="Balanced"
                                                                Height="32"
                                                                Margin="3,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ApplyOverlayExperiencePreset_Click" />
                                                        <Button x:Name="OverlayExperienceReducedMotionButton"
                                                                Content="减少动画"
                                                                Tag="ReducedMotion"
                                                                Height="32"
                                                                Margin="5,0,0,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ApplyOverlayExperiencePreset_Click" />
                                                    </UniformGrid>
                                                    <TextBlock x:Name="OverlayExperiencePresetHintText"
                                                               Text="此操作会同时调整启动转场与常驻动画帧率，可撤销，也可继续单独修改。"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                             <TextBlock x:Name="OverlayStartupTransitionGroupLabel"
                                                       Text="风格对应转场"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <CheckBox x:Name="OverlayTransitionEnabledCheck"
                                                      Style="{StaticResource OverlayCommandSwitchStyle}"
                                                      Content="启动浮层时播放转场"
                                                      Margin="0,0,0,8"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <CheckBox x:Name="OverlaySkipTransitionInGameCheck"
                                                      Style="{StaticResource OverlayCommandSwitchStyle}"
                                                      Content="游戏内开启时跳过转场"
                                                      ToolTip="Star Citizen 位于前台时，开启浮层将直接显示内容。"
                                                      Margin="18,0,0,8"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                            <Border Padding="10,8"
                                                    Margin="0,0,0,10"
                                                    Background="{StaticResource FieldBackBrush}"
                                                    BorderBrush="{StaticResource AccentDimBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock x:Name="OverlayTransitionStyleValueText"
                                                               Text="舰桥终端接入"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="OverlayTransitionStyleHintText"
                                                               Text="随当前外观风格自动切换"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
