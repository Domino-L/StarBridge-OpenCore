                                                      Content="斯坦顿"
                                                      Checked="FindFleetFilterChanged"
                                                      Unchecked="FindFleetFilterChanged" />
                                            <CheckBox x:Name="FindFleetSystemPyroCheck"
                                                      Content="派罗"
                                                      Margin="0,5,0,0"
                                                      Checked="FindFleetFilterChanged"
                                                      Unchecked="FindFleetFilterChanged" />
                                            <CheckBox x:Name="FindFleetSystemNyxCheck"
                                                      Content="尼克斯"
                                                      Margin="0,5,0,0"
                                                      Checked="FindFleetFilterChanged"
                                                      Unchecked="FindFleetFilterChanged" />
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="玩法标签"
                                                       Style="{StaticResource BridgeDirectoryLabelStyle}"
                                                       Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FindFleetFilterTagCountText"
                                                           Text="0 / 5"
                                                           Foreground="{StaticResource BridgeInk}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Content="选择"
                                                        Height="26"
                                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                        Click="FindFleetFilterEditTagsButton_Click" />
                                            </Grid>
                                            <ComboBox x:Name="FindFleetTagMatchModeBox"
                                                      Height="30"
                                                      Margin="0,8,0,0"
                                                      SelectionChanged="FindFleetFilterTagMatchModeChanged">
                                                <ComboBoxItem Content="匹配任一所选标签" Tag="any" IsSelected="True" />
                                                <ComboBoxItem Content="同时包含全部标签" Tag="all" />
                                            </ComboBox>
                                            <TextBlock x:Name="FindFleetFilterTagEmptyText"
                                                       Text="未选择标签"
                                                       Margin="0,8,0,0"
                                                       Foreground="{StaticResource BridgeInk2}"
                                                       FontSize="11" />
                                            <ItemsControl x:Name="FindFleetFilterSelectedTagsList"
                                                          Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,6,6"
                                                                Padding="9,4"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                BorderThickness="1"
                                                                ToolTip="{Binding TooltipText}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{StaticResource BridgeInk}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <CheckBox x:Name="FindFleetHasBannerCheck"
                                                      Content=""
                                                      Visibility="Collapsed"
                                                      Checked="FindFleetFilterChanged"
                                                      Unchecked="FindFleetFilterChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                    </ScrollViewer>

                                    <TextBlock Grid.Row="2"
                                               x:Name="FindFleetFilterSummaryText"
                                               Text="未设置筛选条件。点击“确定”返回完整目录。"
                                               Margin="0,10,0,0"
                                               Foreground="{StaticResource BridgeInk2}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2"
                                  Grid.Column="0"
                                  x:Name="FindFleetAppliedFiltersRow"
                                  Margin="0,10,0,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="FindFleetAppliedFiltersPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="已筛选"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource BridgeDirectoryLabelStyle}"
                                               VerticalAlignment="Center" />
                                    <ItemsControl x:Name="FindFleetAppliedFiltersList"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BridgePanelRaised}"
                                                        BorderBrush="{StaticResource BridgeStatusInfo}"
                                                        BorderThickness="1"
                                                        Padding="8,3"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource BridgeInk}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="清除"
                                            Width="58"
                                            Height="28"
                                            Margin="2,0,0,0"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Click="FindFleetClearFiltersButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3"
                                    Grid.Column="0"
                                    x:Name="FindFleetDirectoryStatusPanel"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    Background="{StaticResource BridgePanelRaised}"
                                    BorderBrush="{StaticResource BridgeStatusInfo}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="FindFleetDirectoryStatusDot"
                                             Width="7"
                                             Height="7"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource BridgeInk}" />
                                    <TextBlock Grid.Column="1"
                                               x:Name="FindFleetDirectoryStatusText"
                                               Text="正在加载公开舰队..."
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BridgeInk}" />
                                    <Button Grid.Column="2"
                                            x:Name="FindFleetDirectoryRetryButton"
                                            Content="重试"
                                            Width="72"
                                            Height="28"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="FindFleetDirectoryRetryButton_Click" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4"
                                  Grid.Column="0"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid x:Name="OverlayPreviewGrid">
                                        <TextBlock x:Name="FindFleetEmptyText"
                                                   Text="暂无公开舰队。你可以创建舰队，或稍后刷新目录。"
                                                   Foreground="{StaticResource BridgeInk2}"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Margin="0,80,0,0"
                                                   Visibility="Collapsed" />
                                        <ItemsControl x:Name="FindFleetResults"
                                                      HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:ResponsiveCardWrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="FleetDirectoryCardRoot"
                                                            Height="198"
                                                            Padding="0"
                                                            ClipToBounds="True"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonUp="FindFleetCard_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource BridgeDirectoryCardStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Snapshot.RecruitingEnabled}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BridgeStatusOk}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                         </Border.Style>
                                                         <Grid>
                                                             <Grid Margin="12,10">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="98" />
                                                                    <RowDefinition Height="38" />
                                                                    <RowDefinition Height="34" />
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="220" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Width="54"
                                                                            Height="58"
                                                                            BorderBrush="{StaticResource BridgeInk}"
                                                                            BorderThickness="1"
                                                                            Background="{StaticResource BridgePanel}"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top">
                                                                        <Grid>
                                                                            <Image Source="{Binding LogoImageData, Converter={StaticResource ImageDataConverter}}"
                                                                                   Stretch="UniformToFill"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                            <TextBlock Text="{Binding LogoText}"
                                                                                       Visibility="{Binding LogoTextVisibility}"
                                                                                       Foreground="{StaticResource BridgeInk}"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   Foreground="{StaticResource BridgeInk}"
                                                                                   FontSize="17"
                                                                                   FontWeight="SemiBold"
                                                                                   MaxWidth="250"
                                                                                   HorizontalAlignment="Left"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding FleetCodeText}"
                                                                                   Margin="0,3,0,0"
                                                                                   Foreground="{StaticResource BridgeInk}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding CommanderLine}"
                                                                                   Margin="0,3,0,0"
                                                                                   Foreground="{StaticResource BridgeInk2}"
                                                                                   FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <ItemsControl ItemsSource="{Binding TagChips}"
                                                                                      Visibility="{Binding TagChipsVisibility}"
                                                                                      MaxHeight="23"
                                                                                      Margin="0,4,0,0"
                                                                                      ClipToBounds="True">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="{Binding BackgroundBrush}"
                                                                                            BorderBrush="{Binding BorderBrush}"
                                                                                            BorderThickness="1"
                                                                                            Padding="6,1"
                                                                                            Margin="0,0,5,0"
                                                                                            ToolTip="{Binding TooltipText}">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   Foreground="{Binding AccentBrush}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   FontSize="11" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                                VerticalAlignment="Center">
                                                                        <StackPanel Style="{StaticResource BridgeDirectoryFieldRowStyle}">
                                                                            <TextBlock Text="活跃时间"
                                                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding LocalActiveTimeValueText}"
                                                                                       Style="{StaticResource BridgeDirectoryFieldValueTextStyle}" />
                                                                        </StackPanel>
                                                                        <StackPanel Style="{StaticResource BridgeDirectoryFieldRowStyle}">
                                                                            <TextBlock Text="舰船资源"
                                                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding PublicShipTotalValueText}"
                                                                                       Style="{StaticResource BridgeDirectoryFieldValueTextStyle}" />
                                                                        </StackPanel>
                                                                        <StackPanel Style="{StaticResource BridgeDirectoryFieldRowStyle}">
                                                                            <TextBlock Text="成员规模"
                                                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding MemberScaleOnlyValueText}"
                                                                                       Style="{StaticResource BridgeDirectoryFieldValueTextStyle}" />
                                                                        </StackPanel>
                                                                        <StackPanel Style="{StaticResource BridgeDirectoryFieldRowStyle}">
                                                                            <TextBlock Text="加入方式"
                                                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding JoinPolicyValueText}"
                                                                                       Style="{StaticResource BridgeDirectoryFieldValueTextStyle}" />
                                                                        </StackPanel>
                                                                        <StackPanel Style="{StaticResource BridgeDirectoryFieldRowStyle}">
                                                                            <TextBlock Text="舰队时区"
                                                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding FleetTimeZoneText}"
                                                                                       Style="{StaticResource BridgeDirectoryFieldValueTextStyle}"
                                                                                       ToolTip="{Binding FleetTimeZoneText}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <StackPanel Grid.Row="1" Margin="66,2,0,0">
                                                                    <TextBlock Text="{Binding PublicDescriptionText}"
                                                                               Foreground="{StaticResource BridgeInk}"
                                                                               FontSize="12"
                                                                               LineHeight="18"
                                                                               MaxHeight="36"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>

                                                                 <Grid Grid.Row="2" Margin="0,6,0,0">
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="Auto" />
                                                                     </Grid.ColumnDefinitions>
                                                                     <ItemsControl ItemsSource="{Binding SystemRecommendationChips}"
                                                                                   Visibility="{Binding SystemRecommendationVisibility}"
                                                                                   VerticalAlignment="Center"
                                                                                   MaxHeight="26"
                                                                                   ClipToBounds="True">
                                                                         <ItemsControl.ItemsPanel>
                                                                             <ItemsPanelTemplate>
                                                                                 <StackPanel Orientation="Horizontal" />
                                                                             </ItemsPanelTemplate>
                                                                         </ItemsControl.ItemsPanel>
                                                                         <ItemsControl.ItemTemplate>
                                                                             <DataTemplate>
                                                                                 <Border Background="{Binding BackgroundBrush}"
                                                                                         BorderBrush="{Binding BorderBrush}"
                                                                                         BorderThickness="1"
                                                                                         Padding="7,2"
                                                                                         Margin="0,0,6,0"
                                                                                         ToolTip="{Binding TooltipText}">
                                                                                     <TextBlock Text="{Binding Name}"
                                                                                                Foreground="{Binding AccentBrush}"
                                                                                                FontSize="10"
                                                                                                FontWeight="SemiBold" />
                                                                                 </Border>
                                                                             </DataTemplate>
                                                                         </ItemsControl.ItemTemplate>
                                                                     </ItemsControl>
                                                                     <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Border MinWidth="70"
                                                                                Margin="0,0,6,0"
                                                                                Padding="8,4"
                                                                                BorderBrush="{StaticResource BridgeHairline}"
                                                                                BorderThickness="1"
                                                                                Background="{StaticResource BridgePanelRaised}">
                                                                            <TextBlock Text="{Binding RelationText}"
                                                                                       Foreground="{StaticResource BridgeInk}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       HorizontalAlignment="Center" />
                                                                        </Border>
                                                                        <Button Width="86"
                                                                                Height="28"
                                                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                                                Content="查看详情"
                                                                                Tag="{Binding}"
                                                                                Click="FindFleetCardDetails_Click" />
                                                                        <Button Width="86"
                                                                                Height="28"
                                                                                Margin="6,0,0,0"
                                                                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                                                Content="{Binding JoinButtonText}"
                                                                                IsEnabled="{Binding CanJoin}"
                                                                                Visibility="{Binding JoinActionVisibility}"
                                                                                Tag="{Binding}"
                                                                                Click="JoinNetworkFleet_Click" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                         </Grid>
                                                     </Border>
                                                 </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <controls:BridgeModalHost x:Name="FindFleetDetailPanel"
                                                          Grid.ColumnSpan="2"
                                                          Panel.ZIndex="100"
                                                          Title="舰队名片"
                                                          Description="公开身份、活动状态与加入信息"
                                                          Size="Detail"
                                                          DismissRequested="FindFleetDetailCloseButton_Click">
                                    <controls:BridgeModalHost.Footer>
                                        <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FindFleetDetailHintText"
                                                       Text=""
                                                       Margin="0,0,16,0"
                                                       Foreground="{StaticResource BridgeInk2}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="FindFleetDetailCopyCodeButton"
                                                    Grid.Column="1"
                                                    Width="128"
                                                    Content="复制识别码"
                                                    Height="32"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Click="CopyFindFleetCode_Click" />
                                            <Button x:Name="FindFleetDetailJoinButton"
                                                    Grid.Column="2"
                                                    Width="148"
                                                    Content="选择舰队"
                                                    Height="32"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                    Click="JoinNetworkFleet_Click" />
                                        </Grid>
                                    </controls:BridgeModalHost.Footer>
                                    <StackPanel>
                                        <Border x:Name="FindFleetDetailIdentityBand"
                                                Margin="0"
                                                Padding="0"
                                                Background="{StaticResource BridgePanelRaised}"
                                                BorderBrush="{StaticResource BridgeHairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="318" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource BridgeInk}" />
                                                <Border Grid.Column="1"
                                                        Width="68"
                                                        Height="68"
                                                        Margin="12"
                                                        BorderBrush="{StaticResource BridgeInk}"
                                                        BorderThickness="1"
                                                        Background="{StaticResource BridgePanelRaised}"
                                                        VerticalAlignment="Top">
                                                    <Grid>
                                                        <Image x:Name="FindFleetDetailLogoImage"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock x:Name="FindFleetDetailLogoText"
                                                                   Text="LOGO"
                                                                   Foreground="{StaticResource BridgeInk}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2"
                                                            Margin="4,12,18,12">
                                                    <TextBlock x:Name="FindFleetDetailNameText"
                                                               Text="选择舰队查看详情"
                                                               Foreground="{StaticResource BridgeInk}"
                                                               FontSize="21"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="FindFleetDetailCodeText"
                                                               Text="识别码 / -"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource BridgeInk}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="FindFleetDetailCommanderText"
                                                               Text="指挥官 / -"
                                                               Margin="0,8,0,0"
                                                               Foreground="{StaticResource BridgeInk2}" />
                                                    <TextBlock x:Name="FindFleetDetailDescriptionText"
                                                               Text="选择舰队后，这里会显示完整的公开介绍。"
                                                               Margin="0,6,0,0"
                                                               Foreground="{StaticResource BridgeInk}"
                                                               LineHeight="19"
                                                               MaxHeight="42"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="FindFleetDetailTagChips"
                                                                  Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding BackgroundBrush}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        BorderThickness="1"
                                                                        Padding="7,2"
                                                                        Margin="0,0,6,0"
                                                                        ToolTip="{Binding TooltipText}">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <Border Grid.Column="3"
                                                        Margin="0,12,12,12"
                                                        Padding="12,10"
                                                        Background="{StaticResource BridgePanelRaised}"
                                                        BorderBrush="{StaticResource BridgeHairline}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="FindFleetDetailActiveTimeText"
                                                                   Margin="0,0,10,10"
                                                                   Foreground="{StaticResource BridgeInk}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock x:Name="FindFleetDetailMembersText"
                                                                   Grid.Column="1"
                                                                   Margin="0,0,0,10"
                                                                   Foreground="{StaticResource BridgeInk}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock x:Name="FindFleetDetailJoinPolicyText"
                                                                   Grid.Row="1"
                                                                   Margin="0,0,10,0"
                                                                   Foreground="{StaticResource BridgeInk}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock x:Name="FindFleetDetailRecruitingText"
                                                                   Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   Foreground="{StaticResource BridgeStatusOk}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid x:Name="FindFleetDetailBodyGrid"
                                              Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <Border Padding="13"
                                                            Background="{StaticResource BridgePanelRaised}"
                                                            BorderBrush="{StaticResource BridgeHairline}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="活动概况"
                                                                       Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                                            <TextBlock x:Name="FindFleetDetailTimeZoneText"
                                                                       Text="舰队默认时间 / 未公开"
                                                                       Margin="0,8,0,0"
                                                                       Foreground="{StaticResource BridgeInk}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="活动时间已按你的所在地自动换算。"
                                                                       Margin="0,4,0,0"
                                                                       Foreground="{StaticResource BridgeInk}"
                                                                       FontSize="11"
