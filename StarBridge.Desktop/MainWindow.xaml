                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle x:Name="HoverWash"
                                                               Fill="#182C314D"
                                                               Opacity="0" />
                                                    <Rectangle x:Name="ActiveWash"
                                                               Fill="#2C282451"
                                                               Opacity="0" />
                                                    <Border x:Name="ActiveRail"
                                                            Width="3"
                                                            HorizontalAlignment="Left"
                                                            Background="#A79BFF"
                                                            Opacity="0" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="15,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <Path x:Name="MenuGlyph"
                                                              Width="20"
                                                              Height="20"
                                                              Data="{TemplateBinding CommandParameter}"
                                                              Fill="Transparent"
                                                              Stroke="{TemplateBinding Foreground}"
                                                              StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Stretch="Uniform" />
                                                        <ContentPresenter Margin="13,0,0,0"
                                                                          VerticalAlignment="Center"
                                                                          RecognizesAccessKey="True" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HoverWash"
                                                            Property="Opacity"
                                                            Value="0.9" />
                                                    <Setter Property="Foreground"
                                                            Value="#F2F0FF" />
                                                </Trigger>
                                                <Trigger Property="Tag" Value="Active">
                                                    <Setter TargetName="ActiveWash"
                                                            Property="Opacity"
                                                            Value="1" />
                                                    <Setter TargetName="ActiveRail"
                                                            Property="Opacity"
                                                            Value="1" />
                                                    <Setter Property="Foreground"
                                                            Value="#F2F0FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="196" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Visibility="Collapsed"
                                Style="{StaticResource StarBridgePanel}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="18,18,18,14">
                                    <TextBlock Text="游戏内工具"
                                               Foreground="#A79BFF"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="菜单浮层"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="22"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="设置打开方式、可用工具与窗口恢复行为。"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,4,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
