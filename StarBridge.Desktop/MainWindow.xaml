                                            <Setter Property="MinWidth" Value="72" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type RadioButton}">
                                                        <Border x:Name="ScopeChrome"
                                                                Background="{DynamicResource BridgeGround}"
                                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                                BorderThickness="1"
                                                                Padding="{TemplateBinding Padding}"
                                                                TextElement.Foreground="{TemplateBinding Foreground}"
                                                                SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  RecognizesAccessKey="True" />
                                                                <Border x:Name="ScopeAccent"
                                                                        Height="2"
                                                                        Background="{DynamicResource BridgeStatusInfo}"
                                                                        VerticalAlignment="Bottom"
                                                                        Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ScopeChrome" Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                                <Setter TargetName="ScopeChrome" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ScopeChrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                <Setter TargetName="ScopeChrome" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                                <Setter TargetName="ScopeAccent" Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="ScopeChrome" Property="Background" Value="{DynamicResource BridgeGround}" />
                                                                <Setter TargetName="ScopeChrome" Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOff}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
