                                                                    <TextBlock Text="刚刚" Foreground="{DynamicResource BridgeInk3}" FontSize="10" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel x:Name="PlayerActivityNotificationOptionsPanel"
