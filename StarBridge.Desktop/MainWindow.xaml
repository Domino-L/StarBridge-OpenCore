                                                <ComboBoxItem Content="组队房间" Tag="PartyRoom" />
                                            </ComboBox>
                                            <TextBlock x:Name="OverlaySceneSourceHintText"
                                                       Text="自动模式会在加入组队房间时显示房间内容，其余时间显示舰队内容。"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,14" />
                                            <TextBlock x:Name="OverlayGameWindowLinkLabel"
                                                       Text="游戏窗口联动"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <CheckBox x:Name="OverlayAutoOpenOnGameStartCheck"
                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="启动游戏时自动开启浮层"
                                                      Margin="0,0,0,8"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
