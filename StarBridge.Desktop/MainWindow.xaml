                                    <TextBlock Text="图片检查"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="BannerPickerStatusText"
                                               Text="等待选择图片"
                                               Margin="0,6,0,0"
