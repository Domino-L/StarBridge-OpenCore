                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Text, ElementName=PersonalOverlayModeText}" Foreground="{DynamicResource BridgeInk}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Text="启动行为" Foreground="{DynamicResource BridgeInk3}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Text, ElementName=PersonalOverlayTrayModeText}" Foreground="{Binding Foreground, ElementName=PersonalOverlayTrayModeText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Text="配置目录" Foreground="{DynamicResource BridgeInk3}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Text, ElementName=PersonalConfigPathText}" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="5" Text="缓存目录" Foreground="{DynamicResource BridgeInk3}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Text, ElementName=PersonalCachePathText}" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="6" Text="应用版本" Foreground="{DynamicResource BridgeInk3}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Text, ElementName=PersonalVersionText}" Foreground="{DynamicResource BridgeInk}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="7" Text="服务器地址" Foreground="{DynamicResource BridgeInk3}" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Text, ElementName=PersonalServerAddressText}" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Grid.Row="2"
                                                Margin="0,10,0,0"
                                                Padding="10,8"
