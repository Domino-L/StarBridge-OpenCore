                                    Margin="12,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SyncChoiceCancelButton_Click" />
                            <Button x:Name="SyncChoiceSaveButton"
                                    Grid.Column="2"
                                    Content="保存选择"
                                    Height="34"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SyncChoiceSaveButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

