                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="FleetShipDatabaseList"
                                                     Margin="10,10,6,10"
