                            <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FleetAnnouncementCenterStatusText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="WithdrawFleetAnnouncementButton"
                                            Content="撤下当前公告"
                                            Height="32"
                                            Padding="12,0"
                                            Style="{StaticResource BridgeModalDangerButtonStyle}"
                                            Click="WithdrawFleetAnnouncementButton_Click" />
                                    <Button x:Name="EditFleetAnnouncementButton"
                                            Content="编辑当前公告"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="EditFleetAnnouncementButton_Click" />
                                    <Button x:Name="NewFleetAnnouncementButton"
                                            Content="发布新公告"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="NewFleetAnnouncementButton_Click" />
                                </StackPanel>
                            </Grid>
                        </controls:BridgeModalHost.Footer>
                        <Grid Height="450">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Padding="15,13"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{StaticResource AccentDimBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Margin="13,0,18,0">
                                        <TextBlock Text="正在广播"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="FleetAnnouncementCenterCurrentTitleText"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="FleetAnnouncementCenterCurrentContentText"
                                                   Margin="0,6,0,0"
                                                   MaxHeight="58"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="FleetAnnouncementCenterCurrentTimeText"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10.5"
                                                   TextAlignment="Right" />
                                            <TextBlock x:Name="FleetAnnouncementCenterCurrentAuthorText"
                                                       Margin="0,5,0,0"
                                                       Foreground="{DynamicResource BridgeInk3}"
                                                   FontSize="10.5"
                                                   TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="历史公告"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="FleetAnnouncementHistoryCountText"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10.5" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,9,0,0">
                                <ListBox x:Name="FleetAnnouncementHistoryList"
                                         Background="{DynamicResource BridgeRail}"
                                         BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                         BorderThickness="1"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,11"
                                                    Background="{DynamicResource BridgePanel}"
                                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BridgeStatusOff}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWithdrawn}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BridgeStatusBad}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,18,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StateText}"
                                                                       Margin="9,0,0,0"
                                                                       FontSize="10.5">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOff}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWithdrawn}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                                     Value="True">
                                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                                            <Setter Property="TextTrimming" Value="None" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10.5"
                                                                   TextAlignment="Right" />
                                                                <TextBlock Text="{Binding AuthorText}"
                                                                           Margin="0,5,0,0"
                                                                           Foreground="{DynamicResource BridgeInk3}"
                                                                   FontSize="10"
                                                                   TextAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="FleetAnnouncementHistoryEmptyText"
                                           Text="尚无历史公告。发布下一条公告后，当前公告会自动归档在这里。"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           IsHitTestVisible="False" />
                                </Grid>
                            </Grid>

                        </Grid>
                    </controls:BridgeModalHost>

                    <controls:BridgeModalHost x:Name="FleetNoticeEditorPanel"
