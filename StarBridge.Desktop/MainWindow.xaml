                                                <CheckBox x:Name="FindFleetShipTransportCheck" Content="运输" Checked="FindFleetFilterChanged" Unchecked="FindFleetFilterChanged" />
                                                <CheckBox x:Name="FindFleetShipIndustrialCheck" Content="工业" Margin="0,5,0,0" Checked="FindFleetFilterChanged" Unchecked="FindFleetFilterChanged" />
                                                <CheckBox x:Name="FindFleetShipExplorationCheck" Content="探索" Margin="0,5,0,0" Checked="FindFleetFilterChanged" Unchecked="FindFleetFilterChanged" />
                                                <CheckBox x:Name="FindFleetShipSupportCheck" Content="支援" Margin="0,5,0,0" Checked="FindFleetFilterChanged" Unchecked="FindFleetFilterChanged" />
                                                <CheckBox x:Name="FindFleetShipUtilityCheck" Content="其他" Margin="0,5,0,0" Checked="FindFleetFilterChanged" Unchecked="FindFleetFilterChanged" />
                                            </UniformGrid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="主要活跃星系"
                                                       Style="{StaticResource BridgeDirectoryLabelStyle}"
