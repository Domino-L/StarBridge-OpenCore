<Window x:Class="StarBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StarBridge.Desktop"
        xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
        xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
        Title="星海舰桥 测试版"
        Icon="/Assets/Brand/StarBridge_AppIcon.ico"
        Width="1664"
        Height="988"
        MinWidth="1060"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="MainWindow_Closing"
        Activated="MainWindow_Activated"
        Deactivated="MainWindow_Deactivated"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Icons.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Modals.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <local:ImagePathConverter x:Key="ImagePathConverter" />
        <local:ImageDataConverter x:Key="ImageDataConverter" />
        <Style x:Key="AvatarPresenceDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Stroke" Value="#06111A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Panel.ZIndex" Value="2" />
        </Style>
        <Style x:Key="FriendCenterSectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BridgeFontBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BridgeRailKeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource BridgeRowHover}"
                                    Opacity="0" />
                            <Border x:Name="RouteLight"
                                    Width="3"
                                    Margin="0,8,0,8"
                                    HorizontalAlignment="Left"
                                    Opacity="0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                </Border.Background>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="RouteLight" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterSecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
            <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BridgeFontAux}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BridgeRailKeyboardFocusStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BridgeChipHairline}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BridgeInk3}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource FriendCenterSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource BridgeGround}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterDangerButtonStyle" TargetType="Button"
               BasedOn="{StaticResource FriendCenterSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BridgeStatusBad}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BridgeInk}" />
            <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BridgeFontBody}" />
            <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="FriendSearchPlaceholderText"
                                       Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BridgeInk3}"
                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                       FontSize="{DynamicResource BridgeFontBody}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       Text="搜索呼号或游戏 ID" />
                            <Border x:Name="FocusLayer"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="FriendSearchPlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="FriendSearchPlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterCountTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk3}" />
            <Setter Property="FontFamily" Value="{DynamicResource BridgeDataFont}" />
            <Setter Property="FontSize" Value="{DynamicResource BridgeFontAux}" />
        </Style>
        <Style x:Key="ShipDataTagBorder" TargetType="Border">
            <Setter Property="Background" Value="#B0061722" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ShipDataTagLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ShipDataTagValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SyncOverlayRetryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFF1D6D8" />
            <Setter Property="Background" Value="#38171B" />
            <Setter Property="BorderBrush" Value="#B85764" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#552026" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource StatusDangerBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#281217" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D55D68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonDisabledBackBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource ButtonDisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderUtilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#B9D0DE" />
            <Setter Property="Background" Value="#8A071520" />
            <Setter Property="BorderBrush" Value="#234A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderUtilityChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderUtilityChrome" Property="Background" Value="#C2112B3B" />
                                <Setter TargetName="HeaderUtilityChrome" Property="BorderBrush" Value="#3883A8" />
                                <Setter Property="Foreground" Value="#F2FAFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderUtilityChrome" Property="Background" Value="#E0081B28" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="HeaderUtilityChrome" Property="Background" Value="#C6123347" />
                                <Setter TargetName="HeaderUtilityChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderAuthenticationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="146" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#F3FAFF" />
            <Setter Property="Background" Value="#B811354A" />
            <Setter Property="BorderBrush" Value="#3AA8D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AuthenticationChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AuthenticationChrome" Property="Background" Value="#D5164560" />
                                <Setter TargetName="AuthenticationChrome" Property="BorderBrush" Value="#55C8F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AuthenticationChrome" Property="Background" Value="#E00A2637" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#F20A1823" />
            <Setter Property="Foreground" Value="#E6F1F8" />
            <Setter Property="BorderBrush" Value="#2A5871" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Placement" Value="Bottom" />
            <Setter Property="HorizontalOffset" Value="0" />
            <Setter Property="VerticalOffset" Value="5" />
        </Style>
        <Style x:Key="UserAvatarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="AvatarActionChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AvatarActionChrome" Property="BorderBrush" Value="#3883A8" />
                                <Setter TargetName="AvatarActionChrome" Property="Background" Value="#241B4B63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="AvatarActionChrome" Property="Background" Value="#66112B3B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AvatarActionChrome" Property="BorderBrush" Value="#29AFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PassiveListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManageProfileSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track"
                                Background="#122637"
                                BorderBrush="#3B5E73"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Grid>
                                <TextBlock x:Name="StateText"
                                           Text="OFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#12384B" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38B8F2" />
                                <Setter TargetName="StateText" Property="Text" Value="ON" />
                                <Setter TargetName="StateText" Property="Foreground" Value="#B8F2FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#2E8FBA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter TargetName="StateText" Property="Foreground" Value="#637A89" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlaySettingSwitchRowStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource OverlaySettingsSwitchRowStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown"
                         Handler="OverlaySettingSwitch_PreviewMouseLeftButtonDown" />
        </Style>
        <Style x:Key="OverlayCommandSwitchStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource OverlaySettingSwitchRowStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OverlayOptionCheckStyle"
               TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource OverlaySettingSwitchRowStyle}" />
        <DataTemplate x:Key="UnifiedChatMessageTemplate">
            <Grid Margin="0,3,0,8">
                <Border x:Name="UnifiedMessagePanel"
                        MaxWidth="760"
                        Padding="8,6"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderBrush="{Binding SenderRoleBrush}"
                        BorderThickness="2,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UnifiedMessageAvatarButton"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DataContext="{Binding}"
                                Style="{StaticResource UserAvatarButtonStyle}"
                                ToolTip="用户菜单"
                                Click="UserAvatarButton_Click">
                            <Grid>
                                <ContentControl Tag="{Binding SenderAvatarImageData}"
                                                Style="{StaticResource IdentityBeaconAvatarFallbackStyle}"
                                                Foreground="{Binding SenderRoleBrush}" />
                                <Image Source="{Binding SenderAvatarImageData, Converter={StaticResource ImageDataConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="UnifiedMessageBody"
                                    Grid.Column="2"
                                    MaxWidth="650">
                            <Grid x:Name="UnifiedMessageMeta"
                                  HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UnifiedMessageSender"
                                           Grid.Column="0"
                                           Text="{Binding SenderCallsign}"
                                           Foreground="{Binding SenderRoleBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="UnifiedMessageGameId"
                                           Grid.Column="1"
                                           Text="{Binding SenderGameIdText}"
                                           Margin="7,0,0,0"
                                           Foreground="{DynamicResource BridgeInk3}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                                <Border x:Name="UnifiedMessageRoleBadge"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="6,1"
                                        Background="{DynamicResource BridgePanelRaised}"
                                        BorderBrush="{Binding SenderRoleBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding RoleVisibility}">
                                    <TextBlock Text="{Binding SenderRoleTitle}"
                                               Foreground="{Binding SenderRoleBrush}"
                                               FontSize="9.5" />
                                </Border>
                                <TextBlock x:Name="UnifiedMessageTime"
                                           Grid.Column="3"
                                           Text="{Binding TimeText}"
                                           Margin="9,0,0,0"
                                           Foreground="{DynamicResource BridgeInk3}"
                                           FontFamily="{DynamicResource BridgeDataFont}"
                                           FontSize="{DynamicResource BridgeFontAux}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="UnifiedMessageText"
