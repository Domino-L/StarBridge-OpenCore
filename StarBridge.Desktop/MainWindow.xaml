                                                                <ComboBoxItem Content="1.5 小时" Tag="90" />
                                                                <ComboBoxItem Content="2 小时" Tag="120" />
                                                                <ComboBoxItem Content="3 小时" Tag="180" />
                                                            </ComboBox>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Column="2"
                                                            Padding="11,9"
                                                            Background="{DynamicResource BridgePanel}"
                                                            BorderBrush="{DynamicResource BridgeHairline}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="118" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="后续提醒" Foreground="{DynamicResource BridgeInk}" FontWeight="SemiBold" />
                                                                <TextBlock Text="首次提醒后的重复间隔。" Margin="0,3,8,0" Foreground="{DynamicResource BridgeInk2}" FontSize="10.5" />
                                                            </StackPanel>
                                                            <ComboBox x:Name="ContinuousPlayRepeatIntervalBox"
                                                                      Grid.Column="1"
                                                                      Height="30"
                                                                      Style="{StaticResource NotificationOptionBoxStyle}"
                                                                      SelectionChanged="LocalPlayReminderSetting_Changed">
                                                                <ComboBoxItem Content="1 小时" Tag="60" />
                                                                <ComboBoxItem Content="2 小时" Tag="120" />
                                                            </ComboBox>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="ContinuousPlayReminderStatusText"
                                                           Grid.Row="2"
