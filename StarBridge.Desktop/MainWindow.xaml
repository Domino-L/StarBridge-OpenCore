                                                                                                Tag="{Binding}"
                                                                                                Click="TransferFleetCommander_Click" />
                                                                                    </Grid>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>

                                            <StackPanel Grid.Row="2"
