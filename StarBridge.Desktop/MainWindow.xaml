                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Grid>
        </DataTemplate>
        <Style x:Key="UnifiedChatAttachmentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Content" Value="添加" />
            <Setter Property="ContentTemplate" Value="{StaticResource UnifiedChatAttachmentGlyphTemplate}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ToolTip" Value="发送更多内容" />
        </Style>
        <Style x:Key="FriendCenterChatComposerTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource UnifiedChatComposerTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BridgeInk}" />
            <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                            <Border x:Name="FocusLayer"
                                    Background="Transparent"
                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendCenterChatAttachmentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FriendCenterSecondaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Content" Value="添加" />
            <Setter Property="ContentTemplate" Value="{StaticResource UnifiedChatAttachmentGlyphTemplate}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ToolTip" Value="发送更多内容" />
        </Style>
        <Style x:Key="FriendCenterChatSendButtonStyle"
               TargetType="Button"
