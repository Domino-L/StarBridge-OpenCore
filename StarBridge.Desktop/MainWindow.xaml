                <Rectangle Fill="{StaticResource GeometricBackgroundBrush}"
                           Opacity="0.62"
                           IsHitTestVisible="False" />
                <Border Width="720"
                        MaxHeight="720"
                        Padding="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F006101A"
                        BorderBrush="#2B5F79"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Border.Resources>
                        <Style x:Key="SyncChoiceSwitchStyle" TargetType="{x:Type CheckBox}">
                            <Setter Property="Width" Value="46" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                        <Border x:Name="Track"
                                                Background="#111920"
                                                BorderBrush="#3A4C58"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <TextBlock x:Name="StateText"
                                                       Text="OFF"
                                                       Foreground="#8298A7"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="#102A1D" />
                                                <Setter TargetName="Track" Property="BorderBrush" Value="#2C7A51" />
                                                <Setter TargetName="StateText" Property="Text" Value="ON" />
                                                <Setter TargetName="StateText" Property="Foreground" Value="#42CF7C" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Track" Property="BorderBrush" Value="#3B9AC4" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="SyncChoiceScopeStyle" TargetType="{x:Type RadioButton}">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="MinWidth" Value="88" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="#91A5B5" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type RadioButton}">
                                        <Border x:Name="Chrome"
                                                Background="#081722"
                                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#102737" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3B789A" />
                                                <Setter Property="Foreground" Value="#DFF5FF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#102B3D" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#29AFFF" />
                                                <Setter Property="Foreground" Value="#E6F1F8" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SYNC &amp; PRIVACY"
                                       Foreground="#63C7FF"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
