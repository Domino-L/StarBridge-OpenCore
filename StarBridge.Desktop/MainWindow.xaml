                                    <Border Padding="10"
                                            Margin="0,14,0,0"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <TextBlock Text="图片尺寸"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                            <TextBlock x:Name="BannerPickerImageSizeText"
                                                       Text="未选择"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="10"
                                            Margin="0,8,0,0"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <TextBlock Text="比例 / 大小"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                            <TextBlock x:Name="BannerPickerRatioText"
                                                       Text="目标 4:1 / 通用横幅"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="10"
                                            Margin="0,8,0,0"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <TextBlock Text="适配建议"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                            <TextBlock x:Name="BannerPickerFitHintText"
                                                       Text="选择图片后显示裁剪建议。"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="10,8"
                                            Margin="0,10,0,0"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <TextBlock Text="裁剪框对应最终保存区域。缩放或移动裁剪框后，可直接应用横幅。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
        </controls:BridgeModalHost>

