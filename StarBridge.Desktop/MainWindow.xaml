                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Padding="14"
                                          ScrollChanged="MenuOverlaySettingsScrollViewer_ScrollChanged">
                                <StackPanel x:Name="MenuOverlaySettingsDocument"
                                            HorizontalAlignment="Stretch">
                                    <StackPanel x:Name="MenuOverlaySettingsDocumentOverview"
                                                Margin="0,0,0,24">
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="概览与打开方式"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="菜单浮层是按需打开的游戏内工具空间；选择上方紫色通道可随时返回这里。"
                                                       Margin="0,6,20,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="MenuOverlaySettingsSectionOverview"
                                            Style="{StaticResource StarBridgeSettingsSection}"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="打开菜单浮层"
                                                           Foreground="#A79BFF"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="MenuOverlayOverviewHotkeyText"
                                                           Text="--"
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="仅在 Star Citizen 位于前台时响应"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="1"
                                                    Background="{StaticResource BorderDefaultBrush}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="当前布局"
                                                           Foreground="#A79BFF"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="MenuOverlayCurrentLayoutText"
                                                           Text="底部工具栏"
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="可移动和缩放，不会贴顶最大化"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="MenuOverlaySettingsDocumentHotkey"
                                                Margin="0,0,0,24">
                                        <TextBlock Text="启动与热键"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="菜单热键只在 Star Citizen 位于前台时打开工具空间；菜单已打开时可再次按下返回游戏。"
                                                   Margin="0,6,0,18"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <CheckBox x:Name="MenuOverlayHotkeyEnabledCheck"
                                                          Content="启用菜单浮层热键"
                                                          IsChecked="True"
                                                          Style="{StaticResource OverlayCommandSwitchStyle}"
                                                          Checked="MenuOverlayHotkeyEnabledCheck_Changed"
                                                          Unchecked="MenuOverlayHotkeyEnabledCheck_Changed" />
                                                <TextBlock Text="点击输入框后直接按下新的组合键。字母和数字键至少需要一个修饰键。"
                                                           Margin="0,8,0,10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="104" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MenuOverlayHotkeyBox"
                                                             Height="36"
                                                             IsReadOnly="True"
                                                             VerticalContentAlignment="Center"
                                                             Text="--"
                                                             ToolTip="点击后按下新的菜单浮层热键"
                                                             GotKeyboardFocus="MenuOverlayHotkeyBox_GotKeyboardFocus"
                                                             PreviewKeyDown="MenuOverlayHotkeyBox_PreviewKeyDown" />
                                                    <Button Grid.Column="2"
                                                            Content="恢复默认"
                                                            Height="36"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="ResetMenuOverlayHotkey_Click" />
                                                </Grid>
                                                <Border x:Name="MenuOverlayHotkeyStatusBadge"
                                                        Margin="0,12,0,0"
                                                        Padding="10,6"
                                                        HorizontalAlignment="Left"
                                                        Background="{StaticResource StatusDisabledSurfaceBrush}"
                                                        BorderBrush="{StaticResource StatusDisabledBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="MenuOverlayHotkeyStatusIndicator"
                                                                 Width="6"
                                                                 Height="6"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{StaticResource StatusDisabledBrush}" />
                                                        <TextBlock x:Name="MenuOverlayHotkeyStatusText"
                                                                   Text="正在检查"
                                                                   Foreground="{StaticResource StatusDisabledBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="MenuOverlayHotkeyRegistrationHintText"
                                                           Text="启动后会显示游戏内监听状态。"
                                                           Margin="0,7,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                Background="#1224213E"
                                                BorderBrush="#5E536F9D"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="热键范围"
                                                           Foreground="#BFB7FF"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="菜单热键不会在桌面打开菜单，也无法判断是否与游戏内按键设置重复。若组合键在游戏中已有用途，请换一个更少使用的组合。"
                                                           Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="MenuOverlaySettingsDocumentLocalTools"
                                                Margin="0,0,0,24">
                                    <StackPanel Margin="0,0,0,9">
                                        <TextBlock Text="本地工具"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="不需要登录即可使用；关闭菜单后保留当前窗口与内容。"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" />
                                    </StackPanel>

                                    <UniformGrid x:Name="MenuOverlaySettingsSectionLocalTools"
                                                 Columns="1"
                                                 Margin="0,0,0,12">
                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="浏览器"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="在游戏中搜索攻略或浏览网页。关闭菜单后会保留当前页面。"
                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="当前搜索首页"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10" />
                                                        <ComboBox x:Name="InGameBrowserProviderComboBox"
                                                                  MinWidth="132"
                                                                  MaxWidth="220"
                                                                  Height="34"
                                                                  Margin="0,5,14,0"
                                                                  HorizontalAlignment="Stretch"
                                                                  DisplayMemberPath="DisplayName"
                                                                  SelectedValuePath="Key"
                                                                  ToolTip="选择游戏内浏览器打开时使用的搜索首页"
                                                                  SelectionChanged="InGameBrowserProviderComboBox_SelectionChanged" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="打开浏览器"
                                                            MinWidth="104"
                                                            Height="34"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="PreviewMenuBrowser_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="参考图"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="查看地图、任务路线或其他参考图。可缩放、调节透明度并固定在游戏画面上。"
                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="固定显示"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10" />
                                                        <TextBlock Text="仅在游戏位于前台时可见"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="打开参考图"
                                                            MinWidth="104"
                                                            Height="34"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="PreviewMenuImage_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource StarBridgeSettingsSection}"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="全屏截屏"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="截取当前游戏画面，自动保存到本地并复制到剪贴板。"
                                                           Margin="0,7,20,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="10,5"
                                                    VerticalAlignment="Center"
                                                    Background="#102C3D4B"
                                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <TextBlock Text="菜单工具栏"
                                                           Foreground="#A79BFF"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="MenuOverlaySettingsDocumentCollaboration"
                                                Margin="0,0,0,24">
                                    <StackPanel Margin="0,0,0,9">
                                        <TextBlock Text="社交与协作"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="登录后查看舰队、好友、频道和当前组队房间。"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10" />
                                    </StackPanel>

                                    <UniformGrid x:Name="MenuOverlaySettingsSectionCollaboration"
                                                 Columns="1"
                                                 Margin="0,0,0,12">
                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="舰队"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="查看舰队概况、成员、小队和共享舰船，不包含管理操作。"
                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Button Content="打开舰队"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PreviewMenuFleet_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="好友"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="查看好友、在线状态和好友申请，也可以搜索并添加用户。"
                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Button Content="打开好友"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PreviewMenuFriends_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="通讯"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
                                                <TextBlock Text="切换好友私信、舰队频道和当前房间频道，并在游戏中直接回复。"
                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Button Content="打开通讯"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PreviewMenuChat_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="组队房间"
                                                           Style="{StaticResource StarBridgeSectionTitleText}" />
