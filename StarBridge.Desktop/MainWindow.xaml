                                                    <Setter Property="MinHeight" Value="52" />
                                                    <Setter Property="Padding" Value="12,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </Popup.Resources>
                                            <Border Width="360"
                                                    Padding="14"
                                                    Background="{DynamicResource BridgePanel}"
                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="添加主页模块"
                                                               Foreground="{DynamicResource BridgeInk}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="选择需要展示的内容。添加后可在主页中拖动排序。"
