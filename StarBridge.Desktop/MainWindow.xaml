                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ManageUnsavedChangesStatusText"
                                                   Grid.Column="1"
                                                   Margin="16,0"
                                                   Foreground="{DynamicResource BridgeStatusBad}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="ManageDiscardChangesButton"
