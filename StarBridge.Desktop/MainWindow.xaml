                        </TabControl>
                        </Grid>
                        </controls:ChamferBorder>
                    </Grid>

                    <Border x:Name="FleetFooterStatusBar"
                            Grid.Row="2"
                            Style="{StaticResource FleetRightPanel}"
                            Padding="18,10"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="FleetFooterValueText"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource ReplicaLabelText}">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.82*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="本地时间" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterLocalTimeText" Grid.Column="1" Text="--" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="舰队默认时间" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterFleetTimeText" Grid.Column="1" Text="--" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="2" Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="游戏状态" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterGameStatusText" Grid.Column="1" Text="未启动" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="3" Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="服务器" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterServerText" Grid.Column="1" Text="等待进入游戏" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="4" Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="同步状态" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterSyncText" Grid.Column="1" Text="等待同步" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="5" Margin="0,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="网络延迟" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterLatencyText" Grid.Column="1" Text="--" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                            <Grid Grid.Column="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="浮层状态" Style="{StaticResource ReplicaLabelText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FleetFooterOverlayText" Grid.Column="1" Text="未开启" Margin="10,0,0,0" Style="{StaticResource FleetFooterValueText}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <controls:BridgeModalHost x:Name="ActionPlanEditorPanel"
                                              Grid.RowSpan="3"
                                              Panel.ZIndex="50"
                                              Title="安排稍后行动"
                                              Description="填写行动内容、开始时间和通知范围。"
                                              Size="Form"
                                              DismissRequested="CancelActionPlanButton_Click">
                        <controls:BridgeModalHost.Footer>
                            <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Content="取消"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CancelActionPlanButton_Click" />
                                <Button x:Name="PublishActionPlanButton"
                                        Grid.Column="2"
                                        Content="发布"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsDefault="True"
                                        Click="PublishActionPlanButton_Click" />
                            </Grid>
                        </controls:BridgeModalHost.Footer>
                        <StackPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="行动标题：" Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox x:Name="ActionPlanTitleBox" Grid.Row="0" Grid.Column="1" MaxLength="48" />

                                <TextBlock Text="行动内容：" Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Top" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox x:Name="ActionPlanContentBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="120"
                                         Margin="0,14,0,0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MaxLength="500" />

                                <TextBlock Text="行动时间：" Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="ActionPlanDatePicker" />
                                    <TextBox Grid.Column="1"
                                             x:Name="ActionPlanTimeBox"
                                             Margin="12,0,0,0"
                                             MaxLength="5"
                                             Text="20:00"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="只能设定现在开始的 7 天之内，24 小时制 HH:mm"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>

                                <CheckBox x:Name="ActionPlanNotifyFleetCheck"
                                          Grid.Row="3"
                                          Grid.ColumnSpan="2"
                                          Margin="0,18,0,0"
                                          Content="是否向舰队成员发送通知（需要舰队成员同意接收；联网后发送到注册邮箱）" />
                            </Grid>
                            <TextBlock x:Name="ActionPlanValidationText"
                                       Foreground="{DynamicResource BridgeStatusWarn}"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </controls:BridgeModalHost>

                    <controls:BridgeModalHost x:Name="PublishTaskPanel"
                                              Grid.RowSpan="2"
                                              Panel.ZIndex="56"
                                              Title="发布行动令"
                                              Description="只填写目标与描述，其他条件通过选择确定，减少发布时的沟通噪音。"
                                              Size="Detail"
                                              DismissRequested="CancelPublishTaskButton_Click">
                        <controls:BridgeModalHost.Footer>
                            <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Content="取消"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CancelPublishTaskButton_Click" />
                                <Button Grid.Column="2"
                                        Content="发布"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsDefault="True"
                                        Click="PublishFleetTaskButton_Click" />
                            </Grid>
                        </controls:BridgeModalHost.Footer>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Padding="14"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <TextBlock Text="行动目标"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="只需要写清楚要做什么，后续条件交给选择项。"
                                                       Margin="0,4,0,10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />

                                            <TextBlock Text="目标" Style="{StaticResource HudCaptionText}" />
                                            <TextBox x:Name="PublishTaskObjectiveBox"
                                                     Margin="0,5,0,12"
                                                     MaxLength="48"
                                                     Text="战术打击" />

                                            <TextBlock Text="描述" Style="{StaticResource HudCaptionText}" />
                                            <TextBox x:Name="PublishTaskBriefBox"
                                                     Height="118"
                                                     Margin="0,5,0,0"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MaxLength="280"
                                                     Text="说明目标、风险、抵达后要做的事。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="2"
                                            Padding="14"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <TextBlock Text="任务类型覆盖面"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="可多选，用来告诉成员这次行动可能涉及哪些职责。"
                                                       Margin="0,4,0,10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" />
                                            <WrapPanel>
                                                <CheckBox x:Name="PublishTaskTypeGroundCombatCheck" Content="地面战斗" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeAirCombatCheck" Content="空战" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeEscortCheck" Content="护航" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeCargoCheck" Content="货运" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeMiningCheck" Content="采矿" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeSalvageCheck" Content="打捞" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeMedicalCheck" Content="医疗救援" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeSearchRescueCheck" Content="搜救" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeReconCheck" Content="侦察扫描" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeExplorationCheck" Content="探索" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeRepairRefuelCheck" Content="维修补给" Margin="0,0,12,8" />
                                                <CheckBox x:Name="PublishTaskTypeRallyCheck" Content="集结组织" Margin="0,0,12,8" />
                                            </WrapPanel>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="预计时长" Style="{StaticResource HudCaptionText}" />
                                                    <ComboBox x:Name="PublishTaskDurationBox" Margin="0,5,0,0">
                                                        <ComboBoxItem Content="15-30 分钟" />
                                                        <ComboBoxItem Content="30-60 分钟" IsSelected="True" />
                                                        <ComboBoxItem Content="1-2 小时" />
                                                        <ComboBoxItem Content="2 小时以上" />
                                                        <ComboBoxItem Content="待定" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="战斗强度" Style="{StaticResource HudCaptionText}" />
                                                    <ComboBox x:Name="PublishTaskCombatIntensityBox" Margin="0,5,0,0">
                                                        <ComboBoxItem Content="非战斗" />
                                                        <ComboBoxItem Content="低：战斗机可处理" />
                                                        <ComboBoxItem Content="中：重型战斗机与小型炮艇" IsSelected="True" />
                                                        <ComboBoxItem Content="高：重型炮艇与护卫舰" />
                                                        <ComboBoxItem Content="极高：主力舰与各类飞船" />
                                                        <ComboBoxItem Content="未知" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Margin="0,12,0,0"
                                            Padding="14"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="320" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="集结点"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="可以搜索建议地点，也可以直接输入自定义地点。"
                                                           Margin="0,4,0,10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" />
                                                <CheckBox x:Name="PublishTaskRallyCheck"
                                                          Content="发布集结点" />
                                                <ComboBox x:Name="PublishTaskRallyBox"
                                                          Margin="0,7,0,0"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          KeyUp="PublishTaskRallyBox_KeyUp"
                                                          Text="未指定" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="指定舰船"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="从舰队舰船或全舰船目录中选择，列表会显示定位、持有者和在线状态。"
                                                                   Margin="0,4,0,10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Bottom">
                                                        <CheckBox x:Name="PublishTaskShipRequiredCheck"
                                                                  Content="指定"
                                                                  Margin="0,0,14,0"
                                                                  Checked="PublishTaskShipFilter_Changed"
                                                                  Unchecked="PublishTaskShipFilter_Changed" />
                                                        <CheckBox x:Name="PublishTaskShipOnlineOnlyCheck"
                                                                  Content="只看在线"
                                                                  Margin="0,0,14,0"
                                                                  Checked="PublishTaskShipFilter_Changed"
                                                                  Unchecked="PublishTaskShipFilter_Changed" />
                                                        <CheckBox x:Name="PublishTaskShipIncludeCatalogCheck"
                                                                  Content="显示全库"
                                                                  Checked="PublishTaskShipFilter_Changed"
                                                                  Unchecked="PublishTaskShipFilter_Changed" />
                                                    </StackPanel>
                                                </Grid>
                                                <ListBox x:Name="PublishTaskShipList"
                                                         Height="142"
                                                         SelectionMode="Single"
                                                         Background="{StaticResource FieldBackBrush}"
                                                         BorderBrush="{StaticResource AccentDimBrush}"
                                                         Foreground="{StaticResource PrimaryTextBrush}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="125" />
                                                                    <ColumnDefinition Width="86" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ShipName}"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ShipMetaText}"
                                                                               Margin="0,2,0,0"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding OwnerText}"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               FontSize="11"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding SourceText}"
                                                                               Margin="0,2,0,0"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               FontSize="10"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding OwnerStatusText}"
                                                                           Foreground="{Binding OwnerStatusBrush}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Margin="0,12,0,0"
                                            Padding="14"
                                            Background="{StaticResource AvionicsGlassPanelBrush}"
                                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="300" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="参与范围"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="全员参与"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="召集"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="需要时通过邮件提醒舰队成员。"
                                                           Margin="0,4,0,10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" />
                                                <CheckBox x:Name="PublishTaskEmailCallCheck"
                                                          Content="发布召集令：邮件召集舰队成员" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="PublishTaskValidationText"
                                               Grid.Row="3"
                                               Grid.ColumnSpan="3"
                                               Foreground="{DynamicResource BridgeStatusWarn}"
                                               Margin="0,16,0,0" />
                                </Grid>
                    </controls:BridgeModalHost>

                    <controls:BridgeModalHost x:Name="JoinActionPlanPanel"
                                              Grid.RowSpan="2"
                                              Panel.ZIndex="55"
                                              Title="参与预约行动"
                                              Description="确认是否接取，并选择开始前提醒。"
                                              Size="Confirm"
                                              DismissRequested="CancelJoinActionPlanButton_Click">
                        <controls:BridgeModalHost.Footer>
                            <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1"
                                        Content="取消"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CancelJoinActionPlanButton_Click" />
                                <Button Grid.Column="2"
                                        Content="确认"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsDefault="True"
                                        Click="ConfirmJoinActionPlanButton_Click" />
                            </Grid>
                        </controls:BridgeModalHost.Footer>
                        <StackPanel>
                            <TextBlock x:Name="JoinActionPlanTitleText"
                                       Text="预约行动"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <CheckBox x:Name="JoinActionNotifyCheck"
                                      Margin="0,16,0,0"
                                      Content="是否在开始时通知？（开始前 5 分钟向邮箱发送即将开始信息）" />
                        </StackPanel>
                    </controls:BridgeModalHost>

                    <controls:BridgeModalHost x:Name="FleetActivitySchedulePanel"
                                              Grid.RowSpan="2"
                                              Panel.ZIndex="56"
                                              Title="舰队活动时间"
                                              Description="查看完整排期；页头横幅优先显示当前或最近一次活动。"
                                              Size="Form"
                                              DismissRequested="CloseFleetActivityScheduleButton_Click">
                        <controls:BridgeModalHost.Footer>
                            <Grid Style="{StaticResource BridgeModalFooterStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="活动时间由舰队管理者维护"
                                           Foreground="{DynamicResource BridgeInk3}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="EditFleetActivityScheduleButton"
                                        Grid.Column="1"
                                        Content="编辑活动时间"
                                        Height="32"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="EditFleetActivityScheduleButton_Click" />
                            </Grid>
                        </controls:BridgeModalHost.Footer>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
