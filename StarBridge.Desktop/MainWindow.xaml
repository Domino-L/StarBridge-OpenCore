                                                            <StackPanel><TextBlock Text="舰船概览" TextAlignment="Left" FontWeight="SemiBold" /><TextBlock Text="汇总机库数量、构成与价值" Margin="0,3,0,0" TextAlignment="Left" Foreground="{DynamicResource BridgeInk2}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                        <Button x:Name="PersonalProfilePickerSkilledRolesButton" Tag="skilled-roles" Margin="0" Style="{StaticResource PersonalProfileModulePickerButtonStyle}" Click="PersonalProfileModulePickerItem_Click">
                                                            <StackPanel><TextBlock Text="游戏定位" TextAlignment="Left" FontWeight="SemiBold" /><TextBlock Text="展示擅长领域、参与偏好与支援能力" Margin="0,3,0,0" TextAlignment="Left" Foreground="{DynamicResource BridgeInk2}" FontSize="10" /></StackPanel>
                                                        </Button>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <Popup x:Name="PersonalProfileModuleSizePopup"
