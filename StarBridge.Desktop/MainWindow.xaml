                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Background="Transparent"
                                                      Visibility="Collapsed">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="{x:Type ScrollBar}"
                                                       BasedOn="{StaticResource StarBridgeScrollBar}" />
                                            </ScrollViewer.Resources>
                                            <Grid Margin="0,0,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Padding="10"
                                                        MinHeight="248"
                                                        Background="{DynamicResource BridgePanelRaised}"
                                                        BorderBrush="{DynamicResource BridgeHairline}"
                                                        BorderThickness="1"
                                                        Margin="0,0,6,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="1" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
