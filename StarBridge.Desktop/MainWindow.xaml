                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource StarBridgeScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="快速设置"
                                                   Margin="14,0,0,5"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="MenuOverlayOverviewNavigationButton"
                                                Content="总览"
                                                CommandParameter="{StaticResource MenuRailOverviewIcon}"
                                                Uid="overview"
                                                Tag="Active"
                                                Style="{StaticResource MenuOverlaySettingsRailButton}"
                                                Click="MenuOverlayNavigationButton_Click" />
                                        <TextBlock Text="打开与控制"
                                                   Margin="14,10,0,5"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="MenuOverlayHotkeyNavigationButton"
                                                Content="启动与热键"
                                                CommandParameter="{StaticResource MenuRailHotkeyIcon}"
                                                Uid="hotkey"
                                                Tag="Inactive"
                                                Style="{StaticResource MenuOverlaySettingsRailButton}"
                                                Click="MenuOverlayNavigationButton_Click" />
                                        <TextBlock Text="工具与内容"
                                                   Margin="14,10,0,5"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="MenuOverlayLocalToolsNavigationButton"
                                                Content="本地工具"
                                                CommandParameter="{StaticResource MenuRailLocalToolsIcon}"
                                                Uid="local"
                                                Tag="Inactive"
                                                Style="{StaticResource MenuOverlaySettingsRailButton}"
                                                Click="MenuOverlayNavigationButton_Click" />
                                        <Button x:Name="MenuOverlayCollaborationNavigationButton"
                                                Content="社交与协作"
                                                CommandParameter="{StaticResource MenuRailCollaborationIcon}"
                                                Uid="collaboration"
                                                Tag="Inactive"
                                                Style="{StaticResource MenuOverlaySettingsRailButton}"
                                                Click="MenuOverlayNavigationButton_Click" />
                                        <TextBlock Text="布局"
                                                   Margin="14,10,0,5"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="MenuOverlayBehaviorNavigationButton"
                                                Content="窗口恢复"
                                                CommandParameter="{StaticResource MenuRailBehaviorIcon}"
                                                Uid="behavior"
                                                Tag="Inactive"
                                                Style="{StaticResource MenuOverlaySettingsRailButton}"
                                                Click="MenuOverlayNavigationButton_Click" />
                                    </StackPanel>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2"
                                            Margin="16">
                                    <Border Height="1"
                                            Margin="0,0,0,12"
                                            Background="{StaticResource BorderDefaultBrush}" />
                                    <TextBlock x:Name="MenuOverlayRailHotkeyText"
                                               Text="--"
                                               Foreground="#CBC5FF"
                                               FontFamily="Bahnschrift"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="仅在 Star Citizen 位于前台时响应"
                                               Margin="0,3,0,10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="MenuOverlayRailPreviewButton"
                                            Content="打开菜单浮层"
                                            Height="36"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="OpenInGameMenu_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="MenuOverlaySettingsContentPanel"
                                Grid.Column="2"
                                Visibility="Collapsed"
                                Style="{StaticResource StarBridgePanel}"
                                Padding="0">
                            <ScrollViewer x:Name="MenuOverlaySettingsScrollViewer"
