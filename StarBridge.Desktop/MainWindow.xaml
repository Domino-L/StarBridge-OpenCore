                                                           Margin="0,10,0,0"
                                                           Foreground="{DynamicResource BridgeStatusOk}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                            </StackPanel>
                                        </ScrollViewer>

