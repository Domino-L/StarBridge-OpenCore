                                                           Margin="0,7,0,12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <Button Content="打开房间"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="104"
                                                        Height="34"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="PreviewMenuRooms_Click" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    </StackPanel>

                                    <StackPanel x:Name="MenuOverlaySettingsDocumentBehavior">
                                        <StackPanel x:Name="MenuOverlaySettingsSectionBehavior"
                                                    Margin="0,0,0,9">
                                            <TextBlock Text="窗口恢复"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="决定再次打开菜单时，是否恢复本次应用会话中仍在使用的工具。"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10" />
                                        </StackPanel>

                                        <Border Style="{StaticResource StarBridgeSettingsSection}"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <CheckBox x:Name="MenuOverlayRestoreToolsCheck"
                                                          Content="重新打开菜单时恢复本次使用的工具"
                                                          IsChecked="True"
                                                          Style="{StaticResource OverlayOptionCheckStyle}"
                                                          Checked="MenuOverlayRestoreToolsCheck_Changed"
                                                          Unchecked="MenuOverlayRestoreToolsCheck_Changed" />
                                                <TextBlock Text="关闭菜单时工具仍会隐藏；启用后，再次打开菜单会恢复本次应用会话中尚未关闭的工具窗口。"
                                                           Margin="0,7,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="12"
                                                Background="#10241F3A"
                                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="工具窗口会在菜单关闭时隐藏；固定的参考图仅在 Star Citizen 位于前台时显示。"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="MenuOverlayPreferenceSaveStatusText"
                                                   Text=""
                                                   Margin="0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="MenuOverlayLayoutPreviewPanel"
                                Grid.Column="4"
                                Visibility="Collapsed"
                                Style="{StaticResource StarBridgePanel}"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="菜单布局"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="当前版本使用固定布局。这里用于确认工具栏、时间信息与状态区的位置，暂时不能修改。"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <local:InGameMenuPreviewSurface
                                    x:Name="InGameMenuPreviewSurface"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="#0C1B2731"
                                    BorderBrush="#786BE3"
                                    BorderThickness="1"
                                    ClipToBounds="True" />

                                <Border Grid.Row="2"
                                        Margin="0,10,0,0"
                                        Padding="12,9"
                                        Background="#10241F3A"
                                        BorderBrush="#574E9C"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="MenuOverlayPreviewResolutionText"
                                               Text="目标画布 1920 × 1080 · 自动匹配当前显示器"
                                               Foreground="#CBC5FF"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <local:InGameMenuSettingsEditor
                            x:Name="MenuOverlaySettingsEditor"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            DraftChanged="InGameMenuSettingsEditor_DraftChanged"
                            ActionRequested="InGameMenuSettingsEditor_ActionRequested" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="FriendCenterTab" Header="Friends">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:ChamferBorder x:Name="FriendCenterAvionicsHeader"
                                            Padding="20,16"
                                            Background="{DynamicResource BridgePanel}"
                                            BorderBrush="{DynamicResource BridgeHairline}"
                                            BorderThickness="1"
                                            Chamfer="16"
                                            Corners="Signature">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="560" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="好友与私信"
                                           Style="{StaticResource BridgePageTitleTextStyle}" />
                                <TextBlock Text="管理好友关系，处理申请，并在这里继续仅对双方可见的私信。"
                                           Margin="0,5,20,0"
                                           Style="{StaticResource BridgeAuxTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid x:Name="FriendCenterHeaderActionsGrid"
                                  Grid.Column="1"
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FriendSearchBox"
                                         Style="{StaticResource FriendCenterSearchBoxStyle}"
                                         Padding="10,4"
                                         ToolTip="输入至少 2 个字符搜索呼号或游戏 ID"
                                         KeyDown="FriendSearchBox_KeyDown" />
                                <Button x:Name="PublishFleetNoticeButton"
                                        Grid.Column="2"
                                        Content="查找用户"
                                        Style="{StaticResource FriendCenterPrimaryButtonStyle}"
                                        Click="FriendSearchButton_Click" />
                                <Button Grid.Column="4"
                                        Content="刷新"
                                        Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                        Click="FriendCenterRefreshButton_Click" />
                            </Grid>
                        </Grid>
                    </controls:ChamferBorder>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:ChamferBorder x:Name="FriendCenterAvionicsRail"
                                                Padding="12"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1"
                                                Chamfer="16"
                                                Corners="TopLeft">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,2">
                                    <Border Height="1" Background="{DynamicResource BridgeRowHairline}" Margin="0,0,0,10" />
                                    <TextBlock Text="隐身和离线模式下，好友看到的仍是离线状态。"
                                               Style="{StaticResource BridgeAuxTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="会话"
                                               Margin="4,2,0,10"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                               FontSize="{DynamicResource BridgeFontAux}"
                                               FontWeight="SemiBold" />
                                    <Button x:Name="FriendCenterConversationsButton"
                                            Grid.Row="1"
                                            Margin="0,0,0,12"
                                            Style="{StaticResource FriendCenterSectionButtonStyle}"
                                            Click="FriendCenterSectionButton_Click">
                                        <Grid>
                                            <TextBlock Text="最近私聊" />
                                            <Border x:Name="FriendCenterConversationUnreadBadge"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BridgeCountBadgeStyle}">
                                                <TextBlock x:Name="FriendCenterConversationUnreadText"
                                                           Text="0"
                                                           Style="{StaticResource BridgeCountBadgeTextStyle}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Border Grid.Row="2" Height="1" Margin="4,0,4,12" Background="{DynamicResource BridgeRowHairline}" />
                                    <TextBlock Text="关系分类"
                                               Grid.Row="3"
                                               Margin="4,2,0,10"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                               FontSize="{DynamicResource BridgeFontAux}"
                                               FontWeight="SemiBold" />
                                    <Button x:Name="FriendCenterFriendsButton"
                                            Grid.Row="4"
                                            Style="{StaticResource FriendCenterSectionButtonStyle}"
                                            Click="FriendCenterSectionButton_Click">
                                        <Grid>
                                            <TextBlock Text="好友" />
                                            <TextBlock x:Name="FriendCenterFriendsCountText" Text="0" Style="{StaticResource FriendCenterCountTextStyle}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FriendCenterIncomingButton"
                                            Grid.Row="5"
                                            Style="{StaticResource FriendCenterSectionButtonStyle}"
                                            Click="FriendCenterSectionButton_Click">
                                        <Grid>
                                            <TextBlock Text="收到的申请" />
                                            <TextBlock x:Name="FriendCenterIncomingCountText" Text="0" Style="{StaticResource FriendCenterCountTextStyle}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FriendCenterOutgoingButton"
                                            Grid.Row="6"
                                            Style="{StaticResource FriendCenterSectionButtonStyle}"
                                            Click="FriendCenterSectionButton_Click">
                                        <Grid>
                                            <TextBlock Text="已发送" />
                                            <TextBlock x:Name="FriendCenterOutgoingCountText" Text="0" Style="{StaticResource FriendCenterCountTextStyle}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FriendCenterBlockedButton"
                                            Grid.Row="7"
                                            Style="{StaticResource FriendCenterSectionButtonStyle}"
                                            Click="FriendCenterSectionButton_Click">
                                        <Grid>
                                            <TextBlock Text="已屏蔽" />
                                            <TextBlock x:Name="FriendCenterBlockedCountText" Text="0" Style="{StaticResource FriendCenterCountTextStyle}" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DockPanel>
                        </controls:ChamferBorder>

                        <controls:ChamferBorder x:Name="FriendCenterAvionicsContent"
                                                Grid.Column="2"
                                                Padding="16"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1"
                                                Chamfer="16"
                                                Corners="BottomRight">
                            <Grid>
                            <Grid x:Name="FriendCenterRelationshipPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FriendCenterResultsTitleText"
                                               Text="好友"
                                               Style="{StaticResource BridgePageTitleTextStyle}" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="FriendCenterStatusText"
                                                   MaxWidth="420"
                                                   Text="好友数据将在登录后同步。"
                                                   Style="{StaticResource BridgeAuxTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <Border Width="1"
                                                Height="12"
                                                Margin="12,0"
                                                Background="{DynamicResource BridgeHairline}" />
                                        <TextBlock x:Name="FriendCenterResultsMetaText"
                                                   Text="0 位用户"
                                                   Style="{StaticResource BridgeAuxTextStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="FriendCenterDegradedBanner"
                                        Grid.Row="1"
                                        Margin="0,0,0,10"
                                        Padding="12,9"
                                        Background="{DynamicResource BridgePanelRaised}"
                                        BorderBrush="{DynamicResource BridgeStatusWarn}"
                                        BorderThickness="1,0,0,0"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE774;"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BridgeStatusWarn}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" />
                                        <TextBlock x:Name="FriendCenterDegradedText"
                                                   Grid.Column="1"
                                                   Text="当前显示上次同步的好友数据。"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BridgeAuxTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Content="重试"
                                                Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                Click="FriendCenterRefreshButton_Click" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2"
                                      MinHeight="220"
                                      MaxHeight="520"
                                      VerticalAlignment="Top">
                                    <ListBox x:Name="FriendCenterResultsList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"
                                                   BasedOn="{StaticResource PassiveListBoxItemStyle}" />
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="FriendCenterRowChrome"
                                                        Margin="0,0,0,6"
                                                        Padding="12,10"
                                                        BorderThickness="0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Width="42"
                                                                Height="42"
                                                                Style="{StaticResource UserAvatarButtonStyle}"
                                                                Click="UserAvatarButton_Click">
                                                            <Grid>
                                                                <ContentControl Tag="{Binding AvatarSource}"
                                                                                Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                <Image Source="{Binding AvatarSource, Converter={StaticResource ImageDataConverter}, ConverterParameter=84}"
                                                                       Stretch="UniformToFill" />
                                                                <Ellipse Width="8"
                                                                         Height="8"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Bottom"
                                                                         Fill="{Binding PresenceBrush}"
                                                                         Stroke="{DynamicResource BridgePanelRaised}"
                                                                         StrokeThickness="1" />
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Callsign}"
                                                                           Foreground="{DynamicResource BridgeInk}"
                                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                                           FontSize="{DynamicResource BridgeFontBody}"
                                                                           FontWeight="SemiBold" />
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="7,2"
                                                                        Background="{DynamicResource BridgeRowHover}"
                                                                        BorderBrush="{DynamicResource BridgeChipHairline}"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding RelationshipText}"
                                                                               Foreground="{DynamicResource BridgeInk2}"
                                                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                                                               FontSize="{DynamicResource BridgeFontAux}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding GameId}" Style="{StaticResource BridgeAuxTextStyle}" />
                                                                <Ellipse Width="5" Height="5" Margin="10,0,6,0" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding PresenceText}"
                                                                           Foreground="{Binding PresenceBrush}"
                                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                                           FontSize="{DynamicResource BridgeFontAux}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button MinWidth="64"
                                                                    Margin="0,0,8,0"
                                                                    Content="私聊"
                                                                    Tag="chat"
                                                                    Visibility="{Binding ChatActionVisibility}"
                                                                    Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                                    Click="FriendCenterRowActionButton_Click" />
                                                            <Button MinWidth="78"
                                                                    Content="{Binding PrimaryActionText}"
                                                                    Tag="{Binding PrimaryAction}"
                                                                    Style="{StaticResource FriendCenterPrimaryButtonStyle}"
                                                                    Click="FriendCenterRowActionButton_Click" />
                                                            <Button MinWidth="78"
                                                                    Margin="8,0,0,0"
                                                                    Content="{Binding SecondaryActionText}"
                                                                    Tag="{Binding SecondaryAction}"
                                                                    Visibility="{Binding SecondaryActionVisibility}"
                                                                    Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                                    Click="FriendCenterRowActionButton_Click" />
                                                            <Button MinWidth="60"
                                                                    Height="32"
                                                                    Margin="8,0,0,0"
                                                                    Padding="12,0"
                                                                    Content="屏蔽"
                                                                    Tag="block"
                                                                    Visibility="{Binding BlockActionVisibility}"
                                                                    Style="{StaticResource FriendCenterDangerButtonStyle}"
                                                                    Click="FriendCenterRowActionButton_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="FriendCenterEmptyState"
                                                Width="420"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="52"
                                                Height="52"
                                                Margin="0,0,0,14"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource BridgePanelRaised}"
                                                BorderBrush="{DynamicResource BridgeChipHairline}"
                                                BorderThickness="1">
                                            <TextBlock Text="&#xE716;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22" />
                                        </Border>
                                        <TextBlock x:Name="FriendCenterEmptyTitleText"
                                                   Text="还没有好友"
                                                   Style="{StaticResource BridgePageTitleTextStyle}"
                                                   TextAlignment="Center" />
                                        <TextBlock x:Name="FriendCenterEmptyDescriptionText"
                                                   Text="使用上方搜索框查找呼号或游戏 ID，发送第一条好友申请。"
                                                   Margin="0,7,0,0"
                                                   Style="{StaticResource BridgeAuxTextStyle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <controls:BridgeStatePresenter x:Name="FriendCenterSystemStatePanel"
                                                                   Panel.ZIndex="5"
                                                                   Background="{DynamicResource BridgePanel}"
                                                                   State="Loading"
                                                                   TitleOverride="正在同步好友"
                                                                   DescriptionOverride="正在读取好友、申请与在线状态。"
                                                                   ActionInvoked="FriendCenterRefreshButton_Click"
                                                                   Visibility="Visible" />
                                </Grid>

                            </Grid>

                            <Grid x:Name="FriendChatWorkspace" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource BridgePanelRaised}"
                                        BorderThickness="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="14,12"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="最近私聊"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                           FontSize="{DynamicResource BridgeFontBodyStrong}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="聊天记录会保存在你的账号中"
                                                   Margin="0,3,0,0"
                                                           Style="{StaticResource BridgeAuxTextStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1">
                                            <ListBox x:Name="FriendChatConversationList"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     LostMouseCapture="FriendChatConversationList_LostMouseCapture"
                                                     PreviewMouseLeftButtonDown="FriendChatConversationList_PreviewMouseLeftButtonDown"
                                                     PreviewMouseLeftButtonUp="FriendChatConversationList_PreviewMouseLeftButtonUp"
                                                     SelectionChanged="FriendChatConversationList_SelectionChanged"
                                                     ScrollViewer.CanContentScroll="True"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10"
                                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4" />
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="FriendConversationSelectedEdge"
                                                                        Width="3"
                                                                        Margin="0,6,0,6"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                                    </Border.Background>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                             Value="True">
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                                <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0">
                                                                    <ContentControl Tag="{Binding AvatarSource}"
                                                                                    Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                    <Image Source="{Binding AvatarSource, Converter={StaticResource ImageDataConverter}, ConverterParameter=72}"
                                                                           Stretch="UniformToFill" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Callsign}"
                                                                               Foreground="{DynamicResource BridgeInk}"
                                                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                                                               FontSize="{DynamicResource BridgeFontBody}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Preview}"
                                                                               Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource BridgeInk2}"
                                                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                                                               FontSize="{DynamicResource BridgeFontAux}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ContextText}"
                                                                               Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource BridgeInk3}"
                                                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                                                               FontSize="{DynamicResource BridgeFontAux}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding UpdatedAtText}"
                                                                               HorizontalAlignment="Right"
                                                                               Foreground="{DynamicResource BridgeInk3}"
                                                                               FontFamily="{DynamicResource BridgeDataFont}"
                                                                               FontSize="{DynamicResource BridgeFontAux}" />
                                                                    <Border Height="19"
                                                                            Margin="0,4,0,0"
                                                                            Padding="6,0"
                                                                            HorizontalAlignment="Right"
                                                                            Background="{DynamicResource BridgeRowHover}"
                                                                            BorderBrush="{DynamicResource BridgeChipHairline}"
                                                                            BorderThickness="1"
                                                                            Visibility="{Binding RequestBadgeVisibility}">
                                                                        <TextBlock Text="{Binding ConversationStateText}"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource BridgeInk2}"
                                                                                   FontFamily="{DynamicResource BridgeCjkFont}"
                                                                                   FontSize="{DynamicResource BridgeFontAux}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Border MinWidth="20"
                                                                            Height="20"
                                                                            Margin="0,5,0,0"
                                                                            Padding="5,0"
                                                                            HorizontalAlignment="Right"
                                                                            Background="{DynamicResource BridgeStatusInfo}"
                                                                            BorderBrush="{DynamicResource BridgeStatusInfo}"
                                                                            BorderThickness="1"
                                                                            Visibility="{Binding UnreadVisibility}">
                                                                        <TextBlock Text="{Binding UnreadText}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource BridgeGround}"
                                                                                   FontFamily="{DynamicResource BridgeDataFont}"
                                                                                   FontSize="{DynamicResource BridgeFontAux}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <StackPanel x:Name="FriendChatConversationEmptyState"
                                                        Width="240"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8BD;"
                                                           Margin="0,0,0,12"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="22"
                                                           TextAlignment="Center" />
                                                <TextBlock Text="还没有私聊"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                           FontSize="{DynamicResource BridgeFontBodyStrong}"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center" />
                                                <TextBlock Text="从好友列表选择“私聊”，开始第一段对话。"
                                                           Margin="0,6,0,0"
                                                           Style="{StaticResource BridgeAuxTextStyle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource BridgePanelRaised}"
                                        BorderThickness="0">
                                    <Grid>
                                        <StackPanel x:Name="FriendChatNoSelectionState"
                                                    Width="420"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8BD;"
                                                       Margin="0,0,0,14"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="选择一位好友开始私聊"
                                                       Style="{StaticResource BridgePageTitleTextStyle}"
                                                       TextAlignment="Center" />
                                                    <TextBlock Text="好友私聊只对你和对方可见，不会进入游戏浮层或舰队频道。"
                                                       Margin="0,7,0,0"
                                                       Style="{StaticResource BridgeAuxTextStyle}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid x:Name="FriendChatActivePanel" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Margin="20,15,20,13"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="36" Height="36">
                                                        <ContentControl x:Name="FriendChatSelectedInitialsText"
                                                                        Style="{StaticResource IdentityBeaconAvatarPlaceholderStyle}" />
                                                        <Image x:Name="FriendChatSelectedAvatarImage" Stretch="UniformToFill" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="FriendChatSelectedCallsignText"
                                                                       Foreground="{DynamicResource BridgeInk}"
                                                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                                                       FontSize="{DynamicResource BridgeFontBody}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock x:Name="FriendChatSelectedPresenceText"
                                                                       Margin="9,0,0,0"
                                                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                                                       FontSize="{DynamicResource BridgeFontAux}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock x:Name="FriendChatSelectedRelationText"
                                                                       Margin="9,0,0,0"
                                                                       Foreground="{DynamicResource BridgeInk2}"
                                                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                                                       FontSize="{DynamicResource BridgeFontAux}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="FriendChatSelectedGameIdText"
                                                                   Margin="0,2,0,0"
                                                                   Style="{StaticResource BridgeAuxTextStyle}" />
                                                        <TextBlock x:Name="FriendChatSelectedContextText"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource BridgeInk3}"
                                                                   FontFamily="{DynamicResource BridgeCjkFont}"
                                                                   FontSize="{DynamicResource BridgeFontAux}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <StackPanel x:Name="FriendChatRequestActionsPanel"
                                                                    Orientation="Horizontal"
                                                                    Margin="0,0,6,0"
                                                                    Visibility="Collapsed">
                                                            <Button Content="接受"
                                                                    Tag="accept"
                                                                    MinWidth="58"
                                                                    Height="30"
                                                                    Margin="0,0,6,0"
                                                                    Style="{StaticResource FriendCenterPrimaryButtonStyle}"
                                                                    Click="FriendChatRequestActionButton_Click" />
                                                            <Button Content="拒绝"
                                                                    Tag="reject"
                                                                    MinWidth="58"
                                                                    Height="30"
                                                                    Margin="0,0,6,0"
                                                                    Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                                    Click="FriendChatRequestActionButton_Click" />
                                                            <Button Content="屏蔽"
                                                                    Tag="block"
                                                                    MinWidth="58"
                                                                    Height="30"
                                                                    Style="{StaticResource FriendCenterDangerButtonStyle}"
                                                                    Click="FriendChatRequestActionButton_Click" />
                                                        </StackPanel>
                                                        <Button x:Name="FriendChatSelectedProfileButton"
                                                                MinWidth="76"
                                                                Height="30"
                                                                Padding="12,0"
                                                                Content="查看资料"
                                                                Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                                Click="FriendChatSelectedProfileButton_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1" Margin="0" Background="{DynamicResource BridgeGround}">
                                                <Border BorderBrush="{DynamicResource BridgeRowHairline}"
                                                        BorderThickness="0,1,0,1" />
                                                <ListBox x:Name="FriendChatMessageList"
                                                         Style="{StaticResource UnifiedChatMessageListStyle}" />
                                                <Border x:Name="FriendChatHistoryStatusPanel"
                                                        Panel.ZIndex="4"
                                                        Margin="0,10,0,0"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource BridgePanelRaised}"
                                                        BorderBrush="{DynamicResource BridgeChipHairline}"
                                                        BorderThickness="1"
                                                        Visibility="Collapsed">
                                                    <TextBlock x:Name="FriendChatHistoryStatusText"
                                                               Text="正在加载更早消息…"
                                                               Style="{StaticResource BridgeAuxTextStyle}" />
                                                </Border>
                                                <Button x:Name="FriendChatJumpToLatestButton"
                                                        Panel.ZIndex="4"
                                                        Content="回到最新"
                                                        Margin="0,0,16,14"
                                                        Padding="13,0"
                                                        Height="30"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Style="{StaticResource FriendCenterSecondaryButtonStyle}"
                                                        Visibility="Collapsed"
                                                        Click="FriendChatJumpToLatestButton_Click" />

                                                <StackPanel x:Name="FriendChatMessageEmptyState"
                                                            Width="360"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8F2;"
                                                               Margin="0,0,0,12"
                                                               Foreground="{DynamicResource BridgeInk2}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="发送第一条消息"
                                                               Foreground="{DynamicResource BridgeInk}"
                                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                                               FontSize="{DynamicResource BridgeFontBodyStrong}"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="这段对话只会出现在你与该好友的私聊中。"
                                                               Margin="0,6,0,0"
                                                               Style="{StaticResource BridgeAuxTextStyle}"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="2"
                                                    Margin="18,14,18,16"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="FriendChatAttachmentButton"
                                                        Style="{StaticResource FriendCenterChatAttachmentButtonStyle}"
                                                                Click="FriendChatAttachmentButton_Click" />
                                                        <TextBox x:Name="FriendChatInputBox"
                                                                 Grid.Column="1"
                                                                 MaxLength="1000"
                                                                 Style="{StaticResource FriendCenterChatComposerTextBoxStyle}"
                                                                 ToolTip="Enter 发送；Shift+Enter 换行"
                                                                 PreviewKeyDown="FriendChatInputBox_KeyDown" />
                                                        <Button x:Name="FriendChatSendButton"
                                                                Grid.Column="2"
                                                                Content="发送"
                                                                Style="{StaticResource FriendCenterChatSendButtonStyle}"
                                                                Click="FriendChatSendButton_Click" />
                                                    </Grid>
                                                    <Grid Grid.Row="1" Margin="0,7,0,0">
                                                        <TextBlock x:Name="FriendChatStatusText"
                                                                   Text="仅你与该好友可见"
                                                                   Style="{StaticResource BridgeAuxTextStyle}" />
                                                        <TextBlock Text="Enter 发送 · Shift+Enter 换行 · 最多 1000 字"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource BridgeInk3}"
                                                                   FontFamily="{DynamicResource BridgeDataFont}"
                                                                   FontSize="{DynamicResource BridgeFontAux}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Grid>
                        </controls:ChamferBorder>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="HangarTab" Header="我的机库">
                <Grid Margin="0,14,0,0"
                      Background="{DynamicResource BridgeGround}">
                    <ContentControl x:Name="HangarPageHost"
                                    Background="{DynamicResource BridgeGround}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>
            </TabItem>

            <TabItem x:Name="PersonalTab" Header="Personal">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            MaxWidth="1320"
                            Padding="18,8"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid MinHeight="132">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108" />
                                <ColumnDefinition Width="255" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                            </Grid.ColumnDefinitions>

                            <Border Width="88"
                                    Height="88"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AvionicsGlassPanelBrush}"
                                    BorderBrush="{DynamicResource BridgeHairline}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="AVATAR"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="PersonalProfileAvatarDisplayImage"
                                           Stretch="UniformToFill"
                                           Source="{Binding Source, ElementName=AvatarImage, Path=Source}" />
                                    <Image x:Name="PersonalProfileAvatarDraftImage"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed" />
                                    <Button x:Name="PersonalProfileAvatarEditButton"
                                            Content="更换头像"
                                            Width="76"
                                            Height="24"
                                            Margin="6"
                                            Padding="4,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource SecondaryButton}"
                                            Visibility="Collapsed"
                                            Click="PersonalProfileAvatarEditButton_Click" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="PERSONAL PROFILE"
                                           Foreground="{DynamicResource BridgeInk3}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PersonalProfileCallsignText"
                                           Text="{Binding Text, ElementName=AccountNameText}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource BridgeInk}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="PersonalProfileCallsignEditor"
                                         Height="36"
                                         Margin="0,4,0,0"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource BridgePanelRaised}"
                                         BorderBrush="{DynamicResource BridgeChipHairline}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource BridgeInk}"
                                         CaretBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         FontSize="18"
                                         FontWeight="SemiBold"
                                         MaxLength="24"
                                         Visibility="Collapsed"
                                         TextChanged="PersonalProfileCallsignEditor_TextChanged" />
                                <TextBlock x:Name="PersonalProfileGameIdText"
                                           Text="{Binding Text, ElementName=GameNameText}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource BridgeInk2}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="PersonalProfileOwnerIdentityBadgesPanel"
                                            Orientation="Horizontal"
                                            Margin="0,10,0,0">
                                    <Border x:Name="PersonalProfileIdentityStatusBadge"
                                            Height="24"
                                            Padding="8,0"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="在线">
                                                        <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusOk}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="应用在线">
                                                        <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="游戏中">
                                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusOk}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="暂离">
                                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusWarn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="同步中">
                                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusWarn}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="同步失败">
                                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusBad}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="需要身份信息">
                                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusBad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock x:Name="PersonalProfileStatusText"
                                                   Text="{Binding Text, ElementName=ProfileStatusText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="在线">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOk}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="应用在线">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusInfo}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="游戏中">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOk}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="暂离">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusWarn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="同步中">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusWarn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="同步失败">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PersonalProfileStatusText}" Value="需要身份信息">
                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border x:Name="PersonalProfilePresenceIntentBadge"
                                            Height="24"
                                            Padding="8,0"
                                            Margin="6,0,0,0"
                                            Background="{DynamicResource BridgePanelRaised}"
                                            BorderBrush="{DynamicResource BridgeChipHairline}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="PersonalProfilePresenceIntentText"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="PersonalProfileVisibilityModePanel"
                                            Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <TextBlock Text="对外状态"
                                               Margin="0,0,7,0"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="PersonalProfileVisibilityModeBox"
                                              Width="104"
                                              Height="32"
                                              Padding="10,4"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              ToolTip="控制你向其他用户公开的即时状态"
                                              SelectionChanged="PersonalProfileVisibilityModeBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel x:Name="PersonalProfilePresenceIntentEditorPanel"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="当前意向（可选）"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="9" />
                                    <ComboBox x:Name="PersonalProfilePresenceIntentBox"
                                              Width="156"
                                              Height="32"
                                              Margin="0,4,0,0"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="PersonalProfilePresenceIntentBox_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>

                            <Border x:Name="PersonalProfileIntroductionSummaryPanel"
                                    Grid.Column="2"
                                    Margin="18,5,18,5"
                                    Padding="20,0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                    BorderThickness="1,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="个人介绍"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="PersonalProfileIntroductionText"
                                               Grid.Row="1"
                                               Margin="0,7,0,0"
                                               Text="添加个人介绍"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="12"
                                               LineHeight="19"
                                               MaxHeight="60"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBox x:Name="PersonalProfileIntroductionEditor"
                                             Grid.Row="1"
                                             Margin="0,6,0,0"
                                             MinHeight="58"
                                             MaxHeight="68"
                                             Padding="8,6"
                                             MaxLength="300"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Visibility="Collapsed"
                                             TextChanged="PersonalProfileEditorChanged" />
                                </Grid>
                            </Border>

                            <Grid x:Name="PersonalProfileOwnerSummaryPanel"
                                  Grid.Column="3"
                                  Margin="0,5,0,5"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="54"
                                        Height="54"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AvionicsGlassPanelBrush}"
                                        BorderBrush="{StaticResource AvionicsGlassEdgeBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="舰"
                                                   Foreground="{DynamicResource BridgeInk3}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding Source, ElementName=PersonalHeaderFleetLogoImage, Path=Source}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="舰队身份"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="10" />
                                    <TextBlock Text="{Binding Text, ElementName=PersonalHeaderFleetNameText}"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource BridgeInk}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Text, ElementName=PersonalHeaderFleetRoleText}"
                                               Margin="0,4,0,0"
                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Text, ElementName=PersonalHeaderFleetCodeText}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource BridgeInk3}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="PersonalProfileScrollViewer"
                                  Grid.Row="1"
                                  Margin="18,12,18,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel Width="{Binding ViewportWidth, ElementName=PersonalProfileScrollViewer}"
                                    MaxWidth="1320"
                                    HorizontalAlignment="Center">
                            <Border Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PersonalProfileVisitorBackButton"
                                            Width="34"
                                            Height="34"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            ToolTip="返回刚才的页面"
                                            Style="{StaticResource SecondaryButton}"
                                            Visibility="Collapsed"
                                            Click="PersonalProfileVisitorBackButton_Click">
                                        <Path Width="12"
                                              Height="12"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource BridgeInk}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Square"
                                              StrokeEndLineCap="Square"
                                              Data="M 10,1 L 3,6 L 10,11 M 3,6 L 12,6" />
                                    </Button>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="PersonalProfilePageTitleText"
                                                   Text="个人主页"
                                                   Foreground="{DynamicResource BridgeInk}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="PersonalProfilePageDescriptionText"
