                                                                <TextBlock x:Name="FleetEventsPlanTitleText"
                                                                           Text="即将开始"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock x:Name="FleetEventsPlanSummaryText"
                                                                           Margin="0,4,0,0"
                                                                           Foreground="{StaticResource MutedTextBrush}"
