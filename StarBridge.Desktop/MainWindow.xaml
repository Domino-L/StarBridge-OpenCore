                                                                              Style="{StaticResource ManageProfileSwitchStyle}"
                                                                              Checked="ManageProfileDraftChanged"
                                                                              Unchecked="ManageProfileDraftChanged" />
                                                                </Grid>
                                                                <Separator Background="{DynamicResource BridgeRowHairline}" Opacity="0.35" Margin="0,0,0,10" Visibility="Collapsed" />

                                                                <UniformGrid Columns="2">
                                                                    <Grid Margin="0,0,10,10">
                                                                        <Grid.ColumnDefinitions>
