                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="10.5"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="3"
                                              Margin="0,10,0,0">
                                            <Border Background="{DynamicResource BridgeGround}"
                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="44" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Padding="11,0"
                                                            Background="{DynamicResource BridgePanelRaised}"
                                                            BorderBrush="{DynamicResource BridgeHairline}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="本地事件日志"
                                                                           Foreground="{DynamicResource BridgeInk}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock x:Name="LocalGameEventSummaryText"
                                                                           Text="等待新的已识别事件"
                                                                           Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource BridgeInk3}"
                                                                           FontSize="9.5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <ComboBox x:Name="LocalGameEventFilterBox"
                                                                          Width="124"
                                                                          Height="30"
                                                                          SelectedIndex="0"
                                                                          SelectionChanged="LocalGameEventFilterBox_SelectionChanged">
                                                                    <ComboBoxItem Content="全部事件" Tag="all" />
                                                                    <ComboBoxItem Content="会话" Tag="session" />
                                                                    <ComboBoxItem Content="身份" Tag="identity" />
                                                                    <ComboBoxItem Content="服务器" Tag="server" />
                                                                    <ComboBoxItem Content="舰船" Tag="ship" />
                                                                    <ComboBoxItem Content="地点" Tag="location" />
                                                                    <ComboBoxItem Content="生命状态" Tag="life" />
                                                                </ComboBox>
                                                                <Button x:Name="ExportLocalGameEventsButton"
                                                                        Content="导出"
                                                                        MinWidth="66"
                                                                        Height="30"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                                        Click="ExportLocalGameEventsButton_Click" />
                                                                <Button x:Name="ClearLocalGameEventsButton"
                                                                        Content="清空"
                                                                        MinWidth="66"
                                                                        Height="30"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Click="ClearLocalGameEventsButton_Click" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Grid Grid.Row="1">
                                                        <Border Width="1"
                                                                Margin="19,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource BridgeStatusInfo}"
                                                                Opacity="0.65"
                                                                IsHitTestVisible="False" />
                                                        <ListBox x:Name="LocalGameEventList"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.CanContentScroll="True"
                                                                 VirtualizingPanel.IsVirtualizing="True"
                                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                                 VirtualizingPanel.ScrollUnit="Pixel">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="Margin" Value="0" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="Focusable" Value="False" />
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border MinHeight="48"
                                                                            Padding="0,5"
                                                                            Background="{DynamicResource BridgePanel}"
                                                                            BorderBrush="{DynamicResource BridgeHairline}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="3" />
                                                                                <ColumnDefinition Width="88" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="82" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Background="{Binding AccentBrush}" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding TimeText}"
                                                                                       Margin="13,0,8,0"
                                                                                       Foreground="{DynamicResource BridgeInk3}"
                                                                                       FontFamily="Bahnschrift"
                                                                                       FontSize="9.5"
                                                                                       LineHeight="13"
                                                                                       VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           Foreground="{DynamicResource BridgeInk}"
                                                                                           FontSize="10.5"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding Detail}"
                                                                                           Margin="0,2,10,0"
                                                                                           Foreground="{DynamicResource BridgeInk3}"
                                                                                           FontSize="9"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{Binding DetailVisibility}" />
                                                                            </StackPanel>
                                                                            <Border Grid.Column="3"
                                                                                    Height="20"
                                                                                    Padding="7,0"
                                                                                    Margin="8,0,10,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource BridgePanelRaised}"
                                                                                    BorderBrush="{Binding AccentBrush}"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Text="{Binding CategoryText}"
                                                                                           Foreground="{Binding AccentBrush}"
                                                                                           FontSize="8.5"
                                                                                           FontWeight="SemiBold"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <StackPanel x:Name="LocalGameEventEmptyState"
                                                                    Width="360"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="等待 Game.log 中的新事件"
                                                                       Foreground="{DynamicResource BridgeInk}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center" />
                                                            <TextBlock Text="这里只保留星海舰桥已经识别的事件，不保存完整日志原文，也不会上传服务器。"
                                                                       Margin="0,5,0,0"
                                                                       Foreground="{DynamicResource BridgeInk3}"
                                                                       FontSize="9.5"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Row="4"
                                              Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="RunApplicationDiagnosticsButton"
                                                    Content="运行一键诊断"
                                                    Height="30"
                                                    Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                    Click="RunApplicationDiagnosticsButton_Click" />
                                            <Button Grid.Column="1"
                                                    Content="复制诊断信息"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Click="CopyPersonalDiagnosticInfoButton_Click" />
                                            <Button Grid.Column="2"
                                                    Content="打开配置目录"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Click="OpenPersonalConfigDirectoryButton_Click" />
                                            <Button Grid.Column="3"
                                                    Content="清理图片缓存"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="ClearPersonalCacheButton_Click" />
                                        </Grid>
                                    </Grid>
                                </controls:ChamferBorder>

                                <controls:ChamferBorder x:Name="PersonalDashboardNotificationSection"
                                        Grid.ColumnSpan="2"
                                        Grid.RowSpan="3"
                                        Visibility="Collapsed"
                                        Style="{StaticResource SettingsWorkspaceSurfaceStyle}"
                                        Padding="12"
                                        Background="{DynamicResource BridgePanel}"
                                        BorderBrush="{DynamicResource BridgeHairline}"
                                        BorderThickness="1"
                                        Margin="0">
                                    <Border.Resources>
                                        <Style x:Key="NotificationSwitchStyle" TargetType="{x:Type CheckBox}">
                                            <Setter Property="Width" Value="44" />
                                            <Setter Property="Height" Value="22" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type CheckBox}">
                                                        <Border x:Name="SwitchTrack"
                                                                Background="{DynamicResource BridgePanel}"
                                                                BorderBrush="{DynamicResource BridgeStatusOff}"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                SnapsToDevicePixels="True">
                                                            <TextBlock x:Name="SwitchText"
                                                                       Text="OFF"
                                                                       Foreground="{DynamicResource BridgeInk2}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource BridgeSignalSurface}" />
                                                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BridgeStatusOk}" />
                                                                <Setter TargetName="SwitchText" Property="Text" Value="ON" />
                                                                <Setter TargetName="SwitchText" Property="Foreground" Value="{DynamicResource BridgeStatusOk}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource BridgeGround}" />
                                                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                                                <Setter TargetName="SwitchText" Property="Foreground" Value="{DynamicResource BridgeStatusOff}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="NotificationOptionBoxStyle" TargetType="{x:Type ComboBox}">
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="MinWidth" Value="96" />
                                            <Setter Property="local:SmoothWheelScrollBehavior.GuardsBackgroundWhileDropDownOpen" Value="True" />
                                            <Setter Property="Background" Value="{DynamicResource BridgeGround}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="MaxDropDownHeight" Value="180" />
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="{x:Type ComboBoxItem}">
                                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Background" Value="{DynamicResource BridgeGround}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                        <Setter Property="Padding" Value="9,6" />
                                                        <Setter Property="MinHeight" Value="28" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                                    <Border x:Name="ItemChrome"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{DynamicResource BridgeRowHairline}"
                                                                            BorderThickness="0,0,0,1"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                                            <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusInfo}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOff}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ComboBox}">
                                                        <Grid SnapsToDevicePixels="True">
                                                            <Border x:Name="ComboChrome"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <Grid>
                                                                    <ContentPresenter x:Name="ContentSite"
                                                                                      Margin="9,0,26,0"
                                                                                      IsHitTestVisible="False"
                                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                                      RecognizesAccessKey="True" />
                                                                    <Path x:Name="DropArrow"
                                                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                                                          Width="8"
                                                                          Height="4"
                                                                          Fill="{DynamicResource BridgeInk2}"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,10,0" />
                                                                </Grid>
                                                            </Border>
                                                            <ToggleButton x:Name="ToggleButton"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          OverridesDefaultStyle="True"
                                                                          Focusable="False"
                                                                          ClickMode="Press"
                                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                        <Border Background="Transparent" />
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <Popup x:Name="PART_Popup"
                                                                   AllowsTransparency="True"
                                                                   Focusable="False"
                                                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                   Placement="Bottom"
                                                                   PopupAnimation="Fade">
                                                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                                    <Border Background="{DynamicResource BridgePanel}"
                                                                            BorderBrush="{DynamicResource BridgeChipHairline}"
                                                                            BorderThickness="1"
                                                                            SnapsToDevicePixels="True">
                                                                        <ScrollViewer Background="{DynamicResource BridgePanel}"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      CanContentScroll="True"
                                                                                      local:SmoothWheelScrollBehavior.StopsWheelPropagation="True">
                                                                            <ScrollViewer.Resources>
                                                                                <Style TargetType="{x:Type ScrollBar}"
                                                                                       BasedOn="{StaticResource StarBridgeScrollBar}" />
                                                                            </ScrollViewer.Resources>
                                                                            <ItemsPresenter />
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                                <Setter TargetName="DropArrow" Property="Fill" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                                                <Setter TargetName="DropArrow" Property="Fill" Value="{DynamicResource BridgeStatusInfo}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource BridgeGround}" />
                                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOff}" />
                                                                <Setter TargetName="DropArrow" Property="Fill" Value="{DynamicResource BridgeStatusOff}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Border.Resources>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="通知与提醒"
                                                           Foreground="{DynamicResource BridgeStatusInfo}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="管理玩家动态通知和连续游玩提醒。"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Border x:Name="LegacyNotificationMailStatus"
                                                    Grid.Column="1"
                                                    Padding="10,7"
                                                    Background="{DynamicResource BridgePanel}"
                                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                                    BorderThickness="1"
                                                    Margin="12,0,0,0"
                                                    Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BridgeStatusOk}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="邮件提醒状态"
                                                                   Foreground="{DynamicResource BridgeInk3}"
                                                                   FontSize="10" />
                                                        <TextBlock>
                                                            <Run x:Name="NotificationMailStateText"
                                                                 Text="已启用"
                                                                 Foreground="{DynamicResource BridgeInk}"
                                                                 FontWeight="SemiBold" />
                                                            <Run Text=" · " Foreground="{DynamicResource BridgeInk3}" />
                                                            <Run x:Name="NotificationMailEmailText"
                                                                 Text="未绑定邮箱"
                                                                 Foreground="{DynamicResource BridgeInk2}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="NotificationMailLastText"
                                                                   Text="无"
                                                                   Foreground="{DynamicResource BridgeInk2}"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock x:Name="NotificationMailCooldownText"
                                                                   Text="无冷却"
                                                                   Foreground="{DynamicResource BridgeStatusWarn}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="LegacyNotificationSummaryPanel"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Height="34"
                                                    Padding="10,0"
                                                    Margin="0,8,0,0"
                                                    Background="{DynamicResource BridgePanel}"
                                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                                    BorderThickness="1"
                                                    Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
