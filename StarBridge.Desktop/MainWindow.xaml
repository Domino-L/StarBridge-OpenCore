                                                                    </StackPanel>
                                                                    <CheckBox x:Name="NotificationInAppCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Padding="0,5,0,5" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="浮层提醒" Foreground="{DynamicResource BridgeInk}" FontSize="12" FontWeight="SemiBold" />
