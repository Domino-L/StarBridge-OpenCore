            <Setter Property="Width" Value="94" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        </ResourceDictionary>
