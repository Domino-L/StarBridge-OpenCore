                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="Active">
                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.42" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
