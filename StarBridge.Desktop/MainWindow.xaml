                                                                        <TextBlock Text="同房间" Margin="6,0,0,0" Foreground="{DynamicResource BridgeInk2}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <Border Margin="0,8,0,0"
                                                                    Padding="11,9"
                                                                    Background="{DynamicResource BridgePanel}"
                                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="246" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="弹出位置" Foreground="{DynamicResource BridgeInk}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="使用当前显示器的安全区域，不会遮挡任务栏。" Margin="0,3,8,0" Foreground="{DynamicResource BridgeInk2}" FontSize="10.5" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="8" />
                                                                            <ColumnDefinition Width="78" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox x:Name="PlayerActivityNotificationPositionBox"
                                                                                  Height="30"
                                                                                  Style="{StaticResource NotificationOptionBoxStyle}"
