                                                            <Style TargetType="{x:Type ScrollBar}"
                                                                   BasedOn="{StaticResource StarBridgeScrollBar}" />
                                                        </ScrollViewer.Resources>
                                                        <ItemsControl x:Name="FleetEventLogList"
                                                                      Margin="10">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Style="{StaticResource ManageProfilePanel}"
                                                                            Margin="0,0,0,8"
                                                                            Padding="12,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="4" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="132" />
                                                                                <ColumnDefinition Width="96" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="76" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Style="{StaticResource StatusAccentStrip}"
                                                                                    Background="{Binding AccentBrush}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding TimestampText}"
                                                                                       Style="{StaticResource HudCaptionText}"
                                                                                       VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Column="3"
                                                                                        Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">
                                                                                <Ellipse Style="{StaticResource StatusDot}"
