                                                                    <TextBlock Text="舰队网址"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBox x:Name="ManageFleetWebsiteBox"
                                                                             Grid.Column="1"
                                                                             Height="32"
                                                                             Style="{StaticResource ManageProfileTextBox}"
                                                                             MaxLength="120"
                                                                             TextChanged="ManageProfileDraftChanged" />
                                                                </Grid>

                                                                <Grid x:Name="ManageFleetExternalContactsEditor"
