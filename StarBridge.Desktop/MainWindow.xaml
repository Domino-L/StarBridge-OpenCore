                                                Click="ResetFleetProfileDraftButton_Click" />
                                        <Button x:Name="ManageSaveChangesButton"
                                                Grid.Column="3"
                                                Content="保存更改"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="32"
                                                Click="SaveFleetProfileDraftButton_Click" />
