                                                    <ContextMenu Placement="Bottom"
                                                                 Style="{StaticResource StarBridgeContextMenu}"
                                                                 Background="{DynamicResource BridgePanelRaised}"
                                                                 BorderBrush="{DynamicResource BridgeHairline}"
                                                                 BorderThickness="1"
                                                                 StaysOpen="False">
                                                        <ContextMenu.ItemContainerStyle>
                                                            <Style TargetType="{x:Type MenuItem}">
                                                                <Setter Property="Focusable" Value="False" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                                                            <ContentPresenter ContentSource="Header" />
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ContextMenu.ItemContainerStyle>
                                                        <Border Padding="12,9" MaxWidth="300">
                                                            <StackPanel>
                                                                <TextBlock Text="舰船数据口径"
                                                                           Foreground="{DynamicResource BridgeInk}"
                                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="根据成员上传的官网机库汇总，仅展示已同步舰船。"
                                                                           Margin="0,5,0,0"
                                                                           Foreground="{DynamicResource BridgeInk2}"
                                                                           FontFamily="{DynamicResource BridgeCjkFont}"
                                                                           FontSize="12"
                                                                           MaxWidth="280"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <TextBlock Text="ⓘ"
                                                           Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>

                                            <Grid x:Name="FleetShipDatabaseSpecDistributionBar"
                                                  Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  Height="18"
                                                  VerticalAlignment="Center"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True" />

                                            <Grid x:Name="FleetShipDatabaseRoleDistributionBar"
                                                  Grid.Row="4"
                                                  Grid.ColumnSpan="2"
                                                  Height="18"
                                                  ClipToBounds="True"
                                                  SnapsToDevicePixels="True" />
                                        </Grid>

                                        <Border x:Name="FleetShipDatabasePreferredDispatchRow"
                                                Grid.Row="1"
                                                Margin="0,5,0,0"
                                                Padding="2,5,2,0"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="角色分布"
                                                           Style="{StaticResource FleetShipMetricLabel}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="可调度 / 全部"
                                                           Margin="7,0,0,0"
                                                           Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontFamily="{DynamicResource BridgeDataFont}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="首选出动"
                                                           Style="{StaticResource FleetShipMetricLabel}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="FleetShipDatabasePreferredDispatchText"
                                                           Grid.Column="4"
                                                           Margin="7,0,0,0"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontFamily="Microsoft YaHei UI"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="暂无在线可飞舰船"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        </Grid>
