                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="FleetShipSortPriceArrow"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="FleetShipSortOwnerArrow"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="FleetShipSortRoleArrow"
                                                           Visibility="Collapsed" />
