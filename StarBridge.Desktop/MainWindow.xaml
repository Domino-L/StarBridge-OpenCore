                                        <Button x:Name="PersonalProfileSaveButton"
                                                Content="保存主页"
                                                Height="30"
                                                MinWidth="92"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource PrimaryButton}"
                                                Visibility="Collapsed"
                                                Click="PersonalProfileSaveButton_Click" />
                                        <Popup x:Name="PersonalProfileModulePickerPopup"
                                               PlacementTarget="{Binding ElementName=PersonalProfileAddModuleButton}"
