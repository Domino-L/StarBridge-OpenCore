                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="在线状态" Foreground="#E6F1F8" FontWeight="SemiBold" /><TextBlock Text="显示你当前是否在线。" Foreground="#91A5B5" FontSize="10" /></StackPanel>
                                        <CheckBox x:Name="SyncChoiceOnlineCheck" Grid.Column="1" Style="{StaticResource SyncChoiceSwitchStyle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="12,9" Background="{StaticResource AvionicsGlassRaisedBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1,1,1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="当前飞船" Foreground="#E6F1F8" FontWeight="SemiBold" /><TextBlock Text="显示游戏日志识别到的飞船。" Foreground="#91A5B5" FontSize="10" /></StackPanel>
                                        <CheckBox x:Name="SyncChoiceShipCheck" Grid.Column="1" Style="{StaticResource SyncChoiceSwitchStyle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="12,9" Background="{StaticResource AvionicsGlassRaisedBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="当前位置" Foreground="#E6F1F8" FontWeight="SemiBold" /><TextBlock Text="显示识别到的位置摘要。" Foreground="#91A5B5" FontSize="10" /></StackPanel>
                                        <CheckBox x:Name="SyncChoiceLocationCheck" Grid.Column="1" Style="{StaticResource SyncChoiceSwitchStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <Border Padding="12,9" Background="{StaticResource AvionicsGlassRaisedBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1,1,1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="服务器信息" Foreground="#E6F1F8" FontWeight="SemiBold" /><TextBlock Text="显示所在服务器、区域和 PU 状态。" Foreground="#91A5B5" FontSize="10" /></StackPanel>
                                        <CheckBox x:Name="SyncChoiceServerCheck" Grid.Column="1" Style="{StaticResource SyncChoiceSwitchStyle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="12,9" Background="#151B22" BorderBrush="#6F5724" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="个人机库" Foreground="#F1D28A" FontWeight="SemiBold" /><TextBlock Text="向舰队舰船库共享你的机库摘要。默认关闭。" Foreground="#B8A77F" FontSize="10" /></StackPanel>
                                        <CheckBox x:Name="SyncChoiceHangarCheck" Grid.Column="1" Style="{StaticResource SyncChoiceSwitchStyle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="12,8" Background="{StaticResource AvionicsGlassPanelBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1,0,1,1">
                                    <TextBlock Text="不会同步 RSI 登录信息、邮箱、密码或 Game.log 文件内容。"
                                               Foreground="#7F95A4"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="可见范围"
                                           Foreground="#E6F1F8"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="范围只影响上方已开启的状态；指定成员名单可在同步与隐私设置中选择。"
                                           Margin="0,2,0,8"
                                           Foreground="#91A5B5"
                                           FontSize="10" />
                                <WrapPanel x:Name="SyncChoiceScopeHost">
                                    <RadioButton x:Name="SyncChoiceScopePrivateRadio" Content="仅自己" GroupName="SyncChoiceScope" Style="{StaticResource SyncChoiceScopeStyle}" />
                                    <RadioButton x:Name="SyncChoiceScopeAdminRadio" Content="管理员" GroupName="SyncChoiceScope" Style="{StaticResource SyncChoiceScopeStyle}" />
                                    <RadioButton x:Name="SyncChoiceScopeSpecifiedRadio" Content="指定成员" GroupName="SyncChoiceScope" Style="{StaticResource SyncChoiceScopeStyle}" />
                                    <RadioButton x:Name="SyncChoiceScopeFleetRadio" Content="全舰队" GroupName="SyncChoiceScope" Style="{StaticResource SyncChoiceScopeStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SyncChoiceFooterText"
                                       Text="之后可在“个人 > 同步与隐私”中修改。"
                                       Foreground="#637A89"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="取消"
