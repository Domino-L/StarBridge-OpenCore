                                                                                                          Margin="0,0,12,6" />
                                                                                                <CheckBox Content="发布行动"
                                                                                                          IsChecked="{Binding CanPublishTasks}"
                                                                                                          IsEnabled="False"
                                                                                                          Foreground="{StaticResource MutedTextBrush}"
                                                                                                          Margin="0,0,12,6" />
                                                                                                <CheckBox Content="创建预约"
                                                                                                          IsChecked="{Binding CanPublishPlans}"
                                                                                                          IsEnabled="False"
                                                                                                          Foreground="{StaticResource MutedTextBrush}"
                                                                                                          Margin="0,0,12,6" />
                                                                                            </WrapPanel>
                                                                                        </StackPanel>
                                                                                    </Border>

                                                                                    <Grid Margin="0,10,0,0">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Button Content="保存"
                                                                                                Height="30"
                                                                                                Tag="{Binding}"
                                                                                                Click="SaveFleetMemberPermission_Click">
                                                                                            <Button.Style>
                                                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding ShowSavePermissions}" Value="True">
                                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Button.Style>
                                                                                        </Button>
                                                                                        <Button Grid.Column="1"
                                                                                                Content="移除"
                                                                                                Height="30"
                                                                                                Margin="6,0,0,0"
