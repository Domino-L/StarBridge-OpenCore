                                                       Text="决定浮层显示什么内容，以及它如何跟随游戏窗口。"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14" />
                                            <TextBlock x:Name="OverlaySceneSourceLabel"
                                                       Text="内容场景"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
