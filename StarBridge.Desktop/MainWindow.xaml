                                                                                <TextBlock Text="{Binding Type}"
                                                                                           Foreground="{Binding AccentBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="4">
                                                                                <TextBlock Text="{Binding Title}"
                                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                                           FontWeight="SemiBold" />
