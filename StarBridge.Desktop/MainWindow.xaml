                                                                               FontSize="10.5"
                                                                               Width="96"
                                                                               Margin="0,0,8,0"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Right"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />

                                                                    <StackPanel Grid.Column="6"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Right"
