                                                                        </Border>
                                                                        <StackPanel>
                                                                            <TextBlock Text="当前行动"
                                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                                       FontSize="15"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBlock Text="有任务时切换为执行监控。"
                                                                                       Margin="0,4,0,0"
                                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                                       FontSize="11" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <StackPanel Grid.Row="1"
                                                                                Margin="0,16,0,0">
                                                                        <TextBlock x:Name="FleetCommandCurrentTaskTitleText"
                                                                                   Text="暂无当前行动"
                                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                                   FontSize="17"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock x:Name="FleetCommandCurrentTaskDetailText"
                                                                                   Margin="0,8,0,0"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   MaxHeight="42"
                                                                                   TextWrapping="Wrap"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Text="暂无当前行动，可以提醒成员预约，或创建新的行动。" />
                                                                        <StackPanel Visibility="Collapsed"
                                                                                    Height="0">
                                                                            <TextBlock x:Name="FleetCommandCurrentTaskMetaText" />
                                                                            <TextBlock x:Name="FleetCommandCurrentTaskNextText" />
                                                                            <TextBlock x:Name="FleetCommandCurrentTaskSourceText" />
                                                                            <TextBlock x:Name="FleetCommandCurrentTaskRecentText" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Button x:Name="FleetCommandCurrentTaskDetailButton"
                                                                            Grid.Row="2"
                                                                            Content="查看详情"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Height="28"
                                                                            MinWidth="84"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="0,12,0,0"
                                                                            Click="FleetCommandCurrentTaskDetailButton_Click" />
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Padding="14"
                                                                Margin="0,12,0,0"
                                                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="服务器状态"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               FontSize="15"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="显示当前可见成员所在的服务器。"
                                                                               Margin="0,4,0,0"
                                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="FleetCommandShardStateItems"
                                                                            Grid.Row="1"
                                                                            Margin="0,12,0,0" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Margin="0,12,0,0"
                                                                Padding="14"
                                                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="最近事件"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               FontSize="15"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="只看决定性行动变化。"
                                                                               Margin="0,4,0,0"
                                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="FleetCommandRecentEventItems"
                                                                            Grid.Row="1"
                                                                            Margin="0,12,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Margin="0,0,0,12"
                                                        Padding="12"
                                                        Background="{StaticResource AvionicsGlassPanelBrush}"
                                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="调度概况"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="资源只做快速判断，详细舰船仍进入舰船库。"
                                                                       Margin="12,2,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="FleetCommandDispatchItems"
                                                                    Grid.Row="1"
                                                                    Margin="0,10,0,0" />
                                                    </Grid>
                                                </Border>

                                                <Border Padding="14"
                                                        Background="{StaticResource AvionicsGlassPanelBrush}"
                                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="下一步建议"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="把当前态势转成可执行动作。"
                                                                       Margin="0,4,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="FleetCommandAdviceItems"
                                                                    Grid.Row="1"
                                                                    Margin="0,12,0,0" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="FleetShipDatabaseTab"
                                 Header="舰船">
                            <Border x:Name="FleetShipDatabaseSurface"
                                    Margin="0"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.Resources>
                                        <Style x:Key="FleetShipCardBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource BridgeDirectoryRowStyle}">
                                            <Setter Property="MinHeight" Value="88" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                        <Style x:Key="FleetShipTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectorySectionTitleStyle}">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    <Style x:Key="FleetShipCodeText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryAuxTextStyle}">
                                            <Setter Property="FontFamily" Value="{DynamicResource BridgeDataFont}" />
                                            <Setter Property="Margin" Value="0,3,0,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetShipMetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource BridgeDirectoryRaisedStyle}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="9,5" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="MinHeight" Value="32" />
                                        </Style>
                                        <Style x:Key="FleetShipPrimaryMetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource FleetShipMetricCard}">
                                            <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                            <Setter Property="MinWidth" Value="118" />
                                        </Style>
                                    <Style x:Key="FleetShipMetricLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryLabelStyle}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                        <Style x:Key="FleetShipMetricValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryValueTextStyle}">
                                            <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style x:Key="FleetShipBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource BridgeDirectoryTagChipStyle}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Padding" Value="7,1" />
                                            <Setter Property="Margin" Value="0,0,6,5" />
                                            <Setter Property="MinHeight" Value="20" />
                                        </Style>
                                    <Style x:Key="FleetShipBadgeText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryAuxTextStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetShipStatusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryAuxTextStyle}">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style x:Key="FleetShipPriceText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BridgeDirectoryValueTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeMetricInfo}" />
                                            <Setter Property="FontFamily" Value="{DynamicResource BridgeDataFont}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="MinWidth" Value="48" />
                                            <Setter Property="TextAlignment" Value="Right" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                        <Style x:Key="FleetShipSearchBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BridgeDirectoryTextBoxStyle}">
                                            <Setter Property="CaretBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                            <Setter Property="Padding" Value="11,0" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type TextBox}">
                                                        <Border x:Name="SearchChrome"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="2"
                                                                SnapsToDevicePixels="True">
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          Margin="{TemplateBinding Padding}"
                                                                          VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Setter TargetName="SearchChrome" Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    <Style x:Key="FleetShipToolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}">
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="ButtonChrome"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="2">
                                                            <Grid>
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                <Border x:Name="ActiveLine"
                                                                        Height="2"
                                                                        Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                        VerticalAlignment="Bottom"
                                                                        Opacity="0" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgePanel}" />
                                                            </Trigger>
                                                            <Trigger Property="Tag" Value="Active">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Setter TargetName="ActiveLine" Property="Opacity" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="FleetShipChipButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FleetShipToolButton}">
                                            <Setter Property="Height" Value="25" />
                                            <Setter Property="Padding" Value="8,0" />
                                            <Setter Property="Margin" Value="0,0,5,0" />
                                            <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                            <Setter Property="FontSize" Value="10.5" />
                                        </Style>
                                        <Style x:Key="FleetShipSortButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FleetShipToolButton}">
                                            <Setter Property="Height" Value="30" />
                                            <Setter Property="MinWidth" Value="126" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="Margin" Value="8,0,0,0" />
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                        </Style>
                                        <Style x:Key="FleetShipActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource FleetShipToolButton}">
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                        <Style x:Key="FleetShipSortMenuItem" TargetType="{x:Type MenuItem}">
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Padding" Value="12,6" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type MenuItem}">
                                                        <Border x:Name="MenuChrome"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                              ContentSource="Header"
                                                                              RecognizesAccessKey="True" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="MenuChrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid x:Name="FleetShipDatabaseCompactSummary">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <UniformGrid Grid.Column="0" Columns="4" Rows="1">
                                                <Border Style="{StaticResource FleetShipPrimaryMetricCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="数量" Style="{StaticResource FleetShipMetricLabel}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="FleetShipDatabaseCountText"
                                                                   Grid.Column="1"
                                                                   Text="0"
                                                                   Margin="7,0,0,0"
                                                                   Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                   FontFamily="{DynamicResource BridgeDataFont}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource FleetShipPrimaryMetricCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="舰队总价值" Style="{StaticResource FleetShipMetricLabel}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="FleetShipDatabaseTotalValueText"
                                                                   Grid.Column="1"
                                                                   Text="未公布"
                                                                   Margin="7,0,0,0"
                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                   FontFamily="{DynamicResource BridgeDataFont}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource FleetShipPrimaryMetricCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="舰船最多玩家"
                                                                   Style="{StaticResource FleetShipMetricLabel}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="FleetShipDatabaseTopOwnerText"
                                                                   Grid.Column="1"
                                                                   Text="-"
                                                                   Style="{StaticResource FleetShipMetricValue}"
                                                                   Margin="7,0,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource FleetShipPrimaryMetricCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="舰队王牌"
                                                                   Style="{StaticResource FleetShipMetricLabel}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="FleetShipDatabaseAceText"
                                                                   Grid.Column="1"
                                                                   Text="待评定"
                                                                   Style="{StaticResource FleetShipMetricValue}"
                                                                   Margin="7,0,0,0"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    </Grid>
                                                </Border>
                                            </UniformGrid>

                                            <Button x:Name="FleetShipDatabaseScopeInfo"
                                                    Grid.Column="1"
                                                    Width="30"
                                                    Height="32"
                                                    Margin="0"
                                                    Padding="0"
                                                    Style="{StaticResource FleetShipToolButton}"
                                                    Click="FleetShipDatabaseScopeInfo_Click">
