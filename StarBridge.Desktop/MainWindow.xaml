                                                                        Padding="10,8"
                                                                        Background="{StaticResource AvionicsGlassPanelBrush}"
                                                                        BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="2">
                                                                    <StackPanel>
                                                                        <TextBlock Text="开放预约" Style="{StaticResource HudCaptionText}" />
                                                                        <TextBlock x:Name="FleetCommandOpenPlansText"
