                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="旧版隐私选择"
                                                                                       Foreground="{StaticResource StatusWarningBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBlock x:Name="ManageLegacyPrivateExternalContactsText"
                                                                                       Text="这些旧版联系方式目前未公开。保存其他设置不会公开它们；请清空不希望公开的内容，或确认公开后再保存。"
                                                                                       Margin="0,4,12,0"
                                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                                       TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <Button x:Name="ConfirmLegacyPrivateExternalContactsButton"
                                                                                Grid.Column="1"
                                                                                Content="确认公开"
