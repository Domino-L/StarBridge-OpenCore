                                                      Style="{StaticResource OverlayOptionCheckStyle}"
                                                      Content="启动浮层时自动切换至游戏窗口"
                                                      Margin="0"
                                                      Checked="OverlaySetting_Changed"
                                                      Unchecked="OverlaySetting_Changed" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="OverlaySettingsSectionBackground"
                                            Grid.Row="2"
                                            Style="{StaticResource InformationOverlaySettingsSectionStyle}">
                                        <StackPanel>
                                             <TextBlock x:Name="OverlayDisplayBehaviorTitleText"
                                                        Text="跟随游戏"
                                                       Style="{StaticResource OverlaySettingsSectionTitleTextStyle}"
                                                       Margin="0,0,0,8" />
