                                            Height="44"
                                            Margin="8,0,0,0"
                                            Click="FleetCreateButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="FleetCreatePanel"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Panel.ZIndex="30"
                            Visibility="Collapsed"
                            Background="{StaticResource PageBackgroundBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <StackPanel Margin="42,34,42,42">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource BridgePanelRaised}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="ID"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CREATE FLEET"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="CreateFleetTitleText"
                                                   Text="创建舰队"
                                                   FontSize="27"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="CreateFleetSubtitleText"
                                                   Text="一次性确认舰队名称、识别码与公开展示资料。创建后名称与识别码不可在应用内修改。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="舰队标志" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="用于舰队信息栏、寻找舰队和后续展示页面。舰队视觉由标志、标签、活跃星系与活跃时间共同组成。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Width="94"
                                                        Height="94"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="ChooseFleetLogo_Click">
                                                    <Grid>
                                                        <Image x:Name="CreateFleetLogoImage" Stretch="UniformToFill" />
                                                        <TextBlock x:Name="CreateFleetLogoText"
                                                                   Text="LOGO"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="舰队标志"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="建议使用清晰方形图片。创建后仍可在基础资料中更换标志。"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Margin="0,5,0,12"
                                                               TextWrapping="Wrap" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="10" />
                                                            <ColumnDefinition Width="116" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="选择标志"
                                                                Height="30"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ChooseFleetLogo_Click" />
                                                        <Button Grid.Column="2"
                                                                Content="选择横幅"
                                                                Height="30"
                                                                Visibility="Collapsed"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ChooseFleetBanner_Click" />
                                                    </Grid>
                                                    <Border Height="46"
                                                            Margin="0,12,0,0"
                                                            BorderBrush="{DynamicResource BridgeChipHairline}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource BridgePanel}"
                                                            Visibility="Collapsed">
                                                        <Grid>
                                                            <Image x:Name="CreateFleetBannerImage"
                                                                   Stretch="UniformToFill"
                                                                   Opacity="0.82" />
                                                            <Rectangle Fill="{DynamicResource BridgeGround}" />
                                                            <TextBlock x:Name="CreateFleetBannerText"
                                                                       Text="未选择舰队横幅"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="12,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="舰队名称与识别" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                                            <TextBlock Text="参考 RSI 组织命名方式：名称用于展示，识别码用于链接、同步和浮层标识。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,14"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="舰队名称"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         x:Name="CreateFleetNameBox"
                                                         Height="34"
                                                         MaxLength="32"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="CreateFleetField_TextChanged" />
                                            </Grid>
                                            <TextBlock x:Name="CreateFleetNameHintText"
                                                       Text="4-32 位，只允许英文、数字、空格、短横线和下划线。创建后不可修改。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="104,-6,0,12"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="舰队识别码"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         x:Name="CreateFleetCodeBox"
                                                         Height="34"
                                                         MaxLength="10"
                                                         CharacterCasing="Upper"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="CreateFleetField_TextChanged" />
                                            </Grid>
                                            <TextBlock x:Name="CreateFleetCodeHintText"
                                                       Text="3-10 位，仅允许大写英文和数字，不允许空格。创建后用于邀请链接与服务器同步，不能随意更改。"
                                                       Foreground="{DynamicResource BridgeStatusWarn}"
                                                       Margin="104,-6,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="舰队介绍" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="用于展示舰队定位、招募方向和长期说明。没有填写时，对外显示“暂无舰队介绍”。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,10"
                                                       TextWrapping="Wrap" />
                                            <TextBox x:Name="CreateFleetIntroBox"
                                                     Height="118"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MaxLength="500" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="12,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="舰队标签" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="最多选择 5 个标签。后续会显示在寻找舰队与我的舰队信息中。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,12"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CreateFleetTagCountText"
                                                           Text="0 / 5"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        x:Name="CreateFleetEditTagsButton"
                                                        Content="编辑标签"
                                                        Height="28"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="CreateFleetEditTagsButton_Click" />
                                            </Grid>
                                            <ItemsControl x:Name="CreateFleetSelectedTagsList"
                                                          ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,6,6"
                                                                Padding="9,4"
                                                                Background="{Binding BackgroundBrush}"
                                                                BorderBrush="{Binding BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                ToolTip="{Binding TooltipText}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="4"
                                                                        Height="14"
                                                                        Background="{Binding AccentBrush}"
                                                                        CornerRadius="2"
                                                                        Margin="0,0,6,0" />
                                                                 <TextBlock Text="{Binding Name}"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="0,0,12,12">
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style x:Key="CreateFleetSystemCardCheckBox" TargetType="{x:Type CheckBox}">
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type CheckBox}">
                                                                <Border x:Name="Root"
                                                                        Background="{DynamicResource BridgePanelRaised}"
                                                                        BorderBrush="{DynamicResource BridgeChipHairline}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="2"
                                                                        MinHeight="152">
                                                                    <Grid>
                                                                        <ContentPresenter />
                                                                        <Border x:Name="SelectedMark"
                                                                                Width="22"
                                                                                Height="22"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                Margin="0,8,8,0"
                                                                                Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="11"
                                                                                Visibility="Collapsed">
                                                                            <TextBlock Text="✓"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                        <Setter TargetName="Root" Property="Background" Value="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                        <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </StackPanel.Resources>
                                            <TextBlock Text="主要活跃星系" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="选择舰队主要活跃星系。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,12"
                                                       TextWrapping="Wrap" />
                                            <UniformGrid Columns="3">
                                                <CheckBox x:Name="CreateFleetSystemStantonCheck"
                                                          Tag="stanton"
                                                          IsChecked="True"
                                                          Margin="0,0,10,0"
                                                          Style="{StaticResource CreateFleetSystemCardCheckBox}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="112" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border ClipToBounds="True"
                                                                Background="{DynamicResource BridgeRail}">
                                                            <Grid>
                                                                <Image Source="pack://siteoforigin:,,,/Assets/systems/stanton.png"
                                                                       Stretch="UniformToFill" />
                                                                <Border Background="{DynamicResource BridgeRail}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Row="1"
                                                                    Margin="10,8,10,10">
                                                            <TextBlock Text="斯坦顿"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center" />
                                                            <TextBlock Text="Stanton"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11"
                                                                       TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </CheckBox>
                                                <CheckBox x:Name="CreateFleetSystemPyroCheck"
                                                          Tag="pyro"
                                                          Margin="0,0,10,0"
                                                          Style="{StaticResource CreateFleetSystemCardCheckBox}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="112" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border ClipToBounds="True"
                                                                Background="{DynamicResource BridgeRail}">
                                                            <Grid>
                                                                <Image Source="pack://siteoforigin:,,,/Assets/systems/pyro.png"
                                                                       Stretch="UniformToFill" />
                                                                <Border Background="{DynamicResource BridgeRail}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Row="1"
                                                                    Margin="10,8,10,10">
                                                            <TextBlock Text="派罗"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center" />
                                                            <TextBlock Text="Pyro"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11"
                                                                       TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </CheckBox>
                                                <CheckBox x:Name="CreateFleetSystemNyxCheck"
                                                          Tag="nyx"
                                                          Style="{StaticResource CreateFleetSystemCardCheckBox}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="112" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border ClipToBounds="True"
                                                                Background="{DynamicResource BridgeRail}">
                                                            <Grid>
                                                                <Image Source="pack://siteoforigin:,,,/Assets/systems/nyx.png"
                                                                       Stretch="UniformToFill" />
                                                                <Border Background="{DynamicResource BridgeRail}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Row="1"
                                                                    Margin="10,8,10,10">
                                                            <TextBlock Text="尼克斯"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center" />
                                                            <TextBlock Text="Nyx"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="11"
                                                                       TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </CheckBox>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource HudPanel}"
                                            Padding="18"
                                            Margin="12,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="活动信息" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="创建时先设置默认活动时间。后续可在基础资料中添加更多时间段。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,12"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="舰队语言"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          x:Name="CreateFleetLanguageBox"
                                                          Height="34"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="默认时区"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1"
                                                          x:Name="CreateFleetTimeZoneBox"
                                                          Height="34"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Id"
                                                          SelectionChanged="CreateFleetField_SelectionChanged" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="活动时间"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         x:Name="CreateFleetOnlineFromBox"
                                                         Text="19:00"
                                                         Height="34"
                                                         MaxLength="5"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="CreateFleetField_TextChanged" />
                                                <TextBlock Grid.Column="2"
                                                           Text="至"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBox Grid.Column="3"
                                                         x:Name="CreateFleetOnlineToBox"
                                                         Text="22:00"
                                                         Height="34"
                                                         MaxLength="5"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="CreateFleetField_TextChanged" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource HudPanel}"
                                        Padding="18"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="招募与加入" Style="{StaticResource HudCaptionText}" FontSize="15" />
                                            <TextBlock Text="设置新成员如何加入。创建者会成为唯一舰队指挥官，其他玩家加入后默认是成员。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,4,0,12"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="CreateFleetJoinOpenRadio" Content="公开加入" Tag="Open" GroupName="FleetJoinPolicy" IsChecked="True" Margin="0,0,20,0" />
                                                <RadioButton x:Name="CreateFleetJoinApplicationRadio" Content="申请加入" Tag="Application" GroupName="FleetJoinPolicy" Margin="0,0,20,0" />
                                                <RadioButton x:Name="CreateFleetJoinInviteRadio" Content="仅邀请码" Tag="Invite" GroupName="FleetJoinPolicy" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource BridgeChipHairline}"
                                                BorderThickness="1"
                                                Background="{DynamicResource BridgePanel}"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="创建后不可回避的规则"
                                                           Foreground="{DynamicResource BridgeStatusWarn}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="舰队名称与识别码会用于同步与邀请链接。请在创建前确认拼写，后续应用内不提供修改入口。"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <CheckBox x:Name="CreateFleetOperationNoticeCheck"
                                          Visibility="Collapsed"
                                          IsChecked="False" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CreateFleetValidationText"
                                               Foreground="{DynamicResource BridgeStatusWarn}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="取消"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"
                                            Click="CreateFleetCancel_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="CreateFleetSubmitButton"
                                            Content="创建舰队"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0"
                                            Click="CreateFleetSubmit_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                    <controls:BridgeStatePresenter x:Name="FleetStartupBlockingState"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Panel.ZIndex="150"
                                                   Background="{DynamicResource BridgeGround}"
                                                   State="Loading"
                                                   ActionInvoked="StartupDataRetry_Click"
                                                   Visibility="Collapsed" />
                </Grid>
            </TabItem>

            <TabItem x:Name="MySquadTab" Header="组队大厅">
                <TabItem.Resources>
                    <Style x:Key="PartyLobbyTagChip"
                           TargetType="Border"
                           BasedOn="{StaticResource BridgeDirectoryTagChipStyle}">
                        <Setter Property="Padding" Value="8,3" />
                        <Setter Property="Margin" Value="0,0,6,4" />
                    </Style>
                    <DataTemplate x:Key="PartyLobbyDisplayTagTemplate">
                        <Border Style="{StaticResource PartyLobbyTagChip}"
                                Background="{Binding Background}"
                                BorderBrush="{Binding BorderBrush}">
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Foreground}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold" />
                        </Border>
                    </DataTemplate>
                    <Style x:Key="PartyRoomCreateComboBox"
                           TargetType="ComboBox"
                           BasedOn="{StaticResource BridgeDirectoryComboBoxStyle}">
                        <Setter Property="Height" Value="38" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                    <Style x:Key="PartyRoomTagColumnList" TargetType="ListBox">
                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="5" />
                        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                    <Style x:Key="PartyRoomTagColumnItem" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="11,9" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BridgeStatusInfo}" />
                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabItem.Resources>
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:AuthenticationRequiredView x:Name="PartyLobbyLoginRequiredPanel"
                                                      Grid.Row="0"
                                                      Grid.RowSpan="2"
                                                      Grid.Column="0"
                                                      Grid.ColumnSpan="2"
                                                      Panel.ZIndex="110"
                                                      Visibility="Collapsed"
                                                      Heading="登录后进入组队大厅"
                                                      Description="创建或加入临时房间，与好友和其他玩家组队、通讯并共享当前房间状态。"
                                                      FirstCapability="创建与加入房间"
                                                      SecondCapability="房间通讯"
                                                      ThirdCapability="好友邀请"
                                                      LoginRequested="LoginButton_Click" />

                    <Grid x:Name="PartyLobbyPage"
                          Grid.RowSpan="2"
                          Grid.ColumnSpan="2"
                          Panel.ZIndex="100"
                          Background="{StaticResource BridgeGround}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.Resources>
                            <Style x:Key="PartyLobbyFilterComboBox" TargetType="ComboBox" BasedOn="{StaticResource BridgeDirectoryComboBoxStyle}">
                                <Setter Property="Height" Value="36" />
                                <Setter Property="MinWidth" Value="112" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                            </Style>
                        </Grid.Resources>

                        <controls:ChamferBorder Style="{StaticResource BridgeDirectoryHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PartyLobbyTitleText"
                                               Text="组队大厅"
                                               Style="{StaticResource BridgePageTitleTextStyle}" />
                                    <TextBlock x:Name="PartyLobbySubtitleText"
                                               Text="寻找现在可以一起游玩的队友，或创建一支临时队伍。"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource BridgeAuxTextStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="PartyLobbyHeaderActionsPanel"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="PartyLobbyInvitationsButton"
                                            Content="房间邀请"
                                            Width="126"
                                            Height="36"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Click="PartyLobbyInvitations_Click" />
                                    <Button x:Name="PartyLobbyCodeButton"
                                            Content="输入房间码"
                                            Width="126"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Click="PartyLobbyCode_Click" />
                                     <Button x:Name="PartyLobbyCreateButton"
                                            Content="创建房间"
                                            Width="138"
                                            Height="36"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                             Click="PartyLobbyCreate_Click" />
                                </StackPanel>
                            </Grid>
                        </controls:ChamferBorder>

                        <controls:ChamferBorder Grid.Row="1"
                                Margin="0,10,0,0"
                                Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="36">
                                    <TextBox x:Name="PartyLobbySearchBox"
                                             VerticalContentAlignment="Center"
                                             PreviewMouseLeftButtonDown="EmptyPromptTextBox_PreviewMouseLeftButtonDown"
                                             TextChanged="PartyLobbySearchBox_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                   BasedOn="{StaticResource BridgeDirectoryTextBoxStyle}">
                                                <Setter Property="Padding" Value="12,0" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Padding" Value="34,0,12,0" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Path Data="{StaticResource BridgeIconSearch}"
                                               Width="14"
                                               Height="14"
                                               Stretch="Uniform"
                                               Stroke="{StaticResource BridgeInk3}"
                                               StrokeThickness="1.5"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0"
                                               IsHitTestVisible="False">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=PartyLobbySearchBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PartyLobbySearchBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="搜索房间名、目标、标签或房主"
                                               Foreground="{StaticResource BridgeInk3}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Margin" Value="26,0,12,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PartyLobbySearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=PartyLobbySearchBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PartyLobbySearchBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Margin" Value="34,0,12,0" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox x:Name="PartyLobbyActivityFilter"
                                          Grid.Column="1"
                                          Style="{StaticResource PartyLobbyFilterComboBox}"
                                          SelectedIndex="0"
                                          SelectionChanged="PartyLobbyFilter_SelectionChanged">
                                    <ComboBoxItem Content="全部玩法" Tag="" />
                                    <ComboBoxItem Content="战斗" Tag="combat" />
                                    <ComboBoxItem Content="工业" Tag="industry" />
                                    <ComboBoxItem Content="物流与贸易" Tag="logistics" />
                                    <ComboBoxItem Content="救援与支援" Tag="support" />
                                    <ComboBoxItem Content="探索与调查" Tag="exploration" />
                                    <ComboBoxItem Content="竞技场 AC" Tag="arena" />
                                    <ComboBoxItem Content="社交与休闲" Tag="social" />
                                    <ComboBoxItem Content="特殊任务与活动" Tag="special" />
                                </ComboBox>
                                <ComboBox x:Name="PartyLobbyVoiceFilter"
                                          Grid.Column="2"
                                          Style="{StaticResource PartyLobbyFilterComboBox}"
                                          SelectedIndex="0"
                                          SelectionChanged="PartyLobbyFilter_SelectionChanged">
                                    <ComboBoxItem Content="全部语音" Tag="" />
                                    <ComboBoxItem Content="不要求语音" Tag="none" />
                                    <ComboBoxItem Content="建议语音" Tag="recommended" />
                                    <ComboBoxItem Content="语音必须" Tag="required" />
                                </ComboBox>
                                <ComboBox x:Name="PartyLobbyAdmissionFilter"
                                          Grid.Column="3"
                                          Style="{StaticResource PartyLobbyFilterComboBox}"
                                          SelectedIndex="0"
                                          SelectionChanged="PartyLobbyFilter_SelectionChanged">
                                    <ComboBoxItem Content="全部加入方式" Tag="" />
                                    <ComboBoxItem Content="直接加入" Tag="direct" />
                                    <ComboBoxItem Content="需要批准" Tag="approval" />
                                </ComboBox>
                                <Button x:Name="PartyLobbyClearFiltersButton"
                                        Grid.Column="4"
                                        Content="清除筛选"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                        Click="PartyLobbyClearFilters_Click" />
                                <Button x:Name="PartyLobbyRefreshButton"
                                        Grid.Column="5"
                                        Content="刷新"
                                        Height="36"
                                        Width="82"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                        Click="PartyLobbyRefresh_Click" />
                            </Grid>
                        </controls:ChamferBorder>

                        <controls:DirectorySplitPanel Grid.Row="2"
                                                      Margin="0,10,0,0"
                                                      SidebarMinWidth="330"
                                                      Style="{StaticResource BridgeDirectorySplitPanelStyle}">

                            <controls:ChamferBorder controls:DirectorySplitPanel.Region="List"
                                    Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="38" />
                                    </Grid.RowDefinitions>

                                    <Border BorderBrush="{StaticResource BridgeRowHairline}"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,0">
                                        <Grid>
                                            <TextBlock x:Name="PartyLobbyListTitleText"
                                                       Text="全部房间"
                                                       Style="{StaticResource BridgeDirectorySectionTitleStyle}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <controls:BridgeLoadingIndicator x:Name="PartyLobbyRefreshLoadingIndicator"
                                                                                 Margin="0,0,7,0"
                                                                                 Visibility="Collapsed" />
                                                <TextBlock x:Name="PartyLobbyResultCountText"
                                                           Text="暂无可加入房间"
                                                           Foreground="{StaticResource BridgeInk3}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource BridgeDataFont}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="PartyLobbyRoomList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="10"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 SelectionChanged="PartyLobbyRoomList_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0"
                                                            Style="{StaticResource BridgeDirectoryRowStyle}"
                                                            Cursor="Hand">
                                                        <Grid MinHeight="126">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="190" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{Binding BeaconBrush}" />
                                                            <StackPanel Grid.Column="1" Margin="16,14,16,12">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{StaticResource BridgeInk}"
                                                                           FontSize="17"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding GoalDisplay}"
                                                                           Margin="0,6,0,0"
                                                                           Foreground="{StaticResource BridgeInk2}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <ItemsControl ItemsSource="{Binding DisplayTags}"
                                                                              ItemTemplate="{StaticResource BridgeDirectoryCategoryTagTemplate}"
                                                                              Margin="0,10,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <Border Grid.Column="2"
                                                                    BorderBrush="{StaticResource BridgeRowHairline}"
                                                                    BorderThickness="1,0,0,0"
                                                                    Padding="15,13">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding HostDisplay, StringFormat=房主：{0}}"
                                                                               Foreground="{StaticResource BridgeInk2}"
                                                                               FontSize="11.5"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding MemberCountText}"
                                                                               Margin="0,9,0,0"
                                                                               Foreground="{StaticResource BridgeInk}"
                                                                               FontFamily="{DynamicResource BridgeDataFont}"
                                                                               FontSize="14" />
                                                                    <TextBlock Text="{Binding VoiceRequirementText}"
                                                                               Margin="0,6,0,0"
                                                                               Foreground="{StaticResource BridgeInk2}"
                                                                               FontSize="11" />
                                                                    <TextBlock Text="{Binding AdmissionText}"
                                                                               Margin="0,5,0,0"
                                                                               Foreground="{StaticResource BridgeInk2}"
                                                                               FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <controls:BridgeStatePresenter x:Name="PartyLobbyRoomLoadingState"
                                                                       Panel.ZIndex="4"
                                                                       Background="{StaticResource BridgeGround}"
                                                                       State="Loading"
                                                                       TitleOverride="正在读取房间"
                                                                       DescriptionOverride="请稍候，房间列表正在同步。"
                                                                       Visibility="Collapsed" />

                                        <StackPanel x:Name="PartyLobbyRoomEmptyPanel"
                                                    Width="420"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Border Width="54"
                                                    Height="54"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                                <Path Data="{StaticResource BridgeIconSearch}"
                                                      Style="{StaticResource BridgeDirectoryEmptyIconStyle}" />
                                            </Border>
                                            <TextBlock x:Name="PartyLobbyRoomEmptyTitleText"
                                                       Text="当前没有可加入的房间"
                                                       Margin="0,16,0,0"
                                                       Foreground="{StaticResource BridgeInk}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="PartyLobbyRoomEmptyDetailText"
                                                       Text="可以调整搜索条件，或创建一个临时房间等待队友加入。"
                                                       Margin="0,7,0,0"
                                                       Foreground="{StaticResource BridgeInk2}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,18,0,0"
                                                        HorizontalAlignment="Center">
                                                <Button Content="清除筛选"
                                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                        Click="PartyLobbyClearFilters_Click" />
                                                 <Button Content="创建房间"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                         Click="PartyLobbyCreate_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            BorderBrush="{StaticResource BridgeRowHairline}"
                                            BorderThickness="0,1,0,0"
                                            Padding="16,0">
                                        <TextBlock Text="临时房间不会改变你的舰队成员关系。"
                                                   Foreground="{StaticResource BridgeInk3}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </controls:ChamferBorder>

                            <controls:ChamferBorder controls:DirectorySplitPanel.Region="Sidebar"
                                    Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                    Padding="18">
                                <Grid>
                                    <StackPanel x:Name="PartyLobbyPreviewEmptyPanel"
                                                Width="260"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="50"
                                                Height="50"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                            <Path Data="{StaticResource BridgeIconPreview}"
                                                  Style="{StaticResource BridgeDirectoryEmptyIconStyle}" />
                                        </Border>
                                        <TextBlock x:Name="PartyLobbyPreviewTitleText"
                                                   Text="房间预览"
                                                   Margin="0,14,0,0"
                                                   Foreground="{StaticResource BridgeInk}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="选择一个房间查看目标、成员与加入要求。"
                                                   Margin="0,7,0,0"
                                                   Foreground="{StaticResource BridgeInk2}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid x:Name="PartyLobbyPreviewContent" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PartyLobbyPreviewHintText"
                                                       Text="加入后进入房间"
                                                       Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                            <TextBlock Text="{Binding Title}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource BridgeInk}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GoalDisplay}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{StaticResource BridgeInk2}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding DisplayTags}"
                                                          ItemTemplate="{StaticResource BridgeDirectoryCategoryTagTemplate}"
                                                          Margin="0,12,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Border Grid.Row="1"
                                                Margin="0,16,0,0"
                                                BorderBrush="{StaticResource BridgeRowHairline}"
                                                BorderThickness="0,1,0,1"
                                                Padding="0,13">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Style="{StaticResource BridgeDirectoryFieldRowStyle}"
                                                            Margin="0">
                                                    <TextBlock Text="房主"
                                                               Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                    <TextBlock Text="{Binding HostDisplay}"
                                                               Style="{StaticResource BridgeDirectoryFieldPrimaryValueTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Style="{StaticResource BridgeDirectoryFieldRowStyle}"
                                                            Margin="24,0,0,0">
                                                    <TextBlock Text="成员"
                                                               Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                    <TextBlock Text="{Binding MemberCountText}"
                                                               Style="{StaticResource BridgeDirectoryFieldPrimaryValueTextStyle}"
                                                               FontFamily="{DynamicResource BridgeDataFont}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Margin="0,14,0,0"
                                                Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                            <StackPanel>
                                                <TextBlock Text="加入要求" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                                <TextBlock Text="{Binding AccessSummary}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource BridgeInk}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PasswordText}"
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource BridgeInk2}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Row="3" Margin="0,17,0,0">
                                            <TextBlock Text="成员预览" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                            <ItemsControl ItemsSource="{Binding Members}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="44"
                                                                Height="44"
                                                                Margin="0,0,7,7"
                                                                Style="{StaticResource UserAvatarButtonStyle}"
                                                                ToolTip="用户操作"
                                                                AutomationProperties.Name="打开用户操作"
                                                                Click="UserAvatarButton_Click">
                                                        <Border Width="42"
                                                                Height="42"
                                                                Background="{StaticResource BridgePanelRaised}"
                                                                BorderBrush="{StaticResource BridgeHairline}"
                                                                BorderThickness="1"
                                                                ToolTip="{Binding Callsign}">
                                                            <Grid>
                                                                <Image Source="{Binding AvatarImageData, Converter={StaticResource ImagePathConverter}}"
                                                                       Stretch="UniformToFill" />
                                                                <ContentControl Tag="{Binding AvatarImageData}"
                                                                                Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                            </Grid>
                                                        </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button x:Name="PartyLobbyJoinButton"
                                                Grid.Row="4"
                                                Content="申请加入"
                                                Height="40"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                Click="PartyLobbyJoin_Click" />
                                    </Grid>
                                </Grid>
                            </controls:ChamferBorder>
                        </controls:DirectorySplitPanel>

                        <Grid x:Name="PartyCurrentRoomPanel"
                              Grid.RowSpan="3"
                              Panel.ZIndex="150"
                              Visibility="Collapsed"
                              Background="{DynamicResource BridgeGround}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <controls:ChamferBorder Style="{StaticResource BridgeDirectoryHeaderStyle}"
                                                    Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BridgeStatusOk}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PartyCurrentRoomStatusText"
                                                       Text="房间开放中"
                                                       Margin="8,0,0,0"
                                                       Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BridgePageTitleTextStyle}" />
                                        <TextBlock Text="{Binding GoalDisplay}"
                                                   Margin="0,5,0,0"
                                                   Style="{StaticResource BridgeAuxTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Height="36"
                                                MinWidth="118"
                                                Padding="11,0"
                                                Background="{DynamicResource BridgePanelRaised}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="PartyCurrentRoomCodeText"
                                                       Text="房间码 ••••••"
                                                       Foreground="{DynamicResource BridgeInk}"
                                                       FontFamily="{DynamicResource BridgeDataFont}"
                                                       FontSize="{DynamicResource BridgeFontLabel}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Button x:Name="PartyCurrentRoomCodeVisibilityButton"
                                                Width="36"
                                                Height="36"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                ToolTip="显示房间码"
                                                Click="PartyCurrentRoomCodeVisibility_Click">
                                            <TextBlock x:Name="PartyCurrentRoomCodeVisibilityIcon"
                                                       Text="&#xE890;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" />
                                        </Button>
                                        <Button Width="36"
                                                Height="36"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                ToolTip="复制房间码"
                                                Click="PartyCurrentRoomCopyCode_Click">
                                            <TextBlock Text="&#xE8C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" />
                                        </Button>
                                        <Button x:Name="PartyCurrentRoomSettingsButton"
                                                Content="房间设置"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                Click="PartyCurrentRoomSettings_Click" />
                                        <Button x:Name="PartyCurrentRoomInviteFriendsButton"
                                                Content="邀请好友"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Visibility="Collapsed"
                                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                Click="PartyCurrentRoomInviteFriends_Click" />
                                        <Button Content="退出房间"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                Click="PartyCurrentRoomLeave_Click" />
                                        <Button x:Name="PartyCurrentRoomCloseButton"
                                                Content="关闭房间"
                                                Height="36"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                Foreground="{DynamicResource BridgeStatusBad}"
                                                BorderBrush="{DynamicResource BridgeStatusBad}"
                                                Click="PartyCurrentRoomClose_Click" />
                                    </StackPanel>
                                </Grid>
                            </controls:ChamferBorder>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" MinWidth="700" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <controls:ChamferBorder Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                                        Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="房间简报" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                            <ItemsControl ItemsSource="{Binding DisplayTags}"
                                                          ItemTemplate="{StaticResource PartyLobbyDisplayTagTemplate}"
                                                          Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border Grid.Row="1"
                                                Margin="0,15,0,15"
                                                Padding="0,12"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="0,1,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AccessSummary}" Foreground="{DynamicResource BridgeInk}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RecruitmentText}" Margin="0,6,0,0" Foreground="{DynamicResource BridgeInk2}" FontSize="{DynamicResource BridgeFontLabel}" />
                                                <TextBlock Text="{Binding ExpiresAtText}" Margin="0,4,0,0" Foreground="{DynamicResource BridgeInk2}" FontSize="{DynamicResource BridgeFontLabel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PartyCurrentRoomApplicationsPanel"
                                                Grid.Row="2"
                                                Visibility="Collapsed"
                                                Margin="0,0,0,15"
                                                Padding="12"
                                                Background="{DynamicResource BridgePanelRaised}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1"
                                                >
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="加入申请" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                                    <TextBlock Text="{Binding PendingApplicationCountText}"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                               FontSize="{DynamicResource BridgeFontLabel}" />
                                                </Grid>
                                                <ListBox x:Name="PartyCurrentRoomApplicationsList"
                                                         ItemsSource="{Binding PendingApplications}"
                                                         Margin="0,9,0,0"
                                                         MaxHeight="180"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         ItemContainerStyle="{StaticResource PassiveListBoxItemStyle}"
                                                         VirtualizingPanel.IsVirtualizing="True"
                                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                                         VirtualizingPanel.ScrollUnit="Pixel"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="54"
                                                                    Margin="0,0,0,6"
                                                                    Padding="8"
                                                                    Background="{DynamicResource BridgePanelRaised}"
                                                                    BorderBrush="{DynamicResource BridgeHairline}"
                                                                    BorderThickness="1"
                                                                    >
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="38" />
                                                                        <ColumnDefinition Width="10" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Width="38"
                                                                            Height="38"
                                                                            Style="{StaticResource UserAvatarButtonStyle}"
                                                                            ToolTip="打开用户操作"
                                                                            AutomationProperties.Name="打开申请人的用户操作"
                                                                            Click="UserAvatarButton_Click">
                                                                        <Border Background="{DynamicResource BridgePanel}"
                                                                                BorderBrush="{DynamicResource BridgeChipHairline}"
                                                                                BorderThickness="1"
                                                                                ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image Source="{Binding AvatarImageData, Converter={StaticResource ImagePathConverter}}"
                                                                                       Stretch="UniformToFill" />
                                                                                <ContentControl Tag="{Binding AvatarImageData}"
                                                                                                Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </Button>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   Foreground="{DynamicResource BridgeInk}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding SubmittedAtText}"
                                                                                   Margin="0,3,0,0"
                                                                                   Foreground="{DynamicResource BridgeInk2}"
                                                                                   FontSize="{DynamicResource BridgeFontLabel}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="拒绝"
                                                                                Height="30"
                                                                                Padding="12,0"
                                                                                Tag="{Binding ApplicationId}"
                                                                                CommandParameter="reject"
                                                                                Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                                                Click="PartyRoomApplicationDecision_Click" />
                                                                        <Button Content="批准"
                                                                                Height="30"
                                                                                Padding="14,0"
                                                                                Margin="7,0,0,0"
                                                                                Tag="{Binding ApplicationId}"
                                                                                CommandParameter="approve"
                                                                                Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                                                                Click="PartyRoomApplicationDecision_Click" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="全部成员" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                                <TextBlock Text="{Binding MemberCountText}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           FontFamily="{DynamicResource BridgeDataFont}" />
                                            </Grid>
                                            <ListBox x:Name="PartyCurrentRoomMembersList"
                                                     Grid.Row="1"
                                                     Margin="0,10,0,0"
                                                     ItemsSource="{Binding Members}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource PassiveListBoxItemStyle}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="PartyCurrentRoomMemberChrome"
                                                                Margin="0,0,0,7"
                                                                MinHeight="82"
                                                                Padding="12"
                                                                BorderThickness="1"
                                                                >
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Width="40"
                                                                        Height="40"
                                                                        VerticalAlignment="Top"
                                                                        Style="{StaticResource UserAvatarButtonStyle}"
                                                                        ToolTip="用户操作"
                                                                        AutomationProperties.Name="打开用户操作"
                                                                        Click="UserAvatarButton_Click">
                                                                <Border Width="38" Height="38"
                                                                        Background="{DynamicResource BridgePanel}"
                                                                        BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Image Source="{Binding AvatarImageData, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                                                        <ContentControl Tag="{Binding AvatarImageData}"
                                                                                        Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                    </Grid>
                                                                </Border>
                                                                </Button>
                                                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding Callsign}" Foreground="{DynamicResource BridgeInk}" FontSize="{DynamicResource BridgeFontBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding GameId}" Margin="0,3,0,0" Foreground="{DynamicResource BridgeInk2}" FontSize="{DynamicResource BridgeFontLabel}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                        <Ellipse Width="6" Height="6" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding PresenceText}" Margin="6,0,0,0" Foreground="{Binding PresenceBrush}" FontSize="{DynamicResource BridgeFontLabel}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Grid Grid.Column="2" Margin="0,0,12,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.9*" />
                                                                        <ColumnDefinition Width="1.45*" />
                                                                        <ColumnDefinition Width="1.6*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="1,0,0,0" Padding="11,1,7,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="服务器" Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding ShardText}" Margin="0,7,0,0" Foreground="{DynamicResource BridgeInk}" FontSize="{DynamicResource BridgeFontLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShardText}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Grid.Column="1" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="1,0,0,0" Padding="11,1,7,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="当前飞船" Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding ShipText}" Margin="0,7,0,0" Foreground="{DynamicResource BridgeInk}" FontSize="{DynamicResource BridgeFontLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShipText}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Grid.Column="2" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="1,0,0,0" Padding="11,1,7,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="当前位置" Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" />
                                                                            <TextBlock Text="{Binding LocationText}" Margin="0,7,0,0" Foreground="{DynamicResource BridgeInk}" FontSize="{DynamicResource BridgeFontLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocationText}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                                <Border Grid.Column="3" Padding="7,3" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeStatusOk}" BorderThickness="1" VerticalAlignment="Top">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="房主" Foreground="{DynamicResource BridgeStatusOk}" FontSize="{DynamicResource BridgeFontLabel}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </controls:ChamferBorder>

                                <Border x:Name="PartyRoomChatWorkspace"
                                        Grid.Column="2"
                                        Style="{StaticResource BridgeDirectorySeamSurfaceStyle}"
                                        Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="房间聊天" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                            <TextBlock x:Name="PartyRoomChatStatusText"
                                                       Text="房间内可见"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource BridgeInk3}"
                                                       FontSize="{DynamicResource BridgeFontAux}" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,12,0,12" Background="{DynamicResource BridgeGround}">
                                            <Border BorderBrush="{DynamicResource BridgeRowHairline}"
                                                    BorderThickness="0,1,0,1" />
                                            <StackPanel x:Name="PartyRoomChatEmptyPanel"
                                                        Width="320"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="50"
                                                        Height="50"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource BridgePanelRaised}"
                                                        BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="&#xE8BD;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="20"
                                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="尚无房间消息"
                                                           Margin="0,14,0,0"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="发送第一条消息，或等待成员加入动态。"
                                                           Margin="0,7,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ListBox x:Name="PartyRoomChatList"
                                                     Visibility="Collapsed"
                                                     Style="{StaticResource UnifiedChatMessageListStyle}" />
                                            <Border x:Name="PartyRoomChatHistoryStatusPanel"
                                                    Panel.ZIndex="4"
                                                    Margin="0,10,0,0"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource BridgePanelRaised}"
                                                    BorderBrush="{DynamicResource BridgeChipHairline}"
                                                    BorderThickness="1"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="PartyRoomChatHistoryStatusText"
                                                           Text="正在加载更早消息…"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="{DynamicResource BridgeFontAux}" />
                                            </Border>
                                            <Button x:Name="PartyRoomChatJumpToLatestButton"
                                                    Panel.ZIndex="4"
                                                    Content="回到最新"
                                                    Margin="0,0,14,12"
                                                    Padding="13,0"
                                                    Height="30"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Click="PartyRoomChatJumpToLatestButton_Click" />
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PartyRoomChatAttachmentButton"
                                                    Style="{StaticResource UnifiedChatAttachmentButtonStyle}"
                                                    Click="PartyRoomChatAttachmentButton_Click" />
                                            <TextBox x:Name="PartyRoomChatInputBox"
                                                     Grid.Column="1"
                                                     MaxLength="300"
                                                     Style="{StaticResource UnifiedChatComposerTextBoxStyle}"
                                                     ToolTip="Enter 发送；Shift+Enter 换行"
                                                     PreviewKeyDown="PartyRoomChatInput_KeyDown" />
                                            <Button x:Name="PartyRoomChatSendButton"
                                                    Grid.Column="2"
                                                    Content="发送"
                                                    Style="{StaticResource UnifiedChatSendButtonStyle}"
                                                    Click="PartyRoomChatSend_Click" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       Text="Enter 发送 · Shift+Enter 换行 · 最多 300 字"
                                                       Margin="1,8,0,0"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource BridgeInk3}"
                                                       FontFamily="{DynamicResource BridgeDataFont}"
                                                       FontSize="{DynamicResource BridgeFontAux}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border x:Name="PartyRoomJoinOverlay"
                                Grid.RowSpan="3"
                                Panel.ZIndex="190"
                                Visibility="Collapsed"
                                Background="{DynamicResource BridgeScrim}"
                                Padding="42,28">
                            <controls:ChamferBorder Width="560"
                                                    MaxHeight="720"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="22,18" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="加入临时房间"
                                                           Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                                <TextBlock Text="确认房间与加入要求后提交。"
                                                           Margin="0,5,0,0"
                                                           Style="{StaticResource BridgeDirectoryAuxTextStyle}" />
                                            </StackPanel>
                                            <Button Content="取消"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                    Click="PartyRoomJoinCancel_Click" />
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="22,20">
                                            <StackPanel x:Name="PartyRoomJoinCodePanel">
                                                <TextBlock Text="房间码" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
