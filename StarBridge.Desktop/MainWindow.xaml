                                        <Button x:Name="PersonalProfilePreviewButton"
                                                Content="预览访客视角"
                                                Height="30"
                                                MinWidth="104"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="PersonalProfilePreviewButton_Click" />
                                        <Button x:Name="PersonalProfileEditButton"
                                                Content="编辑主页"
                                                Height="30"
                                                MinWidth="92"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="PersonalProfileEditButton_Click" />
                                        <Button x:Name="PersonalProfileAddModuleButton"
