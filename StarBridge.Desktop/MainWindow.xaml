                                                         Height="40"
                                                         MaxLength="12"
                                                         Margin="0,13,0,0"
                                                         Padding="11,0"
                                                         VerticalContentAlignment="Center"
                                                         CharacterCasing="Upper"
                                                         Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel x:Name="PartyRoomJoinTargetPanel" Visibility="Collapsed">
                                                <TextBlock Text="已定位房间" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                                <Border Margin="0,12,0,0" Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BridgeDirectorySectionTitleStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding GoalDisplay}" Margin="0,6,0,0" Foreground="{DynamicResource BridgeInk2}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                                            <TextBlock Text="成员 " Foreground="{DynamicResource BridgeInk}" />
                                                            <TextBlock Text="{Binding MemberCountText, Mode=OneWay}" Foreground="{DynamicResource BridgeInk}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding AccessSummary}" Margin="0,5,0,0" Foreground="{DynamicResource BridgeInk}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding PasswordText}" Margin="0,5,0,0" Foreground="{DynamicResource BridgeInk2}" FontSize="{DynamicResource BridgeFontLabel}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel x:Name="PartyRoomJoinPasswordPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                                <TextBlock Text="房间密码" Style="{StaticResource BridgeDirectoryFieldLabelTextStyle}" Margin="0,0,0,6" />
                                                <PasswordBox x:Name="PartyRoomJoinPasswordBox"
                                                             Height="38"
                                                             MaxLength="32"
                                                             Padding="10,0"
                                                             VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" Padding="22,15" BorderBrush="{DynamicResource BridgeRowHairline}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <TextBlock x:Name="PartyRoomJoinValidationText"
                                                       Margin="0,0,175,0"
                                                       Foreground="{DynamicResource BridgeStatusBad}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <Button x:Name="PartyRoomJoinConfirmButton"
                                                    Content="查找房间"
