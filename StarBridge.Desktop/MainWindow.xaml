                                          Style="{StaticResource SyncChoiceSwitchStyle}"
                                          Checked="SyncChoiceMasterCheck_Changed"
                                          Unchecked="SyncChoiceMasterCheck_Changed" />
                            </Grid>
                        </Border>

                        <Grid x:Name="SyncChoiceOptionsHost"
                              Grid.Row="2"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0">
                                <Border Padding="12,9" Background="{StaticResource AvionicsGlassRaisedBrush}" BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}" BorderThickness="1,1,1,0">
