                                                                      Style="{StaticResource FleetShipSortMenuItem}" />
                                                            <MenuItem Header="价格"
                                                                      Tag="price"
                                                                      Click="FleetShipDatabaseSortHeader_Click"
                                                                      Style="{StaticResource FleetShipSortMenuItem}" />
                                                            <MenuItem Header="持有者"
                                                                      Tag="owner"
                                                                      Click="FleetShipDatabaseSortHeader_Click"
                                                                      Style="{StaticResource FleetShipSortMenuItem}" />
