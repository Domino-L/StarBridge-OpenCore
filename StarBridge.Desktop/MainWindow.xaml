                                                                   Text="未注册"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="OverlayHotkeyRegistrationHintText"
                                                       Text="系统启动后会显示热键注册结果。"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
