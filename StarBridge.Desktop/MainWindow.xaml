                        </controls:ChamferBorder>

                        <controls:ChamferBorder x:Name="OverlayInspectorPanel"
                                                Grid.Column="1"
                                                Padding="14"
                                                Margin="0,0,10,0"
                                                Chamfer="8"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeHairline}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="Collapsed"
                                                Panel.ZIndex="20">
                            <controls:ChamferBorder.Resources>
                                <Style x:Key="OverlayOptionCheckStyle"
                                       TargetType="{x:Type CheckBox}"
                                       BasedOn="{StaticResource InformationOverlaySettingsSwitchRowStyle}">
                                    <EventSetter Event="PreviewMouseLeftButtonDown"
                                                 Handler="OverlaySettingSwitch_PreviewMouseLeftButtonDown" />
                                </Style>
                            </controls:ChamferBorder.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="OverlayInspectorHeaderText"
                                                       Text="模块工作台"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Padding="7,3"
                                                    Margin="8,0,0,0"
                                                    Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                <TextBlock Text="实时预览"
                                                           Foreground="{DynamicResource BridgeInk}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="OverlayInspectorHintText"
                                                   Text="调整当前模块，右侧画面会立即显示结果。"
                                                   Foreground="{DynamicResource BridgeInk3}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,12,0" />
                                    </StackPanel>
                                    <Button x:Name="OverlayInspectorCloseButton"
                                            Grid.Column="1"
                                            MinWidth="108"
                                            Height="30"
                                            Padding="12,0"
                                            Content="返回设置"
                                            ToolTip="返回之前查看的设置"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="CloseOverlayInspector_Click" />
                                </Grid>

                                <Expander x:Name="OverlayInspectorModulePickerExpander"
                                          Grid.Row="1"
                                          IsExpanded="False"
                                          Margin="0,12,0,12"
                                          Style="{StaticResource InformationOverlayModulePrecisionExpanderStyle}">
                                    <Expander.Header>
                                        <Grid x:Name="OverlayInspectorStickyModuleHeader"
                                              MinHeight="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
