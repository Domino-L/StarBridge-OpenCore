                                                                        <CheckBox x:Name="PlayerActivityOfflineCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="PlayerActivityNotificationSetting_Changed" Unchecked="PlayerActivityNotificationSetting_Changed" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="4" Padding="10,8" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="开始游戏" Foreground="{DynamicResource BridgeInk}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <CheckBox x:Name="PlayerActivityGameStartCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="PlayerActivityNotificationSetting_Changed" Unchecked="PlayerActivityNotificationSetting_Changed" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="6" Padding="10,8" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="结束游戏" Foreground="{DynamicResource BridgeInk}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <CheckBox x:Name="PlayerActivityGameStopCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="PlayerActivityNotificationSetting_Changed" Unchecked="PlayerActivityNotificationSetting_Changed" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>

                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Padding="10,8" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="仅在后台时显示" Foreground="{DynamicResource BridgeInk}" FontSize="11" FontWeight="SemiBold" />
                                                                            <TextBlock Text="前台使用应用时不重复打扰。" Margin="0,2,8,0" Foreground="{DynamicResource BridgeInk3}" FontSize="10" />
                                                                        </StackPanel>
                                                                        <CheckBox x:Name="PlayerActivityBackgroundOnlyCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="PlayerActivityNotificationSetting_Changed" Unchecked="PlayerActivityNotificationSetting_Changed" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="2" Padding="10,8" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="游戏中减少通知" Foreground="{DynamicResource BridgeInk}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="浮层已显示的事件不再重复弹出。" Margin="0,2,8,0" Foreground="{DynamicResource BridgeInk3}" FontSize="10" />
                                                                        </StackPanel>
                                                                        <CheckBox x:Name="PlayerActivityReduceInGameCheck" Grid.Column="1" Style="{StaticResource NotificationSwitchStyle}" Checked="PlayerActivityNotificationSetting_Changed" Unchecked="PlayerActivityNotificationSetting_Changed" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>

                                                        <TextBlock x:Name="PlayerActivityNotificationStatusText"
                                                                   Grid.Row="3"
