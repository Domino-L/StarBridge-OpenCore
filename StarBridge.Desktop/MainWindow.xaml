                                    <Setter Property="FontSize" Value="{StaticResource BridgeFontAux}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource BridgeRailKeyboardFocusStyle}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="Chrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent"
                                                        BorderBrush="{StaticResource BridgeChipHairline}"
                                                        BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BridgeRowHover}" />
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BridgeInk3}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BridgeRowSelected}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.42" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FleetMembersSectionTitleText"
                                               Text="舰队成员"
                                               Style="{StaticResource FleetMembersPanelTitleStyle}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <StackPanel x:Name="FleetMembersHeaderActionsGrid"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="搜索成员"
                                                   Margin="0,0,8,0"
                                                   Style="{StaticResource FleetMembersLabelTextStyle}"
                                                   VerticalAlignment="Center" />
<TextBox x:Name="FleetMembersSearchBox"
                                                 Width="210"
                                                 Height="30"
                                                 Padding="10,0"
                                                 Margin="0,0,14,0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="输入呼号、游戏 ID、服务器、角色、飞船或地点"
                                                 TextChanged="FleetMembersSearchBox_TextChanged" />
                                        <Button x:Name="FleetMembersViewInviteButton"
                                                Content="查看邀请"
                                                Style="{StaticResource FleetMembersSecondaryButtonStyle}"
                                                Height="30"
                                                MinWidth="92"
                                                Margin="0,0,8,0"
                                                Visibility="Collapsed"
                                                Click="FleetMembersViewInviteButton_Click" />
                                        <Button x:Name="FleetMembersGenerateInviteButton"
                                                Content="生成邀请"
                                                Style="{StaticResource FleetMembersSecondaryButtonStyle}"
                                                Height="30"
                                                MinWidth="92"
                                                Margin="0,0,10,0"
                                                Visibility="Collapsed"
                                                Click="FleetMembersGenerateInviteButton_Click" />
                                        <Button x:Name="FleetMembersOverlayRosterButton"
                                                Content="浮层选人"
                                                Style="{StaticResource FleetMembersSecondaryButtonStyle}"
                                                Height="30"
                                                MinWidth="92"
                                                Margin="0,0,10,0"
                                                Click="OverlayRosterSelectionOpenButton_Click" />
                                        <TextBlock Text="全舰队成员名册"
                                                   Style="{StaticResource FleetMembersLabelTextStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Background="{StaticResource BridgeGround}">
                                    <Grid.Resources>
                                        <Style x:Key="FleetMemberCardBorder" TargetType="{x:Type Border}">
                                            <Setter Property="Height" Value="82" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="{StaticResource BridgePanel}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BridgeHairline}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="SnapsToDevicePixels" Value="True" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BridgeRowHover}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BridgeChipHairline}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style x:Key="FleetMemberHeaderText" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk3}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeCjkFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontLabel}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetMemberCallsignText" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeCjkFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontSceneName}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetMemberGameIdText" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk2}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeDataFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontLabel}" />
                                            <Setter Property="Margin" Value="0,3,0,0" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetMemberLabelText" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk3}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeCjkFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontLabel}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetMemberValueText" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeCjkFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontBody}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                        <Style x:Key="FleetMemberMoreButtonStyle" TargetType="{x:Type Button}">
                                            <Setter Property="Width" Value="24" />
                                            <Setter Property="Height" Value="24" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BridgeChipHairline}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource BridgeInk2}" />
                                            <Setter Property="FontFamily" Value="{StaticResource BridgeDataFont}" />
                                            <Setter Property="FontSize" Value="{StaticResource BridgeFontBody}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Opacity" Value="0.62" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="ButtonChrome"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              RecognizesAccessKey="True" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource BridgeRowHover}" />
                                                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BridgeInk3}" />
                                                                <Setter Property="Foreground" Value="{StaticResource BridgeInk}" />
                                                                <Setter Property="Opacity" Value="0.96" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource BridgePanel}" />
                                                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BridgeHairline}" />
                                                                <Setter Property="Foreground" Value="{StaticResource BridgeInk3}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="31" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="FleetMemberTableHeader"
                                            Grid.Row="0"
                                            BorderBrush="{StaticResource BridgeHairline}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!-- ColumnDefinition.Width is GridLength; do not inject the
                                                     Double scrollbar token here because WPF does not run a
                                                     type converter after StaticResource resolution. The
                                                     desktop contract test keeps this value numerically equal
                                                     to StarBridgeScrollBarWidth. -->
                                                <ColumnDefinition Width="10" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="FleetMemberHeaderColumns">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="1.55*" MinWidth="140" />
                                                <ColumnDefinition Width="0.85*" MinWidth="78" />
                                                <ColumnDefinition Width="0.9*" MinWidth="86" />
                                                <ColumnDefinition Width="1.1*" MinWidth="110" />
                                                <ColumnDefinition Width="1*" MinWidth="96" />
                                                <ColumnDefinition Width="0.7*" MinWidth="68" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="2" Text="成员" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
<TextBlock Grid.Column="3" Text="服务器" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="角色" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="5" Text="飞船" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="6" Text="位置" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="7" Text="状态" Style="{StaticResource FleetMemberHeaderText}">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="8" Text="操作" Style="{StaticResource FleetMemberHeaderText}" HorizontalAlignment="Right">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ScrollViewer x:Name="FleetMembersScrollViewer"
                                                      VerticalScrollBarVisibility="Visible"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ListBox x:Name="FleetMembersDeckList"
                                                     Margin="0,8,0,0"
                                                     HorizontalAlignment="Stretch"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     IsSynchronizedWithCurrentItem="True"
                                                     SelectionMode="Single"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     MouseLeave="FleetMembersDeckList_MouseLeave">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource FleetMemberCardBorder}"
                                                                HorizontalAlignment="Stretch"
                                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3" />
                                                                    <ColumnDefinition Width="58" />
                                                                    <ColumnDefinition Width="1.55*" MinWidth="140" />
                                                                    <ColumnDefinition Width="0.85*" MinWidth="78" />
                                                                    <ColumnDefinition Width="0.9*" MinWidth="86" />
                                                                    <ColumnDefinition Width="1.1*" MinWidth="110" />
                                                                    <ColumnDefinition Width="1*" MinWidth="96" />
                                                                    <ColumnDefinition Width="0.7*" MinWidth="68" />
                                                                    <ColumnDefinition Width="62" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border x:Name="FleetMemberInGameTint"
                                                                        Grid.ColumnSpan="9"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Style>
                                                                        <Style TargetType="{x:Type Border}">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="Opacity" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SharedPresence}" Value="InGame">
                                                                                    <Setter Property="Background" Value="{StaticResource BridgeStatusOk}" />
                                                                                    <Setter Property="Opacity" Value="0.08" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>

                                                                <Border Grid.Column="0"
                                                                        Background="{Binding SharedStatusBrush}" />

                                                                <Button Grid.Column="1"
                                                                        Width="50"
                                                                        Height="50"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Center"
                                                                        Style="{StaticResource UserAvatarButtonStyle}"
                                                                        ToolTip="用户操作"
                                                                        AutomationProperties.Name="打开用户操作"
                                                                        Click="UserAvatarButton_Click">
                                                                    <Grid Width="48"
                                                                          Height="48">
                                                                        <Border Background="{StaticResource BridgePanelRaised}"
                                                                                BorderBrush="{StaticResource BridgeChipHairline}"
                                                                                BorderThickness="1"
                                                                                ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image Source="{Binding AvatarPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                                                                <ContentControl Tag="{Binding AvatarPath}"
                                                                                                Style="{StaticResource IdentityBeaconAvatarFallbackStyle}" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>

                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="8,0,10,0">
                                                                    <TextBlock Text="{Binding Callsign}" Style="{StaticResource FleetMemberCallsignText}" />
                                                                    <TextBlock Text="{Binding GameId}" Style="{StaticResource FleetMemberGameIdText}" />
                                                                </StackPanel>

<TextBlock Grid.Column="3"
           Text="{Binding ServerRelationshipText}"
           Style="{StaticResource FleetMemberValueText}"
           Foreground="{StaticResource BridgeInk2}" />

                                                                <Border Grid.Column="4"
                                                                        MinHeight="23"
                                                                        MaxHeight="24"
                                                                        Padding="8,0"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="{x:Type Border}">
                                                                            <Setter Property="Background" Value="{x:Null}" />
                                                                            <Setter Property="BorderBrush" Value="{Binding RoleColorBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RoleColorBrush}" Value="{x:Null}">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource BridgeHairline}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Role}"
                                                                               FontFamily="{StaticResource BridgeCjkFont}"
                                                                               FontSize="{StaticResource BridgeFontLabel}"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="{x:Type TextBlock}">
                                                                                <Setter Property="Foreground" Value="{Binding RoleColorBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding RoleColorBrush}" Value="{x:Null}">
                                                                                        <Setter Property="Foreground" Value="{StaticResource BridgeInk2}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>

                                                                <TextBlock Grid.Column="5"
                                                                           Margin="0,0,10,0"
                                                                           Text="{Binding SharedShipDisplayText}"
                                                                           Style="{StaticResource FleetMemberValueText}"
                                                                           ToolTip="{Binding SharedShipDisplayText}" />

                                                                <TextBlock Grid.Column="6"
                                                                           Margin="0,0,10,0"
                                                                           Text="{Binding SharedLocationDisplayText}"
                                                                           Style="{StaticResource FleetMemberValueText}"
                                                                           ToolTip="{Binding SharedLocationDisplayText}" />

                                                                <TextBlock Grid.Column="7"
                                                                           Margin="0,0,8,0"
                                                                           Text="{Binding SharedPresenceText}"
                                                                           Foreground="{Binding SharedStatusBrush}"
                                                                           FontFamily="{StaticResource BridgeCjkFont}"
                                                                           FontSize="{StaticResource BridgeFontAux}"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" />

                                                                <StackPanel Grid.Column="8"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center">
                                                                    <Button Content="..."
                                                                            Style="{StaticResource FleetMemberMoreButtonStyle}"
                                                                            Visibility="{Binding MemberActionVisibility}"
                                                                            ToolTip="更多"
                                                                            Tag="{Binding}"
                                                                            Click="FleetMemberMoreButton_Click" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <StackPanel x:Name="FleetMembersEmptyPanel"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.Style>
                                                <Style TargetType="{x:Type StackPanel}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=FleetMembersDeckList}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock x:Name="FleetMembersSearchEmptyText"
                                                       Text="暂无舰队成员"
                                                       Foreground="{StaticResource BridgeInk}"
                                                       FontFamily="{StaticResource BridgeCjkFont}"
                                                       FontSize="{StaticResource BridgeFontSceneName}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="FleetMembersSearchEmptyDetailText"
                                                       Text="成员加入舰队后将在此显示。"
                                                       Foreground="{StaticResource BridgeInk3}"
                                                       FontFamily="{StaticResource BridgeCjkFont}"
                                                       FontSize="{StaticResource BridgeFontAux}"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <controls:ChamferBorder x:Name="FleetRightSidebarPanel"
                                                controls:DirectorySplitPanel.Region="Sidebar"
                                                Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                                Corners="BottomRight"
                                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="FleetTimelineSectionTitleText"
                                               Text="舰队时间线"
                                               Style="{StaticResource BridgeDirectorySectionTitleStyle}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="最新通讯与舰队事件按时间合并。"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid x:Name="FleetMemberTimelinePanel"
                                      Grid.Row="1"
                                      Margin="0,16,0,0">
                                    <Grid.Resources>
                                        <!-- Timeline categories reuse the shared semantic status palette. -->
                                        <Style x:Key="FleetTimelineCategoryLabelStyle"
                                               TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource BridgeDirectoryFieldLabelTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="人员">
                                                    <Setter Property="Foreground" Value="{DynamicResource BridgeStatusOk}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="公告">
                                                    <Setter Property="Foreground" Value="{DynamicResource BridgeStatusWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="小队">
                                                    <Setter Property="Foreground" Value="{DynamicResource BridgeSignal}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="通讯">
                                                    <Setter Property="Foreground" Value="{DynamicResource BridgeStatusInfo}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0"
                                                  Margin="0,0,0,12"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="FleetMemberTimelineList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BridgeDirectorySectionDividerStyle}"
                                                            Padding="0,10">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                                    <Border x:Name="FleetTimelineCategoryMarker"
                                                                    Grid.RowSpan="2"
                                                                    Width="4"
                                                                    HorizontalAlignment="Stretch">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="Background" Value="{DynamicResource BridgeStatusBad}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="人员">
                                                                                <Setter Property="Background" Value="{DynamicResource BridgeStatusOk}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="公告">
                                                                                <Setter Property="Background" Value="{DynamicResource BridgeStatusWarn}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="小队">
                                                                                <Setter Property="Background" Value="{DynamicResource BridgeSignal}" />
                                                                            </DataTrigger>
