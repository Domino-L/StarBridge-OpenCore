                                                               Foreground="{DynamicResource BridgeInk2}"
                                                               FontSize="10" />
                                                    <UniformGrid Columns="1" Rows="3">
                                                        <Button x:Name="PersonalProfilePickerFavoriteShipsButton" Tag="favorite-ships" Margin="0,0,0,6" Style="{StaticResource PersonalProfileModulePickerButtonStyle}" Click="PersonalProfileModulePickerItem_Click">
                                                            <StackPanel><TextBlock Text="最爱舰船" TextAlignment="Left" FontWeight="SemiBold" /><TextBlock Text="展示常用或最喜爱的舰船" Margin="0,3,0,0" TextAlignment="Left" Foreground="{DynamicResource BridgeInk2}" FontSize="10" /></StackPanel>
