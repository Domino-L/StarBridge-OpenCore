                                                <Border x:Name="PersonalConsoleActivityHangarItem" Height="30" Margin="0,7,0,0" Padding="9,0" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{Binding Fill, ElementName=PersonalActivityHangarDot}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=PersonalActivityHangarText}" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="同步" Foreground="{DynamicResource BridgeInk2}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
                                                <Border x:Name="PersonalConsoleActivityOverlayItem" Height="30" Margin="0,7,0,0" Padding="9,0" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{DynamicResource BridgeInk3}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="游戏浮层状态已更新" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="状态" Foreground="{DynamicResource BridgeInk2}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
                                                <Border x:Name="PersonalConsoleActivityConfigItem" Height="30" Margin="0,7,0,0" Padding="9,0" Background="{DynamicResource BridgePanel}" BorderBrush="{DynamicResource BridgeHairline}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="{DynamicResource BridgeStatusWarn}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="应用配置已保存" Foreground="{DynamicResource BridgeInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="本地" Foreground="{DynamicResource BridgeInk2}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SupportTab"
                     Header="帮助与反馈"
                     Visibility="Collapsed">
                <Grid Margin="0,14,0,0"
                      Background="{DynamicResource BridgeGround}">
                    <Grid.Resources>
                        <Style x:Key="HelpSupportRailSurfaceStyle"
                               TargetType="{x:Type controls:ChamferBorder}">
                            <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Chamfer" Value="16" />
                            <Setter Property="Corners" Value="TopLeft" />
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                        </Style>

                        <Style x:Key="HelpSupportContentSurfaceStyle"
                               TargetType="{x:Type controls:ChamferBorder}">
                            <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Chamfer" Value="16" />
                            <Setter Property="Corners" Value="BottomRight" />
                            <Setter Property="Padding" Value="24" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                        </Style>

                        <Style x:Key="HelpSupportSectionSurfaceStyle"
                               TargetType="{x:Type Border}"
                               BasedOn="{StaticResource BridgeDirectoryRaisedStyle}">
                            <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BridgeRowHairline}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="18" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="UseLayoutRounding" Value="True" />
                        </Style>

                        <Style x:Key="HelpSupportRailButtonStyle" TargetType="{x:Type Button}">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
                            <Setter Property="FontSize" Value="{DynamicResource BridgeFontBody}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource BridgeDirectoryKeyboardFocusStyle}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <controls:ChamferBorder x:Name="Chrome"
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Chamfer="6"
                                                                Corners="BottomRight">
                                            <Grid>
                                                <Border x:Name="Rail"
                                                        Width="2"
                                                        Margin="-14,7,0,7"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                                        Opacity="0" />
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True" />
                                            </Grid>
                                        </controls:ChamferBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="Active">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                <Setter TargetName="Rail" Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.42" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:ChamferBorder x:Name="HelpSupportRailSurface"
                                            Grid.Column="0"
                                            Style="{StaticResource HelpSupportRailSurfaceStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="帮助中心"
                                           Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                <TextBlock Text="按主题查找说明与支持"
                                           Margin="0,5,0,12"
                                           Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="HelpSupportGuideButton"
                                        Content="使用帮助"
                                        CommandParameter="guide"
                                        Style="{StaticResource HelpSupportRailButtonStyle}"
                                        Visibility="Collapsed" />
                                <Button x:Name="HelpSupportLogRecognitionButton"
                                        Content="游戏日志识别"
                                        CommandParameter="log-recognition"
                                        Style="{StaticResource HelpSupportRailButtonStyle}"
                                        Click="HelpSupportSectionButton_Click" />
                                <Button x:Name="HelpSupportPrivacyButton"
                                        Content="说明与声明"
                                        CommandParameter="privacy"
                                        Style="{StaticResource HelpSupportRailButtonStyle}"
                                        Click="HelpSupportSectionButton_Click" />
                                <Button x:Name="HelpSupportVersionButton"
                                        Content="更新与版本"
                                        CommandParameter="version"
                                        Style="{StaticResource HelpSupportRailButtonStyle}"
                                        Click="HelpSupportSectionButton_Click" />
                                <Button x:Name="HelpSupportFeedbackButton"
                                        Content="问题反馈"
                                        CommandParameter="feedback"
                                        Style="{StaticResource HelpSupportRailButtonStyle}"
                                        Click="HelpSupportSectionButton_Click" />
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       Text="说明与反馈无需登录即可查看。"
                                       Margin="6,12,6,4"
                                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </controls:ChamferBorder>

                    <ScrollViewer x:Name="HelpSupportScrollViewer"
                              Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <controls:ChamferBorder x:Name="HelpSupportContentSurface"
                                            Style="{StaticResource HelpSupportContentSurfaceStyle}"
                                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="按主题查看说明、版本状态与反馈入口。"
                                           Margin="0,0,24,0"
                                           Style="{StaticResource BridgeBodyTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button x:Name="HelpSupportBackToSettingsButton"
                                        Grid.Column="1"
                                        Width="112"
                                        Height="36"
                                        Content="打开设置"
                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                        VerticalAlignment="Top"
                                        Click="HelpSupportBackToSettingsButton_Click" />
                            </Grid>

                            <Border x:Name="HelpSupportGuideSection"
                                    Style="{StaticResource HelpSupportSectionSurfaceStyle}">
                                <StackPanel>
                                    <TextBlock Text="从这里开始"
                                               Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <TextBlock Text="选择你现在想完成的事情。每个入口都会直接带你前往对应位置。"
                                               Margin="0,7,0,16"
                                               Style="{StaticResource BridgeBodyTextStyle}"
                                               TextWrapping="Wrap" />

                                    <Button Height="32"
                                            Margin="0,0,0,12"
                                            HorizontalAlignment="Left"
                                            MinWidth="128"
                                            Content="继续新手引导"
                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                            Click="HelpGuideOnboardingButton_Click" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Padding="15,13"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="连接游戏日志"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1"
                                                           Text="选择 StarCitizen\LIVE\Game.log 后，应用才能识别游戏身份、舰船、地点和游戏状态。你也可以使用自动扫描快速查找。"
                                                           Margin="0,7,0,14"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19" />
                                                <Button Grid.Row="2"
                                                        Height="32"
                                                        Content="前往账号与识别"
                                                        Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                        Click="OpenPersonalIdentitySettings_Click" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Padding="15,13"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="账号与个人资料"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1"
                                                           Text="登录后可使用好友、舰队、房间和资料同步。个人资料用于向其他玩家展示你的身份、游玩时间和游戏定位。"
                                                           Margin="0,7,0,14"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Button x:Name="HelpGuideAccountButton"
                                                            MinWidth="112"
                                                            Height="32"
                                                            Content="登录或查看账号"
                                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                            Click="HelpGuideAccountButton_Click" />
                                                    <Button Height="32"
                                                            MinWidth="92"
                                                            Margin="8,0,0,0"
                                                            Content="个人资料"
                                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                            Click="PersonalNav_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Padding="15,13"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="主要功能"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1"
                                                           Text="寻找长期舰队、创建临时组队房间，或配置游戏浮层。顶部导航始终可以直接进入这些功能。"
                                                           Margin="0,7,0,14"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Button Height="32" MinWidth="88" Content="寻找舰队" Style="{StaticResource BridgeDirectorySecondaryButtonStyle}" Click="FindFleetNav_Click" />
                                                    <Button Height="32" MinWidth="88" Margin="8,0,0,0" Content="组队大厅" Style="{StaticResource BridgeDirectorySecondaryButtonStyle}" Click="MySquadNav_Click" />
                                                    <Button Height="32" MinWidth="88" Margin="8,0,0,0" Content="游戏浮层" Style="{StaticResource BridgeDirectorySecondaryButtonStyle}" Click="OverlayNav_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Grid.Column="2"
                                                Padding="15,13"
                                                Background="{DynamicResource BridgePanel}"
                                                BorderBrush="{DynamicResource BridgeRowHairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="遇到问题"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1"
                                                           Text="先查看应用状态与本地事件日志。仍无法解决时，可在问题反馈中说明发生时间和操作过程。"
                                                           Margin="0,7,0,14"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19" />
                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <Button Height="32"
                                                            MinWidth="112"
                                                            Content="诊断与维护"
                                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                            Click="HelpGuideDiagnosticsButton_Click" />
                                                    <Button Height="32"
                                                            MinWidth="92"
                                                            Margin="8,0,0,0"
                                                            Content="问题反馈"
                                                            Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                                                            Click="HelpGuideFeedbackButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="HelpSupportLogRecognitionSection"
                                    Visibility="Collapsed"
                                    Style="{StaticResource HelpSupportSectionSurfaceStyle}">
                                <Border.Resources>
                                    <Style x:Key="HelpLogSignalCardStyle"
                                           TargetType="{x:Type Border}">
                                        <Setter Property="Margin" Value="0,0,0,9" />
                                        <Setter Property="Padding" Value="15,13" />
                                        <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeRowHairline}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                    <Style x:Key="HelpLogDisclosureExpanderStyle"
                                           TargetType="{x:Type Expander}">
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Expander}">
                                                    <Border x:Name="LogDisclosureChrome"
                                                            Background="{DynamicResource BridgePanel}"
                                                            BorderBrush="{DynamicResource BridgeRowHairline}"
                                                            BorderThickness="1"
                                                            CornerRadius="2">
                                                        <StackPanel>
                                                            <ToggleButton x:Name="LogDisclosureToggle"
                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                          Background="Transparent"
                                                                          BorderThickness="0"
                                                                          Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                        <Border x:Name="LogDisclosureHeaderSurface"
                                                                                Padding="15,11"
                                                                                Background="Transparent">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="3" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="32" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border x:Name="LogDisclosureGuide"
                                                                                        Background="{DynamicResource BridgeChipHairline}" />
                                                                                <ContentPresenter Grid.Column="1"
                                                                                                  Margin="13,0,18,0"
                                                                                                  VerticalAlignment="Center"
                                                                                                  Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" />
                                                                                <TextBlock x:Name="LogDisclosureIndicator"
                                                                                           Grid.Column="2"
                                                                                           Text="＋"
                                                                                           Foreground="{DynamicResource BridgeInk2}"
                                                                                           FontFamily="{DynamicResource BridgeDataFont}"
                                                                                           FontSize="18"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="LogDisclosureHeaderSurface" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="LogDisclosureHeaderSurface" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                                                                                <Setter TargetName="LogDisclosureGuide" Property="Background" Value="{DynamicResource BridgeInk2}" />
                                                                                <Setter TargetName="LogDisclosureIndicator" Property="Text" Value="−" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="LogDisclosureHeaderSurface" Property="BorderBrush" Value="{DynamicResource BridgeInk2}" />
                                                                                <Setter TargetName="LogDisclosureHeaderSurface" Property="BorderThickness" Value="1" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <Border x:Name="LogDisclosureContent"
                                                                    Visibility="Collapsed"
                                                                    Padding="18,14,18,17"
                                                                    BorderBrush="{DynamicResource BridgeRowHairline}"
                                                                    BorderThickness="0,1,0,0">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="LogDisclosureContent" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="LogDisclosureChrome" Property="BorderBrush" Value="{DynamicResource BridgeChipHairline}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="HelpLogDetailRowStyle"
                                           TargetType="{x:Type Border}">
                                        <Setter Property="Margin" Value="0,0,0,7" />
                                        <Setter Property="Padding" Value="12,10" />
                                        <Setter Property="Background" Value="{DynamicResource BridgePanelRaised}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </Border.Resources>
                                <StackPanel>
                                    <TextBlock Text="游戏日志识别说明"
                                               Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <TextBlock Text="了解游戏内行为如何变成应用中的状态，以及信息没有及时更新时可以怎么处理。"
                                               Margin="0,7,0,14"
                                               Style="{StaticResource BridgeBodyTextStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="19" />

                                    <Border Margin="0,0,0,14"
                                            Padding="14,11"
                                            Background="{DynamicResource BridgePanelRaised}"
                                            BorderBrush="{DynamicResource BridgeChipHairline}"
                                            BorderThickness="1,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="只读取你选择的 Game.log"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="星海舰桥不会读取游戏内存、注入游戏或修改游戏文件。只有日志写出新的有效信息时，应用才会更新对应状态；没有新信息时会保留最近一次可靠结果。"
                                                       Foreground="{DynamicResource BridgeInk2}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="15,0,15,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="1.15*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="游戏中发生"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="星海舰桥如何识别"
