<UserControl x:Class="StarBridge.Desktop.ReportModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
             xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
             Focusable="True"
             Background="{DynamicResource BridgeGround}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ReportModerationQueueItemButton"
                   TargetType="Button"
                   BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="76" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="18" Background="{DynamicResource BridgeGround}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="查看举报内容、核对对象快照，并记录每次处理结果。"
                       VerticalAlignment="Center"
                       Style="{StaticResource BridgeBodyTextStyle}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="刷新"
                    Width="82"
                    Height="34"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="显示"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BridgeInk2}"
                       FontSize="11" />
            <ComboBox x:Name="QueueFilterComboBox"
                      Grid.Column="1"
                      Height="34"
                      Margin="10,0,0,0"
                      Style="{StaticResource BridgeDirectoryComboBoxStyle}"
                      SelectionChanged="QueueFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="全部举报" Tag="" IsSelected="True" />
                <ComboBoxItem Content="待审核" Tag="submitted" />
                <ComboBoxItem Content="审核中" Tag="reviewing" />
                <ComboBoxItem Content="已处理" Tag="actioned" />
                <ComboBoxItem Content="未发现违规" Tag="no_violation" />
            </ComboBox>
            <Border Grid.Column="3"
                    Padding="9,4"
                    Background="{DynamicResource BridgePanelRaised}"
                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    BorderThickness="1"
                    CornerRadius="2">
                <TextBlock x:Name="QueueCountText"
                           Text="0 条"
                           Foreground="{DynamicResource BridgeInk}"
                           FontSize="11"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="270" MaxWidth="440" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <controls:ChamferBorder Style="{StaticResource BridgeDirectorySurfaceStyle}" Padding="12">
                <Grid>
                    <ScrollViewer x:Name="QueueScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="QueueListPanel" />
                    </ScrollViewer>
                    <controls:BridgeStatePresenter x:Name="QueueStatePanel"
                                                   State="Loading"
                                                   TitleOverride="正在读取举报记录"
                                                   DescriptionOverride="正在获取最新审核队列。"
                                                   ActionTextOverride=""
                                                   Visibility="Collapsed" />
                </Grid>
            </controls:ChamferBorder>

            <controls:ChamferBorder Grid.Column="2" Style="{StaticResource BridgeDirectorySurfaceStyle}" Padding="16">
                <Grid>
                    <controls:BridgeStatePresenter x:Name="DetailStatePanel"
                                                   State="Empty"
                                                   TitleOverride="选择一条举报查看详情"
                                                   DescriptionOverride="审核内容会显示在这里。"
                                                   ActionTextOverride="" />

                    <ScrollViewer x:Name="DetailScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DetailTargetText"
                                               Foreground="{DynamicResource BridgeInk}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailMetaText"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="DetailStatusBadge"
                                        Grid.Column="1"
                                        Padding="9,4"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <TextBlock x:Name="DetailStatusText" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeHairline}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="举报内容"
                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailReasonText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource BridgeInk}"
                                               FontSize="12" />
                                    <TextBlock x:Name="DetailBodyText"
                                               Margin="0,7,0,0"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeHairline}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="举报对象快照"
                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailSnapshotText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="ShipImageEvidencePanel"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource BridgePanelRaised}"
                                    BorderBrush="{DynamicResource BridgeHairline}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="被举报的舰船图片"
                                               Foreground="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <Border Margin="0,9,0,0"
                                            Height="280"
                                            Background="{DynamicResource BridgeGround}"
                                            BorderBrush="{DynamicResource BridgeHairline}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:BridgeLoadingIndicator x:Name="ShipImageEvidenceLoadingIndicator"
                                                                                 Width="18"
                                                                                 Height="18"
                                                                                 HorizontalAlignment="Center" />
                                                <TextBlock x:Name="ShipImageEvidenceStatusText"
                                                           Text="正在读取图片"
                                                           Margin="0,7,0,0"
                                                           Foreground="{DynamicResource BridgeInk2}"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <Image x:Name="ShipImageEvidenceImage"
                                                   Stretch="Uniform"
                                                   SnapsToDevicePixels="True" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="请结合原图、举报说明和上下文进行判断。"
                                               Margin="0,7,0,0"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="9" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="审核证据快照"
                                       Margin="0,15,0,3"
                                       Foreground="{DynamicResource BridgeInk}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="EvidenceScopeText"
                                       Margin="0,0,0,7"
                                       Foreground="{DynamicResource BridgeInk2}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="EvidenceListPanel" />

                            <TextBlock Text="处理记录"
                                       Margin="0,15,0,7"
                                       Foreground="{DynamicResource BridgeInk}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="AuditListPanel" />

                            <TextBlock Text="已应用的账号处理"
                                       Margin="0,15,0,7"
                                       Foreground="{DynamicResource BridgeInk}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="SanctionListPanel" />

                            <controls:ChamferBorder Margin="0,15,0,0"
                                                    Padding="13"
                                                    Style="{StaticResource BridgeDirectorySurfaceStyle}">
                                <StackPanel>
                                    <TextBlock Text="更新处理状态"
                                               Foreground="{DynamicResource BridgeInk}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="用户只会看到处理状态和下方的公开说明；内部备注仅供审核人员查看。"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <ComboBox x:Name="ReviewStatusComboBox" Height="34" Margin="0,12,0,0" Style="{StaticResource BridgeDirectoryComboBoxStyle}">
                                        <ComboBoxItem Content="审核中" Tag="reviewing" IsSelected="True" />
                                        <ComboBoxItem Content="已处理" Tag="actioned" />
                                        <ComboBoxItem Content="未发现违规" Tag="no_violation" />
                                    </ComboBox>
                                    <StackPanel x:Name="ContentActionPanel" Visibility="Collapsed">
                                        <TextBlock Text="图片处理" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                        <ComboBox x:Name="ContentActionComboBox" Height="34" Style="{StaticResource BridgeDirectoryComboBoxStyle}">
                                            <ComboBoxItem Content="不处理图片" Tag="none" />
                                            <ComboBoxItem Content="下架并隔离图片" Tag="quarantine_ship_image" IsSelected="True" />
                                        </ComboBox>
                                        <TextBlock Text="图片下架后将不再公开展示，但会保留原图供复核与申诉使用。"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="账号处理" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                    <ComboBox x:Name="SanctionTypeComboBox"
                                              Height="34"
                                              Style="{StaticResource BridgeDirectoryComboBoxStyle}"
                                              SelectionChanged="SanctionTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="不新增账号处理" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="账号警告" Tag="warning" />
                                        <ComboBoxItem Content="限制消息发送" Tag="chat_mute" />
                                        <ComboBoxItem Content="暂停公开个人资料" Tag="profile_restriction" />
                                        <ComboBoxItem Content="限制创建组队房间" Tag="room_creation_restriction" />
                                        <ComboBoxItem Content="限制加入和邀请房间" Tag="room_participation_restriction" />
                                        <ComboBoxItem Content="限制创建、加入和邀请舰队" Tag="fleet_participation_restriction" />
                                        <ComboBoxItem Content="限制上传和更换舰船图片" Tag="ship_media_upload_restriction" />
                                        <ComboBoxItem Content="限制社交功能" Tag="social_restriction" />
                                        <ComboBoxItem Content="限制账号功能" Tag="account_restriction" />
                                    </ComboBox>
                                    <StackPanel x:Name="SanctionDurationPanel" Visibility="Collapsed">
                                        <TextBlock Text="持续时间（小时）" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                        <TextBox x:Name="SanctionDurationTextBox"
                                                 Height="34"
                                                 Text="24"
                                                 MaxLength="6"
                                                 Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                        <TextBlock Text="单项与社交限制需要填写时间；账号功能限制留空时，将持续到复核撤销。"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource BridgeInk2}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="用户可见说明" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                    <TextBox x:Name="OutcomeSummaryTextBox"
                                             MinHeight="58"
                                             MaxLength="500"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                    <TextBlock Text="内部备注" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                    <TextBox x:Name="InternalNoteTextBox"
                                             MinHeight="72"
                                             MaxLength="2000"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                    <Button x:Name="SaveReviewButton"
                                            Content="保存处理结果"
                                            Width="132"
                                            Height="34"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                            Click="SaveReviewButton_Click" />
                                </StackPanel>
                            </controls:ChamferBorder>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </controls:ChamferBorder>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:BridgeLoadingIndicator x:Name="OperationLoadingIndicator"
                                             Width="15"
                                             Height="15"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                       Text="处理结果会记录时间与审核人，保存前请再次确认。" />
        </Grid>
    </Grid>
</UserControl>
