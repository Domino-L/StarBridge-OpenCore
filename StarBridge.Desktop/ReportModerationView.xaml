<UserControl x:Class="StarBridge.Desktop.ReportModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{StaticResource PageBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="ReportModerationQueueItemButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="18" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRUST &amp; SAFETY"
                           Foreground="#61CAFF"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <TextBlock Text="举报审核"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="查看举报内容、核对对象快照，并记录每次处理结果。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Width="82"
                    Height="34"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryButton}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="显示"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" />
            <ComboBox x:Name="QueueFilterComboBox"
                      Grid.Column="1"
                      Height="34"
                      Margin="10,0,0,0"
                      SelectionChanged="QueueFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="全部举报" Tag="" IsSelected="True" />
                <ComboBoxItem Content="待审核" Tag="submitted" />
                <ComboBoxItem Content="审核中" Tag="reviewing" />
                <ComboBoxItem Content="已处理" Tag="actioned" />
                <ComboBoxItem Content="未发现违规" Tag="no_violation" />
            </ComboBox>
            <Border Grid.Column="3"
                    Padding="9,4"
                    Background="#102B3A"
                    BorderBrush="#28536B"
                    BorderThickness="1"
                    CornerRadius="2">
                <TextBlock x:Name="QueueCountText"
                           Text="0 条"
                           Foreground="#8FDFFF"
                           FontSize="11"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource HudPanel}" Padding="12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="QueueListPanel" />
                    </ScrollViewer>
                    <StackPanel x:Name="QueueLoadingPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressBar Width="180" Height="3" IsIndeterminate="True" />
                        <TextBlock Text="正在读取举报…"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource HudPanel}" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="选择一条举报查看详情"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" />

                    <ScrollViewer x:Name="DetailScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DetailTargetText"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailMetaText"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border x:Name="DetailStatusBadge"
                                        Grid.Column="1"
                                        Padding="9,4"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <TextBlock x:Name="DetailStatusText" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="12"
                                    Background="#091B27"
                                    BorderBrush="#234D63"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="举报内容"
                                               Foreground="#61CAFF"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailReasonText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="12" />
                                    <TextBlock x:Name="DetailBodyText"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Padding="12"
                                    Background="#091B27"
                                    BorderBrush="#234D63"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="举报对象快照"
                                               Foreground="#61CAFF"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailSnapshotText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="审核证据快照"
                                       Margin="0,15,0,3"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="EvidenceScopeText"
                                       Margin="0,0,0,7"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="EvidenceListPanel" />

                            <TextBlock Text="处理记录"
                                       Margin="0,15,0,7"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="AuditListPanel" />

                            <TextBlock Text="已应用的账号处理"
                                       Margin="0,15,0,7"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <StackPanel x:Name="SanctionListPanel" />

                            <Border Margin="0,15,0,0"
                                    Padding="13"
                                    Background="#0B2230"
                                    BorderBrush="#32637C"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="更新处理状态"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="用户只会看到处理状态和下方的公开说明；内部备注仅供审核人员查看。"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                    <ComboBox x:Name="ReviewStatusComboBox" Height="34" Margin="0,12,0,0">
                                        <ComboBoxItem Content="审核中" Tag="reviewing" IsSelected="True" />
                                        <ComboBoxItem Content="已处理" Tag="actioned" />
                                        <ComboBoxItem Content="未发现违规" Tag="no_violation" />
                                    </ComboBox>
                                    <TextBlock Text="账号处理" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <ComboBox x:Name="SanctionTypeComboBox"
                                              Height="34"
                                              SelectionChanged="SanctionTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="不新增账号处理" Tag="" IsSelected="True" />
                                        <ComboBoxItem Content="账号警告" Tag="warning" />
                                        <ComboBoxItem Content="限制消息发送" Tag="chat_mute" />
                                        <ComboBoxItem Content="暂停公开个人资料" Tag="profile_restriction" />
                                        <ComboBoxItem Content="限制创建组队房间" Tag="room_creation_restriction" />
                                        <ComboBoxItem Content="限制加入和邀请房间" Tag="room_participation_restriction" />
                                        <ComboBoxItem Content="限制创建、加入和邀请舰队" Tag="fleet_participation_restriction" />
                                        <ComboBoxItem Content="限制社交功能" Tag="social_restriction" />
                                        <ComboBoxItem Content="限制账号功能" Tag="account_restriction" />
                                    </ComboBox>
                                    <StackPanel x:Name="SanctionDurationPanel" Visibility="Collapsed">
                                        <TextBlock Text="持续时间（小时）" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                        <TextBox x:Name="SanctionDurationTextBox"
                                                 Height="34"
                                                 Text="24"
                                                 MaxLength="6" />
                                        <TextBlock Text="单项与社交限制需要填写时间；账号功能限制留空时，将持续到复核撤销。"
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="用户可见说明" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OutcomeSummaryTextBox"
                                             MinHeight="58"
                                             MaxLength="500"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="内部备注" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="InternalNoteTextBox"
                                             MinHeight="72"
                                             MaxLength="2000"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" />
                                    <Button x:Name="SaveReviewButton"
                                            Content="保存处理结果"
                                            Width="132"
                                            Height="34"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveReviewButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11"
                   Text="处理结果会记录时间与审核人，保存前请再次确认。" />
    </Grid>
</UserControl>
