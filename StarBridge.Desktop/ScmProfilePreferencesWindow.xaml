<Window x:Class="StarBridge.Desktop.ScmProfilePreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCM 资料偏好"
        Width="520"
        Height="390"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#07131B"
        Foreground="#E8F5FF"
        ShowInTaskbar="False">
    <Border Padding="24"
            BorderBrush="#32BFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="SCM 账号资料偏好"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,20"
                       Text="这些字段由 SCM 统一账号管理。浮层布局、日志路径和本机行为不会上传。"
                       Foreground="#93ADBE"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="语言" Margin="0,0,0,6" Foreground="#AFC5D4" />
                <ComboBox x:Name="LocaleBox"
                          Height="36"
                          Padding="10,4"
                          Background="#102A39"
                          Foreground="#E8F5FF" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="IANA 时区" Margin="0,0,0,6" Foreground="#AFC5D4" />
                <ComboBox x:Name="TimeZoneBox"
                          Height="36"
                          Padding="10,4"
                          IsEditable="False"
                          IsTextSearchEnabled="True"
                          Background="#102A39"
                          Foreground="#E8F5FF" />
                <TextBlock Margin="0,6,0,0"
                           Text="仅显示 SCM 当前启用的 IANA 时区；选择“未设置”会清除账号偏好。"
                           Foreground="#7993A5"
                           FontSize="11" />
            </StackPanel>

            <TextBlock x:Name="ValidationText"
                       Grid.Row="4"
                       Foreground="#FF6B79"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="96"
                        Height="36"
                        Margin="0,0,10,0"
                        Content="取消"
                        IsCancel="True" />
                <Button Width="112"
                        Height="36"
                        Content="保存到 SCM"
                        IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
