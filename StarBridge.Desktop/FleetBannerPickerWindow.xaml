<Window x:Class="StarBridge.Desktop.FleetBannerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择舰队横幅"
        Width="920"
        Height="660"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="{StaticResource PageBackgroundBrush}"
          Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="FLEET BANNER"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock Text="选择舰队横幅"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="先看顶部舰队信息栏效果，再选择或拖入横幅图片。推荐尺寸 1920×480。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource HudPanel}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="顶部信息栏预览"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="这里显示横幅作为舰队信息栏背景时的大致效果，文字覆盖区域会自动压暗。"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="10,5"
                            VerticalAlignment="Top"
                            Background="#0A1D2A"
                            BorderBrush="#27506A"
                            BorderThickness="1"
                            CornerRadius="2">
                        <TextBlock Text="背景强度 60%"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,14,0,0"
                        Height="210"
                        Background="{StaticResource AvionicsGlassPanelBrush}"
                        BorderBrush="#2B5F79"
                        BorderThickness="1"
                        CornerRadius="2"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewBannerImage"
                               Stretch="UniformToFill"
                               Opacity="0.60"
                               Visibility="Collapsed" />
                        <Rectangle x:Name="PreviewScrim"
                                   Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F006111A" Offset="0" />
                                    <GradientStop Color="#D8071621" Offset="0.48" />
                                    <GradientStop Color="#F006111A" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="尚未选择横幅"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="下方选择图片或直接拖入文件后，会先在这里预览。"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="18"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <Border Width="54"
                                    Height="54"
                                    BorderBrush="#2C607A"
                                    BorderThickness="1"
                                    Background="#0B1C27"
                                    CornerRadius="2">
                                <Grid>
                                    <Ellipse Stroke="#2D657F"
                                             StrokeThickness="1"
                                             Margin="10"
                                             Opacity="0.75" />
                                    <TextBlock Text="LOGO"
                                               Foreground="#7CD7FF"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="star citizen"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="sc"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                            </StackPanel>

                            <StackPanel Grid.Column="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="在线人数"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Text="1 / 1"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource StatusSuccessBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="5"
                                        VerticalAlignment="Center">
                                <TextBlock Text="舰船统计"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Text="6"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="星历"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Text="待填"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,14,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource HudPanel}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="选择图片"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="点击选择框或拖入横幅文件。应用前只会预览，不会修改原文件。"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border x:Name="BannerDropZone"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            MinHeight="150"
                            Background="#0A1A25"
                            BorderBrush="#2B5F79"
                            BorderThickness="1"
                            CornerRadius="2"
                            AllowDrop="True"
                            Cursor="Hand"
                            DragEnter="BannerDropZone_DragEnter"
                            DragLeave="BannerDropZone_DragLeave"
                            Drop="BannerDropZone_Drop"
                            MouseLeftButtonUp="BannerDropZone_MouseLeftButtonUp">
                        <Grid Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="54"
                                    Height="54"
                                    VerticalAlignment="Center"
                                    Background="#0D2634"
                                    BorderBrush="#3B7894"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <TextBlock Text="+"
                                           Foreground="#7CD7FF"
                                           FontSize="28"
                                           FontWeight="Light"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedFileNameText"
                                           Text="拖入横幅图片，或点击这里选择"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedFileStateText"
                                           Text="支持 PNG / JPG / BMP / WebP，推荐 1920×480。"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Content="选择图片"
                                    Width="116"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ChooseImage_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Padding="12,9"
                            Background="{StaticResource AvionicsGlassPanelBrush}"
                            BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="8"
                                    Height="8"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="4" />
                            <TextBlock Grid.Column="1"
                                       Text="安全区提示：横幅中间偏左和右侧会被舰队信息文字覆盖，建议不要把主体放在这些位置。"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource HudPanel}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="图片检查"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusText"
                                   Text="等待选择图片"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                        <Border Padding="10"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="当前尺寸"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock x:Name="ImageSizeText"
                                           Text="未选择"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Padding="10"
                                Margin="0,8,0,0"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="比例 / 大小"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock x:Name="RatioAndFileText"
                                           Text="推荐 4:1 / 1920×480"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Padding="10"
                                Margin="0,8,0,0"
                                Background="{StaticResource AvionicsGlassPanelBrush}"
                                BorderBrush="{StaticResource AvionicsGlassSoftEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <StackPanel>
                                <TextBlock Text="适配建议"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock x:Name="FitHintText"
                                           Text="选择一张宽幅图片后显示。"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="图片会复制到 StarBridge 本地资源目录，原文件不会被修改。"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PathText"
                       Text="未选择图片"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Content="取消"
                    Height="32"
                    Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click" />
            <Button Grid.Column="3"
                    x:Name="RestoreDefaultButton"
                    Content="恢复默认"
                    Height="32"
                    Style="{StaticResource SecondaryButton}"
                    Click="RestoreDefault_Click" />
            <Button Grid.Column="5"
                    x:Name="ApplyButton"
                    Content="应用横幅"
                    Height="32"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Click="Apply_Click" />
        </Grid>
    </Grid>
</Window>
