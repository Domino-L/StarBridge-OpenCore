<UserControl x:Class="StarBridge.Desktop.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{StaticResource PageBackgroundBrush}">
    <Grid Background="{StaticResource PageBackgroundBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NOTIFICATIONS"
                           Foreground="#61CAFF"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <TextBlock Text="通知中心"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="汇总需要你留意的好友申请、舰队与房间事项。实际处理仍在原页面完成。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button x:Name="MarkAllReadButton"
                        Content="全部标为已读"
                        Height="34"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="MarkAllReadButton_Click" />
                <Button Content="刷新"
                        Height="34"
                        MinWidth="76"
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NotificationsTabButton"
                    Content="通知"
                    Height="34"
                    MinWidth="92"
                    Style="{StaticResource PrimaryButton}"
                    Click="NotificationsTabButton_Click" />
            <Button x:Name="ReportsTabButton"
                    Grid.Column="1"
                    Content="我的举报"
                    Height="34"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="ReportsTabButton_Click" />
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Padding="9,4"
                        Background="#102B3A"
                        BorderBrush="#28536B"
                        BorderThickness="1"
                        CornerRadius="2">
                    <TextBlock x:Name="UnreadSummaryText"
                               Text="未读 0"
                               Foreground="#8FDFFF"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ActionSummaryBadge"
                        Margin="8,0,0,0"
                        Padding="9,4"
                        Background="#38251B"
                        BorderBrush="#A86E2E"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ActionSummaryText"
                               Text="待处理 0"
                               Foreground="#FFC56B"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource HudPanel}"
                Padding="14">
            <Grid>
                <ScrollViewer x:Name="NotificationsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotificationsListPanel" />
                </ScrollViewer>

                <ScrollViewer x:Name="ReportsScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ReportsListPanel" />
                </ScrollViewer>

                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar Width="220" Height="3" IsIndeterminate="True" />
                    <TextBlock Text="正在读取通知…"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11"
                   Text="通知只用于提醒和跳转，不会替代原页面的处理功能。" />
    </Grid>
</UserControl>
