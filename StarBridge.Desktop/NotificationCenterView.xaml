<UserControl x:Class="StarBridge.Desktop.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
             xmlns:theming="clr-namespace:StarBridge.Desktop.Theming"
             Focusable="True"
             Background="{DynamicResource BridgeGround}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}" />

            <Style x:Key="NotificationCenterTabStyle"
                   TargetType="{x:Type ToggleButton}"
                   BasedOn="{StaticResource BridgeSectionTabStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="Transparent">
                            <controls:ChamferBorder x:Name="Surface"
                                                    Background="{TemplateBinding Background}"
                                                    Chamfer="7"
                                                    Corners="Signature" />
                            <controls:ChamferBorder x:Name="HoverLayer"
                                                    Background="{DynamicResource BridgeRowHover}"
                                                    Chamfer="7"
                                                    Corners="Signature"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                            <controls:ChamferBorder x:Name="SelectedLayer"
                                                    Background="{Binding Path=(theming:BridgeSceneContext.AmbientBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    Chamfer="7"
                                                    Corners="Signature"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="SelectedEdge"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <controls:ChamferBorder x:Name="FocusLayer"
                                                    Background="Transparent"
                                                    BorderBrush="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    BorderThickness="1"
                                                    Chamfer="7"
                                                    Corners="Signature"
                                                    Opacity="0"
                                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedLayer" Property="Opacity" Value="0.72" />
                                <Setter TargetName="SelectedEdge" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68" />
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18"
          Background="{DynamicResource BridgeGround}"
          UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="NotificationsTabButton"
                              Content="通知"
                              Style="{StaticResource NotificationCenterTabStyle}"
                              Click="NotificationsTabButton_Click" />
                <ToggleButton x:Name="ReportsTabButton"
                              Content="我的举报"
                              Style="{StaticResource NotificationCenterTabStyle}"
                              Click="ReportsTabButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="12,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border x:Name="UnreadSummaryBadge"
                        Margin="0,0,8,0"
                        Style="{StaticResource BridgeCountBadgeStyle}"
                        Visibility="Visible">
                    <TextBlock x:Name="UnreadSummaryText"
                               Text="未读 0"
                               Style="{StaticResource BridgeCountBadgeTextStyle}" />
                </Border>
                <Border x:Name="ActionSummaryBadge"
                        Style="{StaticResource BridgeCountBadgeStyle}"
                        Background="{DynamicResource BridgePanelRaised}"
                        BorderBrush="{DynamicResource BridgeStatusWarn}">
                    <TextBlock x:Name="ActionSummaryText"
                               Text="待处理 0"
                               Style="{StaticResource BridgeCountBadgeTextStyle}"
                               Foreground="{DynamicResource BridgeStatusWarn}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="MarkAllReadButton"
                        Content="全部标为已读"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="MarkAllReadButton_Click" />
                <Button Content="刷新"
                        MinWidth="76"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <controls:ChamferBorder Grid.Row="1"
                                Padding="14"
                                Background="{DynamicResource BridgePanel}"
                                BorderBrush="{DynamicResource BridgeHairline}"
                                BorderThickness="1"
                                Chamfer="8"
                                Corners="Signature">
            <Grid>
                <ScrollViewer x:Name="NotificationsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotificationsListPanel" />
                </ScrollViewer>

                <ScrollViewer x:Name="ReportsScrollViewer"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ReportsListPanel" />
                </ScrollViewer>

                <controls:BridgeStatePresenter x:Name="LoadingPanel"
                                               Panel.ZIndex="2"
                                               State="Loading"
                                               TitleOverride="正在读取通知"
                                               ActionTextOverride=""
                                               Visibility="Collapsed" />
            </Grid>
        </controls:ChamferBorder>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                   Text="通知只用于提醒和跳转，实际处理仍在原页面完成。" />
    </Grid>
</UserControl>
