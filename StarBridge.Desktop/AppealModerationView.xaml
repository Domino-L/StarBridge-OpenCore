<UserControl x:Class="StarBridge.Desktop.AppealModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{StaticResource PageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="申诉审核"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="复核账号处理、申诉理由与审核记录，并向用户提供明确结果。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Width="82"
                    Height="34"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryButton}"
                    Click="RefreshButton_Click" />
        </Grid>

        <ComboBox x:Name="QueueFilterComboBox"
                  Grid.Row="1"
                  Width="210"
                  Height="34"
                  Margin="0,15,0,12"
                  HorizontalAlignment="Left"
                  SelectionChanged="QueueFilterComboBox_SelectionChanged">
            <ComboBoxItem Content="全部申诉" Tag="" IsSelected="True" />
            <ComboBoxItem Content="待审核" Tag="submitted" />
            <ComboBoxItem Content="审核中" Tag="reviewing" />
            <ComboBoxItem Content="已通过" Tag="accepted" />
            <ComboBoxItem Content="审核完成" Tag="denied" />
        </ComboBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource HudPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="QueueListPanel" />
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource HudPanel}" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetailText"
                               Text="选择一条申诉查看详情"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" />
                    <ScrollViewer x:Name="DetailScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailMetaText"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,14,0,0" Padding="12" Background="#091B27" BorderBrush="#234D63" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="申诉理由" Foreground="#61CAFF" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AppealDetailsText" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,9,0,0" Padding="12" Background="#091B27" BorderBrush="#234D63" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="原处理" Foreground="#61CAFF" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SanctionDetailsText" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="审核记录" Margin="0,14,0,7" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="AuditListPanel" />
                            <Border Margin="0,15,0,0" Padding="13" Background="#0B2230" BorderBrush="#32637C" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="更新申诉结果" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <ComboBox x:Name="ReviewStatusComboBox" Height="34" Margin="0,11,0,0">
                                        <ComboBoxItem Content="审核中" Tag="reviewing" IsSelected="True" />
                                        <ComboBoxItem Content="通过并撤销原处理" Tag="accepted" />
                                        <ComboBoxItem Content="维持原处理" Tag="denied" />
                                    </ComboBox>
                                    <TextBlock Text="用户可见说明" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="OutcomeSummaryTextBox" MinHeight="58" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="内部备注" Margin="0,11,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                                    <TextBox x:Name="InternalNoteTextBox" MinHeight="64" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                    <Button x:Name="SaveReviewButton"
                                            Content="保存申诉结果"
                                            Width="132"
                                            Height="34"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveReviewButton_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11"
                   Text="通过申诉会立即撤销原处理，请在保存前核对完整记录。" />
    </Grid>
</UserControl>
