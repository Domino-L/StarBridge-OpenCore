<UserControl x:Class="StarBridge.Desktop.AppealModerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
             Focusable="True"
             Background="{DynamicResource BridgeGround}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Bridge/Shell.xaml" />
                <ResourceDictionary Source="Themes/Bridge/Directory.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button"
                   BasedOn="{StaticResource BridgeDirectorySecondaryButtonStyle}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="复核账号处理、申诉理由与审核记录，并向用户提供明确结果。"
                       VerticalAlignment="Center"
                       Style="{StaticResource BridgeBodyTextStyle}"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Content="刷新"
                    Width="82"
                    Height="34"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BridgeDirectorySecondaryButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <ComboBox x:Name="QueueFilterComboBox"
                  Grid.Row="1"
                  Width="210"
                  Height="34"
                  Margin="0,15,0,12"
                  HorizontalAlignment="Left"
                  Style="{StaticResource BridgeDirectoryComboBoxStyle}"
                  SelectionChanged="QueueFilterComboBox_SelectionChanged">
            <ComboBoxItem Content="全部申诉" Tag="" IsSelected="True" />
            <ComboBoxItem Content="待审核" Tag="submitted" />
            <ComboBoxItem Content="审核中" Tag="reviewing" />
            <ComboBoxItem Content="已通过" Tag="accepted" />
            <ComboBoxItem Content="审核完成" Tag="denied" />
        </ComboBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="250" MaxWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <controls:ChamferBorder Style="{StaticResource BridgeDirectorySurfaceStyle}" Padding="12">
                <Grid>
                    <ScrollViewer x:Name="QueueScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="QueueListPanel" />
                    </ScrollViewer>
                    <controls:BridgeStatePresenter x:Name="QueueStatePanel"
                                                   State="Loading"
                                                   TitleOverride="正在读取申诉记录"
                                                   DescriptionOverride="正在获取最新审核队列。"
                                                   ActionTextOverride=""
                                                   Visibility="Collapsed" />
                </Grid>
            </controls:ChamferBorder>
            <controls:ChamferBorder Grid.Column="2"
                                    Style="{StaticResource BridgeDirectorySurfaceStyle}"
                                    Padding="16">
                <Grid>
                    <controls:BridgeStatePresenter x:Name="DetailStatePanel"
                                                   State="Empty"
                                                   TitleOverride="选择一条申诉查看详情"
                                                   DescriptionOverride="审核内容会显示在这里。"
                                                   ActionTextOverride="" />
                    <ScrollViewer x:Name="DetailScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText"
                                       Style="{StaticResource BridgeDirectorySectionTitleStyle}"
                                       FontSize="19" />
                            <TextBlock x:Name="DetailMetaText"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,14,0,0" Padding="12" Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                <StackPanel>
                                    <TextBlock Text="申诉理由" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <TextBlock x:Name="AppealDetailsText" Margin="0,7,0,0" Style="{StaticResource BridgeBodyTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,9,0,0" Padding="12" Style="{StaticResource BridgeDirectoryRaisedStyle}">
                                <StackPanel>
                                    <TextBlock Text="原处理" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <TextBlock x:Name="SanctionDetailsText" Margin="0,7,0,0" Style="{StaticResource BridgeBodyTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="审核记录" Margin="0,14,0,7" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                            <StackPanel x:Name="AuditListPanel" />
                            <controls:ChamferBorder Margin="0,15,0,0"
                                                    Padding="13"
                                                    Style="{StaticResource BridgeDirectorySurfaceStyle}">
                                <StackPanel>
                                    <TextBlock Text="更新申诉结果" Style="{StaticResource BridgeDirectorySectionTitleStyle}" />
                                    <ComboBox x:Name="ReviewStatusComboBox" Height="34" Margin="0,11,0,0" Style="{StaticResource BridgeDirectoryComboBoxStyle}">
                                        <ComboBoxItem Content="审核中" Tag="reviewing" IsSelected="True" />
                                        <ComboBoxItem Content="通过并撤销原处理" Tag="accepted" />
                                        <ComboBoxItem Content="维持原处理" Tag="denied" />
                                    </ComboBox>
                                    <TextBlock Text="用户可见说明" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                    <TextBox x:Name="OutcomeSummaryTextBox" MinHeight="58" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                    <TextBlock Text="内部备注" Margin="0,11,0,5" Style="{StaticResource BridgeDirectoryLabelStyle}" />
                                    <TextBox x:Name="InternalNoteTextBox" MinHeight="64" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource BridgeDirectoryTextBoxStyle}" />
                                    <TextBlock Text="内部备注仅供审核人员查看。"
                                               Margin="0,5,0,0"
                                               Style="{StaticResource BridgeDirectoryAuxTextStyle}" />
                                    <Button x:Name="SaveReviewButton"
                                            Content="保存申诉结果"
                                            Width="132"
                                            Height="34"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource BridgeDirectoryPrimaryButtonStyle}"
                                            Click="SaveReviewButton_Click" />
                                </StackPanel>
                            </controls:ChamferBorder>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </controls:ChamferBorder>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:BridgeLoadingIndicator x:Name="OperationLoadingIndicator"
                                             Width="15"
                                             Height="15"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Style="{StaticResource BridgeDirectoryAuxTextStyle}"
                       Text="通过申诉会立即撤销原处理，请在保存前核对完整记录。" />
        </Grid>
    </Grid>
</UserControl>
