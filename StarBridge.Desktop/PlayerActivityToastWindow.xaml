<Window x:Class="StarBridge.Desktop.PlayerActivityToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Width="344"
        Height="84"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True">
    <Border x:Name="ToastCard"
            Margin="7"
            Background="#F20A1823"
            BorderBrush="#2A5871"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonUp="ToastCard_MouseLeftButtonUp"
            MouseEnter="ToastCard_MouseEnter"
            MouseLeave="ToastCard_MouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="AccentLine" />
            <Grid Grid.Row="1" Margin="12,9,12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="42" Height="42">
                    <ContentControl x:Name="InitialsText"
                                    Style="{StaticResource IdentityBeaconAvatarPlaceholderStyle}" />
                    <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="DisplayNameText"
                               Foreground="#EEF8FF"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="EventText"
                               Margin="0,4,0,0"
                               Foreground="#91A5B5"
                               FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" />
                    <TextBlock Text="刚刚" Foreground="#637A89" FontSize="10" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
