<UserControl x:Class="StarBridge.Desktop.ApplicationLayerHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Visibility="Collapsed"
             PreviewKeyDown="ApplicationLayerHost_PreviewKeyDown"
             SizeChanged="ApplicationLayerHost_SizeChanged">
    <Grid x:Name="LayerRoot">
        <Grid x:Name="WorkspaceLayer"
              Visibility="Collapsed"
              Background="#A602070D">
            <Rectangle Fill="{StaticResource ScanlineBrush}"
                       Opacity="0.34"
                       IsHitTestVisible="False" />

            <Border x:Name="WorkspaceFrame"
                    MaxWidth="1120"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PageBackgroundBrush}"
                    BorderBrush="#3B89AD"
                    BorderThickness="1"
                    CornerRadius="2"
                    ClipToBounds="True">
                <Grid Background="{StaticResource PageBackgroundBrush}">
                    <Rectangle Fill="{StaticResource VerticalStreakBrush}"
                               IsHitTestVisible="False" />
                    <Rectangle Fill="{StaticResource GeometricBackgroundBrush}"
                               IsHitTestVisible="False" />

                    <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F00B1A26"
                        BorderBrush="#294E6373"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="‹  返回"
                                Width="88"
                                Height="34"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}"
                                Click="WorkspaceBackButton_Click" />

                        <StackPanel Grid.Column="1"
                                    Margin="14,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="WorkspaceTitleText"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="WorkspaceSubtitleText"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="关闭"
                                MinWidth="74"
                                Height="34"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}"
                                Click="WorkspaceCloseButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Background="#F202070D"
                        BorderBrush="#243E596A"
                        BorderThickness="1">
                    <ContentPresenter x:Name="WorkspaceContentPresenter" />
                </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ModalLayer"
              Visibility="Collapsed"
              Background="#D902070D">
            <Rectangle Fill="{StaticResource ScanlineBrush}"
                       Opacity="0.42"
                       IsHitTestVisible="False" />

            <Border x:Name="ModalFrame"
                    MinWidth="420"
                    MinHeight="280"
                    Margin="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FC07131D"
                    BorderBrush="#3B89AD"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F0162634"
                            BorderBrush="#294E6373"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="16,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Border Width="2"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}" />
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,12,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ModalTitleText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ModalSubtitleText"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Tag="Close"
                                    AutomationProperties.Name="关闭"
                                    ToolTip="关闭"
                                    Style="{StaticResource CloseWindowCaptionButton}"
                                    Click="ModalCloseButton_Click" />
                        </Grid>
                    </Border>

                    <ContentPresenter x:Name="ModalContentPresenter"
                                      Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
