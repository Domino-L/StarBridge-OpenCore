<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:StarBridge.Desktop.Controls"
                    xmlns:theming="clr-namespace:StarBridge.Desktop.Theming">

    <Style x:Key="BridgeStateActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{DynamicResource BridgeGround}" />
        <Setter Property="FontFamily" Value="{DynamicResource BridgeCjkFont}" />
        <Setter Property="FontSize" Value="{DynamicResource BridgeFontAux}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource BridgeInk}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="FocusLayer"
                                BorderThickness="1"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                            </Border.BorderBrush>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.10" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:BridgeLoadingIndicator}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BridgeLoadingIndicator}">
                    <Grid x:Name="PART_RotatingVisual"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="PART_LoadingRingBase"
                                 Width="15"
                                 Height="15"
                                 Stroke="{DynamicResource BridgeHairline}"
                                 StrokeThickness="2" />
                        <Path Data="M 7.5,1 A 6.5,6.5 0 0 1 14,7.5"
                              StrokeThickness="2"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square">
                            <Path.Stroke>
                                <SolidColorBrush Color="{Binding AccentColor, Source={x:Static theming:SceneState.Current}}" />
                            </Path.Stroke>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:BridgeStatePresenter}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="22,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BridgeStatePresenter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel MaxWidth="460"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border x:Name="PART_StateIconSlot"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,0,9"
                                    Background="{DynamicResource BridgePanelRaised}">
                                <Grid>
                                    <controls:BridgeLoadingIndicator x:Name="PART_LoadingSpinner"
                                                                     Visibility="Collapsed" />
                                    <TextBlock x:Name="StateGlyph"
                                               Text="{TemplateBinding DisplayIcon}"
                                               FontFamily="{DynamicResource BridgeCjkFont}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BridgeInk2}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{TemplateBinding DisplayTitle}"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource BridgeInk}"
                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                       FontSize="{DynamicResource BridgeFontBodyStrong}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{TemplateBinding DisplayDescription}"
                                       Foreground="{DynamicResource BridgeInk2}"
                                       FontFamily="{DynamicResource BridgeCjkFont}"
                                       FontSize="{DynamicResource BridgeFontAux}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="PART_ActionButton"
                                    Margin="0,14,0,0"
                                    Content="{TemplateBinding DisplayActionText}"
                                    Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionCommandParameter}"
                                    Style="{StaticResource BridgeStateActionButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Loading">
                            <Setter TargetName="PART_LoadingSpinner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_LoadingSpinner" Property="IsActive" Value="True" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="Empty">
                            <Setter TargetName="PART_LoadingSpinner" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="PART_LoadingSpinner" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource BridgeStatusBad}" />
                        </Trigger>
                        <Trigger Property="State" Value="AccessDenied">
                            <Setter TargetName="PART_LoadingSpinner" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="OfflineCache">
                            <Setter TargetName="PART_LoadingSpinner" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StateGlyph" Property="Foreground" Value="{DynamicResource BridgeStatusWarn}" />
                        </Trigger>
                        <Trigger Property="HasAction" Value="True">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
