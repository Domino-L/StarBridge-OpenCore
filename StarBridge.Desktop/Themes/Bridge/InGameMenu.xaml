<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:StarBridge.Desktop.Theming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- One visual module serves both the live menu and its settings preview.
         Layout remains owned by each surface; colour and control shape do not. -->
    <Style x:Key="MenuTopActionButton" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
        <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                            <Setter TargetName="Surface"
                                    Property="BorderBrush"
                                    Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuCloseButton"
           TargetType="Button"
           BasedOn="{StaticResource MenuTopActionButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MenuDockButton" TargetType="Button">
        <Setter Property="Width" Value="82" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
        <Setter Property="Background" Value="{DynamicResource BridgePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BridgeHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="DockSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DockSurface" Property="Background" Value="{DynamicResource BridgeRowHover}" />
                            <Setter TargetName="DockSurface"
                                    Property="BorderBrush"
                                    Value="{Binding Path=(theming:BridgeSceneContext.AccentBrush), RelativeSource={RelativeSource Self}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DockSurface" Property="Background" Value="{DynamicResource BridgeRowSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DockSurface" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuDockGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MenuDockLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk2}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="MenuContextLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk3}" />
        <Setter Property="FontSize" Value="9" />
    </Style>

    <Style x:Key="MenuContextValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BridgeInk}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
</ResourceDictionary>
