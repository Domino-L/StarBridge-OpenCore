    <Style x:Key="IdentityBeaconAvatarPlaceholderStyle"
           TargetType="ContentControl">
        <Setter Property="Background" Value="#081923" />
        <Setter Property="Foreground" Value="#79CFF4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" />
                        <Viewbox Margin="5"
                                 Stretch="Uniform">
                            <Canvas Width="64" Height="64">
                                <Ellipse Canvas.Left="11"
                                         Canvas.Top="11"
                                         Width="42"
                                         Height="42"
                                         Fill="Transparent"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                         StrokeThickness="1.35"
                                         Opacity="0.24" />
                                <Path Data="M4,18 L4,4 L18,4 M46,4 L60,4 L60,18 M60,46 L60,60 L46,60 M18,60 L4,60 L4,46"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Opacity="0.58" />
                                <Ellipse Canvas.Left="25"
                                         Canvas.Top="17"
                                         Width="14"
                                         Height="14"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                         Opacity="0.88" />
                                <Path Data="M16,49 C18,39 24,34 32,34 C40,34 46,39 48,49 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      Opacity="0.78" />
                                <Path Data="M21,54 L43,54"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Opacity="0.42" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A real avatar and its fallback are mutually exclusive. Bind Tag to the
         original avatar value (path, data, or ImageSource); the beacon is only
         created visually while that value is absent. -->
    <Style x:Key="IdentityBeaconAvatarFallbackStyle"
           TargetType="ContentControl"
           BasedOn="{StaticResource IdentityBeaconAvatarPlaceholderStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Tag" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

