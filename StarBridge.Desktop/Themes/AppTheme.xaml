    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Height" Value="50" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid Width="18"
                              Height="18"
                              Margin="0,1,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True">
                            <Rectangle x:Name="MinimizeIcon"
                                       Height="1"
                                       Width="12"
                                       Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <Rectangle x:Name="MaximizeIcon"
                                       Width="10"
                                       Height="10"
                                       Stroke="{TemplateBinding Foreground}"
                                       StrokeThickness="1"
                                       Fill="Transparent"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <Grid x:Name="RestoreIcon"
                                  Width="14"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Rectangle Width="8"
                                           Height="8"
                                           Stroke="{TemplateBinding Foreground}"
                                           StrokeThickness="1"
                                           Fill="Transparent"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0" />
                                <Rectangle Width="8"
                                           Height="8"
                                           Stroke="{TemplateBinding Foreground}"
                                           StrokeThickness="1"
                                           Fill="Transparent"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Margin="2,5,0,0" />
                            </Grid>
                            <Grid x:Name="CloseIcon"
                                  Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Line X1="2" Y1="2" X2="10" Y2="10"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square" />
                                <Line X1="10" Y1="2" X2="2" Y2="10"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1"
                                      StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Minimize">
                            <Setter TargetName="MinimizeIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Maximize">
                            <Setter TargetName="MaximizeIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Restore">
                            <Setter TargetName="RestoreIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Close">
                            <Setter TargetName="CloseIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionChrome" Property="Background" Value="#263C5061" />
                            <Setter Property="Foreground" Value="#F2FAFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionChrome" Property="Opacity" Value="0.75" />
                            <Setter TargetName="CaptionChrome" Property="Background" Value="#1E304250" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CaptionChrome" Property="BorderBrush" Value="#2E8FBA" />
                            <Setter Property="Foreground" Value="#F2FAFF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Close" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaptionChrome" Property="Background" Value="#2A171B" />
                            <Setter TargetName="CaptionChrome" Property="BorderBrush" Value="#6A343B" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
