                                    <Grid Width="24"
                                          Height="24">
                                        <Path Data="M4.5,5.5 H15.2 V8.8 H4.5 Z M4.5,10.4 H15.2 V13.7 H4.5 Z M4.5,15.3 H15.2 V18.6 H4.5 Z"
