        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonChrome"
                            Margin="4,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="HoverWash"
                                       Fill="#14283A"
                                       Opacity="0" />
                            <Rectangle x:Name="ActiveWash"
                                       Fill="#1E2F4968"
                                       Opacity="0" />
                            <Rectangle x:Name="Rail"
                                       Width="3.5"
                                       HorizontalAlignment="Left"
                                       Fill="{StaticResource AvionicsRouteLightBrush}"
                                       Opacity="0" />
                            <StackPanel x:Name="MenuContent"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <TextBlock x:Name="MenuGlyph"
                                           Width="28"
                                           Text="{TemplateBinding CommandParameter}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter x:Name="MenuLabel"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="13,0,0,0"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0.82" />
                            <Setter Property="Foreground" Value="#EAF6FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="#A9DFFF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="ActiveWash" Property="Opacity" Value="1" />
                            <Setter TargetName="Rail" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#F2FAFF" />
                            <Setter TargetName="MenuGlyph" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#69CCFF"
                                                      BlurRadius="6"
                                                      ShadowDepth="0"
                                                      Opacity="0.32" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="MenuContent" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="MenuContent" Property="Margin" Value="0" />
                            <Setter TargetName="MenuLabel" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveWash" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FleetShipRailButton" TargetType="Button" BasedOn="{StaticResource FleetRailButton}">
