<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);STARBRIDGE_HOST_RUNTIME</DefineConstants>
    <!-- Temporary, private diagnostic candidate only; off in ordinary builds. -->
    <DefineConstants Condition="'$(StarBridgeSessionProbeEnabled)' == 'true'">$(DefineConstants);STARBRIDGE_SESSION_PROBE</DefineConstants>
    <StarBridgeMemberReadProbeEnabled Condition="'$(StarBridgeMemberReadProbeEnabled)' == ''">false</StarBridgeMemberReadProbeEnabled>
    <DefineConstants Condition="'$(StarBridgeMemberReadProbeEnabled)' == 'true'">$(DefineConstants);STARBRIDGE_MEMBER_READ_PROBE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Saved source-preset workspaces are a normal client capability. Only
         explicitly selected diagnostic profiles may compile this support out. -->
    <StarBridgeEnableOverlaySourcePresets Condition="'$(StarBridgeEnableOverlaySourcePresets)' == ''">true</StarBridgeEnableOverlaySourcePresets>
    <DefineConstants Condition="'$(StarBridgeEnableOverlaySourcePresets)' == 'true'">$(DefineConstants);STARBRIDGE_OVERLAY_SOURCE_PRESETS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="StarBridgeEnableOverlaySourcePresets" Value="$(StarBridgeEnableOverlaySourcePresets)" />
    <AssemblyMetadata Include="StarBridgeAcceptanceMediaFree" Value="$(StarBridgeAcceptanceMediaFree)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarBridge.Core\StarBridge.Core.csproj" />
    <ProjectReference Include="..\StarBridge.NativeBridge\StarBridge.NativeBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../shared/client-policies/NotificationSettings.cs" Link="Notifications/WpfNotificationSettings.cs" />
    <Compile Include="../shared/client-policies/PlayerActivityNotificationPolicy.cs" Link="Notifications/WpfPlayerActivityPolicy.cs" />
    <!-- Pure client rules have no dependency on the retired UI source tree. -->
    <Compile Include="../shared/client-policies/PartyRoomTagCatalog.cs" Link="PartyRooms/PartyRoomTagCatalog.cs" />
    <Compile Include="../shared/client-policies/GameServerRegionPresentation.cs" Link="PartyRooms/GameServerRegionPresentation.cs" />
    <Compile Include="../shared/community-queries/CommunityDirectoryFilters.cs" Link="Communities/CommunityDirectoryFilters.cs" />
    <Compile Include="../shared/community-queries/CommunityShipQuery.cs" Link="Communities/CommunityShipQuery.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared display names only; schema and provenance remain source-only. -->
    <EmbeddedResource Include="../release-notes/catalog.json" LogicalName="StarBridge.ReleaseNotes.catalog.json" />
    <EmbeddedResource Include="../deploy/update-signing-public.xml" LogicalName="StarBridge.Updates.update-signing-public.xml" />
    <EmbeddedResource Include="../deploy/update-signing-public-v2.xml" LogicalName="StarBridge.Updates.update-signing-public-v2.xml" />
    <EmbeddedResource Include="..\data\ship-names\ship-name-pack.json"
                      LogicalName="StarBridge.ShipNamePack.json" />
    <EmbeddedResource Include="$(StarBridgeShipDisplayCatalogPath)"
                      LogicalName="StarBridge.ShipDisplayCatalog.tsv"
                      Condition="'$(StarBridgeIncludeRestrictedGameData)' == 'true' and Exists('$(StarBridgeShipDisplayCatalogPath)')" />
    <EmbeddedResource Include="$(StarBridgeShipDisplayReviewPath)"
                      LogicalName="StarBridge.ShipDisplayReview.json"
                      Condition="'$(StarBridgeIncludeRestrictedGameData)' == 'true' and Exists('$(StarBridgeShipDisplayReviewPath)')" />
    <EmbeddedResource Include="../StarBridge.Desktop/Data/ship-loaner-matrix.tsv"
                      LogicalName="StarBridge.ShipLoanerMatrix.tsv"
                      Condition="'$(StarBridgeIncludeRestrictedGameData)' == 'true' and Exists('../StarBridge.Desktop/Data/ship-loaner-matrix.tsv')" />
    <EmbeddedResource Include="../StarBridge.Desktop/Data/starbridge_location_catalog.json"
                      LogicalName="StarBridge.LocationHierarchy.json"
                      Condition="'$(StarBridgeAcceptanceMediaFree)' != 'true' and Exists('../StarBridge.Desktop/Data/starbridge_location_catalog.json')" />
    <EmbeddedResource Include="..\data\location-names\location-name-pack.json"
                      LogicalName="StarBridge.LocationCatalog.json"
                      Condition="'$(StarBridgeAcceptanceMediaFree)' != 'true' and Exists('..\data\location-names\location-name-pack.json')" />
    <EmbeddedResource Include="../StarBridge.Desktop/Data/location-names-zh.txt"
                      LogicalName="StarBridge.LocationCompatibilityNames.txt"
                      Condition="'$(StarBridgeIncludeRestrictedGameData)' == 'true' and Exists('../StarBridge.Desktop/Data/location-names-zh.txt')" />
    <!-- Private local test assets, never an official redistribution grant. -->
    <EmbeddedResource Include="../StarBridge.Flutter/assets/ships/catalog-manifest.json"
                      LogicalName="StarBridge.ShipMedia.json"
                      Condition="'$(StarBridgeIncludeThirdPartyMedia)' == 'true' and Exists('../StarBridge.Flutter/assets/ships/catalog-manifest.json')" />
  </ItemGroup>

  <!-- Optional externally owned modules; public builds never import these. -->
  <Import Project="$(StarBridgePrivateAppearanceRoot)/Host/StarBridge.PrivateHost.projitems"
          Condition="'$(StarBridgeIncludeCommercialAppearances)' == 'true' and '$(StarBridgePrivateAppearanceRoot)' != '' and Exists('$(StarBridgePrivateAppearanceRoot)/Host/StarBridge.PrivateHost.projitems')" />
  <Import Project="$(StarBridgePrivateOfflineReceiptRoot)/Host/StarBridge.OfflineReceipts.projitems"
          Condition="'$(StarBridgeIncludeCommercialAppearances)' == 'true' and '$(StarBridgePrivateOfflineReceiptRoot)' != '' and Exists('$(StarBridgePrivateOfflineReceiptRoot)/Host/StarBridge.OfflineReceipts.projitems')" />
  <ItemGroup>
    <AssemblyMetadata Include="StarBridgeMemberReadProbeEnabled" Value="$(StarBridgeMemberReadProbeEnabled)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../shared/community-queries/CommunityImageUpload.cs" Link="Communities/CommunityImageUpload.cs" />
  </ItemGroup>
</Project>
